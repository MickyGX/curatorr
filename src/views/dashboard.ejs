<%- include('partials/head', { pageTitle: title || 'Dashboard — Curatorr', extraCss: extraCss || ['/styles-layout.css', '/styles-curatorr.css'] }) %>
<body class="dash-body">
  <style>
    .dash-content--dashboard .cur-panel--stats .cur-stat-value--sm {
      font-size: 14px;
      line-height: 1.2;
    }
  </style>
  <div class="dash-frame<%= sidebarCollapsed ? ' sidebar-collapsed' : '' %>">
    <aside class="dash-sidebar">
      <div class="dash-brand">
        <span class="dash-logo">
          <img class="nav-icon app-icon" src="/icons/curatorr-icon.svg" alt="Curatorr" onerror="this.style.display='none'" />
        </span>
        <div>
          <div class="dash-title">Curatorr</div>
        </div>
      </div>

      <div class="dash-nav">
        <%- include('partials/nav-categories', { navActivePage: 'dashboard', role: role }) %>
      </div>

      <%- include('partials/user-menu') %>
    </aside>

    <section class="dash-main">
      <div class="main-window-bar">
        <button class="sidebar-toggle main-toggle left-toggle" type="button" aria-label="Toggle sidebar">
          <img class="toggle-icon" src="/icons/sidebar-toggle.svg" alt="" />
        </button>
        <div class="main-window-title">
          <img class="main-window-icon" src="/icons/dashboard.svg" alt="" />
          <span class="main-window-app">Curatorr</span>
          <span class="main-window-rest">| Dashboard</span>
        </div>
        <div class="main-window-spacer"></div>
        <div class="main-window-status">
          <span class="status-dot"></span>
        </div>
      </div>

      <div class="dash-content dash-content--dashboard">
        <%- include('partials/plex-banner') %>
        <%
          const _stats7d = stats7d || { plays: 0, skips: 0, skipRate: 0 };
          const _stats30d = stats30d || { plays: 0, skips: 0, skipRate: 0 };
          const _byDay = Array.isArray(byDay) ? byDay : [];
          const _topArtists = Array.isArray(topArtists) ? topArtists : [];
          const _topTracks = Array.isArray(topTracks) ? topTracks : [];
          const _recentHistory = Array.isArray(recentHistory) ? recentHistory : [];
          const _dashboardPlaylists = Array.isArray(dashboardPlaylists) ? dashboardPlaylists : [];
          const _lidarrStatus = lidarrStatus && typeof lidarrStatus === 'object' ? lidarrStatus : { items: [], counts: {} };
          const _maxPlays = _byDay.reduce((m, d) => Math.max(m, d.plays || 0), 1);
          const _masterTrackCount = Number(masterTrackCount || 0);
          const _masterArtistCount = Number(masterArtistCount || 0);
          const _heardTrackCount = Number(heardTrackCount || 0);
          const _belterTrackCount = Number(belterTrackCount || 0);
          const _excludedTrackCount = Number(excludedTrackCount || 0);
          const _skipTierArtistCount = Number(skipTierArtistCount || 0);
          const _lastPlaylistSync = lastPlaylistSync || null;

          function fmtTime(ms) {
            if (!ms) return '—';
            const s = Math.floor(ms / 1000);
            const m = Math.floor(s / 60);
            const h = Math.floor(m / 60);
            if (h) return h + 'h ' + (m % 60) + 'm';
            if (m) return m + 'm ' + (s % 60) + 's';
            return s + 's';
          }
          function fmtListenTime(ms) {
            if (!ms) return '—';
            const totalMins = Math.floor(ms / 60000);
            if (totalMins >= 60) {
              const hours = Math.round((totalMins / 60) * 10) / 10;
              return String(hours).replace(/\.0$/, '') + 'h';
            }
            const m = totalMins % 60;
            return m + 'm';
          }
          function fmtDate(ts) {
            if (!ts) return '—';
            return new Date(ts).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
          }
          function fmtRelative(ts) {
            if (!ts) return 'never';
            const diff = Date.now() - ts;
            const mins = Math.floor(diff / 60000);
            const hours = Math.floor(mins / 60);
            const days = Math.floor(hours / 24);
            if (mins < 2) return 'just now';
            if (mins < 60) return mins + 'm ago';
            if (hours < 24) return hours + 'h ago';
            return days + 'd ago';
          }
        %>

        <%# ── Stat cards widget bar ─────────────────────────────────────── %>
        <%
          const _statsAll = statsAll || { plays: 0, skips: 0, skipRate: 0, uniqueArtists: 0, uniqueTracks: 0, totalListenMs: 0 };
          const _periodSummaryLabel = '7d / 30d / all time';
          const _pFmt = {
            plays: [
              Number(_stats7d.plays || 0).toLocaleString(),
              Number(_stats30d.plays || 0).toLocaleString(),
              Number(_statsAll.plays || 0).toLocaleString(),
            ].join(' / '),
            skips: [
              Number(_stats7d.skips || 0).toLocaleString(),
              Number(_stats30d.skips || 0).toLocaleString(),
              Number(_statsAll.skips || 0).toLocaleString(),
            ].join(' / '),
            skipRate: [
              (_stats7d.plays ? Math.round(_stats7d.skipRate * 100) : 0) + '%',
              (_stats30d.plays ? Math.round(_stats30d.skipRate * 100) : 0) + '%',
              (_statsAll.plays ? Math.round(_statsAll.skipRate * 100) : 0) + '%',
            ].join(' / '),
            listenTime: [
              fmtListenTime(_stats7d.totalListenMs),
              fmtListenTime(_stats30d.totalListenMs),
              fmtListenTime(_statsAll.totalListenMs),
            ].join(' / '),
            artists: [
              Number(_stats7d.uniqueArtists || 0).toLocaleString(),
              Number(_stats30d.uniqueArtists || 0).toLocaleString(),
              Number(_statsAll.uniqueArtists || 0).toLocaleString(),
            ].join(' / '),
            tracks: [
              Number(_stats7d.uniqueTracks || 0).toLocaleString(),
              Number(_stats30d.uniqueTracks || 0).toLocaleString(),
              Number(_statsAll.uniqueTracks || 0).toLocaleString(),
            ].join(' / '),
          };
          const _statIcons = {
            plays:      '<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 3l9 5-9 5V3z"/></svg>',
            skips:      '<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3 3l7 5-7 5V3zm7 0h2v10h-2z"/></svg>',
            skipRate:   '<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="5.2" cy="5.2" r="1.8"/><circle cx="10.8" cy="10.8" r="1.8"/><path d="M12.5 3.5l-9 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/></svg>',
            listenTime: '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="6"/><path d="M8 5v3l2.5 2"/></svg>',
            artists:    '<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="5" r="2.5"/><path d="M2 14c0-3.3 2.7-5 6-5s6 1.7 6 5H2z"/></svg>',
            tracks:     '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z"/></svg>',
          };
          const _statCards = [
            { key: 'plays',      label: 'Plays',       mod: ''     },
            { key: 'skips',      label: 'Skips',       mod: 'skip' },
            { key: 'skipRate',   label: 'Skip rate',   mod: ''     },
            { key: 'listenTime', label: 'Listen time', mod: ''     },
            { key: 'artists',    label: 'Artists',     mod: ''     },
            { key: 'tracks',     label: 'Tracks',      mod: ''     },
          ];
        %>
        <div class="cur-panel cur-panel--stats" data-panel-key="dashboard-stats">
          <div class="cur-panel-header">
            <h3 class="cur-panel-title">Overview Stats</h3>
          </div>
          <div class="cur-panel-body">
            <div class="cur-stat-row">
              <% _statCards.forEach(function(card) { %>
                <div class="cur-stat-card<%= card.mod ? ' cur-stat-card--' + card.mod : '' %>">
                  <div class="cur-stat-body">
                    <div class="cur-stat-label"><%= card.label %></div>
                    <div class="cur-stat-value cur-stat-value--sm"><%= _pFmt[card.key] %></div>
                    <div class="cur-stat-sub"><%= _periodSummaryLabel %></div>
                  </div>
                  <div class="cur-stat-icon"><%- _statIcons[card.key] || '' %></div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>

        <%# ── Library at a glance ────────────────────────────────────────── %>
        <div class="cur-panel cur-panel--library-glance" data-panel-key="dashboard-library">
          <div class="cur-panel-header">
            <h3 class="cur-panel-title">Curatorr at a glance</h3>
          </div>
          <div class="cur-panel-body">
            <div class="cur-stat-row cur-stat-row--glance">
              <div class="cur-stat-card cur-stat-card--glance">
                <div class="cur-stat-body">
                  <div class="cur-stat-label">Library tracks</div>
                  <div class="cur-stat-value"><%= _masterTrackCount.toLocaleString() %></div>
                  <div class="cur-stat-sub">in master cache</div>
                </div>
                <div class="cur-stat-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="8" cy="8" r="6"/><circle cx="8" cy="8" r="2.4"/><circle cx="8" cy="8" r=".9" fill="currentColor" stroke="none"/></svg></div>
              </div>
              <div class="cur-stat-card cur-stat-card--glance">
                <div class="cur-stat-body">
                  <div class="cur-stat-label">Tracks heard</div>
                  <div class="cur-stat-value"><%= _heardTrackCount.toLocaleString() %></div>
                  <% if (_masterTrackCount > 0) { %>
                    <div class="cur-stat-sub"><%= Math.round(_heardTrackCount / _masterTrackCount * 100) %>% of library</div>
                  <% } else { %><div class="cur-stat-sub">—</div><% } %>
                </div>
                <div class="cur-stat-icon"><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 2a6 6 0 0 0-6 6v2.5A1.5 1.5 0 0 0 3.5 12H5V9H3a5 5 0 0 1 10 0h-2v3h1.5A1.5 1.5 0 0 0 14 10.5V8a6 6 0 0 0-6-6z"/></svg></div>
              </div>
              <div class="cur-stat-card cur-stat-card--glance cur-stat-card--belter">
                <div class="cur-stat-body">
                  <div class="cur-stat-label">Belter tracks</div>
                  <div class="cur-stat-value"><%= _belterTrackCount.toLocaleString() %></div>
                  <div class="cur-stat-sub">fully played</div>
                </div>
                <div class="cur-stat-icon"><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1.5l1.6 3.4 3.7.5-2.7 2.6.7 3.8L8 10.1l-3.3 1.7.7-3.8-2.7-2.6 3.7-.5L8 1.5z"/></svg></div>
              </div>
              <div class="cur-stat-card cur-stat-card--glance<%= _excludedTrackCount > 0 ? ' cur-stat-card--warn' : '' %>">
                <div class="cur-stat-body">
                  <div class="cur-stat-label">Excluded tracks</div>
                  <div class="cur-stat-value"><%= _excludedTrackCount.toLocaleString() %></div>
                  <div class="cur-stat-sub">skipped out</div>
                </div>
                <div class="cur-stat-icon"><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm3.5 7.75h-7v-1.5h7v1.5z"/></svg></div>
              </div>
              <div class="cur-stat-card cur-stat-card--glance<%= _skipTierArtistCount > 0 ? ' cur-stat-card--warn' : '' %>">
                <div class="cur-stat-body">
                  <div class="cur-stat-label">Low-rated artists</div>
                  <div class="cur-stat-value"><%= _skipTierArtistCount %></div>
                  <div class="cur-stat-sub">below threshold</div>
                </div>
                <div class="cur-stat-icon"><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1.5L1 14h14L8 1.5zM7.25 6.5h1.5V10h-1.5V6.5zm0 4.25h1.5v1.75h-1.5v-1.75z"/></svg></div>
              </div>
              <div class="cur-stat-card cur-stat-card--glance">
                <div class="cur-stat-body">
                  <div class="cur-stat-label">Library artists</div>
                  <div class="cur-stat-value"><%= _masterArtistCount.toLocaleString() %></div>
                  <div class="cur-stat-sub">unique in library</div>
                </div>
                <div class="cur-stat-icon"><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="5.5" cy="4.5" r="2.2"/><circle cx="10.5" cy="4.5" r="2.2"/><path d="M0.5 13.5c0-2.8 2.2-4.5 5-4.5s5 1.7 5 4.5H0.5z"/><path d="M10.5 9.2c1.7.3 3 1.7 3 4.3H13"/></svg></div>
              </div>
            </div>
          </div>
        </div>

        <%# ── Active streams + Activity chart side by side ──────────────── %>
        <div class="cur-two-col cur-two-col--streams-chart">
        <div class="cur-panel cur-panel--streams" id="cur-streams-panel">
          <div class="cur-panel-header">
            <h3 class="cur-panel-title">
              <span class="cur-stream-dot" id="cur-stream-dot"></span>
              Now playing
            </h3>
            <div class="cur-panel-actions">
              <span class="cur-streams-count" id="cur-streams-count" style="display:none"></span>
              <button class="btn btn-sm btn-ghost cur-nav-button cur-nav-button--compact" type="button" id="curStreamsPrev" aria-label="Previous">
                <span class="cur-nav-chev cur-nav-chev--left" aria-hidden="true"></span>
              </button>
              <button class="btn btn-sm btn-ghost cur-nav-button cur-nav-button--compact" type="button" id="curStreamsNext" aria-label="Next">
                <span class="cur-nav-chev cur-nav-chev--right" aria-hidden="true"></span>
              </button>
            </div>
          </div>
          <div class="cur-panel-body cur-panel-body--streams">
            <div id="cur-streams-body" class="cur-streams-body">
              <div class="cur-streams-viewport plex-carousel-viewport" id="cur-streams-viewport">
                <div id="cur-streams-track" class="cur-streams-track plex-carousel-track"></div>
              </div>
            </div>
          </div>
        </div>

        <%# ── Activity chart ──────────────────────────────────────────────── %>
        <div class="cur-panel cur-panel--plays-chart">
          <div class="cur-panel-header">
            <h3 class="cur-panel-title">Plays last 14 days</h3>
          </div>
          <div class="cur-panel-body cur-panel-body--plays-chart">
            <div class="cur-bar-chart">
              <% _byDay.forEach(function(day) { %>
                <%
                  const barPct = _maxPlays > 0 ? Math.round((day.plays / _maxPlays) * 100) : 0;
                  const skipPct = day.plays > 0 ? Math.round((day.skips / day.plays) * 100) : 0;
                %>
                <div class="cur-bar-col" title="<%= day.label %>: <%= day.plays %> plays, <%= day.skips %> skips">
                  <div class="cur-bar-wrap">
                    <div class="cur-bar" style="height:<%= barPct %>%">
                      <% if (day.skips > 0) { %>
                        <div class="cur-bar-skip" style="height:<%= skipPct %>%"></div>
                      <% } %>
                    </div>
                  </div>
                  <div class="cur-bar-label"><%= day.label %></div>
                </div>
              <% }) %>
              <% if (!_byDay.length) { %>
                <div class="cur-empty">No play data yet. Plays will appear here once your media server starts sending events.</div>
              <% } %>
            </div>
          </div>
        </div>
        </div><%# end cur-two-col--streams-chart %>

        <div class="cur-panel cur-panel--lidarr">
          <div class="cur-panel-header">
            <h3 class="cur-panel-title">Artist activity</h3>
            <div class="cur-panel-actions">
              <a href="/discover" class="cur-panel-link">View all</a>
            </div>
          </div>
          <div class="cur-panel-body">
            <% if ((_lidarrStatus.items || []).length) { %>
              <ul class="cur-list">
                <% _lidarrStatus.items.slice(0, 5).forEach(function(item) { %>
                  <li class="cur-list-item cur-list-item--stack">
                    <span class="cur-list-thumb cur-overview-trigger" role="button" tabindex="0" data-cur-overview-kind="artist" data-cur-overview-name="<%= item.artistName %>">
                      <img src="/api/music/thumb/artist/<%= encodeURIComponent(item.artistName) %>" alt="" loading="lazy" onerror="this.style.visibility='hidden'" />
                    </span>
                    <span class="cur-list-primary">
                      <span class="cur-list-name cur-overview-trigger" role="button" tabindex="0" data-cur-overview-kind="artist" data-cur-overview-name="<%= item.artistName %>"><%= item.artistName %></span>
                      <% if (item.detail) { %>
                        <span class="cur-list-sub"><%= item.detail %></span>
                      <% } %>
                    </span>
                    <span class="cur-badge cur-badge--<%= item.tone || 'neutral' %>"><%= item.label %></span>
                  </li>
                <% }) %>
              </ul>
            <% } else if (Object.keys(_lidarrStatus.counts || {}).length) { %>
              <div class="cur-panel-foot">
                <span class="cur-panel-meta">No artist rows yet, but Lidarr activity has been recorded.</span>
              </div>
            <% } %>
          </div>
        </div>

        <div class="cur-two-col">
          <%# ── Top artists ──────────────────────────────────────────────── %>
          <div class="cur-panel">
            <div class="cur-panel-header">
              <h3 class="cur-panel-title">Top artists (30d)</h3>
              <a href="/artists" class="cur-panel-link">View all</a>
            </div>
            <div class="cur-panel-body">
              <% if (_topArtists.length) { %>
                <ul class="cur-list">
                  <% _topArtists.forEach(function(a) { %>
                    <li class="cur-list-item">
                      <span class="cur-list-thumb cur-overview-trigger" role="button" tabindex="0" data-cur-overview-kind="artist" data-cur-overview-name="<%= a.artist_name %>">
                        <img src="/api/music/thumb/artist/<%= encodeURIComponent(a.artist_name) %>" alt="" loading="lazy" onerror="this.style.visibility='hidden'" />
                      </span>
                      <span class="cur-list-primary">
                        <span class="cur-list-titleline">
                          <span class="cur-list-name cur-overview-trigger" role="button" tabindex="0" data-cur-overview-kind="artist" data-cur-overview-name="<%= a.artist_name %>"><%= a.artist_name %></span>
                          <% if (a.curatorrTier) { %><span class="cur-badge cur-badge--<%= a.curatorrTier.tone %>"><%= a.curatorrTier.label %></span><% } %>
                        </span>
                        <% const _score = Math.min(10, Math.max(0, Number(a.ranking_score || 5))); %>
                        <span class="cur-artist-score-bar" title="Curatorr score: <%= _score.toFixed(1) %>/10">
                          <span class="cur-artist-score-fill" style="width:<%= Math.round(_score * 10) %>%"></span>
                        </span>
                      </span>
                      <span class="cur-list-meta"><%= a.total_plays %> plays</span>
                    </li>
                  <% }) %>
                </ul>
              <% } else { %>
                <div class="cur-empty">No artist data yet.</div>
              <% } %>
            </div>
          </div>

          <%# ── Top tracks ───────────────────────────────────────────────── %>
          <div class="cur-panel">
            <div class="cur-panel-header">
              <h3 class="cur-panel-title">Top tracks (30d)</h3>
              <a href="/tracks" class="cur-panel-link">View all</a>
            </div>
            <div class="cur-panel-body">
              <% if (_topTracks.length) { %>
                <ul class="cur-list">
                  <% _topTracks.forEach(function(t) { %>
                    <li class="cur-list-item">
                      <span class="cur-list-thumb cur-overview-trigger" role="button" tabindex="0" data-cur-overview-kind="track" data-cur-overview-key="<%= t.rating_key || '' %>">
                        <img src="/api/music/thumb/track/<%= encodeURIComponent(t.rating_key || '') %>" alt="" loading="lazy" onerror="this.style.visibility='hidden'" />
                      </span>
                      <div class="cur-list-primary">
                        <span class="cur-list-titleline">
                          <span class="cur-list-name cur-overview-trigger" role="button" tabindex="0" data-cur-overview-kind="track" data-cur-overview-key="<%= t.rating_key || '' %>"><%= t.track_title %></span>
                          <% if (Number(t.popularRank || 0) > 0 && Number(t.popularRank || 0) <= 3 && Number(t.ratingCount || 0) > 0) { %><span class="cur-track-flame" title="Popular on this album — Top <%= t.popularRank %> by Plex rating count (<%= Number(t.ratingCount || 0).toLocaleString() %>)" aria-label="Popular on this album">🔥</span><% } %>
                          <% if (t.curatorrTier) { %><span class="cur-badge cur-badge--<%= t.curatorrTier.tone %>"><%= t.curatorrTier.label %></span><% } %>
                        </span>
                        <span class="cur-list-sub cur-overview-trigger" role="button" tabindex="0" data-cur-overview-kind="artist" data-cur-overview-name="<%= t.artist_name %>"><%= t.artist_name %></span>
                      </div>
                      <span class="cur-list-meta"><%= t.total_plays %> plays</span>
                    </li>
                  <% }) %>
                </ul>
              <% } else { %>
                <div class="cur-empty">No track data yet.</div>
              <% } %>
            </div>
          </div>
        </div>

        <%# ── Recent history ──────────────────────────────────────────────── %>
        <div class="cur-panel">
          <div class="cur-panel-header">
            <h3 class="cur-panel-title">Recent plays</h3>
            <a href="/history" class="cur-panel-link">View all</a>
          </div>
          <div class="cur-panel-body">
            <% if (_recentHistory.length) { %>
              <div class="cur-history-table">
                <div class="cur-history-head">
                  <span>Track</span>
                  <span>Artist</span>
                  <span>Listened</span>
                  <span>When</span>
                </div>
                <% _recentHistory.forEach(function(h) { %>
                  <%
                    const _completionPct = h.track_duration_ms > 0
                      ? Math.min(100, Math.round(h.duration_ms / h.track_duration_ms * 100))
                      : null;
                  %>
                  <div class="cur-history-row<%= h.is_skip ? ' cur-history-row--skip' : '' %>">
                    <span class="cur-history-track">
                      <span class="cur-history-track-main">
                        <span class="cur-overview-trigger" role="button" tabindex="0" data-cur-overview-kind="track" data-cur-overview-key="<%= h.plex_rating_key || '' %>" data-cur-overview-user="<%= h.user_plex_id || '' %>"><%= h.track_title || '—' %></span>
                        <% if (Number(h.popularRank || 0) > 0 && Number(h.popularRank || 0) <= 3 && Number(h.ratingCount || 0) > 0) { %><span class="cur-track-flame" title="Popular on this album — Top <%= h.popularRank %> by Plex rating count (<%= Number(h.ratingCount || 0).toLocaleString() %>)" aria-label="Popular on this album">🔥</span><% } %>
                        <% if (h.curatorrTier) { %><span class="cur-badge cur-badge--<%= h.curatorrTier.tone %>"><%= h.curatorrTier.label %></span><% } %>
                      </span>
                      <span class="cur-history-track-sub cur-overview-trigger" role="button" tabindex="0" data-cur-overview-kind="artist" data-cur-overview-name="<%= h.artist_name || '' %>" data-cur-overview-user="<%= h.user_plex_id || '' %>"><%= h.artist_name || '—' %></span>
                    </span>
                    <span class="cur-history-artist cur-overview-trigger" role="button" tabindex="0" data-cur-overview-kind="artist" data-cur-overview-name="<%= h.artist_name || '' %>" data-cur-overview-user="<%= h.user_plex_id || '' %>"><%= h.artist_name || '—' %></span>
                    <span class="cur-history-dur">
                      <%= fmtTime(h.duration_ms) %>
                      <% if (_completionPct !== null) { %>
                        <span class="cur-history-completion" title="<%= _completionPct %>% of track">
                          <span class="cur-history-completion-bar">
                            <span class="cur-history-completion-fill<%= _completionPct >= 90 ? ' cur-history-completion-fill--full' : '' %>" style="width:<%= _completionPct %>%"></span>
                          </span>
                        </span>
                      <% } %>
                    </span>
                    <span class="cur-history-when"><%= fmtDate(h.started_at) %></span>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="cur-empty">No play history yet. Play something in your media server to start tracking.</div>
            <% } %>
          </div>
        </div>

        <%# ── Playlists carousel ──────────────────────────────────────────── %>
        <div class="cur-panel cur-panel--dashboard-playlists">
          <div class="cur-panel-header">
            <h3 class="cur-panel-title">Playlists</h3>
            <div class="cur-panel-actions">
              <a href="/playlists" class="cur-panel-link">Manage</a>
              <button class="btn btn-sm btn-ghost cur-nav-button cur-nav-button--compact" type="button" id="curDashboardPlaylistsPrev" aria-label="Previous">
                <span class="cur-nav-chev cur-nav-chev--left" aria-hidden="true"></span>
              </button>
              <button class="btn btn-sm btn-ghost cur-nav-button cur-nav-button--compact" type="button" id="curDashboardPlaylistsNext" aria-label="Next">
                <span class="cur-nav-chev cur-nav-chev--right" aria-hidden="true"></span>
              </button>
            </div>
          </div>
          <div class="cur-panel-body cur-panel-body--dashboard-playlists">
            <% if (_dashboardPlaylists.length) { %>
              <div class="cur-dashboard-playlists-viewport plex-carousel-viewport" id="curDashboardPlaylistsViewport">
                <div class="cur-dashboard-playlists-track plex-carousel-track" id="curDashboardPlaylistsTrack">
                  <% _dashboardPlaylists.forEach(function(p) { %>
                    <article class="plex-card cur-discover-result-card cur-dashboard-playlist-card">
                      <div class="plex-poster-wrap cur-discover-poster-wrap cur-dashboard-playlist-poster-wrap">
                        <div class="plex-poster-well cur-discover-result-art cur-dashboard-playlist-art<%= p.artPath ? '' : ' is-empty' %>">
                          <% if (p.artPath) { %>
                            <img src="/api/plex/art?path=<%= encodeURIComponent(p.artPath) %>" alt="" loading="lazy" onerror="this.parentElement.classList.add('is-empty');this.remove()" />
                          <% } %>
                          <% if (p.curatorrUpdatedAt > 0) { %>
                            <div class="cur-delta-badge">
                              <% if (p.tracksAdded > 0) { %><span class="cur-delta cur-delta--up">↑<%= p.tracksAdded %></span><% } %>
                              <% if (p.tracksRemoved > 0) { %><span class="cur-delta cur-delta--down">↓<%= p.tracksRemoved %></span><% } %>
                              <% if (!p.tracksAdded && !p.tracksRemoved) { %><span class="cur-delta cur-delta--neutral">=</span><% } %>
                            </div>
                          <% } %>
                        </div>
                      </div>
                      <div class="plex-footer cur-discover-result-main cur-dashboard-playlist-main">
                        <div class="plex-name cur-discover-result-name cur-dashboard-playlist-title"><%= p.playlistTitle || 'Playlist' %></div>
                        <div class="plex-meta cur-discover-result-meta cur-dashboard-playlist-meta"><%= Number(p.trackCount || 0).toLocaleString() %> tracks</div>
                        <div class="plex-meta cur-discover-result-meta cur-dashboard-playlist-meta">Curatorr updated <%= fmtDate(p.curatorrUpdatedAt) %></div>
                      </div>
                    </article>
                  <% }) %>
                </div>
              </div>
            <% } else { %>
              <div class="cur-empty">No Curatorr playlists have been built yet.</div>
            <% } %>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script src="/sidebar.js?v=<%= assetVersion %>"></script>
  <script src="/user-menu.js?v=<%= assetVersion %>"></script>
  <script src="/version-badge.js?v=<%= assetVersion %>"></script>
  <script src="/brand-menu.js?v=<%= assetVersion %>"></script>
  <script src="/curatorr-overview.js?v=<%= assetVersion %>"></script>
  <script>
  (function() {
    var body   = document.getElementById('cur-streams-body');
    var vp     = document.getElementById('cur-streams-viewport');
    var track  = document.getElementById('cur-streams-track');
    var dot    = document.getElementById('cur-stream-dot');
    var cnt    = document.getElementById('cur-streams-count');
    var prev   = document.getElementById('curStreamsPrev');
    var next   = document.getElementById('curStreamsNext');
    var dragBound = false;

    function fmtMs(ms) {
      if (!ms) return '0:00';
      var s = Math.floor(ms / 1000), m = Math.floor(s / 60);
      return m + ':' + String(s % 60).padStart(2, '0');
    }
    function pct(offset, dur) {
      return dur > 0 ? Math.min(100, Math.round(offset / dur * 100)) : 0;
    }

    function artUrl(path) {
      return path ? '/api/plex/art?path=' + encodeURIComponent(path) : '';
    }

    function updateNav() {
      if (!vp || !prev || !next) return;
      var maxLeft = Math.max(0, vp.scrollWidth - vp.clientWidth - 2);
      prev.disabled = vp.scrollLeft <= 2;
      next.disabled = vp.scrollLeft >= maxLeft;
    }

    function bindDrag() {
      if (!vp || dragBound) return;
      dragBound = true;
      var down = false, startX = 0, startScroll = 0, moved = false;
      vp.addEventListener('pointerdown', function(e) {
        if (e.pointerType === 'mouse') return;
        down = true;
        moved = false;
        startX = e.clientX;
        startScroll = vp.scrollLeft;
        vp.classList.add('is-dragging');
        if (vp.setPointerCapture) vp.setPointerCapture(e.pointerId);
      });
      vp.addEventListener('pointermove', function(e) {
        if (!down) return;
        var d = e.clientX - startX;
        if (Math.abs(d) > 6) moved = true;
        vp.scrollLeft = startScroll - d;
        updateNav();
      });
      function end(e) {
        if (!down) return;
        down = false;
        vp.classList.remove('is-dragging');
        updateNav();
        if (e && vp.releasePointerCapture) try { vp.releasePointerCapture(e.pointerId); } catch(_) {}
      }
      vp.addEventListener('pointerup', end);
      vp.addEventListener('pointercancel', end);
      vp.addEventListener('pointerleave', function(e) { if (e.pointerType !== 'mouse') end(e); });
      vp.addEventListener('click', function(e) {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
          moved = false;
        }
      }, true);
      vp.addEventListener('scroll', updateNav, { passive: true });
    }

    function scrollStreams(dir) {
      if (!vp) return;
      vp.scrollBy({ left: dir * Math.max(280, Math.floor(vp.clientWidth * 0.82)), behavior: 'smooth' });
      window.setTimeout(updateNav, 220);
    }

    function escHtml(s) {
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
    function escAttr(s) {
      return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;');
    }

    function handleStreamImageError(img) {
      if (!img) return;
      var frame = img.parentElement;
      if (frame) frame.classList.add('is-empty');
      img.remove();
    }

    window.handleStreamImageError = handleStreamImageError;

    function renderEmptyCard() {
      if (!track) return;
      track.innerHTML =
        '<div class="plex-card cur-discover-result-card cur-stream-card cur-stream-card--empty">' +
          '<div class="plex-poster-wrap cur-discover-poster-wrap cur-stream-card-poster-wrap">' +
            '<div class="plex-poster-well cur-discover-result-art cur-stream-card-art is-empty">' +
              '<div class="cur-stream-empty-copy">' +
                '<div class="cur-stream-empty-title">No active streams</div>' +
                '<div class="cur-stream-empty-sub">Start a track in <%= mediaServerType === "jellyfin" ? "Jellyfin" : (mediaServerType === "emby" ? "Emby" : "Plex") %> and it will appear here.</div>' +
              '</div>' +
            '</div>' +
          '</div>' +
          '<div class="plex-footer cur-discover-result-main cur-stream-card-main">' +
            '<div class="cur-discover-result-name cur-stream-card-title">Nothing playing</div>' +
            '<div class="cur-discover-result-meta cur-stream-card-meta">Waiting for a music session</div>' +
          '</div>' +
        '</div>';
    }

    function render(sessions) {
      dot.className = 'cur-stream-dot' + (sessions.length ? ' cur-stream-dot--live' : '');
      if (sessions.length) {
        cnt.style.display = '';
        cnt.textContent = sessions.length + ' stream' + (sessions.length > 1 ? 's' : '');
      } else {
        cnt.style.display = 'none';
      }

      if (!sessions.length) {
        renderEmptyCard();
        if (prev) prev.disabled = true;
        if (next) next.disabled = true;
        updateNav();
        return;
      }
      if (!track) return;
      track.innerHTML = sessions.map(function(s) {
        var p = pct(s.viewOffset, s.duration);
        var isPaused = s.state === 'paused';
        var stateLabel = isPaused ? 'Paused' : 'Playing';
        var albumImg = artUrl(s.albumThumb || s.artistThumb);
        return '<div class="plex-card cur-discover-result-card cur-stream-card' + (isPaused ? ' cur-stream-card--paused' : '') + '">' +
          '<div class="plex-poster-wrap cur-discover-poster-wrap cur-stream-card-poster-wrap">' +
            '<div class="plex-poster-well cur-discover-result-art cur-stream-card-art">' +
              (albumImg
                ? '<img src="' + escAttr(albumImg) + '" alt="" loading="lazy" onerror="handleStreamImageError(this)" />'
                : '') +
              '<div class="cur-stream-card-badges">' +
                '<span class="cur-stream-card-user">@' + escHtml(s.userName || 'unknown') + '</span>' +
                '<span class="cur-stream-card-state' + (isPaused ? ' cur-stream-card-state--paused' : '') + '">' + escHtml(stateLabel) + '</span>' +
              '</div>' +
              '<div class="cur-stream-card-progress"><div class="cur-stream-card-progress-bar" style="width:' + p + '%"></div></div>' +
            '</div>' +
          '</div>' +
          '<div class="plex-footer cur-discover-result-main cur-stream-card-main">' +
            '<div class="cur-discover-result-name cur-stream-card-title"><span class="cur-overview-trigger" role="button" tabindex="0" data-cur-overview-kind="track" data-cur-overview-key="' + escAttr(s.key || '') + '">' + escHtml(s.title) + '</span></div>' +
            '<div class="cur-discover-result-meta cur-stream-card-meta"><span class="cur-overview-trigger" role="button" tabindex="0" data-cur-overview-kind="artist" data-cur-overview-name="' + escAttr(s.artist || '') + '">' + escHtml(s.artist || 'Unknown artist') + '</span>' +
              (s.album ? '<span class="cur-stream-card-sep"> · </span><span class="cur-overview-trigger" role="button" tabindex="0" data-cur-overview-kind="album" data-cur-overview-artist="' + escAttr(s.artist || '') + '" data-cur-overview-album="' + escAttr(s.album || '') + '">' + escHtml(s.album) + '</span>' : '') +
            '</div>' +
            '<div class="cur-stream-card-submeta">' +
              (s.playerTitle ? '<span>' + escHtml(s.playerTitle) + '</span>' : '') +
              '<span>' + escHtml(fmtMs(s.viewOffset) + ' / ' + fmtMs(s.duration)) + '</span>' +
            '</div>' +
          '</div>' +
        '</div>';
      }).join('');
      bindDrag();
      if (prev) prev.disabled = false;
      if (next) next.disabled = false;
      updateNav();
    }

    if (prev) {
      prev.addEventListener('click', function() { scrollStreams(-1); });
    }
    if (next) {
      next.addEventListener('click', function() { scrollStreams(1); });
    }
    window.addEventListener('resize', updateNav);

    function poll() {
      fetch('/api/media-server/sessions', { cache: 'no-store', headers: { Accept: 'application/json' } })
        .then(function(r){ return r.json(); })
        .then(function(d){ if (d.ok) render(d.sessions); })
        .catch(function(){ render([]); });
    }

    render([]);
    poll();
    setInterval(poll, 12000);
  })();

  (function() {
    var vp = document.getElementById('curDashboardPlaylistsViewport');
    var prev = document.getElementById('curDashboardPlaylistsPrev');
    var next = document.getElementById('curDashboardPlaylistsNext');
    if (!vp) {
      if (prev) prev.style.display = 'none';
      if (next) next.style.display = 'none';
      return;
    }

    var dragBound = false;

    function updateNav() {
      if (!prev || !next) return;
      var maxLeft = Math.max(0, vp.scrollWidth - vp.clientWidth - 2);
      prev.disabled = vp.scrollLeft <= 2;
      next.disabled = vp.scrollLeft >= maxLeft;
    }

    function bindDrag() {
      if (dragBound) return;
      dragBound = true;
      var down = false;
      var startX = 0;
      var startScroll = 0;
      var moved = false;
      vp.addEventListener('pointerdown', function(e) {
        if (e.pointerType === 'mouse') return;
        down = true;
        moved = false;
        startX = e.clientX;
        startScroll = vp.scrollLeft;
        vp.classList.add('is-dragging');
        if (vp.setPointerCapture) vp.setPointerCapture(e.pointerId);
      });
      vp.addEventListener('pointermove', function(e) {
        if (!down) return;
        var d = e.clientX - startX;
        if (Math.abs(d) > 6) moved = true;
        vp.scrollLeft = startScroll - d;
        updateNav();
      });
      function end(e) {
        if (!down) return;
        down = false;
        vp.classList.remove('is-dragging');
        updateNav();
        if (e && vp.releasePointerCapture) try { vp.releasePointerCapture(e.pointerId); } catch (_) {}
      }
      vp.addEventListener('pointerup', end);
      vp.addEventListener('pointercancel', end);
      vp.addEventListener('pointerleave', function(e) { if (e.pointerType !== 'mouse') end(e); });
      vp.addEventListener('click', function(e) {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
          moved = false;
        }
      }, true);
      vp.addEventListener('scroll', updateNav, { passive: true });
    }

    function scroll(dir) {
      vp.scrollBy({ left: dir * Math.max(280, Math.floor(vp.clientWidth * 0.82)), behavior: 'smooth' });
      window.setTimeout(updateNav, 220);
    }

    if (prev) prev.addEventListener('click', function() { scroll(-1); });
    if (next) next.addEventListener('click', function() { scroll(1); });
    window.addEventListener('resize', updateNav);
    bindDrag();
    updateNav();
  })();
  </script>
</body>
</html>

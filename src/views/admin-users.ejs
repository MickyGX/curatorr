<%- include('partials/head', { pageTitle: title || 'Users — Curatorr', extraCss: extraCss || ['/styles-layout.css', '/styles-curatorr.css', '/styles-settings.css'] }) %>
<body class="dash-body cur-admin-users-page">
  <style>
    .cur-admin-users-page .cur-stat-card-link {
      display: block;
      color: inherit;
      text-decoration: none;
      height: 100%;
    }
    .cur-admin-users-page .cur-panel--stats .cur-stat-card {
      min-height: 116px;
      height: 100%;
      align-items: center;
    }
    .cur-admin-users-page .cur-stat-card-link .cur-stat-card {
      transition: transform .16s ease, border-color .16s ease, background .16s ease, box-shadow .16s ease;
    }
    .cur-admin-users-page .cur-stat-card-link:hover .cur-stat-card,
    .cur-admin-users-page .cur-stat-card-link:focus-visible .cur-stat-card {
      transform: translateY(-1px);
      border-color: rgba(var(--brand-rgb), .35);
      background: rgba(255,255,255,.07);
      box-shadow: 0 8px 18px rgba(0,0,0,.18);
    }
    .cur-admin-users-page .cur-stat-card-link:focus-visible {
      outline: none;
    }
    .cur-admin-users-page .cur-stat-card-link:focus-visible .cur-stat-card {
      box-shadow: 0 0 0 1px rgba(var(--brand-rgb), .55), 0 8px 18px rgba(0,0,0,.18);
    }
    .cur-admin-users-page .cur-admin-users-table-wrap {
      overflow: auto;
      border-radius: var(--radius, 10px);
      border: 1px solid rgba(255,255,255,0.08);
      background: rgba(8, 10, 18, 0.42);
    }
    .cur-admin-users-page .cur-admin-users-table-wrap::-webkit-scrollbar {
      height: 6px;
    }
    .cur-admin-users-page .cur-admin-users-table-wrap::-webkit-scrollbar-track {
      background: transparent;
    }
    .cur-admin-users-page .cur-admin-users-table-wrap::-webkit-scrollbar-thumb {
      background: rgba(255,255,255,0.18);
      border-radius: 999px;
    }
    .cur-admin-users-page .cur-admin-users-table-wrap::-webkit-scrollbar-thumb:hover {
      background: rgba(255,255,255,0.32);
    }
    html[data-square-corners="1"] .cur-admin-users-page .cur-admin-users-table-wrap {
      border-radius: 0 !important;
    }
    .cur-admin-users-page .cur-admin-users-table {
      min-width: 1220px;
      width: 100%;
    }
    .cur-admin-users-page .cur-admin-users-head,
    .cur-admin-users-page .cur-admin-users-row {
      display: grid;
      grid-template-columns: minmax(260px, 2.15fr) minmax(170px, 1.05fr) minmax(160px, 1fr) minmax(150px, 1fr) minmax(140px, .9fr) minmax(170px, 1fr) minmax(170px, 1fr) minmax(180px, 1.05fr);
      gap: 12px;
      align-items: center;
      padding: 14px 16px;
    }
    .cur-admin-users-page .cur-admin-users-head {
      position: sticky;
      top: 0;
      z-index: 1;
      background: rgba(18, 22, 34, 0.96);
      border-bottom: 1px solid rgba(255,255,255,0.08);
      box-shadow: 0 0 0 100vmax rgba(18, 22, 34, 0.96);
      clip-path: inset(0 -100vmax 0 -100vmax);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted, rgba(255,255,255,0.68));
    }
    .cur-admin-users-page .cur-admin-users-head .cur-pl-head-btn {
      width: 100%;
      color: inherit;
      font: inherit;
      letter-spacing: inherit;
      text-transform: inherit;
      justify-content: flex-start;
    }
    .cur-admin-users-page .cur-admin-users-head .cur-pl-head-btn--right {
      justify-content: flex-start;
    }
    .cur-admin-users-page .cur-admin-users-row {
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .cur-admin-users-page .cur-admin-users-row:last-child {
      border-bottom: 0;
    }
    .cur-admin-users-page .cur-admin-user-cell--user {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }
    .cur-admin-users-page .cur-admin-user-avatar,
    .cur-admin-users-page .cur-admin-user-avatar-curatorr,
    .cur-admin-users-page .cur-admin-user-avatar-fallback {
      width: 40px;
      height: 40px;
      border-radius: 999px;
      flex: 0 0 auto;
    }
    .cur-admin-users-page .cur-admin-user-avatar {
      object-fit: cover;
      background: rgba(255,255,255,0.06);
    }
    .cur-admin-users-page .cur-admin-user-avatar-curatorr {
      object-fit: cover;
      padding: 7px;
      background: linear-gradient(135deg, rgba(110, 74, 255, 0.28), rgba(245, 158, 11, 0.22));
      border: 1px solid rgba(255,255,255,0.08);
    }
    .cur-admin-users-page .cur-admin-user-avatar-fallback {
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.28), rgba(59, 130, 246, 0.22));
      border: 1px solid rgba(255,255,255,0.08);
      color: rgba(255,255,255,0.92);
      font-weight: 700;
      font-size: 15px;
    }
    .cur-admin-users-page .cur-admin-user-identity {
      min-width: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    .cur-admin-users-page .cur-admin-user-name {
      font-weight: 700;
      font-size: 14px;
      line-height: 1.2;
      word-break: break-word;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
    }
    .cur-admin-users-page .cur-admin-user-sub {
      margin-top: 3px;
      display: block;
      color: var(--muted, rgba(255,255,255,0.7));
      font-size: 12px;
      line-height: 1.3;
      word-break: break-word;
    }
    .cur-admin-users-page .cur-admin-user-sub .cur-badge {
      vertical-align: middle;
      font-size: 10px;
      padding: 4px 10px;
    }
    .cur-admin-users-page .cur-admin-user-home {
      display: inline-flex;
      width: 14px;
      height: 14px;
      color: rgba(255,255,255,0.74);
      opacity: 0.92;
      flex: 0 0 auto;
    }
    .cur-admin-users-page .cur-admin-user-home svg {
      width: 100%;
      height: 100%;
      display: block;
      fill: currentColor;
    }
    .cur-admin-users-page .cur-admin-user-cell {
      min-width: 0;
      font-size: 13px;
      color: rgba(255,255,255,0.92);
    }
    .cur-admin-users-page .cur-admin-user-cell strong {
      font-size: 14px;
    }
    .cur-admin-users-page .cur-admin-user-cell-note {
      display: block;
      margin-top: 3px;
      color: var(--muted, rgba(255,255,255,0.68));
      font-size: 11px;
      line-height: 1.3;
    }
    .cur-admin-users-page .cur-admin-user-cell-muted {
      color: var(--muted, rgba(255,255,255,0.68));
    }
    .cur-admin-users-page .cur-admin-users-empty {
      color: var(--muted, rgba(255,255,255,0.7));
      font-size: 14px;
    }
  </style>
  <style>
    .dash-content--admin-users { --ov-panel-line: rgba(255,255,255,0.14); --ov-muted: rgba(255,255,255,0.62); }
    .dash-content--admin-users .cur-panel { margin-bottom: 16px; background: transparent; border: 0; border-radius: 0; }
    .dash-content--admin-users .cur-panel-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; background: transparent; border: 0; border-bottom: 1px solid var(--ov-panel-line); border-radius: 0; padding: 9px 0 8px; min-height: 42px; }
    .dash-content--admin-users .cur-panel-title { margin: 0; flex: 1 1 auto; min-width: 0; font-size: 17px; line-height: 1; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; text-shadow: none; font-family: "Segoe UI", "Helvetica Neue", sans-serif; }
    .dash-content--admin-users .cur-panel-body { background: transparent; border: 0; border-radius: 0; padding: 6px 0 0; }
    .dash-content--admin-users .cur-empty { color: var(--ov-muted); padding: 18px 0; }
  </style>
  <div class="dash-frame<%= sidebarCollapsed ? ' sidebar-collapsed' : '' %>">
    <aside class="dash-sidebar">
      <div class="dash-brand">
        <span class="dash-logo">
          <img class="nav-icon app-icon" src="/icons/curatorr-icon.svg" alt="Curatorr" onerror="this.style.display='none'" />
        </span>
        <div><div class="dash-title">Curatorr</div></div>
      </div>
      <div class="dash-nav">
        <%- include('partials/nav-categories', { navActivePage: 'admin-users', role: role, actualRole: actualRole }) %>
      </div>
      <%- include('partials/user-menu') %>
    </aside>

    <section class="dash-main">
      <div class="main-window-bar">
        <button class="sidebar-toggle main-toggle left-toggle" type="button" aria-label="Toggle sidebar">
          <img class="toggle-icon" src="/icons/sidebar-toggle.svg" alt="" />
        </button>
        <div class="main-window-title">
          <img class="main-window-icon" src="/icons/user-profile.svg" alt="" />
          <span class="main-window-app">Curatorr</span>
          <span class="main-window-rest">| Users</span>
        </div>
        <div class="main-window-spacer"></div>
        <div class="main-window-status">
          <span class="status-dot"></span>
        </div>
      </div>

      <div class="dash-content dash-content--admin-users">
        <%
          const _plexUsers = Array.isArray(plexUsers) ? plexUsers : [];
          const _msType = String(typeof mediaServerType !== 'undefined' ? mediaServerType : 'plex').trim().toLowerCase();
          const _msLabel = _msType === 'jellyfin' ? 'Jellyfin' : _msType === 'emby' ? 'Emby' : 'Plex';
          const _summary = summary || {};
          const _summaryIcons = {
            plexUsers: '<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3.1 12.8c0-2.4 1.9-3.8 4.2-3.8s4.2 1.4 4.2 3.8H3.1zm4.2-6.2a2.4 2.4 0 1 1 0-4.8 2.4 2.4 0 0 1 0 4.8zm4.9 2.1c1.6.4 2.7 1.6 2.7 4.1h-1.7c0-1.4-.4-2.5-1.3-3.3.1-.2.2-.5.3-.8z"/></svg>',
            activeUsers: '<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M5.2 3a2.2 2.2 0 1 1 0 4.4 2.2 2.2 0 0 1 0-4.4zm5.6 1.2a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6zM1.8 13c0-2 1.6-3.2 3.6-3.2S9 11 9 13H1.8zm8.1 0c0-1.1-.3-2-.9-2.8 1.7.1 3.2 1 3.2 2.8H9.9z"/></svg>',
            recentPlays: '<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 2a6 6 0 0 0-6 6v2.5A1.5 1.5 0 0 0 3.5 12H5V9H3a5 5 0 0 1 10 0h-2v3h1.5A1.5 1.5 0 0 0 14 10.5V8a6 6 0 0 0-6-6z"/></svg>',
            playlistOwners: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16"/><path d="M4 11h9"/><path d="M4 16h9"/><path d="M15.5 9.5 20 12l-4.5 2.5V9.5z"/></svg>',
            lidarr: '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18.4 7.7A8 8 0 0 0 6.8 5.9" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/><path d="M18.2 4.8v3.9h-3.9" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.6 16.3A8 8 0 0 0 17.2 18.1" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.8 19.2v-3.9h3.9" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 6.5v7.55A3.2 3.2 0 1 0 13.6 17V9.2h3.2V6.5H12z" fill="currentColor" stroke="none" transform="translate(1.2 1.2) scale(.82)"/></svg>',
          };

          function fmtDate(ts) {
            if (!ts) return '';
            return new Date(ts).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
          }
          function fmtRelative(ts) {
            if (!ts) return '';
            const diff = Math.max(0, Date.now() - ts);
            const mins = Math.floor(diff / 60000);
            const hours = Math.floor(mins / 60);
            const days = Math.floor(hours / 24);
            if (mins < 2) return 'just now';
            if (mins < 60) return mins + 'm ago';
            if (hours < 24) return hours + 'h ago';
            return days + 'd ago';
          }
          function fmtListenTime(ms) {
            const totalMins = Math.floor(Number(ms || 0) / 60000);
            if (!totalMins) return '0m';
            const h = Math.floor(totalMins / 60);
            const m = totalMins % 60;
            if (h) return h + 'h ' + m + 'm';
            return m + 'm';
          }
          function roleTone(roleName) {
            const roleKey = String(roleName || 'user').trim().toLowerCase();
            if (roleKey === 'admin') return 'belter';
            if (roleKey === 'co-admin') return 'decent';
            if (roleKey === 'power-user') return 'curatorr';
            if (roleKey === 'disabled') return 'skip';
            return 'neutral';
          }
          function titleRole(roleName) {
            const roleKey = String(roleName || 'user').trim().toLowerCase();
            if (roleKey === 'co-admin') return 'Co-admin';
            if (roleKey === 'power-user') return 'Power user';
            if (roleKey === 'disabled') return 'Disabled';
            return roleKey ? roleKey.charAt(0).toUpperCase() + roleKey.slice(1) : 'User';
          }
        %>

        <div class="cur-panel cur-panel--stats">
          <div class="cur-panel-header">
            <h3 class="cur-panel-title">Admin user overview</h3>
            <div class="cur-panel-actions">
              <a href="/settings?tab=users" class="cur-panel-link">Manage roles</a>
            </div>
          </div>
          <div class="cur-panel-body">
            <div class="cur-stat-row">
              <a href="#plex-users" class="cur-stat-card-link" aria-label="Jump to media server users table">
                <div class="cur-stat-card">
                  <div class="cur-stat-body">
                    <div class="cur-stat-label"><%= _msLabel %> users</div>
                    <div class="cur-stat-value"><%= Number(_summary.plexUserCount || 0).toLocaleString() %></div>
                    <div class="cur-stat-sub">saved roles and observed activity</div>
                  </div>
                  <div class="cur-stat-icon"><%- _summaryIcons.plexUsers %></div>
                </div>
              </a>
              <a href="/history" class="cur-stat-card-link" aria-label="Open listening history">
                <div class="cur-stat-card">
                  <div class="cur-stat-body">
                    <div class="cur-stat-label">Active users</div>
                    <div class="cur-stat-value cur-stat-value--sm"><%= Number(_summary.activePlexUsers7d || 0).toLocaleString() %> / <%= Number(_summary.activePlexUsers30d || 0).toLocaleString() %> / <%= Number(_summary.activePlexUsersAll || 0).toLocaleString() %></div>
                    <div class="cur-stat-sub">7d / 30d / all time</div>
                  </div>
                  <div class="cur-stat-icon"><%- _summaryIcons.activeUsers %></div>
                </div>
              </a>
              <a href="/history" class="cur-stat-card-link" aria-label="Open recent plays">
                <div class="cur-stat-card">
                  <div class="cur-stat-body">
                    <div class="cur-stat-label">Plays</div>
                    <div class="cur-stat-value cur-stat-value--sm"><%= Number(_summary.totalPlexPlays7d || 0).toLocaleString() %> / <%= Number(_summary.totalPlexPlays30d || 0).toLocaleString() %> / <%= Number(_summary.totalPlexPlaysAll || 0).toLocaleString() %></div>
                    <div class="cur-stat-sub">7d / 30d / all time</div>
                  </div>
                  <div class="cur-stat-icon"><%- _summaryIcons.recentPlays %></div>
                </div>
              </a>
              <a href="/playlists" class="cur-stat-card-link" aria-label="Open playlists">
                <div class="cur-stat-card">
                  <div class="cur-stat-body">
                    <div class="cur-stat-label">Total playlists</div>
                    <div class="cur-stat-value"><%= Number(_summary.totalPlaylists || 0).toLocaleString() %></div>
                    <div class="cur-stat-sub">system, user, and linked playlists combined</div>
                  </div>
                  <div class="cur-stat-icon"><%- _summaryIcons.playlistOwners %></div>
                </div>
              </a>
              <a href="/discover" class="cur-stat-card-link" aria-label="Open Lidarr automation view">
                <div class="cur-stat-card">
                  <div class="cur-stat-body">
                    <div class="cur-stat-label">Lidarr automation</div>
                    <div class="cur-stat-value cur-stat-value--sm"><%= Number(_summary.totalLidarrArtistsAdded || 0).toLocaleString() %> / <%= Number(_summary.totalLidarrAlbumsAdded || 0).toLocaleString() %> / <%= _summary.totalLidarrTracksAdded == null ? '—' : Number(_summary.totalLidarrTracksAdded || 0).toLocaleString() %></div>
                    <div class="cur-stat-sub">artists / albums / tracks via Curatorr</div>
                  </div>
                  <div class="cur-stat-icon"><%- _summaryIcons.lidarr %></div>
                </div>
              </a>
            </div>
          </div>
        </div>

        <div class="cur-panel">
          <div class="cur-panel-header">
            <h3 class="cur-panel-title"><%= _msLabel %> users <span class="cur-count"><%= _plexUsers.length %></span></h3>
          </div>
          <div class="cur-panel-body" id="plex-users">
            <details class="cur-score-explainer">
              <summary>What is included here?</summary>
              <div class="cur-score-explainer-body">
                <p>Each row shows the user avatar, name, role, plays and skip rate for 7d / 30d / all time, artists and tracks heard, playlist totals, Lidarr additions, latest activity, and the most recent media server or Curatorr sign-in that has been recorded for that user.</p>
              </div>
            </details>
            <% if (_plexUsers.length) { %>
              <div class="cur-admin-users-table-wrap">
                <div class="cur-admin-users-table">
                  <div class="cur-admin-users-head">
                    <button type="button" class="cur-pl-head-btn cur-au-head-btn" data-sort="user">
                      <span data-sort-label>User</span>
                      <span class="cur-pl-sort-arrow">↕</span>
                    </button>
                    <button type="button" class="cur-pl-head-btn cur-au-head-btn cur-pl-head-btn--right" data-sort="plays">
                      <span data-sort-label>Plays</span>
                      <span class="cur-pl-sort-arrow">↕</span>
                    </button>
                    <button type="button" class="cur-pl-head-btn cur-au-head-btn cur-pl-head-btn--right" data-sort="skipRate">
                      <span data-sort-label>Skip rate</span>
                      <span class="cur-pl-sort-arrow">↕</span>
                    </button>
                    <button type="button" class="cur-pl-head-btn cur-au-head-btn cur-pl-head-btn--right" data-sort="artistsTracks">
                      <span data-sort-label>Artists / Tracks</span>
                      <span class="cur-pl-sort-arrow">↕</span>
                    </button>
                    <button type="button" class="cur-pl-head-btn cur-au-head-btn cur-pl-head-btn--right" data-sort="playlists">
                      <span data-sort-label>Playlists</span>
                      <span class="cur-pl-sort-arrow">↕</span>
                    </button>
                    <button type="button" class="cur-pl-head-btn cur-au-head-btn cur-pl-head-btn--right" data-sort="lidarr">
                      <span data-sort-label>Lidarr</span>
                      <span class="cur-pl-sort-arrow">↕</span>
                    </button>
                    <button type="button" class="cur-pl-head-btn cur-au-head-btn cur-pl-head-btn--right" data-sort="recentActivity">
                      <span data-sort-label>Recent activity</span>
                      <span class="cur-pl-sort-arrow">↕</span>
                    </button>
                    <button type="button" class="cur-pl-head-btn cur-au-head-btn cur-pl-head-btn--right" data-sort="signIns">
                      <span data-sort-label>Sign-ins</span>
                      <span class="cur-pl-sort-arrow">↕</span>
                    </button>
                  </div>
                  <% _plexUsers.forEach(function(entry) { %>
                    <div
                      class="cur-admin-users-row"
                      data-sort-user="<%= String(entry.name || '').trim().toLowerCase() %>"
                      data-sort-plays-7d="<%= Number(entry.plays7d || 0) %>"
                      data-sort-plays-30d="<%= Number(entry.plays30d || 0) %>"
                      data-sort-plays-all="<%= Number(entry.playsAll || 0) %>"
                      data-sort-skip-7d="<%= Number(entry.skipRate7d || 0) %>"
                      data-sort-skip-30d="<%= Number(entry.skipRate30d || 0) %>"
                      data-sort-skip-all="<%= Number(entry.skipRateAll || 0) %>"
                      data-sort-artists="<%= Number(entry.uniqueArtists || 0) %>"
                      data-sort-tracks="<%= Number(entry.uniqueTracks || 0) %>"
                      data-sort-playlists-total="<%= Number(entry.playlistTotalCount || 0) %>"
                      data-sort-playlists-auto="<%= Number(entry.systemPlaylistCount || entry.playlistCount || 0) %>"
                      data-sort-playlists-user="<%= Number(entry.userPlaylistCount || entry.personalPlaylistCount || 0) %>"
                      data-sort-lidarr-artists="<%= Number(entry.lidarrArtistsAdded || 0) %>"
                      data-sort-lidarr-albums="<%= Number(entry.lidarrAlbumsAdded || 0) %>"
                      data-sort-lidarr-tracks="<%= entry.lidarrTracksAdded == null ? -1 : Number(entry.lidarrTracksAdded || 0) %>"
                      data-sort-recent-play="<%= Number(entry.lastPlayAt || 0) %>"
                      data-sort-recent-sync="<%= Number(entry.lastPlaylistSyncAt || 0) %>"
                      data-sort-signins="<%= Math.max(Date.parse(entry.lastPlexLogin || '') || 0, Date.parse(entry.lastCuratorrLogin || '') || 0) %>">
                      <div class="cur-admin-user-cell cur-admin-user-cell--user">
                        <% if (entry.avatarUrl && /^https?:\/\//i.test(entry.avatarUrl)) { %>
                          <img class="cur-admin-user-avatar" src="<%= entry.avatarUrl %>" alt="" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                          <img class="cur-admin-user-avatar-curatorr" src="/icons/curatorr-icon.svg" alt="" loading="lazy" style="display:none" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                          <span class="cur-admin-user-avatar-fallback" aria-hidden="true" style="display:none"><%= entry.avatarLabel || 'P' %></span>
                        <% } else { %>
                          <img class="cur-admin-user-avatar-curatorr" src="/icons/curatorr-icon.svg" alt="" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                          <span class="cur-admin-user-avatar-fallback" aria-hidden="true" style="display:none"><%= entry.avatarLabel || 'P' %></span>
                        <% } %>
                        <span class="cur-admin-user-identity">
                          <span class="cur-admin-user-name">
                            <%= entry.name %>
                            <% if (entry.isHomeUser) { %>
                              <span class="cur-admin-user-home" title="Home user" aria-label="Home user">
                                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                                  <path d="M8 2.2 2.3 6.8l.9 1.1 1.1-.9V13h3.4V9.8h1V13h3.4V7l1.1.9.9-1.1L8 2.2z"/>
                                </svg>
                              </span>
                            <% } %>
                          </span>
                          <span class="cur-admin-user-sub">
                            <span class="cur-badge cur-badge--<%= roleTone(entry.role) %>"><%= titleRole(entry.role) %></span>
                          </span>
                        </span>
                      </div>
                      <div class="cur-admin-user-cell">
                        <strong><%= Number(entry.plays7d || 0).toLocaleString() %> / <%= Number(entry.plays30d || 0).toLocaleString() %> / <%= Number(entry.playsAll || 0).toLocaleString() %></strong>
                        <span class="cur-admin-user-cell-note">7d / 30d / all time</span>
                      </div>
                      <div class="cur-admin-user-cell">
                        <strong><%= Math.round((entry.skipRate7d || 0) * 100) %>% / <%= Math.round((entry.skipRate30d || 0) * 100) %>% / <%= Math.round((entry.skipRateAll || 0) * 100) %>%</strong>
                        <span class="cur-admin-user-cell-note">7d / 30d / all time</span>
                      </div>
                      <div class="cur-admin-user-cell">
                        <strong><%= Number(entry.uniqueArtists || 0).toLocaleString() %> / <%= Number(entry.uniqueTracks || 0).toLocaleString() %></strong>
                        <% if (entry.topArtist) { %>
                          <span class="cur-admin-user-cell-note">Top artist: <%= entry.topArtist %></span>
                        <% } %>
                      </div>
                      <div class="cur-admin-user-cell">
                        <strong><%= Number(entry.playlistTotalCount || 0).toLocaleString() %></strong>
                        <% if ((entry.playlistTotalCount || 0) > 0) { %>
                          <span class="cur-admin-user-cell-note"><%= Number(entry.systemPlaylistCount || 0).toLocaleString() %> system<% if (entry.userPlaylistCount) { %> · <%= Number(entry.userPlaylistCount || 0).toLocaleString() %> user<% } %><% if (entry.otherPlaylistCount) { %> · <%= Number(entry.otherPlaylistCount || 0).toLocaleString() %> other<% } %></span>
                          <% if (entry.draftPlaylistCount) { %>
                            <span class="cur-admin-user-cell-note cur-admin-user-cell-muted"><%= Number(entry.draftPlaylistCount || 0).toLocaleString() %> unsynced draft<%= Number(entry.draftPlaylistCount || 0) === 1 ? '' : 's' %></span>
                          <% } %>
                        <% } else { %>
                          <span class="cur-admin-user-cell-note cur-admin-user-cell-muted">No playlists yet</span>
                        <% } %>
                      </div>
                      <div class="cur-admin-user-cell">
                        <% if ((entry.lidarrArtistsAdded || 0) > 0 || (entry.lidarrAlbumsAdded || 0) > 0) { %>
                          <strong><%= Number(entry.lidarrArtistsAdded || 0).toLocaleString() %> / <%= Number(entry.lidarrAlbumsAdded || 0).toLocaleString() %> / <%= entry.lidarrTracksAdded == null ? '—' : Number(entry.lidarrTracksAdded || 0).toLocaleString() %></strong>
                          <span class="cur-admin-user-cell-note">Artists / albums / tracks</span>
                          <% if (entry.lidarrTracksAdded == null) { %>
                            <span class="cur-admin-user-cell-note cur-admin-user-cell-muted">Tracks not tracked yet</span>
                          <% } %>
                        <% } else { %>
                          <span class="cur-admin-user-cell-muted">No Lidarr adds yet</span>
                        <% } %>
                      </div>
                      <div class="cur-admin-user-cell">
                        <% if (entry.lastPlayAt) { %>
                          <strong><%= fmtDate(entry.lastPlayAt) %></strong>
                          <span class="cur-admin-user-cell-note"><%= fmtRelative(entry.lastPlayAt) %> · <%= fmtListenTime(entry.totalListenMs) %> listened</span>
                        <% } else { %>
                          <span class="cur-admin-user-cell-muted">No play history yet</span>
                        <% } %>
                        <% if (entry.lastPlaylistSyncAt) { %>
                          <span class="cur-admin-user-cell-note">Last sync <%= fmtDate(entry.lastPlaylistSyncAt) %></span>
                        <% } %>
                      </div>
                      <div class="cur-admin-user-cell">
                        <% if (entry.lastPlexLogin) { %>
                          <strong><%= _msLabel %></strong>
                          <span class="cur-admin-user-cell-note"><%= entry.lastPlexLogin %></span>
                        <% } else { %>
                          <span class="cur-admin-user-cell-muted">No <%= _msLabel %> sign-in recorded</span>
                        <% } %>
                        <% if (entry.lastCuratorrLogin) { %>
                          <span class="cur-admin-user-cell-note">Curatorr: <%= entry.lastCuratorrLogin %></span>
                        <% } %>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% } else { %>
              <div class="cur-admin-users-empty">No <%= _msLabel %> users have been observed yet.</div>
            <% } %>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script src="/sidebar.js?v=<%= assetVersion %>"></script>
  <script src="/user-menu.js?v=<%= assetVersion %>"></script>
  <script src="/version-badge.js?v=<%= assetVersion %>"></script>
  <script src="/brand-menu.js?v=<%= assetVersion %>"></script>
  <script>
  (function() {
    var table = document.querySelector('.cur-admin-users-table');
    if (!table) return;
    var rows = Array.from(table.querySelectorAll('.cur-admin-users-row'));
    var sortButtons = Array.from(table.querySelectorAll('.cur-au-head-btn[data-sort]'));
    if (!rows.length || !sortButtons.length) return;

    var sortState = {
      key: 'plays',
      dir: 'desc',
      partIndex: 0,
    };
    var sortConfig = {
      user: { label: 'User', parts: [{ keys: ['sortUser'], label: '' }], defaultDir: 'asc', defaultPartIndex: 0 },
      plays: {
        label: 'Plays',
        parts: [
          { keys: ['sortPlays30d', 'sortPlays7d', 'sortPlaysAll'], label: '30d' },
          { keys: ['sortPlays7d', 'sortPlays30d', 'sortPlaysAll'], label: '7d' },
          { keys: ['sortPlaysAll', 'sortPlays30d', 'sortPlays7d'], label: 'all' },
        ],
        defaultDir: 'desc',
        defaultPartIndex: 0,
      },
      skipRate: {
        label: 'Skip rate',
        parts: [
          { keys: ['sortSkip30d', 'sortSkip7d', 'sortSkipAll'], label: '30d' },
          { keys: ['sortSkip7d', 'sortSkip30d', 'sortSkipAll'], label: '7d' },
          { keys: ['sortSkipAll', 'sortSkip30d', 'sortSkip7d'], label: 'all' },
        ],
        defaultDir: 'desc',
        defaultPartIndex: 0,
      },
      artistsTracks: {
        label: 'Artists / Tracks',
        parts: [
          { keys: ['sortArtists', 'sortTracks'], label: 'artists' },
          { keys: ['sortTracks', 'sortArtists'], label: 'tracks' },
        ],
        defaultDir: 'desc',
        defaultPartIndex: 0,
      },
      playlists: {
        label: 'Playlists',
        parts: [
          { keys: ['sortPlaylistsTotal', 'sortPlaylistsAuto', 'sortPlaylistsUser'], label: 'total' },
          { keys: ['sortPlaylistsAuto', 'sortPlaylistsTotal', 'sortPlaylistsUser'], label: 'auto' },
          { keys: ['sortPlaylistsUser', 'sortPlaylistsTotal', 'sortPlaylistsAuto'], label: 'user' },
        ],
        defaultDir: 'desc',
        defaultPartIndex: 0,
      },
      lidarr: {
        label: 'Lidarr',
        parts: [
          { keys: ['sortLidarrArtists', 'sortLidarrAlbums', 'sortLidarrTracks'], label: 'artists' },
          { keys: ['sortLidarrAlbums', 'sortLidarrArtists', 'sortLidarrTracks'], label: 'albums' },
          { keys: ['sortLidarrTracks', 'sortLidarrArtists', 'sortLidarrAlbums'], label: 'tracks' },
        ],
        defaultDir: 'desc',
        defaultPartIndex: 0,
      },
      recentActivity: {
        label: 'Recent activity',
        parts: [
          { keys: ['sortRecentPlay', 'sortRecentSync'], label: 'plays' },
          { keys: ['sortRecentSync', 'sortRecentPlay'], label: 'sync' },
        ],
        defaultDir: 'desc',
        defaultPartIndex: 0,
      },
      signIns: { label: 'Sign-ins', parts: [{ keys: ['sortSignins'], label: '' }], defaultDir: 'desc', defaultPartIndex: 0 },
    };

    sortState.partIndex = sortConfig[sortState.key].defaultPartIndex;

    function compareStrings(a, b) {
      return String(a || '').localeCompare(String(b || ''), undefined, { sensitivity: 'base', numeric: true });
    }

    function compareNumbers(a, b) {
      return Number(a || 0) - Number(b || 0);
    }

    function compareByTuple(rowA, rowB, keys) {
      for (var i = 0; i < keys.length; i += 1) {
        var diff = compareNumbers(rowA.dataset[keys[i]], rowB.dataset[keys[i]]);
        if (diff) return diff;
      }
      return compareStrings(rowA.dataset.sortUser, rowB.dataset.sortUser);
    }

    function compareRows(rowA, rowB) {
      var config = sortConfig[sortState.key] || sortConfig.user;
      var part = config.parts[sortState.partIndex] || config.parts[0];
      var result = 0;
      result = part.keys.length === 1 && part.keys[0] === 'sortUser'
        ? compareStrings(rowA.dataset.sortUser, rowB.dataset.sortUser)
        : compareByTuple(rowA, rowB, part.keys);
      return sortState.dir === 'asc' ? result : -result;
    }

    function updateSortButtons() {
      sortButtons.forEach(function(btn) {
        var isActive = btn.dataset.sort === sortState.key;
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-sort', isActive ? (sortState.dir === 'asc' ? 'ascending' : 'descending') : 'none');
        var label = btn.querySelector('[data-sort-label]');
        var config = sortConfig[btn.dataset.sort] || sortConfig.user;
        var part = config.parts[isActive ? sortState.partIndex : config.defaultPartIndex] || config.parts[0];
        if (label) {
          label.textContent = config.label + (isActive && part.label ? ' · ' + part.label : '');
        }
        var arrow = btn.querySelector('.cur-pl-sort-arrow');
        if (arrow) arrow.textContent = !isActive ? '↕' : (sortState.dir === 'asc' ? '↑' : '↓');
      });
    }

    function renderSortedRows() {
      rows.slice().sort(compareRows).forEach(function(row) {
        table.appendChild(row);
      });
      updateSortButtons();
    }

    sortButtons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var key = btn.dataset.sort;
        var config = sortConfig[key];
        if (!key) return;
        if (sortState.key === key) {
          if (config && config.parts.length > 1) {
            if (sortState.partIndex < config.parts.length - 1) {
              sortState.partIndex += 1;
            } else {
              sortState.partIndex = 0;
              sortState.dir = sortState.dir === 'asc' ? 'desc' : 'asc';
            }
          } else {
            sortState.dir = sortState.dir === 'asc' ? 'desc' : 'asc';
          }
        } else {
          sortState.key = key;
          sortState.partIndex = config ? config.defaultPartIndex : 0;
          sortState.dir = config ? config.defaultDir : (key === 'user' ? 'asc' : 'desc');
        }
        renderSortedRows();
      });
    });

    renderSortedRows();
  })();
  </script>
</body>

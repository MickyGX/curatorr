<%- include('partials/head', { pageTitle: title || 'Listening Report — Curatorr', extraCss: extraCss || ['/styles-layout.css', '/styles-curatorr.css'] }) %>
<body class="dash-body">
  <style>
    /* ── Listening Report page ──────────────────────────────────────────────── */
    .dash-content--report {
      --ov-accent: rgba(255,255,255,0.36);
      --ov-panel-line: rgba(255,255,255,0.14);
      --ov-muted: rgba(255,255,255,0.62);
    }

    .dash-content--report .cur-panel {
      margin-bottom: 16px;
    }

    .dash-content--report .cur-panel-header {
      background: transparent;
      border: 0;
      border-bottom: 1px solid var(--ov-panel-line);
      border-radius: 0;
      padding: 10px 0 12px;
    }

    .dash-content--report .cur-panel-title {
      font-size: 17px;
      line-height: 1;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      text-shadow: none;
      font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    }

    .dash-content--report .cur-panel-body {
      background: transparent;
      border: 0;
      border-radius: 0;
      padding: 16px 0 0;
    }

    .dash-content--report .cur-empty {
      color: var(--ov-muted);
      padding: 18px 0;
    }

    /* ── Shared hero styles (copied from overview) ────────────────────────── */
    .ov-profile {
      --ov-hero-avatar-left: 22px;
      --ov-hero-avatar-size: 128px;
      --ov-hero-content-left: 170px;
      position: relative;
      min-height: 228px;
      padding: 170px 0 0 !important;
      overflow: visible !important;
      border-bottom: 0;
      margin-bottom: 6px;
    }

    .ov-profile-artist-bg {
      position: absolute;
      top: 0; left: 0;
      width: 100%;
      height: 170px;
      object-fit: cover;
      object-position: center 25%;
      display: block;
      filter: grayscale(55%) brightness(0.88) contrast(1.08);
    }

    .ov-profile-overlay {
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 170px;
      background:
        repeating-linear-gradient(-45deg, transparent 0px, transparent 2px, rgba(0,0,0,0.07) 2px, rgba(0,0,0,0.07) 3px),
        repeating-linear-gradient(45deg, transparent 0px, transparent 2px, rgba(0,0,0,0.04) 2px, rgba(0,0,0,0.04) 3px),
        linear-gradient(to right, rgba(10,12,16,0.94) 0%, rgba(10,12,16,0.84) 38%, rgba(10,12,16,0.52) 68%, rgba(10,12,16,0.28) 100%);
      pointer-events: none;
    }

    .ov-profile-content {
      position: absolute;
      top: 0; left: 0; right: 0;
      z-index: 1;
      height: 170px;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
    }

    .ov-profile-left {
      position: relative;
      display: flex;
      align-items: flex-end;
      min-width: 0;
      flex: 1 1 auto;
      padding: 18px 22px 0 var(--ov-hero-content-left);
    }

    .ov-avatar {
      position: absolute;
      left: var(--ov-hero-avatar-left);
      bottom: -54px;
      width: var(--ov-hero-avatar-size);
      height: var(--ov-hero-avatar-size);
      border-radius: 50%;
      overflow: hidden;
      flex-shrink: 0;
      background: linear-gradient(135deg, var(--brand, #8b5cf6), #6d28d9);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 34px;
      font-weight: 700;
      color: #fff;
      letter-spacing: -1px;
      user-select: none;
      border: 3px solid rgba(var(--brand-rgb), 0.88);
      box-shadow: 0 2px 16px rgba(0,0,0,0.56), 0 0 0 2px rgba(var(--brand-rgb), 0.24);
    }

    [data-theme="day"] .ov-avatar {
      border-color: rgba(var(--brand-rgb), 0.7);
      box-shadow: 0 2px 14px rgba(0,0,0,0.22), 0 0 0 1px rgba(var(--brand-rgb), 0.2);
    }
    .ov-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }

    .ov-profile-name {
      font-size: 31px;
      font-weight: 700;
      line-height: 1;
      color: #fff;
      margin-bottom: 5px;
      letter-spacing: -0.02em;
      font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    }

    .ov-profile-since {
      font-size: 12px;
      color: rgba(255,255,255,0.64);
      margin-bottom: 20px;
    }

    .ov-profile-meta {
      min-width: 0;
      padding-bottom: 16px;
      transform: translateY(28px);
    }

    .ov-profile-stats-wrap {
      position: relative;
      z-index: 2;
      margin-top: 0;
      padding: 4px 0 0 var(--ov-hero-content-left);
      min-height: 44px;
    }

    .ov-profile-stats-row { display: flex; gap: 0; flex-wrap: nowrap; }

    .ov-profile-stat {
      display: flex;
      flex-direction: column;
      gap: 1px;
      padding-right: 14px;
      margin-right: 14px;
      border-right: 1px solid rgba(255,255,255,0.18);
    }
    .ov-profile-stat:last-child { border-right: 0; }

    .ov-profile-stat-value {
      font-size: 22px;
      font-weight: 700;
      color: #fff;
      line-height: 1.1;
      font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    }

    .ov-profile-stat-label {
      font-size: 11px;
      color: rgba(255,255,255,0.55);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    [data-theme="day"] .ov-profile-stat-value { color: #0b151e; }
    [data-theme="day"] .ov-profile-stat-label  { color: rgba(11,21,30,0.5); }

    .ov-featured {
      position: absolute;
      top: 0;
      right: 0;
      height: 170px;
      z-index: 2;
      display: flex;
      align-items: flex-end;
      padding: 12px 18px 14px;
      gap: 11px;
      max-width: 310px;
    }

    .ov-featured-art {
      width: 79px;
      height: 79px;
      border-radius: 5px;
      overflow: hidden;
      box-shadow: 0 3px 14px rgba(0,0,0,0.7);
      background: rgba(255,255,255,0.12);
      flex-shrink: 0;
      border: 1px solid rgba(255,255,255,0.1);
    }

    .ov-featured-art img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .ov-featured-meta {
      min-width: 0;
      text-align: right;
    }

    .ov-featured-label {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #fff;
      margin-bottom: 4px;
      display: flex;
      align-items: center;
      justify-content: flex-end;
    }

    .ov-featured-track {
      font-size: 20px;
      font-weight: 700;
      color: #fff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      line-height: 1.05;
    }

    .ov-featured-artist {
      font-size: 15px;
      color: #fff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin-top: 4px;
    }

    .ov-featured-plays {
      font-size: 12px;
      color: #fff;
      margin-top: 4px;
    }

    [data-theme="day"] .ov-featured-artist { color: #fff; }
    [data-theme="day"] .ov-featured-plays { color: rgba(255,255,255,0.8); }

    /* ── Period selector ──────────────────────────────────────────────────── */
    .lr-period-bar {
      position: sticky;
      top: 0;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 6px;
      padding: 2px 0 8px;
      background: transparent;
      border-bottom: 1px solid var(--ov-panel-line);
      margin-bottom: 10px;
    }

    [data-theme="day"] .lr-period-bar {
      background: transparent;
    }

    .lr-period-btn {
      padding: 4px 14px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.18);
      background: transparent;
      color: rgba(255,255,255,0.7);
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.15s, color 0.15s, border-color 0.15s;
    }

    .lr-period-btn:hover {
      background: rgba(255,255,255,0.08);
      color: #fff;
    }

    .lr-period-btn.active {
      background: var(--brand, #8b5cf6);
      border-color: var(--brand, #8b5cf6);
      color: #fff;
    }

    [data-theme="day"] .lr-period-btn {
      border-color: rgba(11,21,30,0.2);
      color: rgba(11,21,30,0.65);
    }
    [data-theme="day"] .lr-period-btn:hover { background: rgba(11,21,30,0.06); color: #0b151e; }
    [data-theme="day"] .lr-period-btn.active { background: var(--brand,#8b5cf6); border-color: var(--brand,#8b5cf6); color: #fff; }

    .lr-hidden { display: none !important; }

    .lr-section-heading {
      margin: 18px 0 10px;
      padding-top: 4px;
      border-top: 1px solid rgba(255,255,255,0.08);
    }

    .lr-section-kicker {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.48);
      margin-bottom: 4px;
    }

    .lr-section-title {
      font-size: 28px;
      line-height: 1.05;
      font-weight: 700;
      color: #fff;
      margin: 0;
      font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    }

    .lr-section-copy {
      margin-top: 4px;
      color: rgba(255,255,255,0.56);
      font-size: 13px;
    }

    .lr-summary-strip {
      display: grid;
      grid-template-columns: 1.35fr repeat(5, minmax(0, 1fr));
      gap: 10px;
      margin-bottom: 16px;
    }

    .lr-summary-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 8px;
      padding: 14px 16px;
      min-width: 0;
    }

    .lr-summary-card--primary {
      background:
        linear-gradient(135deg, rgba(124,58,237,0.24) 0%, rgba(124,58,237,0.08) 100%),
        rgba(255,255,255,0.03);
    }

    .lr-summary-label {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.11em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.48);
      margin-bottom: 6px;
    }

    .lr-summary-value {
      font-size: 40px;
      line-height: 1;
      font-weight: 700;
      color: #fff;
      font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    }

    .lr-summary-meta {
      margin-top: 6px;
      font-size: 12px;
      color: rgba(255,255,255,0.65);
    }

    [data-theme="day"] .lr-section-heading { border-top-color: rgba(11,21,30,0.08); }
    [data-theme="day"] .lr-section-kicker { color: rgba(11,21,30,0.45); }
    [data-theme="day"] .lr-section-title { color: #0b151e; }
    [data-theme="day"] .lr-section-copy { color: rgba(11,21,30,0.55); }
    [data-theme="day"] .lr-summary-card {
      background: rgba(11,21,30,0.03);
      border-color: rgba(11,21,30,0.1);
    }
    [data-theme="day"] .lr-summary-card--primary {
      background:
        linear-gradient(135deg, rgba(124,58,237,0.12) 0%, rgba(124,58,237,0.04) 100%),
        rgba(11,21,30,0.03);
    }
    [data-theme="day"] .lr-summary-label { color: rgba(11,21,30,0.45); }
    [data-theme="day"] .lr-summary-value { color: #0b151e; }
    [data-theme="day"] .lr-summary-meta { color: rgba(11,21,30,0.62); }
    [data-theme="day"] .lr-summary-mini-label { color: rgba(11,21,30,0.48); }
    [data-theme="day"] .lr-summary-mini-value { color: #0b151e; }

    /* ── Period headline stats ────────────────────────────────────────────── */
    .lr-stats-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 16px;
    }

    .lr-stat-card {
      flex: 1 1 120px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px;
      padding: 12px 16px;
    }

    [data-theme="day"] .lr-stat-card {
      background: rgba(11,21,30,0.04);
      border-color: rgba(11,21,30,0.12);
    }

    .lr-stat-value {
      font-size: 26px;
      font-weight: 700;
      color: #fff;
      line-height: 1.1;
      font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    }

    .lr-stat-label {
      font-size: 11px;
      color: rgba(255,255,255,0.5);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-top: 2px;
    }

    [data-theme="day"] .lr-stat-value { color: #0b151e; }
    [data-theme="day"] .lr-stat-label  { color: rgba(11,21,30,0.5); }

    /* ── Heatmap ──────────────────────────────────────────────────────────── */
    .lr-heatmap-wrap {
      overflow-x: auto;
      padding-bottom: 4px;
    }

    .lr-heatmap-labels {
      display: flex;
      padding-left: 28px;
      margin-bottom: 4px;
      min-width: 640px;
    }

    .lr-heatmap-month-label {
      flex: 1;
      font-size: 10px;
      color: rgba(255,255,255,0.4);
    }

    [data-theme="day"] .lr-heatmap-month-label { color: rgba(11,21,30,0.4); }

    .lr-heatmap-body {
      display: flex;
      gap: 3px;
      min-width: 640px;
    }

    .lr-heatmap-dow {
      display: flex;
      flex-direction: column;
      gap: 3px;
      padding-right: 4px;
      flex-shrink: 0;
      width: 24px;
    }

    .lr-heatmap-dow-label {
      font-size: 9px;
      color: rgba(255,255,255,0.35);
      height: 11px;
      line-height: 11px;
    }

    [data-theme="day"] .lr-heatmap-dow-label { color: rgba(11,21,30,0.35); }

    .lr-heatmap-grid {
      display: grid;
      grid-template-rows: repeat(7, 11px);
      grid-auto-flow: column;
      gap: 3px;
    }

    .lr-heatmap-cell {
      width: 11px;
      height: 11px;
      border-radius: 2px;
      background: rgba(255,255,255,0.06);
      cursor: default;
    }

    [data-theme="day"] .lr-heatmap-cell { background: rgba(11,21,30,0.08); }

    .lr-heatmap-cell[data-bucket="1"] { background: rgba(139,92,246,0.35); }
    .lr-heatmap-cell[data-bucket="2"] { background: rgba(139,92,246,0.55); }
    .lr-heatmap-cell[data-bucket="3"] { background: rgba(139,92,246,0.78); }
    .lr-heatmap-cell[data-bucket="4"] { background: rgba(139,92,246,1); }

    /* ── Two-column layout ────────────────────────────────────────────────── */
    .lr-two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 0;
    }

    /* ── Artist / Album card grid ─────────────────────────────────────────── */
    .lr-card-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 6px;
    }

    .lr-card {
      position: relative;
      aspect-ratio: 1;
      border-radius: 4px;
      overflow: hidden;
      background: rgba(255,255,255,0.06);
      cursor: default;
    }

    [data-theme="day"] .lr-card { background: rgba(11,21,30,0.08); }

    .lr-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .lr-card-footer {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 18px 6px 6px;
      background: linear-gradient(to top, rgba(0,0,0,0.82) 0%, transparent 100%);
    }

    .lr-card-name {
      font-size: 12px;
      font-weight: 600;
      color: #fff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      line-height: 1.2;
    }

    .lr-card-sub {
      font-size: 10px;
      color: rgba(255,255,255,0.68);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* ── Top Tracks list ──────────────────────────────────────────────────── */
    .lr-track-list { list-style: none; margin: 0; padding: 0; }

    .lr-track-row {
      display: grid;
      grid-template-columns: 22px 36px 36px minmax(0,1fr) auto;
      align-items: center;
      gap: 8px;
      padding: 4px 0;
      border-bottom: 1px solid rgba(255,255,255,0.07);
      min-height: 44px;
    }

    [data-theme="day"] .lr-track-row { border-bottom-color: rgba(11,21,30,0.1); }

    .lr-track-row:last-child { border-bottom: 0; }

    .lr-track-rank {
      font-size: 13px;
      font-weight: 600;
      color: rgba(255,255,255,0.35);
      text-align: right;
    }

    [data-theme="day"] .lr-track-rank { color: rgba(11,21,30,0.35); }

    .lr-track-tier {
      --ov-tier-empty: rgba(255,255,255,0.09);
      --ov-tier-ring: rgba(255,255,255,0.22);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    [data-theme="day"] .lr-track-tier {
      --ov-tier-empty: rgba(0,0,0,0.08);
      --ov-tier-ring: rgba(0,0,0,0.22);
    }

    .lr-track-thumb {
      width: 36px;
      height: 36px;
      border-radius: 3px;
      overflow: hidden;
      background: rgba(255,255,255,0.06);
      flex-shrink: 0;
    }

    [data-theme="day"] .lr-track-thumb { background: rgba(11,21,30,0.08); }

    .lr-track-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

    .lr-track-info { min-width: 0; }

    .lr-track-title {
      font-size: 13px;
      font-weight: 600;
      color: #fff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      line-height: 1.3;
    }

    [data-theme="day"] .lr-track-title { color: #0b151e; }

    .lr-track-artist {
      font-size: 11px;
      color: rgba(255,255,255,0.55);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    [data-theme="day"] .lr-track-artist { color: rgba(11,21,30,0.55); }

    .lr-track-plays {
      font-size: 11px;
      color: rgba(255,255,255,0.45);
      white-space: nowrap;
      text-align: right;
    }

    [data-theme="day"] .lr-track-plays { color: rgba(11,21,30,0.45); }

    /* ── Listening clock ──────────────────────────────────────────────────── */
    .lr-clock-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 286px;
      padding: 14px 0 4px;
    }

    .lr-clock-panel {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 28px;
      width: 100%;
    }

    .lr-clock-graphic svg {
      width: min(280px, 100%);
      height: auto;
    }

    .lr-clock-copy {
      display: grid;
      gap: 16px;
      min-width: 168px;
    }

    .lr-clock-copy-stat {
      display: grid;
      gap: 4px;
    }

    .lr-clock-copy-label {
      color: rgba(255,255,255,0.42);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .lr-clock-copy-value {
      color: rgba(255,255,255,0.96);
      font-size: 22px;
      line-height: 1;
      font-weight: 700;
      font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    }

    .lr-clock-copy-meta {
      color: rgba(255,255,255,0.76);
      font-size: 13px;
      line-height: 1.25;
    }

    [data-theme="day"] .lr-clock-copy-label { color: rgba(11,21,30,0.42); }
    [data-theme="day"] .lr-clock-copy-value { color: rgba(11,21,30,0.94); }
    [data-theme="day"] .lr-clock-copy-meta { color: rgba(11,21,30,0.74); }

    .lr-clock-segment {
      cursor: help;
      transition: opacity 0.16s ease, filter 0.16s ease;
    }

    .lr-clock-svg:hover .lr-clock-segment {
      opacity: 0.22;
    }

    .lr-clock-svg:hover .lr-clock-segment:hover {
      opacity: 1;
      filter: brightness(1.08) saturate(1.06);
    }

    .lr-clock-wrap svg text {
      font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    }

    /* ── Tier breakdown ───────────────────────────────────────────────────── */
    .lr-chart-pair-body {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      align-items: stretch;
    }

    .lr-chart-pair-section {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .lr-chart-pair-title {
      margin: 0;
      padding: 0 0 12px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      font-size: 17px;
      line-height: 1;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: #fff;
      font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    }

    [data-theme="day"] .lr-chart-pair-title {
      border-bottom-color: rgba(11,21,30,0.08);
      color: #0b151e;
    }

    .lr-tier-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 286px;
      gap: 28px;
      flex-wrap: wrap;
      padding: 14px 0 4px;
    }

    .lr-tier-radial svg text {
      font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    }

    .lr-tier-radial svg {
      width: min(240px, 100%);
      height: auto;
    }

    .lr-tier-slice {
      cursor: help;
      transition: opacity 0.16s ease, filter 0.16s ease;
    }

    .lr-tier-radial svg:hover .lr-tier-slice {
      opacity: 0.22;
    }

    .lr-tier-radial svg:hover .lr-tier-slice:hover {
      opacity: 1;
      filter: brightness(1.05) saturate(1.06);
    }

    .lr-tier-radial-total {
      font-size: 24px;
      font-weight: 700;
      fill: rgba(255,255,255,0.96);
      text-anchor: middle;
    }

    .lr-tier-radial-sub {
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      fill: rgba(255,255,255,0.5);
      text-anchor: middle;
    }

    .lr-tier-legend {
      display: grid;
      gap: 12px;
      min-width: 190px;
    }

    .lr-tier-legend-item {
      display: flex;
      align-items: flex-start;
      gap: 8px;
    }

    .lr-tier-legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 999px;
      flex-shrink: 0;
      margin-top: 4px;
    }

    .lr-tier-legend-copy {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
    }

    .lr-tier-legend-label {
      font-size: 12px;
      font-weight: 600;
      color: rgba(255,255,255,0.8);
    }

    .lr-tier-legend-meta {
      font-size: 11px;
      color: rgba(255,255,255,0.4);
    }

    [data-theme="day"] .lr-tier-radial-total { fill: rgba(11,21,30,0.94); }
    [data-theme="day"] .lr-tier-radial-sub { fill: rgba(11,21,30,0.48); }
    [data-theme="day"] .lr-tier-legend-label { color: rgba(11,21,30,0.72); }
    [data-theme="day"] .lr-tier-legend-meta  { color: rgba(11,21,30,0.42); }

    /* ── Quick facts ──────────────────────────────────────────────────────── */
    .lr-facts-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
    }

    .lr-ratio-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 286px;
      gap: 34px;
      flex-wrap: wrap;
      padding: 8px 0 2px;
    }

    .lr-ratio-svg {
      width: min(220px, 100%);
      height: auto;
    }

    .lr-ratio-ring {
      cursor: help;
      transition: opacity 0.16s ease, filter 0.16s ease;
    }

    .lr-ratio-svg:hover .lr-ratio-ring {
      opacity: 0.22;
    }

    .lr-ratio-svg:hover .lr-ratio-ring:hover {
      opacity: 1;
      filter: brightness(1.08) saturate(1.08);
    }

    .lr-ratio-legend {
      display: grid;
      gap: 12px;
      min-width: 180px;
    }

    .lr-ratio-legend-item {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .lr-ratio-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .lr-ratio-name {
      font-size: 13px;
      font-weight: 600;
      color: rgba(255,255,255,0.82);
      min-width: 58px;
    }

    .lr-ratio-val {
      font-size: 13px;
      color: rgba(255,255,255,0.5);
      margin-left: auto;
    }

    .lr-fact-card {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px;
      padding: 14px 16px;
    }

    [data-theme="day"] .lr-fact-card {
      background: rgba(11,21,30,0.04);
      border-color: rgba(11,21,30,0.12);
    }

    .lr-fact-value {
      font-size: 28px;
      font-weight: 700;
      color: #fff;
      line-height: 1;
      font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    }

    .lr-fact-unit {
      font-size: 13px;
      font-weight: 400;
      color: rgba(255,255,255,0.6);
      margin-left: 3px;
    }

    .lr-fact-label {
      font-size: 11px;
      color: rgba(255,255,255,0.5);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-top: 5px;
    }

    .lr-fact-sub {
      font-size: 11px;
      color: rgba(255,255,255,0.38);
      margin-top: 2px;
    }

    [data-theme="day"] .lr-fact-value { color: #0b151e; }
    [data-theme="day"] .lr-fact-unit  { color: rgba(11,21,30,0.55); }
    [data-theme="day"] .lr-fact-label { color: rgba(11,21,30,0.5); }
    [data-theme="day"] .lr-fact-sub   { color: rgba(11,21,30,0.38); }
    [data-theme="day"] .lr-ratio-name { color: rgba(11,21,30,0.78); }
    [data-theme="day"] .lr-ratio-val { color: rgba(11,21,30,0.5); }

    /* ── Responsive ───────────────────────────────────────────────────────── */
    @media (max-width: 900px) {
      .ov-profile {
        --ov-hero-avatar-left: 18px;
        --ov-hero-avatar-size: 116px;
        --ov-hero-content-left: 150px;
      }
      .ov-profile-meta { transform: translateY(30px); }
      .ov-featured {
        position: static;
        height: auto;
        max-width: none;
        flex-direction: row-reverse;
        justify-content: flex-end;
        align-items: center;
        padding: 14px 0 6px;
        gap: 14px;
        border-top: 1px solid rgba(255,255,255,0.12);
        margin-top: 10px;
      }
      .ov-featured-meta { text-align: left; }
      .ov-featured-track { font-size: 18px; white-space: normal; }
      .ov-featured-artist { white-space: normal; }
      .lr-two-col { grid-template-columns: 1fr; }
      .lr-chart-pair-body { grid-template-columns: 1fr; }
      .lr-card-grid { grid-template-columns: repeat(4, 1fr); }
      .lr-facts-grid { grid-template-columns: repeat(2, 1fr); }
      .lr-summary-strip { grid-template-columns: 1fr; }
    }

    @media (max-width: 600px) {
      .ov-profile {
        --ov-hero-avatar-left: 14px;
        --ov-hero-avatar-size: 100px;
        --ov-hero-content-left: 128px;
      }
      .ov-profile-meta { transform: translateY(32px); }
      .lr-card-grid { grid-template-columns: repeat(3, 1fr); }
      .lr-facts-grid { grid-template-columns: repeat(2, 1fr); }
      .lr-track-row { grid-template-columns: 18px 28px 28px minmax(0,1fr) auto; gap: 6px; }
      .lr-section-title { font-size: 24px; }
      .lr-summary-value { font-size: 34px; }
      .dash-content--report .cur-panel-title,
      .lr-chart-pair-title { font-size: 15px; }
    }

    /* ── Period stat heroes (Artists / Albums / Tracks) ──────────────────── */
    .lr-stat-heroes {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-bottom: 14px;
    }

    .lr-stat-hero {
      border-radius: 8px;
      padding: 16px 18px 14px;
      min-width: 0;
    }

    .lr-stat-hero--artist { background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%); }
    .lr-stat-hero--album  { background: linear-gradient(135deg, #0d9488 0%, #5eead4 100%); }
    .lr-stat-hero--track  { background: linear-gradient(135deg, #0369a1 0%, #38bdf8 100%); }

    .lr-stat-hero-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: rgba(255,255,255,0.78);
      margin-bottom: 2px;
    }

    .lr-stat-hero-value {
      font-size: 36px;
      font-weight: 700;
      color: #fff;
      line-height: 1;
      font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    }

    .lr-stat-hero-change {
      font-size: 12px;
      color: rgba(255,255,255,0.72);
      margin-top: 4px;
    }

    .lr-stat-hero-change .up   { color: rgba(255,255,255,0.95); }
    .lr-stat-hero-change .down { color: rgba(255,255,255,0.6); }

    /* ── 3-column Top layout ──────────────────────────────────────────────── */
    .lr-top-three {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 16px;
    }

    .lr-top-col {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .lr-top-col-stat {
      display: none;
      margin-bottom: 10px;
    }

    .lr-top-hero {
      position: relative;
      aspect-ratio: 1;
      border-radius: 6px 6px 0 0;
      overflow: hidden;
      background: rgba(255,255,255,0.06);
    }

    [data-theme="day"] .lr-top-hero { background: rgba(11,21,30,0.08); }

    .lr-top-hero img {
      width: 100%; height: 100%;
      object-fit: cover; display: block;
      transition: transform 0.3s;
    }

    .lr-top-hero:hover img { transform: scale(1.03); }

    .lr-top-hero-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.1) 55%, transparent 100%);
    }

    .lr-top-hero-badge {
      position: absolute;
      top: 10px; left: 10px;
      padding: 3px 10px;
      border-radius: 4px;
      font-size: 11px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.05em;
      color: #fff;
    }

    .lr-top-col--artist .lr-top-hero-badge { background: #7c3aed; }
    .lr-top-col--album  .lr-top-hero-badge { background: #0d9488; }
    .lr-top-col--track  .lr-top-hero-badge { background: #0369a1; }

    .lr-top-hero-footer {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      padding: 10px 12px 10px;
    }

    .lr-top-hero-rank {
      font-size: 16px; font-weight: 700;
      color: #fff; line-height: 1.25;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    .lr-top-hero-meta {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 4px;
      margin-top: 2px;
    }

    .lr-top-hero-sub {
      font-size: 11px; color: rgba(255,255,255,0.65);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    .lr-top-hero-plays {
      font-size: 11px; color: rgba(255,255,255,0.5);
      white-space: nowrap; flex-shrink: 0;
    }

    /* ── Ranked list below hero ───────────────────────────────────────────── */
    .lr-top-list {
      list-style: none; margin: 0; padding: 0;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.09);
      border-top: 0;
      border-radius: 0 0 6px 6px;
    }

    [data-theme="day"] .lr-top-list {
      background: rgba(11,21,30,0.03);
      border-color: rgba(11,21,30,0.1);
    }

    .lr-top-list-item {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 7px 12px;
      border-bottom: 1px solid rgba(255,255,255,0.07);
    }
    [data-theme="day"] .lr-top-list-item { border-bottom-color: rgba(11,21,30,0.08); }
    .lr-top-list-item:last-child { border-bottom: 0; }

    .lr-top-list-rank {
      font-size: 12px; font-weight: 600;
      color: rgba(255,255,255,0.35);
      min-width: 22px; text-align: right;
    }
    [data-theme="day"] .lr-top-list-rank { color: rgba(11,21,30,0.35); }

    .lr-top-list-name {
      flex: 1; min-width: 0;
      font-size: 13px; font-weight: 500;
      color: rgba(255,255,255,0.88);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      cursor: pointer;
    }
    .lr-top-list-name:hover { color: #fff; text-decoration: underline; }
    [data-theme="day"] .lr-top-list-name { color: rgba(11,21,30,0.82); }
    [data-theme="day"] .lr-top-list-name:hover { color: #0b151e; }

    .lr-top-list-sub {
      font-size: 10px;
      color: rgba(255,255,255,0.4);
      white-space: nowrap;
      overflow: hidden; text-overflow: ellipsis;
      max-width: 70px;
    }
    [data-theme="day"] .lr-top-list-sub { color: rgba(11,21,30,0.4); }

    .lr-top-list-plays {
      font-size: 11px;
      color: rgba(255,255,255,0.38);
      white-space: nowrap; flex-shrink: 0;
    }
    [data-theme="day"] .lr-top-list-plays { color: rgba(11,21,30,0.4); }

    /* ── Mobile sticky layout vars ───────────────────────────────────────── */
    .dash-content--report {
      --lr-winbar-h: 50px;
      --lr-periodbar-h: 48px;
      --lr-sticky-top: calc(var(--lr-winbar-h) + var(--lr-periodbar-h));
    }

    /* Column section label (mobile only) */
    .lr-top-col-mob-label { display: none; }

    @media (max-width: 900px) {
      .lr-top-three { grid-template-columns: 1fr; }
      .lr-stat-heroes { display: none; }
      .lr-top-col-stat { display: block; }

      /* Period bar sits below the window bar */
      .lr-period-bar { top: var(--lr-winbar-h); }

      /* Sticky column section headers */
      .lr-top-col-mob-label {
        display: block;
        position: sticky;
        top: var(--lr-sticky-top);
        z-index: 5;
        background: var(--dash-content-bg, #0f1117);
        padding: 8px 0 6px;
        font-size: 15px;
        font-weight: 700;
        color: #fff;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        margin-bottom: 0;
      }
      [data-theme="day"] .lr-top-col-mob-label {
        background: rgba(245,246,250,0.98);
        color: #0b151e;
        border-bottom-color: rgba(11,21,30,0.12);
      }

      /* Sticky cur-panel section headers */
      .dash-content--report .cur-panel-header {
        position: sticky;
        top: var(--lr-sticky-top);
        z-index: 4;
        background: var(--dash-content-bg, #0f1117);
        backdrop-filter: blur(6px);
      }
      [data-theme="day"] .dash-content--report .cur-panel-header {
        background: rgba(245,246,250,0.97);
      }

      /* Push top of hero below the sticky label */
      .lr-top-col .lr-top-hero { border-radius: 6px; }
    }

    @media (max-width: 600px) {
      .lr-top-col-stat .lr-stat-hero {
        padding: 14px 16px 12px;
      }

      .lr-top-col-stat .lr-stat-hero-value {
        font-size: 32px;
      }
    }

    /* ── Discovery row (New Artists / Albums / Tracks) ───────────────────── */
    .lr-discovery-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 16px;
    }

    .lr-discovery-card {
      border-radius: 8px;
      overflow: hidden;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.09);
    }
    [data-theme="day"] .lr-discovery-card {
      background: rgba(11,21,30,0.03);
      border-color: rgba(11,21,30,0.1);
    }

    .lr-discovery-header {
      padding: 14px 16px 12px;
    }

    .lr-discovery-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      margin-bottom: 4px;
    }
    .lr-discovery-card--artist .lr-discovery-label { color: #a78bfa; }
    .lr-discovery-card--album  .lr-discovery-label { color: #5eead4; }
    .lr-discovery-card--track  .lr-discovery-label { color: #38bdf8; }
    [data-theme="day"] .lr-discovery-card--artist .lr-discovery-label { color: #7c3aed; }
    [data-theme="day"] .lr-discovery-card--album  .lr-discovery-label { color: #0d9488; }
    [data-theme="day"] .lr-discovery-card--track  .lr-discovery-label { color: #0369a1; }

    .lr-discovery-pct {
      font-size: 32px;
      font-weight: 700;
      line-height: 1;
      color: #fff;
      font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    }
    [data-theme="day"] .lr-discovery-pct { color: #0b151e; }

    .lr-discovery-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 16px 12px;
      border-top: 1px solid rgba(255,255,255,0.08);
    }
    [data-theme="day"] .lr-discovery-item { border-top-color: rgba(11,21,30,0.1); }

    .lr-discovery-thumb {
      width: 40px; height: 40px;
      border-radius: 4px;
      overflow: hidden;
      background: rgba(255,255,255,0.06);
      flex-shrink: 0;
    }
    .lr-discovery-card--artist .lr-discovery-thumb { border-radius: 50%; }
    [data-theme="day"] .lr-discovery-thumb { background: rgba(11,21,30,0.08); }
    .lr-discovery-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

    .lr-discovery-item-info { min-width: 0; }

    .lr-discovery-item-name {
      font-size: 13px;
      font-weight: 600;
      color: #fff;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      cursor: pointer;
    }
    .lr-discovery-item-name:hover { text-decoration: underline; }
    [data-theme="day"] .lr-discovery-item-name { color: #0b151e; }

    .lr-discovery-item-sub {
      font-size: 11px;
      color: rgba(255,255,255,0.45);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    [data-theme="day"] .lr-discovery-item-sub { color: rgba(11,21,30,0.45); }

    @media (max-width: 900px) { .lr-discovery-row { grid-template-columns: 1fr; } }

    /* ── Weekly chart ─────────────────────────────────────────────────────── */
    .lr-weekly-nav {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
    }

    .lr-weekly-btn {
      background: transparent;
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 50%;
      width: 28px; height: 28px;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      color: rgba(255,255,255,0.7);
      font-size: 14px;
      line-height: 1;
      transition: background 0.15s;
      padding: 0;
    }
    .lr-weekly-btn:hover { background: rgba(255,255,255,0.1); color: #fff; }
    .lr-weekly-btn:disabled { opacity: 0.3; cursor: default; }
    [data-theme="day"] .lr-weekly-btn { border-color: rgba(11,21,30,0.2); color: rgba(11,21,30,0.55); }
    [data-theme="day"] .lr-weekly-btn:hover { background: rgba(11,21,30,0.06); color: #0b151e; }

    .lr-weekly-label {
      font-size: 13px;
      color: rgba(255,255,255,0.7);
      flex: 1;
    }
    [data-theme="day"] .lr-weekly-label { color: rgba(11,21,30,0.65); }

    .lr-weekly-total {
      font-size: 13px;
      font-weight: 600;
      color: #fff;
    }
    [data-theme="day"] .lr-weekly-total { color: #0b151e; }

    .lr-weekly-chart { width: 100%; overflow: hidden; }
    .lr-weekly-chart svg { width: 100%; display: block; }

    /* ── Clickable card hover ─────────────────────────────────────────────── */
    .lr-card[role="button"] { cursor: pointer; }
    .lr-card[role="button"]:hover .lr-card-footer { background: linear-gradient(to top, rgba(139,92,246,0.72) 0%, transparent 100%); }

    /* ── Top Tags ─────────────────────────────────────────────────────────── */
    .lr-tag-stream {
      width: 100%;
      overflow: hidden;
      min-height: 278px;
      padding: 10px 0 4px;
    }

    .lr-tag-stream svg {
      width: 100%;
      display: block;
    }

    .lr-tag-stream-band {
      cursor: help;
      transition: opacity 0.16s ease, filter 0.16s ease;
    }

    .lr-tag-stream svg:hover .lr-tag-stream-band {
      opacity: 0.22;
    }

    .lr-tag-stream svg:hover .lr-tag-stream-band:hover {
      opacity: 1;
      filter: brightness(1.06) saturate(1.08);
    }

    .lr-tag-stream-axis {
      font-size: 11px;
      fill: rgba(255,255,255,0.45);
    }

    .lr-tag-stream-label {
      font-size: 12px;
      font-weight: 700;
      fill: rgba(255,255,255,0.92);
      text-anchor: middle;
      dominant-baseline: middle;
      pointer-events: none;
    }

    .lr-tag-stream-label--priority { font-size: 13px; }

    [data-theme="day"] .lr-tag-stream-axis { fill: rgba(11,21,30,0.45); }
    [data-theme="day"] .lr-tag-stream-label { fill: rgba(11,21,30,0.9); }

    /* ── Decade chart ─────────────────────────────────────────────────────── */
    .lr-decade-chart {
      min-height: 330px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 8px 0 4px;
    }

    .lr-decade-stack {
      display: grid;
      gap: 16px;
      min-height: 228px;
      align-content: start;
    }

    .lr-decade-row {
      display: grid;
      grid-template-columns: 42px 1fr 48px;
      align-items: center;
      gap: 8px;
      transition: opacity 0.16s ease, transform 0.16s ease;
    }

    .lr-decade-chart:hover .lr-decade-row {
      opacity: 0.28;
    }

    .lr-decade-chart:hover .lr-decade-row:hover {
      opacity: 1;
    }

    .lr-decade-row:hover {
      transform: translateX(2px);
    }

    .lr-decade-label {
      font-size: 12px;
      color: rgba(255,255,255,0.62);
      text-align: right;
    }
    [data-theme="day"] .lr-decade-label { color: rgba(11,21,30,0.58); }

    .lr-decade-bar-bg {
      position: relative;
      height: 14px;
      border-radius: 4px;
      background:
        repeating-linear-gradient(
          90deg,
          rgba(255,255,255,0.03) 0,
          rgba(255,255,255,0.03) 9px,
          rgba(255,255,255,0.075) 9px,
          rgba(255,255,255,0.075) 11px
        );
      overflow: hidden;
    }
    [data-theme="day"] .lr-decade-bar-bg {
      background:
        repeating-linear-gradient(
          90deg,
          rgba(11,21,30,0.03) 0,
          rgba(11,21,30,0.03) 9px,
          rgba(11,21,30,0.08) 9px,
          rgba(11,21,30,0.08) 11px
        );
    }

    .lr-decade-bar-fill {
      height: 100%;
      border-radius: 4px;
      background: linear-gradient(90deg, rgba(139,92,246,0.92) 0%, rgba(167,139,250,0.98) 100%);
      transition: width 0.3s;
    }

    .lr-decade-plays {
      font-size: 12px;
      color: rgba(255,255,255,0.44);
      text-align: right;
    }
    [data-theme="day"] .lr-decade-plays { color: rgba(11,21,30,0.44); }

    .lr-decade-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 18px;
      padding-top: 12px;
      border-top: 1px solid rgba(255,255,255,0.08);
      font-size: 12px;
    }

    .lr-decade-foot-label {
      color: rgba(255,255,255,0.42);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .lr-decade-foot-value {
      color: rgba(255,255,255,0.82);
      font-weight: 600;
      text-align: right;
    }

    [data-theme="day"] .lr-decade-foot {
      border-top-color: rgba(11,21,30,0.08);
    }
    [data-theme="day"] .lr-decade-foot-label { color: rgba(11,21,30,0.42); }
    [data-theme="day"] .lr-decade-foot-value { color: rgba(11,21,30,0.78); }

    /* ── Listening Fingerprint radar ──────────────────────────────────────── */
    .lr-radar-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 286px;
      gap: 36px;
      flex-wrap: wrap;
      padding: 8px 0 2px;
    }

    .lr-radar-wrap svg text {
      font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    }

    .lr-radar-svg {
      width: min(290px, 100%);
      height: auto;
      overflow: visible;
      display: block;
    }

    .lr-radar-grid,
    .lr-radar-spoke,
    .lr-radar-shape,
    .lr-radar-node {
      transition: opacity 0.16s ease, filter 0.16s ease;
    }

    .lr-radar-svg:hover .lr-radar-node {
      opacity: 0.28;
    }

    .lr-radar-svg:hover .lr-radar-node:hover {
      opacity: 1;
      filter: brightness(1.08);
    }

    .lr-radar-svg:hover .lr-radar-shape {
      opacity: 0.62;
    }

    .lr-radar-legend {
      display: flex;
      flex-direction: column;
      gap: 12px;
      min-width: 180px;
    }

    .lr-radar-leg-item {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .lr-radar-leg-dot {
      width: 11px; height: 11px;
      border-radius: 50%;
      background: rgba(139,92,246,0.7);
      flex-shrink: 0;
    }

    .lr-radar-leg-name {
      font-size: 13px;
      font-weight: 600;
      color: rgba(255,255,255,0.8);
      min-width: 92px;
    }
    [data-theme="day"] .lr-radar-leg-name { color: rgba(11,21,30,0.75); }

    .lr-radar-leg-val {
      font-size: 13px;
      color: rgba(255,255,255,0.45);
    }
    [data-theme="day"] .lr-radar-leg-val { color: rgba(11,21,30,0.45); }
  </style>

  <div class="dash-frame<%= sidebarCollapsed ? ' sidebar-collapsed' : '' %>">
    <aside class="dash-sidebar">
      <div class="dash-brand">
        <span class="dash-logo">
          <img class="nav-icon app-icon" src="/icons/curatorr-icon.svg" alt="Curatorr" onerror="this.style.display='none'" />
        </span>
        <div>
          <div class="dash-title">Curatorr</div>
        </div>
      </div>
      <div class="dash-nav">
        <%- include('partials/nav-categories', { navActivePage: 'report', role: role }) %>
      </div>
      <%- include('partials/user-menu') %>
    </aside>

    <section class="dash-main">
      <div class="main-window-bar">
        <button class="sidebar-toggle main-toggle left-toggle" type="button" aria-label="Toggle sidebar">
          <img class="toggle-icon" src="/icons/sidebar-toggle.svg" alt="" />
        </button>
        <div class="main-window-title">
          <img class="main-window-icon" src="/icons/documents.svg" alt="" />
          <span class="main-window-app">Curatorr</span>
          <span class="main-window-rest">| Listening Report</span>
        </div>
        <div class="main-window-spacer"></div>
        <div class="main-window-status">
          <span class="status-dot"></span>
        </div>
      </div>

      <div class="dash-content dash-content--report">
        <%- include('partials/plex-banner') %>
        <%
          const _displayUsername = String(user?.username || user?.displayName || 'User').trim();
          const _userAvatar      = String(user?.avatar || '').trim();
          const _avatarFallback  = String(user?.avatarFallback || '/icons/user-profile.svg').trim();
          const _avatarInitial   = _displayUsername.charAt(0).toUpperCase();

          const _statsAll  = statsAll  || {};
          const _stats7d   = stats7d   || {};
          const _stats30d  = stats30d  || {};
          const _stats3m   = stats3m   || {};
          const _stats12m  = stats12m  || {};

          const _ta7d  = Array.isArray(topArtists7d)  ? topArtists7d  : [];
          const _ta30d = Array.isArray(topArtists30d) ? topArtists30d : [];
          const _ta3m  = Array.isArray(topArtists3m)  ? topArtists3m  : [];
          const _ta12m = Array.isArray(topArtists12m) ? topArtists12m : [];
          const _taAll = Array.isArray(topArtistsAll) ? topArtistsAll : [];

          const _tAlb7d  = Array.isArray(topAlbums7d)  ? topAlbums7d  : [];
          const _tAlb30d = Array.isArray(topAlbums30d) ? topAlbums30d : [];
          const _tAlb3m  = Array.isArray(topAlbums3m)  ? topAlbums3m  : [];
          const _tAlb12m = Array.isArray(topAlbums12m) ? topAlbums12m : [];
          const _tAlbAll = Array.isArray(topAlbumsAll) ? topAlbumsAll : [];

          const _tt7d  = Array.isArray(topTracks7d)  ? topTracks7d  : [];
          const _tt30d = Array.isArray(topTracks30d) ? topTracks30d : [];
          const _tt3m  = Array.isArray(topTracks3m)  ? topTracks3m  : [];
          const _tt12m = Array.isArray(topTracks12m) ? topTracks12m : [];
          const _ttAll = Array.isArray(topTracksAll) ? topTracksAll : [];

          const _clock7d = Array.isArray(clockHours7d) ? clockHours7d : [];
          const _clock30d = Array.isArray(clockHours30d) ? clockHours30d : [];
          const _clock3m = Array.isArray(clockHours3m) ? clockHours3m : [];
          const _clock12m = Array.isArray(clockHours12m) ? clockHours12m : [];
          const _clockAll = Array.isArray(clockHoursAll) ? clockHoursAll : [];

          const _summaryByPeriod = reportSummaryByPeriod || {};
          const _summaryCompByPeriod = summaryComparisonByPeriod || {};
          const _quickFactsByPeriod = quickFactsByPeriod || {};
          const _tagStreamByPeriod = tagStreamByPeriod || {};
          const _tierByPeriod = tierBreakdownByPeriod || {};
          const _fpByPeriod = fingerprintByPeriod || {};
          const _heatmap = Array.isArray(heatmapData) ? heatmapData : [];
          const _featuredTrackByPeriod = {
            '7d': _tt7d[0] || null,
            '30d': _tt30d[0] || null,
            '3m': _tt3m[0] || null,
            '12m': _tt12m[0] || null,
            'all': _ttAll[0] || null,
          };
          const _heroArtistByPeriod = {
            '7d': _featuredTrackByPeriod['7d']?.artist_name || _ta7d[0]?.artist_name || null,
            '30d': _featuredTrackByPeriod['30d']?.artist_name || _ta30d[0]?.artist_name || null,
            '3m': _featuredTrackByPeriod['3m']?.artist_name || _ta3m[0]?.artist_name || null,
            '12m': _featuredTrackByPeriod['12m']?.artist_name || _ta12m[0]?.artist_name || null,
            'all': _featuredTrackByPeriod['all']?.artist_name || _taAll[0]?.artist_name || null,
          };

          function fmtNum(n) { return Number(n || 0).toLocaleString(); }

          function fmtListenTime(ms) {
            if (!ms) return '—';
            const totalMins = Math.floor(ms / 60000);
            if (totalMins >= 60) {
              const h = Math.round((totalMins / 60) * 10) / 10;
              return String(h).replace(/\.0$/, '') + 'h';
            }
            return totalMins + 'm';
          }

          function fmtMemberSince(ts) {
            if (!ts) return null;
            return new Date(ts).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
          }

          function heatmapMonthLabels(data) {
            const months = [];
            let lastMonth = -1;
            data.forEach((d, i) => {
              const col = Math.floor(i / 7);
              const m = new Date(d.day).getMonth();
              if (m !== lastMonth) {
                months.push({ col, label: new Date(d.day).toLocaleDateString('en-GB', { month: 'short' }) });
                lastMonth = m;
              }
            });
            return months;
          }

          function heatmapBucket(plays) {
            if (plays === 0) return 0;
            if (plays <= 2) return 1;
            if (plays <= 5) return 2;
            if (plays <= 9) return 3;
            return 4;
          }

          const _hmMonths = heatmapMonthLabels(_heatmap);

          const _memberSince = fmtMemberSince(firstPlayAt);

          // Tier SVG (same as overview)
          function tierSvg(tier, size) {
            const sz = size || 28;
            const t = String(tier || 'curatorr').toLowerCase().trim();
            const cx = sz/2, cy = sz/2, r = sz * 0.42;
            const q1 = `M ${cx},${cy} L ${cx},${cy-r} A ${r},${r} 0 0,1 ${cx+r},${cy} Z`;
            const q2 = `M ${cx},${cy} L ${cx+r},${cy} A ${r},${r} 0 0,1 ${cx},${cy+r} Z`;
            const q3 = `M ${cx},${cy} L ${cx},${cy+r} A ${r},${r} 0 0,1 ${cx-r},${cy} Z`;
            const q4 = `M ${cx},${cy} L ${cx-r},${cy} A ${r},${r} 0 0,1 ${cx},${cy-r} Z`;
            const allQ = [q1, q2, q3, q4];
            let color, count;
            if      (t === 'skip')        { color = '#ef4444'; count = 1; }
            else if (t === 'half-decent') { color = '#f97316'; count = 2; }
            else if (t === 'decent')      { color = '#22c55e'; count = 3; }
            else if (t === 'belter')      { color = '#eab308'; count = 4; }
            else                          { color = 'rgba(255,255,255,0.25)'; count = 0; }
            const filled = allQ.slice(0, count).map(d => `<path d="${d}" fill="${color}"/>`).join('');
            const empty  = allQ.slice(count).map(d => `<path d="${d}" fill="var(--ov-tier-empty)"/>`).join('');
            return `<svg width="${sz}" height="${sz}" viewBox="0 0 ${sz} ${sz}" aria-hidden="true"><circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="var(--ov-tier-ring)" stroke-width="1"/>${filled}${empty}</svg>`;
          }

          const LR_TIER_CONFIG = [
            { key: 'belter', label: 'Belter', color: '#eab308' },
            { key: 'decent', label: 'Decent', color: '#22c55e' },
            { key: 'half-decent', label: 'Half-decent', color: '#f97316' },
            { key: 'curatorr', label: 'Unrated', color: 'rgba(255,255,255,0.24)' },
            { key: 'skip', label: 'Skip', color: '#ef4444' },
          ];

          function polarPoint(cx, cy, r, deg) {
            const rad = (deg - 90) * Math.PI / 180;
            return {
              x: cx + Math.cos(rad) * r,
              y: cy + Math.sin(rad) * r,
            };
          }

          function donutArcPath(cx, cy, outerR, innerR, startDeg, endDeg) {
            const safeEnd = Math.min(endDeg, startDeg + 359.999);
            const outerStart = polarPoint(cx, cy, outerR, startDeg);
            const outerEnd = polarPoint(cx, cy, outerR, safeEnd);
            const innerEnd = polarPoint(cx, cy, innerR, safeEnd);
            const innerStart = polarPoint(cx, cy, innerR, startDeg);
            const largeArc = safeEnd - startDeg > 180 ? 1 : 0;
            return [
              `M ${outerStart.x.toFixed(2)} ${outerStart.y.toFixed(2)}`,
              `A ${outerR} ${outerR} 0 ${largeArc} 1 ${outerEnd.x.toFixed(2)} ${outerEnd.y.toFixed(2)}`,
              `L ${innerEnd.x.toFixed(2)} ${innerEnd.y.toFixed(2)}`,
              `A ${innerR} ${innerR} 0 ${largeArc} 0 ${innerStart.x.toFixed(2)} ${innerStart.y.toFixed(2)}`,
              'Z',
            ].join(' ');
          }

          // Polar clock SVG
          function clockSvg(hours) {
            const sz = 280, cx = 140, cy = 140;
            const maxR = 104, minR = 32;
            const max = Math.max(...hours, 1);
            const toRad = d => d * Math.PI / 180;
            const px = (r, deg) => (cx + r * Math.sin(toRad(deg))).toFixed(2);
            const py = (r, deg) => (cy - r * Math.cos(toRad(deg))).toFixed(2);
            let basePaths = '';
            let paths = '';
            for (let h = 0; h < 24; h++) {
              const s = h * 15 + 1.5;
              const e = (h + 1) * 15 - 1.5;
              const basePath = `M ${px(minR,s)} ${py(minR,s)} L ${px(maxR,s)} ${py(maxR,s)} A ${maxR.toFixed(2)} ${maxR.toFixed(2)} 0 0 1 ${px(maxR,e)} ${py(maxR,e)} L ${px(minR,e)} ${py(minR,e)} A ${minR} ${minR} 0 0 0 ${px(minR,s)} ${py(minR,s)} Z`;
              basePaths += `<path d="${basePath}" fill="rgba(255,255,255,0.08)"/>`;
              const c = hours[h] || 0;
              if (c === 0) continue;
              const r = minR + (maxR - minR) * Math.sqrt(c / max);
              const path = `M ${px(minR,s)} ${py(minR,s)} L ${px(r,s)} ${py(r,s)} A ${r.toFixed(2)} ${r.toFixed(2)} 0 0 1 ${px(r,e)} ${py(r,e)} L ${px(minR,e)} ${py(minR,e)} A ${minR} ${minR} 0 0 0 ${px(minR,s)} ${py(minR,s)} Z`;
              const isDaytime = h >= 6 && h < 22;
              const fill = isDaytime ? 'var(--brand,#8b5cf6)' : 'rgba(139,92,246,0.45)';
              const startHour = h % 12 || 12;
              const endHour24 = (h + 1) % 24;
              const endHour = endHour24 % 12 || 12;
              const range = `${startHour}${h < 12 ? 'am' : 'pm'}-${endHour}${endHour24 < 12 ? 'am' : 'pm'}`;
              paths += `<path class="lr-clock-segment" d="${path}" fill="${fill}"><title>${range}: ${Number(c).toLocaleString()} plays</title></path>`;
            }
            const labelHours = [0,3,6,9,12,15,18,21];
            const labelTexts = ['12am','3am','6am','9am','12pm','3pm','6pm','9pm'];
            let labels = '';
            for (let i = 0; i < labelHours.length; i++) {
              const deg = labelHours[i] * 15;
              labels += `<text x="${px(maxR+16,deg)}" y="${py(maxR+16,deg)}" text-anchor="middle" dominant-baseline="middle" font-size="10" fill="rgba(255,255,255,0.45)">${labelTexts[i]}</text>`;
            }
            return `<svg class="lr-clock-svg" width="${sz}" height="${sz}" viewBox="0 0 ${sz} ${sz}"><circle cx="${cx}" cy="${cy}" r="${maxR}" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1"/><circle cx="${cx}" cy="${cy}" r="${minR}" fill="rgba(0,0,0,0.25)"/>${basePaths}${paths}${labels}</svg>`;
          }

          function clockInsight(hours) {
            const values = Array.isArray(hours) ? hours.map((value) => Number(value || 0)) : [];
            let bestHour = 0;
            let bestValue = 0;
            values.forEach((value, idx) => {
              if (value > bestValue) {
                bestValue = value;
                bestHour = idx;
              }
            });
            const hour12 = bestHour % 12 || 12;
            const meridiem = bestHour < 12 ? 'AM' : 'PM';
            const label = `${hour12}:00${meridiem}`;
            return {
              label: bestValue > 0 ? label : 'No plays',
              plays: bestValue,
            };
          }

          function musicRatioSvg(summary) {
            const items = [
              { label: 'Tracks', value: Number(summary?.uniqueTracks || 0), color: '#38bdf8', r: 72 },
              { label: 'Albums', value: Number(summary?.uniqueAlbums || 0), color: '#5eead4', r: 50 },
              { label: 'Artists', value: Number(summary?.uniqueArtists || 0), color: '#a78bfa', r: 28 },
            ];
            const maxValue = Math.max(...items.map((item) => item.value), 1);
            return `<svg class="lr-ratio-svg" width="220" height="220" viewBox="0 0 220 220" aria-hidden="true">${
              items.map((item) => {
                const circumference = 2 * Math.PI * item.r;
                const ratio = maxValue > 0 ? item.value / maxValue : 0;
                const dash = (circumference * ratio).toFixed(2);
                const gap = (circumference - dash).toFixed(2);
                return `
                  <g class="lr-ratio-ring">
                    <title>${escapeHtml(item.label)}: ${item.value.toLocaleString()}</title>
                    <circle cx="110" cy="110" r="${item.r}" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="12" />
                    <circle cx="110" cy="110" r="${item.r}" fill="none" stroke="${item.color}" stroke-width="12"
                            stroke-linecap="round" stroke-dasharray="${dash} ${gap}" transform="rotate(-90 110 110)" />
                  </g>
                `;
              }).join('')
            }</svg>`;
          }

          function escapeHtml(value) {
            return String(value || '')
              .replace(/&/g, '&amp;')
              .replace(/</g, '&lt;')
              .replace(/>/g, '&gt;')
              .replace(/"/g, '&quot;')
              .replace(/'/g, '&#39;');
          }

          function tierRadialSvg(breakdown) {
            const rows = Array.isArray(breakdown) ? breakdown : [];
            const counts = new Map(rows.map((row) => [String(row.tier || 'curatorr').toLowerCase(), Number(row.total_plays || 0)]));
            const items = LR_TIER_CONFIG.map((cfg) => ({
              ...cfg,
              value: counts.get(cfg.key) || 0,
            }));
            const total = items.reduce((sum, item) => sum + item.value, 0);
            if (total <= 0) return '';

            const sz = 220;
            const cx = 110;
            const cy = 110;
            const outerR = 84;
            const innerR = 38;
            const gapDeg = 1.6;
            let startDeg = 0;
            let arcs = '';

            items.forEach((item) => {
              if (item.value <= 0) return;
              const sliceDeg = (item.value / total) * 360;
              const drawStart = startDeg + Math.min(gapDeg / 2, sliceDeg / 4);
              const drawEnd = startDeg + sliceDeg - Math.min(gapDeg / 2, sliceDeg / 4);
              if (drawEnd > drawStart) {
                const pct = Math.round((item.value / total) * 100);
                arcs += `<path class="lr-tier-slice" d="${donutArcPath(cx, cy, outerR, innerR, drawStart, drawEnd)}" fill="${item.color}" fill-opacity="${item.key === 'curatorr' ? '0.82' : '0.96'}"><title>${escapeHtml(item.label)}: ${item.value.toLocaleString()} plays (${pct}%)</title></path>`;
              }
              startDeg += sliceDeg;
            });

            return `
              <svg width="${sz}" height="${sz}" viewBox="0 0 ${sz} ${sz}" aria-hidden="true">
                <circle cx="${cx}" cy="${cy}" r="${outerR}" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1"></circle>
                <circle cx="${cx}" cy="${cy}" r="${innerR}" fill="rgba(0,0,0,0.24)" stroke="rgba(255,255,255,0.08)" stroke-width="1"></circle>
                ${arcs}
                <text class="lr-tier-radial-total" x="${cx}" y="${cy - 4}">${total.toLocaleString()}</text>
                <text class="lr-tier-radial-sub" x="${cx}" y="${cy + 16}">plays</text>
              </svg>
            `;
          }

          function tierLegendHtml(breakdown) {
            const rows = Array.isArray(breakdown) ? breakdown : [];
            const counts = new Map(rows.map((row) => [String(row.tier || 'curatorr').toLowerCase(), Number(row.total_plays || 0)]));
            const items = LR_TIER_CONFIG
              .map((cfg) => ({
                ...cfg,
                value: counts.get(cfg.key) || 0,
              }))
              .filter((item) => item.value > 0);
            const total = items.reduce((sum, item) => sum + item.value, 0) || 1;

            return items.map((item) => {
              const pct = Math.round((item.value / total) * 100);
              return `
                <div class="lr-tier-legend-item">
                  <span class="lr-tier-legend-dot" style="background:${item.color}"></span>
                  <span class="lr-tier-legend-copy">
                    <span class="lr-tier-legend-label">${escapeHtml(item.label)}</span>
                    <span class="lr-tier-legend-meta">${item.value.toLocaleString()} plays · ${pct}%</span>
                  </span>
                </div>
              `;
            }).join('');
          }

          function tagStreamSvg(data) {
            const labels = Array.isArray(data?.labels) ? data.labels : [];
            const series = Array.isArray(data?.series) ? data.series : [];
            if (!series.length || labels.length < 2) return '';
            const width = 720;
            const height = 260;
            const margin = { top: 12, right: 8, bottom: 34, left: 8 };
            const innerWidth = width - margin.left - margin.right;
            const innerHeight = height - margin.top - margin.bottom;
            const midY = margin.top + innerHeight / 2;
            const pointCount = labels.length;
            const totals = labels.map((_, idx) => series.reduce((sum, item) => sum + Number(item.values?.[idx] || 0), 0));
            const maxAbs = Math.max(...totals.map((total) => total / 2), 1);
            const xAt = (idx) => margin.left + (pointCount === 1 ? innerWidth / 2 : (innerWidth * idx / (pointCount - 1)));
            const yAt = (unit) => midY - (unit / maxAbs) * (innerHeight / 2);

            const layered = series.map((item) => {
              const upper = [];
              const lower = [];
              return { ...item, upper, lower };
            });

            labels.forEach((_, idx) => {
              let offset = -totals[idx] / 2;
              layered.forEach((item) => {
                const value = Number(item.values?.[idx] || 0);
                item.lower.push(offset);
                item.upper.push(offset + value);
                offset += value;
              });
            });

            const paths = layered.map((item) => {
              const values = Array.isArray(item.values) ? item.values : [];
              const topPath = item.upper.map((value, idx) => `${idx === 0 ? 'M' : 'L'} ${xAt(idx).toFixed(2)} ${yAt(value).toFixed(2)}`).join(' ');
              const bottomPath = item.lower.slice().reverse().map((value, reverseIdx) => {
                const idx = pointCount - 1 - reverseIdx;
                return `L ${xAt(idx).toFixed(2)} ${yAt(value).toFixed(2)}`;
              }).join(' ');
              const totalValue = values.reduce((sum, value) => sum + Number(value || 0), 0);
              return `<path class="lr-tag-stream-band" d="${topPath} ${bottomPath} Z" fill="${item.color}" fill-opacity="0.88" stroke="rgba(0,0,0,0.28)" stroke-width="1"><title>${escapeHtml(item.tag)}: ${totalValue.toLocaleString()} plays</title></path>`;
            }).join('');

            const labelTexts = layered.slice(0, 4).map((item, itemIndex) => {
              const values = Array.isArray(item.values) ? item.values : [];
              let peakIndex = 0;
              let peakValue = 0;
              values.forEach((value, idx) => {
                if (Number(value || 0) > peakValue) {
                  peakValue = Number(value || 0);
                  peakIndex = idx;
                }
              });
              if (peakValue <= 0) return '';
              const bandHeight = Math.abs(yAt(item.lower[peakIndex]) - yAt(item.upper[peakIndex]));
              if (bandHeight < (itemIndex < 2 ? 8 : 18)) return '';
              let centerY = yAt((item.lower[peakIndex] + item.upper[peakIndex]) / 2);
              if (bandHeight < 18 && itemIndex < 2) {
                centerY += centerY < midY ? -10 : 10;
              }
              const labelWidth = Math.max(34, item.tag.length * 6.4);
              const minX = margin.left + 6 + labelWidth / 2;
              const maxX = width - margin.right - 6 - labelWidth / 2;
              const labelX = Math.max(minX, Math.min(maxX, xAt(peakIndex)));
              centerY = Math.max(margin.top + 12, Math.min(height - margin.bottom - 8, centerY));
              const labelClass = itemIndex < 2 ? 'lr-tag-stream-label lr-tag-stream-label--priority' : 'lr-tag-stream-label';
              return `<text class="${labelClass}" x="${labelX.toFixed(2)}" y="${centerY.toFixed(2)}">${escapeHtml(item.tag)}</text>`;
            }).join('');

            const axisLabels = labels.map((label, idx) => {
              return `<text class="lr-tag-stream-axis" x="${xAt(idx).toFixed(2)}" y="${(height - 6).toFixed(2)}" text-anchor="middle">${escapeHtml(label)}</text>`;
            }).join('');

            return `
              <svg viewBox="0 0 ${width} ${height}" aria-hidden="true">
                ${paths}
                ${labelTexts}
                ${axisLabels}
              </svg>
            `;
          }

          // Fingerprint radar SVG (pentagon, 5 dimensions)
          const _fpDims = [
            { label: 'Consistency', key: 'consistency',  desc: 'Active days / 30' },
            { label: 'Variety',     key: 'variety',      desc: 'Artist spread' },
            { label: 'Loyalty',     key: 'loyalty',      desc: 'Top artist focus' },
            { label: 'Night Owl',   key: 'nightOwl',     desc: 'Late-night plays' },
            { label: 'Intensity',   key: 'intensity',    desc: 'Plays per active day' },
          ];

          function radarSvg(fp, dims) {
            const sz = 290, cx = sz/2, cy = sz/2, maxR = 92, labelR = maxR + 28, ringR = [maxR*0.25, maxR*0.5, maxR*0.75, maxR];
            const n = dims.length;
            const toRad = d => d * Math.PI / 180;
            const pt = (r, i) => {
              const a = toRad(i * 360 / n - 90);
              return [cx + r * Math.cos(a), cy + r * Math.sin(a)];
            };
            let rings = '';
            for (const r of ringR) {
              const pts = dims.map((_, i) => pt(r, i).join(',')).join(' ');
              rings += `<polygon class="lr-radar-grid" points="${pts}" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>`;
            }
            let spokes = '';
            for (let i = 0; i < n; i++) {
              const [x, y] = pt(maxR, i);
              spokes += `<line class="lr-radar-spoke" x1="${cx}" y1="${cy}" x2="${x.toFixed(1)}" y2="${y.toFixed(1)}" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>`;
            }
            const dataPts = dims.map((d, i) => {
              const v = Math.min(100, Math.max(0, Number(fp[d.key] || 0)));
              return pt(maxR * v / 100, i);
            });
            const polyPts = dataPts.map(p => p.map(v => v.toFixed(1)).join(',')).join(' ');
            const fill = `<polygon class="lr-radar-shape" points="${polyPts}" fill="rgba(139,92,246,0.28)" stroke="rgba(139,92,246,0.8)" stroke-width="2" stroke-linejoin="round"/>`;
            const nodes = dataPts.map((point, i) => {
              const val = Math.min(100, Math.max(0, Number(fp[dims[i].key] || 0)));
              return `<circle class="lr-radar-node" cx="${point[0].toFixed(1)}" cy="${point[1].toFixed(1)}" r="4.8" fill="rgba(167,139,250,0.96)" stroke="rgba(15,23,42,0.55)" stroke-width="1.5"><title>${escapeHtml(dims[i].label)}: ${val}%</title></circle>`;
            }).join('');
            let labels = '';
            for (let i = 0; i < n; i++) {
              const [x, y] = pt(labelR, i);
              const anchor = x < cx - 2 ? 'end' : x > cx + 2 ? 'start' : 'middle';
              labels += `<text x="${x.toFixed(1)}" y="${y.toFixed(1)}" text-anchor="${anchor}" dominant-baseline="middle" font-size="10" fill="rgba(255,255,255,0.5)">${dims[i].label}</text>`;
            }
            return `<svg class="lr-radar-svg" width="${sz}" height="${sz}" viewBox="0 0 ${sz} ${sz}">${rings}${spokes}${fill}${nodes}${labels}</svg>`;
          }

          // Decade chart helper
          function decadeBarHtml(rows) {
            if (!rows || !rows.length) return '<div class="cur-empty">No decade data available.</div>';
            const max = Math.max(...rows.map(r => r.plays), 1);
            const topRow = rows.reduce((best, row) => Number(row.plays || 0) > Number(best?.plays || 0) ? row : best, rows[0]);
            const body = rows.map(r => {
              const pct = Math.round((r.plays / max) * 100);
              return `<div class="lr-decade-row" title="${escapeHtml(r.decade)}: ${Number(r.plays || 0).toLocaleString()} plays">
                <span class="lr-decade-label">${r.decade}</span>
                <div class="lr-decade-bar-bg"><div class="lr-decade-bar-fill" style="width:${pct}%"></div></div>
                <span class="lr-decade-plays">${Number(r.plays).toLocaleString()}</span>
              </div>`;
            }).join('');
            const foot = topRow ? `<div class="lr-decade-foot"><span class="lr-decade-foot-label">Top decade</span><span class="lr-decade-foot-value">${escapeHtml(topRow.decade)} · ${Number(topRow.plays || 0).toLocaleString()} plays</span></div>` : '';
            return `<div class="lr-decade-stack">${body}</div>${foot}`;
          }

          const _nd7d  = newData7d  || {};
          const _nd30d = newData30d || {};
          const _nd3m  = newData3m  || {};
          const _nd12m = newData12m || {};

          function newPct(newCount, totalUnique) {
            if (!totalUnique) return 0;
            return Math.min(100, Math.round((newCount / totalUnique) * 100));
          }

          // Comparison stats for % change
          const _comp7d  = statsComp7d  || {};
          const _comp30d = statsComp30d || {};
          const _comp3m  = statsComp3m  || {};
          const _comp12m = statsComp12m || {};

          function pctChange(cur, prev) {
            if (prev === null || prev === undefined) return null;
            if (prev === 0) return cur > 0 ? { dir: 'up', val: 'New' } : null;
            const p = Math.round(((cur - prev) / prev) * 100);
            if (p === 0) return null;
            return { dir: p > 0 ? 'up' : 'down', val: Math.abs(p) + '%' };
          }

          function changeBadge(cur, prev) {
            const c = pctChange(cur, prev);
            if (!c) return '';
            const arrow = c.dir === 'up' ? '↑' : '↓';
            return `<span class="${c.dir}">${arrow} ${c.val}</span>`;
          }
          const _dd7d  = Array.isArray(decadeData7d)  ? decadeData7d  : [];
          const _dd30d = Array.isArray(decadeData30d) ? decadeData30d : [];
          const _dd3m  = Array.isArray(decadeData3m)  ? decadeData3m  : [];
          const _dd12m = Array.isArray(decadeData12m) ? decadeData12m : [];
          const _ddAll = Array.isArray(decadeDataAll) ? decadeDataAll : [];
        %>


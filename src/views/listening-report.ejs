                <div class="lr-top-hero cur-overview-trigger" role="button" tabindex="0"
                     data-cur-overview-kind="track" data-cur-overview-key="<%= _t0.plex_rating_key || '' %>">
                  <img src="/api/music/thumb/track/<%= encodeURIComponent(_t0.plex_rating_key || '') %>"
                       alt="" loading="lazy" onerror="this.onerror=null;this.style.display='none'" />

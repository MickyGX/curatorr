                </ul>
              <% } else { %>
                <div class="cur-empty">No album data.</div>
              <% } %>
              <% if (ps !== 'all') { %>
                <div class="lr-discovery-card lr-discovery-card--album" style="margin-top:8px">
                  <div class="lr-discovery-header">
                    <div class="lr-discovery-label">New Albums</div>
                    <div class="lr-discovery-pct"><%= newPct(nd.newAlbumCount || 0, nd.totalAlbums || 1) %>%</div>

            <%# Track column %>
            <div class="lr-top-col lr-top-col--track">
              <div class="lr-top-col-mob-label">Top Tracks</div>
              <div class="lr-top-col-stat">
                <div class="lr-stat-hero lr-stat-hero--track">
                  <div class="lr-stat-hero-label">Tracks</div>
                  <div class="lr-stat-hero-value"><%= fmtNum(_stPeriod.uniqueTracks) %></div>
                  <div class="lr-stat-hero-change"><%- changeBadge(_stPeriod.uniqueTracks, _cmpPeriod && _cmpPeriod.unique_tracks) %></div>
                </div>

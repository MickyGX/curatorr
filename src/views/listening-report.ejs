                    <div class="lr-top-hero-meta">
                      <span class="lr-top-hero-sub"><%= _t0.artist_name %></span>
                      <span class="lr-top-hero-plays"><%= fmtNum(_t0.play_count) %> plays</span>
                    </div>
                  </div>
                </div>
                <ul class="lr-top-list">
                  <% trks.slice(1, 6).forEach(function(t, i) { %>
                    <li class="lr-top-list-item">
                      <span class="lr-top-list-rank">#<%= i + 2 %></span>
                      <span class="lr-top-list-name cur-overview-trigger" role="button" tabindex="0"
                            data-cur-overview-kind="track" data-cur-overview-key="<%= t.plex_rating_key || '' %>"><%= t.track_title %></span>
                      <span class="lr-top-list-sub"><%= t.artist_name %></span>
                      <span class="lr-top-list-plays"><%= fmtNum(t.play_count) %></span>
                    </li>
                  <% }) %>
                </ul>
              <% } else { %>
                <div class="cur-empty">No track data.</div>
              <% } %>
              <% if (ps !== 'all') { %>
                <div class="lr-discovery-card lr-discovery-card--track" style="margin-top:8px">
                  <div class="lr-discovery-header">
                    <div class="lr-discovery-label">New Tracks</div>
                    <div class="lr-discovery-pct"><%= newPct(nd.newTrackCount || 0, _stPeriod.uniqueTracks || 1) %>%</div>
                  </div>
                  <% if (nd.topNewTrack) { %>
                    <div class="lr-discovery-item">
                      <div class="lr-discovery-thumb">
                        <img src="/api/music/thumb/track/<%= encodeURIComponent(nd.topNewTrack.plex_rating_key || '') %>"
                             alt="" loading="lazy" onerror="this.onerror=null;this.style.display='none'" />
                      </div>
                      <div class="lr-discovery-item-info">
                        <div class="lr-discovery-item-name cur-overview-trigger" role="button" tabindex="0"
                             data-cur-overview-kind="track" data-cur-overview-key="<%= nd.topNewTrack.plex_rating_key || '' %>">#1 <%= nd.topNewTrack.track_title %></div>
                        <div class="lr-discovery-item-sub"><%= nd.topNewTrack.artist_name %> · <%= fmtNum(nd.topNewTrack.play_count) %> play<%= nd.topNewTrack.play_count !== 1 ? 's' : '' %></div>
                      </div>
                    </div>
                  <% } %>
                </div>
              <% } %>
            </div>

          </div><%# end lr-top-three %>
        <% }) %>

        <div class="lr-two-col">

          <div class="cur-panel" data-panel-collapsible="false">
            <div class="cur-panel-header">
              <h3 class="cur-panel-title">Music Ratio</h3>
            </div>
            <div class="cur-panel-body">
              <% [['7d', _summaryByPeriod['7d']], ['30d', _summaryByPeriod['30d']], ['3m', _summaryByPeriod['3m']], ['12m', _summaryByPeriod['12m']], ['all', _summaryByPeriod['all']]].forEach(function(pair) { %>
                <% var ps = pair[0]; var summary = pair[1] || {}; %>
                <div class="lr-ratio-wrap<%= ps !== '30d' ? ' lr-hidden' : '' %>" data-period-set="<%= ps %>">
                  <%- musicRatioSvg(summary) %>
                  <div class="lr-ratio-legend">
                    <div class="lr-ratio-legend-item">
                      <span class="lr-ratio-dot" style="background:#38bdf8"></span>
                      <span class="lr-ratio-name">Tracks</span>
                      <span class="lr-ratio-val"><%= fmtNum(summary.uniqueTracks) %></span>
                    </div>
                    <div class="lr-ratio-legend-item">
                      <span class="lr-ratio-dot" style="background:#5eead4"></span>
                      <span class="lr-ratio-name">Albums</span>
                      <span class="lr-ratio-val"><%= fmtNum(summary.uniqueAlbums) %></span>
                    </div>
                    <div class="lr-ratio-legend-item">
                      <span class="lr-ratio-dot" style="background:#a78bfa"></span>
                      <span class="lr-ratio-name">Artists</span>
                      <span class="lr-ratio-val"><%= fmtNum(summary.uniqueArtists) %></span>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>

          <div class="cur-panel" data-panel-collapsible="false">
            <div class="cur-panel-header">
              <h3 class="cur-panel-title">Listening Fingerprint</h3>
            </div>
            <div class="cur-panel-body">
              <% [['7d', _fpByPeriod['7d']], ['30d', _fpByPeriod['30d']], ['3m', _fpByPeriod['3m']], ['12m', _fpByPeriod['12m']], ['all', _fpByPeriod['all']]].forEach(function(pair) { %>
                <% var ps = pair[0]; var fp = pair[1] || {}; %>
                <div class="lr-radar-wrap<%= ps !== '30d' ? ' lr-hidden' : '' %>" data-period-set="<%= ps %>">
                  <%- radarSvg(fp, _fpDims) %>
                  <div class="lr-radar-legend">
                    <% _fpDims.forEach(function(d) { %>
                      <div class="lr-radar-leg-item">
                        <span class="lr-radar-leg-dot"></span>
                        <span class="lr-radar-leg-name"><%= d.label %></span>
                        <span class="lr-radar-leg-val"><%= Math.min(100, Math.max(0, Number(fp[d.key] || 0))) %>%</span>
                      </div>
                    <% }) %>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>

        </div>

        <%# ── Top Tags + Music by Decade ──────────────────────────────────── %>
        <div class="lr-two-col">

          <%# Top Tags %>
          <div class="cur-panel" data-panel-collapsible="false">
            <div class="cur-panel-header">
              <h3 class="cur-panel-title">Top Tags</h3>
            </div>
            <div class="cur-panel-body">
              <% [['7d', _tagStreamByPeriod['7d']], ['30d', _tagStreamByPeriod['30d']], ['3m', _tagStreamByPeriod['3m']], ['12m', _tagStreamByPeriod['12m']], ['all', _tagStreamByPeriod['all']]].forEach(function(pair) { %>
                <% var ps = pair[0]; var stream = pair[1] || {}; var hasSeries = Array.isArray(stream.series) && stream.series.length; %>
                <div class="lr-tag-stream<%= ps !== '30d' ? ' lr-hidden' : '' %>" data-period-set="<%= ps %>">
                  <% if (hasSeries) { %>
                    <%- tagStreamSvg(stream) %>
                  <% } else { %>
                    <div class="cur-empty">No tag data available for this period.</div>
                  <% } %>
                </div>
              <% }) %>
            </div>
          </div>

          <%# Music by Decade %>
          <div class="cur-panel" data-panel-collapsible="false">
            <div class="cur-panel-header">
              <h3 class="cur-panel-title">Music by Decade</h3>
            </div>
            <div class="cur-panel-body">
              <% [['7d',_dd7d],['30d',_dd30d],['3m',_dd3m],['12m',_dd12m],['all',_ddAll]].forEach(function(pair) { %>
                <% var ps = pair[0]; var dd = pair[1]; %>
                <div class="lr-decade-chart<%= ps !== '30d' ? ' lr-hidden' : '' %>" data-period-set="<%= ps %>">
                  <%- decadeBarHtml(dd) %>
                </div>
              <% }) %>
            </div>
          </div>

        </div><%# end lr-two-col tags+decade %>

        <div class="cur-panel" data-panel-collapsible="false">
          <div class="cur-panel-body lr-chart-pair-body">
            <div class="lr-chart-pair-section">
              <h4 class="lr-chart-pair-title">Listening Clock</h4>
              <% [['7d',_clock7d],['30d',_clock30d],['3m',_clock3m],['12m',_clock12m],['all',_clockAll]].forEach(function(pair) { %>
                <% var ps = pair[0]; var ch = pair[1]; %>
                <% var clockMeta = clockInsight(ch); %>
                <div class="lr-clock-wrap<%= ps !== '30d' ? ' lr-hidden' : '' %>" data-period-set="<%= ps %>">
                  <div class="lr-clock-panel">
                    <div class="lr-clock-graphic"><%- clockSvg(ch) %></div>
                    <div class="lr-clock-copy">
                      <div class="lr-clock-copy-stat">
                        <div class="lr-clock-copy-label">Busiest hour</div>
                        <div class="lr-clock-copy-value"><%= clockMeta.label %></div>
                      </div>
                      <div class="lr-clock-copy-stat">
                        <div class="lr-clock-copy-label">Plays in busiest hour</div>
                        <div class="lr-clock-copy-meta"><%= fmtNum(clockMeta.plays) %> play<%= Number(clockMeta.plays || 0) === 1 ? '' : 's' %></div>
                      </div>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>

            <div class="lr-chart-pair-section">
              <h4 class="lr-chart-pair-title">Tier Breakdown</h4>
              <% [['7d', _tierByPeriod['7d']], ['30d', _tierByPeriod['30d']], ['3m', _tierByPeriod['3m']], ['12m', _tierByPeriod['12m']], ['all', _tierByPeriod['all']]].forEach(function(pair) { %>
                <% var ps = pair[0]; var breakdown = pair[1] || []; %>
                <div class="lr-tier-wrap<%= ps !== '30d' ? ' lr-hidden' : '' %>" data-period-set="<%= ps %>">
                  <% if (breakdown.length) { %>
                    <div class="lr-tier-radial"><%- tierRadialSvg(breakdown) %></div>
                    <div class="lr-tier-legend"><%- tierLegendHtml(breakdown) %></div>
                  <% } else { %>
                    <div class="cur-empty">No tier data available for this period.</div>
                  <% } %>
                </div>
              <% }) %>
            </div>
          </div>
        </div>

        <div class="cur-panel" data-panel-collapsible="false">
          <div class="cur-panel-header">
            <h3 class="cur-panel-title">Activity — last 52 weeks</h3>
          </div>
          <div class="cur-panel-body">
            <div class="lr-heatmap-wrap">
              <%
                const _cols = Math.ceil((_heatmap.length + heatmapStartDow) / 7);
              %>
              <div class="lr-heatmap-labels" style="display:grid;grid-template-columns:repeat(<%= _cols %>, 14px);padding-left:28px;min-width:<%= _cols * 14 + 28 %>px;">
                <% _hmMonths.forEach(function(m) { %>
                  <span style="grid-column:<%= Math.floor(m.col) + 1 %>" class="lr-heatmap-month-label"><%= m.label %></span>
                <% }) %>
              </div>
              <div class="lr-heatmap-body" style="min-width:<%= _cols * 14 + 28 %>px;">
                <div class="lr-heatmap-dow">
                  <span class="lr-heatmap-dow-label"></span>
                  <span class="lr-heatmap-dow-label">Mon</span>
                  <span class="lr-heatmap-dow-label"></span>
                  <span class="lr-heatmap-dow-label">Wed</span>
                  <span class="lr-heatmap-dow-label"></span>
                  <span class="lr-heatmap-dow-label">Fri</span>
                  <span class="lr-heatmap-dow-label"></span>
                </div>
                <div class="lr-heatmap-grid" style="grid-template-columns: repeat(<%= _cols %>, 11px);">
                  <% for (var s = 0; s < heatmapStartDow; s++) { %>
                    <span class="lr-heatmap-cell" style="visibility:hidden"></span>
                  <% } %>
                  <% _heatmap.forEach(function(d) { %>
                    <span class="lr-heatmap-cell"
                          data-bucket="<%= heatmapBucket(d.plays) %>"
                          title="<%= d.day %>: <%= d.plays %> play<%= d.plays !== 1 ? 's' : '' %>"></span>
                  <% }) %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="cur-panel" data-panel-collapsible="false">
          <div class="cur-panel-body">
            <% [['7d', _quickFactsByPeriod['7d']], ['30d', _quickFactsByPeriod['30d']], ['3m', _quickFactsByPeriod['3m']], ['12m', _quickFactsByPeriod['12m']], ['all', _quickFactsByPeriod['all']]].forEach(function(pair) { %>
              <% var ps = pair[0]; var qf = pair[1] || {}; var bestDay = qf.bestDay || {}; var bestDayFmt = bestDay.day ? new Date(bestDay.day + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) : null; %>
              <div class="lr-facts-grid<%= ps !== '30d' ? ' lr-hidden' : '' %>" data-period-set="<%= ps %>">
                <div class="lr-fact-card">
                  <div class="lr-fact-value"><%= qf.streak || 0 %><span class="lr-fact-unit">days</span></div>
                  <div class="lr-fact-label">Listening Streak</div>
                  <div class="lr-fact-sub">consecutive days with plays</div>
                </div>
                <div class="lr-fact-card">
                  <div class="lr-fact-value"><%= bestDay.plays || 0 %><span class="lr-fact-unit">plays</span></div>
                  <div class="lr-fact-label">Best Day</div>
                  <div class="lr-fact-sub"><%= bestDayFmt || 'no plays in this period' %></div>
                </div>
                <div class="lr-fact-card">
                  <div class="lr-fact-value"><%= qf.skipRate || 0 %>%</div>
                  <div class="lr-fact-label">Skip Rate</div>
                  <div class="lr-fact-sub">for this period</div>
                </div>
                <div class="lr-fact-card">
                  <div class="lr-fact-value"><%= qf.mostActiveHour || '—' %></div>
                  <div class="lr-fact-label">Most Active Hour</div>
                  <div class="lr-fact-sub">for this period</div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>

        <% [['7d', 'Last 7 days'], ['30d', 'Last 30 days'], ['3m', 'Last 90 days'], ['12m', 'Last 1 year'], ['all', 'All time']].forEach(function(pair) { %>
          <% var ps = pair[0]; var label = pair[1]; var summary = _summaryByPeriod[ps] || {}; var summaryCmp = _summaryCompByPeriod[ps] || null; %>
          <div class="lr-summary-strip<%= ps !== '30d' ? ' lr-hidden' : '' %>" data-period-set="<%= ps %>">
            <div class="lr-summary-card lr-summary-card--primary">
              <div class="lr-summary-label"><%= label %></div>
              <div class="lr-summary-value"><%= fmtNum(summary.plays) %></div>
              <div class="lr-summary-meta">
                plays
                <% if (summaryCmp) { %>
                  · <span><%- changeBadge(summary.plays, summaryCmp.plays) %></span>
                <% } %>
              </div>
            </div>
            <div class="lr-summary-card">
              <div class="lr-summary-label">Artists</div>
              <div class="lr-summary-value"><%= fmtNum(summary.uniqueArtists) %></div>
              <div class="lr-summary-meta"><%- changeBadge(summary.uniqueArtists, summaryCmp && summaryCmp.unique_artists) %></div>
            </div>
            <div class="lr-summary-card">
              <div class="lr-summary-label">Albums</div>
              <div class="lr-summary-value"><%= fmtNum(summary.uniqueAlbums) %></div>
              <div class="lr-summary-meta"><%- changeBadge(summary.uniqueAlbums, summaryCmp && summaryCmp.unique_albums) %></div>
            </div>
            <div class="lr-summary-card">
              <div class="lr-summary-label">Tracks</div>
              <div class="lr-summary-value"><%= fmtNum(summary.uniqueTracks) %></div>
              <div class="lr-summary-meta"><%- changeBadge(summary.uniqueTracks, summaryCmp && summaryCmp.unique_tracks) %></div>
            </div>
            <div class="lr-summary-card">
              <div class="lr-summary-label">Listen time</div>
              <div class="lr-summary-value"><%= fmtListenTime(summary.listenMs) %></div>
              <div class="lr-summary-meta"><%- changeBadge(summary.listenMs, summaryCmp && summaryCmp.total_listen_ms) %></div>
            </div>
            <div class="lr-summary-card">
              <div class="lr-summary-label">Active days</div>
              <div class="lr-summary-value"><%= fmtNum(summary.activeDays) %></div>
              <div class="lr-summary-meta"><%- changeBadge(summary.activeDays, summaryCmp && summaryCmp.active_days) %></div>
            </div>
          </div>
        <% }) %>

      </div><%# end dash-content %>
    </section>
  </div>

  <script src="/sidebar.js?v=<%= assetVersion %>"></script>
  <script src="/user-menu.js?v=<%= assetVersion %>"></script>
  <script src="/version-badge.js?v=<%= assetVersion %>"></script>
  <script src="/brand-menu.js?v=<%= assetVersion %>"></script>
  <script src="/curatorr-overview.js?v=<%= assetVersion %>"></script>
  <script>
  (function () {
    // ── Period selector ────────────────────────────────────────────────────
    var btns = document.querySelectorAll('.lr-period-btn');
    var sets = document.querySelectorAll('[data-period-set]');

    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var p = btn.dataset.period;
        btns.forEach(function (b) { b.classList.toggle('active', b === btn); });
        sets.forEach(function (el) {
          el.classList.toggle('lr-hidden', el.dataset.periodSet !== p);
        });
      });
    });

    // ── Weekly chart ───────────────────────────────────────────────────────
    var weekOffset  = 0;
    var labelEl  = document.getElementById('lr-week-label');
    var totalEl  = document.getElementById('lr-week-total');
    var chartEl  = document.getElementById('lr-weekly-chart');
    var backBtn  = document.getElementById('lr-week-back');
    var fwdBtn   = document.getElementById('lr-week-fwd');

    function isDayTheme() {
      return document.documentElement.getAttribute('data-theme') === 'day';
    }

    function renderWeekChart(data) {
      var week     = data.week;
      var prevWeek = data.prevWeek;
      var allPlays = week.days.concat(prevWeek.days).map(function(d){ return d.plays; });
      var maxPlays = Math.max.apply(null, allPlays.concat([1]));

      labelEl.textContent = week.label;
      totalEl.textContent = week.totalPlays.toLocaleString() + ' plays';
      backBtn.disabled    = false;
      fwdBtn.disabled     = !data.canGoForward;

      var W = chartEl.offsetWidth || 560;
      var H = 120;
      var padL = 8, padR = 8, padT = 12, padB = 28;
      var innerW = W - padL - padR;
      var innerH = H - padT - padB;
      var barW = Math.floor(innerW / 7);
      var groupW = barW;
      var bW = Math.max(4, Math.floor(groupW * 0.36));

      var isDark = !isDayTheme();
      var prevCol  = isDark ? 'rgba(139,92,246,0.22)' : 'rgba(139,92,246,0.15)';
      var curCol   = isDark ? 'rgba(139,92,246,0.85)' : 'rgba(109,40,217,0.80)';
      var textCol  = isDark ? 'rgba(255,255,255,0.4)' : 'rgba(11,21,30,0.4)';
      var gridCol  = isDark ? 'rgba(255,255,255,0.07)' : 'rgba(11,21,30,0.07)';

      var svgParts = ['<svg width="' + W + '" height="' + H + '" xmlns="http://www.w3.org/2000/svg">'];

      // grid line at top
      var yTop = padT;
      svgParts.push('<line x1="' + padL + '" y1="' + yTop + '" x2="' + (W - padR) + '" y2="' + yTop + '" stroke="' + gridCol + '" stroke-width="1"/>');

      week.days.forEach(function(day, i) {
        var prev = prevWeek.days[i] || { plays: 0 };
        var x = padL + i * groupW;
        var cx = x + groupW / 2;

        // prev bar (behind, lighter)
        if (prev.plays > 0) {
          var ph = Math.round((prev.plays / maxPlays) * innerH);
          svgParts.push('<rect x="' + (cx - bW - 1).toFixed(1) + '" y="' + (padT + innerH - ph) + '" width="' + bW + '" height="' + ph + '" rx="2" fill="' + prevCol + '"/>');
        }

        // current bar
        if (day.plays > 0) {
          var ch = Math.round((day.plays / maxPlays) * innerH);
          svgParts.push('<rect x="' + (cx + 1).toFixed(1) + '" y="' + (padT + innerH - ch) + '" width="' + bW + '" height="' + ch + '" rx="2" fill="' + curCol + '"/>');
          // play count label above bar if > 0
          if (ch > 14) {
            svgParts.push('<text x="' + (cx + 1 + bW/2).toFixed(1) + '" y="' + (padT + innerH - ch - 3) + '" text-anchor="middle" font-size="9" fill="' + curCol + '">' + day.plays + '</text>');
          }
        }

        // Day label
        svgParts.push('<text x="' + cx.toFixed(1) + '" y="' + (H - 6) + '" text-anchor="middle" font-size="10" font-family="Segoe UI,sans-serif" fill="' + textCol + '">' + day.dow + '</text>');
      });

      svgParts.push('</svg>');
      chartEl.innerHTML = svgParts.join('');
    }

    function loadWeek(offset) {
      labelEl.textContent = 'Loading…';
      totalEl.textContent = '';
      fetch('/api/music/report/weekly?offset=' + offset, { credentials: 'same-origin' })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          weekOffset = offset;
          renderWeekChart(data);
        })
        .catch(function() {
          labelEl.textContent = 'Could not load data';
        });
    }

    backBtn.addEventListener('click', function() { loadWeek(weekOffset + 1); });
    fwdBtn.addEventListener('click',  function() { if (weekOffset > 0) loadWeek(weekOffset - 1); });

    // Initial load
    loadWeek(0);

    // Re-render on theme change to update colours
    var themeObserver = new MutationObserver(function() {
      if (chartEl.querySelector('svg')) loadWeek(weekOffset);
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }());
  </script>
</body>
</html>

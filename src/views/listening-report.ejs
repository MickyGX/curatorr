                       onerror="this.onerror=null;this.src='/api/music/thumb/album?artist=<%= encodeURIComponent(featuredArtist || '') %>&album=<%= encodeURIComponent(featuredTrack.album_name || '') %>&noArtistFallback=1';this.onerror=function(){this.onerror=null;this.src='/icons/music.svg';}" />
                </div>

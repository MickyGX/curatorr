<%- include('partials/head', { pageTitle: 'Curatorr · Setup', extraCss: locals.extraCss || [] }) %>
<body class="login-body">
  <%- include('partials/theme-init') %>
  <div class="wizard-shell">
    <div class="wizard-card">
      <div class="wizard-header">
        <div class="wizard-brand">
          <img src="/icons/curatorr-icon.svg" alt="Curatorr" class="wizard-logo" onerror="this.style.display='none'" />
          <span class="wizard-brand-name">Curatorr</span>
        </div>
        <div class="wizard-steps">
          <% for (var i = 1; i <= totalSteps; i++) { %>
            <div class="wizard-step-dot<%= i === displayStep ? ' wizard-step-dot--active' : (i < displayStep ? ' wizard-step-dot--done' : '') %>"></div>
          <% } %>
        </div>
        <div class="wizard-step-label">Step <%= displayStep %> of <%= totalSteps %></div>
      </div>

      <% if (error) { %>
        <div class="wizard-error"><%= error %></div>
      <% } %>
      <% if (info) { %>
        <div class="wizard-info-banner"><%= info %></div>
      <% } %>

      <%# ── Step 1: Create admin account ────────────────────────────────────── %>
      <% if (step === 1) { %>
        <div class="wizard-body">
          <h2 class="wizard-title">Welcome to Curatorr</h2>
          <p class="wizard-desc">Let's get you set up. First, create your administrator account.</p>
          <form method="post" action="/wizard/account" class="wizard-form" id="wsf1">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="wizard-field">
              <label class="wizard-label" for="username">Username</label>
              <input class="wizard-input" type="text" id="username" name="username" required autocomplete="username" autofocus />
            </div>
            <div class="wizard-field">
              <label class="wizard-label" for="email">Email</label>
              <input class="wizard-input" type="email" id="email" name="email" required autocomplete="email" />
            </div>
            <div class="wizard-field">
              <label class="wizard-label" for="password">Password</label>
              <input class="wizard-input" type="password" id="password" name="password" required autocomplete="new-password" />
            </div>
            <div class="wizard-field">
              <label class="wizard-label" for="confirmPassword">Confirm password</label>
              <input class="wizard-input" type="password" id="confirmPassword" name="confirmPassword" required autocomplete="off" />
            </div>
          </form>
          <div class="wizard-actions">
            <button type="submit" form="wsf1" class="btn btn-primary">Create account →</button>
          </div>
        </div>

      <%# ── Step 2: Connect media server ───────────────────────────────────── %>
      <% } else if (step === 2) { %>
        <% var msType = config.mediaServer?.type || 'plex'; %>
        <div class="wizard-body">
          <h2 class="wizard-title">Connect your media server</h2>
          <p class="wizard-desc">Choose your media server. Curatorr will track plays and build smart playlists from your library. Webhooks are registered automatically where supported.</p>
          <form method="post" action="/wizard/media-server" class="wizard-form" id="wsf2">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

            <%# Server type selector %>
            <div class="wizard-field">
              <label class="wizard-label">Media server</label>
              <div class="wizard-radio-group" id="msTypeGroup">
                <label class="wizard-radio-item<%= msType === 'plex' ? ' wizard-radio-item--active' : '' %>">
                  <input type="radio" name="mediaServerType" value="plex" <%= msType === 'plex' ? 'checked' : '' %> />
                  <span class="wizard-radio-label">Plex</span>
                </label>
                <label class="wizard-radio-item<%= msType === 'jellyfin' ? ' wizard-radio-item--active' : '' %>">
                  <input type="radio" name="mediaServerType" value="jellyfin" <%= msType === 'jellyfin' ? 'checked' : '' %> />
                  <span class="wizard-radio-label">Jellyfin</span>
                </label>
                <label class="wizard-radio-item<%= msType === 'emby' ? ' wizard-radio-item--active' : '' %>">
                  <input type="radio" name="mediaServerType" value="emby" <%= msType === 'emby' ? 'checked' : '' %> />
                  <span class="wizard-radio-label">Emby</span>
                </label>
              </div>
            </div>

            <%# Plex fields %>
            <div id="ms-fields-plex" class="ms-fields<%= msType !== 'plex' ? ' ms-fields--hidden' : '' %>">
              <div class="wizard-field">
                <label class="wizard-label" for="plexUrl">Plex server URL</label>
                <input class="wizard-input" type="url" id="plexUrl" name="plexUrl" value="<%= config.plex?.url || '' %>" placeholder="http://192.168.1.x:32400" />
              </div>
              <div class="wizard-field">
                <label class="wizard-label" for="plexToken">Plex token</label>
                <input class="wizard-input" type="text" id="plexToken" name="plexToken" value="" placeholder="<%= config.plex?.tokenSet ? '(saved — leave blank to keep)' : 'Paste a Plex server token or fetch one below' %>" />
                <div class="wizard-hint">Recommended: use Fetch from Plex to sign in as the server owner and save the token automatically.</div>
              </div>
            </div>

            <%# Jellyfin fields %>
            <div id="ms-fields-jellyfin" class="ms-fields<%= msType !== 'jellyfin' ? ' ms-fields--hidden' : '' %>">
              <div class="wizard-field">
                <label class="wizard-label" for="jellyfinUrl">Jellyfin server URL</label>
                <input class="wizard-input" type="url" id="jellyfinUrl" name="serverUrl" value="<%= msType === 'jellyfin' ? (config.jellyfin?.url || '') : '' %>" placeholder="http://192.168.1.x:8096" />
              </div>
              <div class="wizard-field">
                <label class="wizard-label" for="jellyfinUsername">Admin username</label>
                <input class="wizard-input" type="text" id="jellyfinUsername" name="serverUsername" autocomplete="username" placeholder="Your Jellyfin admin username" />
              </div>
              <div class="wizard-field">
                <label class="wizard-label" for="jellyfinPassword">Admin password</label>
                <input class="wizard-input" type="password" id="jellyfinPassword" name="serverPassword" autocomplete="current-password" placeholder="Your Jellyfin admin password" />
                <div class="wizard-hint">Used once to obtain an API key. The password is not stored.</div>
              </div>
            </div>

            <%# Emby fields %>
            <div id="ms-fields-emby" class="ms-fields<%= msType !== 'emby' ? ' ms-fields--hidden' : '' %>">
              <div class="wizard-field">
                <label class="wizard-label" for="embyUrl">Emby server URL</label>
                <input class="wizard-input" type="url" id="embyUrl" name="serverUrl" value="<%= msType === 'emby' ? (config.emby?.url || '') : '' %>" placeholder="http://192.168.1.x:8096" />
              </div>
              <div class="wizard-field">
                <label class="wizard-label" for="embyUsername">Admin username</label>
                <input class="wizard-input" type="text" id="embyUsername" name="serverUsername" autocomplete="username" placeholder="Your Emby admin username" />
              </div>
              <div class="wizard-field">
                <label class="wizard-label" for="embyPassword">Admin password</label>
                <input class="wizard-input" type="password" id="embyPassword" name="serverPassword" autocomplete="current-password" placeholder="Your Emby admin password" />
                <div class="wizard-hint">Used once to obtain an API key. The password is not stored.</div>
              </div>
            </div>

          </form>
          <div class="wizard-actions">
            <form method="post" action="/wizard/back">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="step" value="2" />
              <button type="submit" class="btn btn-ghost">← Back</button>
            </form>
            <button
              type="submit"
              form="wsf2"
              formaction="/wizard/plex/fetch-token"
              class="btn btn-secondary"
              id="plex-fetch-token-btn"
              <%= msType === 'plex' ? '' : 'hidden' %>>
              Fetch from Plex →
            </button>
            <button type="submit" form="wsf2" class="btn btn-primary">Connect &amp; continue →</button>
          </div>
        </div>

      <%# ── Step 3: Select music libraries ─────────────────────────────────── %>
      <% } else if (step === 3) { %>
        <% var activeType = config.mediaServer?.type || 'plex'; %>
        <% var activeCfg = config[activeType] || config.plex || {}; %>
        <% var serverLabel = activeType === 'plex' ? 'Plex' : (activeType === 'jellyfin' ? 'Jellyfin' : 'Emby'); %>
        <div class="wizard-body">
          <h2 class="wizard-title">Select music libraries</h2>
          <p class="wizard-desc">Choose which <%= serverLabel %> music libraries Curatorr should monitor and include in smart playlists.</p>
          <form method="post" action="/wizard/libraries" class="wizard-form" id="wsf3">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <% var availLibs = activeCfg.availableLibraries || []; %>
            <% if (availLibs.length) { %>
              <div class="wizard-check-grid">
                <% availLibs.forEach(function(lib) { %>
                  <label class="wizard-check-item">
                    <input type="checkbox" name="libraries" value="<%= lib.key %>"
                      <%= (activeCfg.libraries || []).includes(lib.key) ? 'checked' : (availLibs.length === 1 ? 'checked' : '') %> />
                    <span class="wizard-check-label"><%= lib.title %></span>
                  </label>
                <% }) %>
              </div>
            <% } else { %>
              <p class="wizard-hint"><% if (activeType === 'plex' && !activeCfg.tokenSet) { %>No token set yet — sign in with your Plex owner account first to auto-populate the token.<% } else { %>No music libraries found. Go back and verify your server connection.<% } %></p>
            <% } %>
          </form>
          <div class="wizard-actions">
            <form method="post" action="/wizard/back">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="step" value="3" />
              <button type="submit" class="btn btn-ghost">← Back</button>
            </form>
            <button type="submit" form="wsf3" class="btn btn-primary">Continue →</button>
          </div>
        </div>

      <%# ── Step 4: Tautulli (optional, Plex only) ─────────────────────────── %>
      <% } else if (step === 4) { %>
        <div class="wizard-body">
          <h2 class="wizard-title">Tautulli <span class="wizard-optional">optional</span></h2>
          <p class="wizard-desc">Connect Tautulli as an optional daily backup source. Curatorr can create the Tautulli webhook automatically and use scheduled syncs to fill gaps without overwriting plays already recorded by Plex.</p>
          <form method="post" action="/wizard/tautulli" class="wizard-form" id="wsf4">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="wizard-field">
              <label class="wizard-label" for="tautulliUrl">Tautulli URL</label>
              <input class="wizard-input" type="url" id="tautulliUrl" name="tautulliUrl" value="<%= config.tautulli?.url || '' %>" placeholder="http://192.168.1.x:8181" />
            </div>
            <div class="wizard-field">
              <label class="wizard-label" for="tautulliApiKey">API key</label>
              <input class="wizard-input" type="text" id="tautulliApiKey" name="tautulliApiKey" value="" placeholder="<%= config.tautulli?.apiKeySet ? '(saved — leave blank to keep)' : 'Tautulli API key' %>" />
              <div class="wizard-hint">Find it in Tautulli → Settings → Web Interface → API key.</div>
            </div>
            <div class="wizard-field">
              <label class="wizard-label" for="curatorrUrl">Curatorr URL <span class="wizard-optional">as Tautulli can reach it</span></label>
              <input class="wizard-input" type="url" id="curatorrUrl" name="curatorrUrl" value="<%= config.tautulli?.curatorrUrl || '' %>" placeholder="http://192.168.1.x:7676" />
              <div class="wizard-hint">The URL Tautulli will POST to — must be reachable from the Tautulli server. Leave blank to skip auto-configure.</div>
            </div>
          </form>
          <div class="wizard-actions">
            <form method="post" action="/wizard/back">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="step" value="4" />
              <button type="submit" class="btn btn-ghost">← Back</button>
            </form>
            <form method="post" action="/wizard/tautulli">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="skip" value="1" />
              <button type="submit" class="btn btn-secondary">Skip Tautulli for now</button>
            </form>
            <button type="submit" form="wsf4" class="btn btn-primary">Connect &amp; continue →</button>
          </div>
        </div>

      <%# ── Step 5: Lidarr (optional) ──────────────────────────────────────── %>
      <% } else if (step === 5) { %>
        <div class="wizard-body">
          <h2 class="wizard-title">Lidarr <span class="wizard-optional">optional</span></h2>
          <p class="wizard-desc">Connect Lidarr to enable automatic artist discovery and library management. You can skip this and connect later from Settings.</p>
          <form method="post" action="/wizard/lidarr" class="wizard-form" id="wsf5">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="wizard-field">
              <label class="wizard-label" for="lidarrUrl">Lidarr URL</label>
              <input class="wizard-input" type="url" id="lidarrUrl" name="lidarrUrl" value="<%= config.lidarr?.url || '' %>" placeholder="http://192.168.1.x:8686" />
            </div>
            <div class="wizard-field">
              <label class="wizard-label" for="lidarrApiKey">API key</label>
              <input class="wizard-input" type="text" id="lidarrApiKey" name="lidarrApiKey" value="" placeholder="<%= config.lidarr?.apiKeySet ? '(saved — leave blank to keep)' : 'Lidarr API key' %>" />
              <div class="wizard-hint">Find it in Lidarr → Settings → General → API key.</div>
            </div>
          </form>
          <div class="wizard-actions">
            <form method="post" action="/wizard/back">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="step" value="5" />
              <button type="submit" class="btn btn-ghost">← Back</button>
            </form>
            <form method="post" action="/wizard/lidarr">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="skip" value="1" />
              <button type="submit" class="btn btn-secondary">Skip for now</button>
            </form>
            <button type="submit" form="wsf5" class="btn btn-primary">Finish setup →</button>
          </div>
        </div>

      <%# ── Step 6: Sign in ─────────────────────────────────────────────────── %>
      <% } else if (step === 6) { %>
        <% var finalServerType = config.mediaServer?.type || 'plex'; %>
        <div class="wizard-body">
          <h2 class="wizard-title">One last thing</h2>
          <% if (finalServerType === 'plex') { %>
            <p class="wizard-desc">Your server is configured. To use Curatorr's music features — playlists, history, discovery — you need to sign in with your <strong>Plex account</strong>.</p>
            <div class="wizard-info-box">
              <div class="wizard-info-row">
                <span class="wizard-info-label">Administrator account</span>
                <span class="wizard-info-value">Manages server settings, users, and configuration. No music features.</span>
              </div>
              <div class="wizard-info-row">
                <span class="wizard-info-label">Plex account</span>
                <span class="wizard-info-value">Your personal Curatorr experience — playlists, play history, discovery, and more.</span>
              </div>
            </div>
            <div class="wizard-actions wizard-actions--col">
              <a href="/auth/plex" class="btn btn-primary">Sign in with Plex →</a>
              <a href="/overview" class="wizard-skip-link">Continue as administrator only</a>
            </div>
          <% } else { %>
            <% var serverDisplayName = finalServerType === 'jellyfin' ? 'Jellyfin' : 'Emby'; %>
            <p class="wizard-desc">Your server is configured. Sign in with your <strong><%= serverDisplayName %> account</strong> to link your personal library, playlists, and play history.</p>
            <div class="wizard-info-box">
              <div class="wizard-info-row">
                <span class="wizard-info-label">Administrator account</span>
                <span class="wizard-info-value">Manages server settings, users, and configuration. No music features.</span>
              </div>
              <div class="wizard-info-row">
                <span class="wizard-info-label"><%= serverDisplayName %> account</span>
                <span class="wizard-info-value">Your personal Curatorr experience — playlists, play history, discovery, and more.</span>
              </div>
            </div>
            <div class="wizard-actions wizard-actions--col">
              <a href="/auth/<%= finalServerType %>" class="btn btn-primary">Sign in with <%= serverDisplayName %> →</a>
              <a href="/overview" class="wizard-skip-link">Continue as administrator only</a>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>

  <script>
    // Toggle media server field panels when type selector changes
    (function () {
      var radios = document.querySelectorAll('input[name="mediaServerType"]');
      if (!radios.length) return;
      var plexFetchButton = document.getElementById('plex-fetch-token-btn');
      function showPanel(type) {
        document.querySelectorAll('.ms-fields').forEach(function (el) {
          el.classList.add('ms-fields--hidden');
          el.querySelectorAll('input, select, textarea').forEach(function (f) { f.disabled = true; });
        });
        document.querySelectorAll('.wizard-radio-item').forEach(function (el) { el.classList.remove('wizard-radio-item--active'); });
        var panel = document.getElementById('ms-fields-' + type);
        if (panel) {
          panel.classList.remove('ms-fields--hidden');
          panel.querySelectorAll('input, select, textarea').forEach(function (f) { f.disabled = false; });
        }
        if (plexFetchButton) plexFetchButton.hidden = type !== 'plex';
        var activeLabel = document.querySelector('.wizard-radio-item input[value="' + type + '"]');
        if (activeLabel) activeLabel.closest('.wizard-radio-item').classList.add('wizard-radio-item--active');
      }
      radios.forEach(function (r) {
        r.addEventListener('change', function () { showPanel(this.value); });
      });
      // Disable inputs in all hidden panels on page load
      var checked = document.querySelector('input[name="mediaServerType"]:checked');
      if (checked) showPanel(checked.value);
    }());
  </script>
</body>
</html>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <%- include('partials/theme-init') %>
    <link rel="stylesheet" href="/styles.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="/styles-auth.css?v=<%= assetVersion %>" />
    <link rel="icon" type="image/png" href="/icons/curatorr-icon.png" />
    <meta name="theme-color" content="#8b5cf6" />
  </head>
  <body class="login-body">
    <div class="login-stars"></div>
    <div class="login-planet"></div>
    <main class="login-wrap">
      <div class="login-hero">
        <div class="login-brand login-brand--full">
          <img class="login-full-logo" src="/icons/curatorr-full-logo.png" alt="Curatorr - Music that moves with you" width="1491" height="1055" />
        </div>
        <div class="login-card">
          <div class="login-card-title">Jellyfin</div>
          <div class="login-card-sub">Enter your Jellyfin credentials</div>
          <% if (error) { %>
            <div class="login-error"><%= error %></div>
          <% } %>
          <form class="login-form" method="post" action="/auth/jellyfin">
            <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>" />
            <label class="login-field">
              <span>Username</span>
              <input class="login-input" type="text" name="username" autocomplete="username" required autofocus />
            </label>
            <label class="login-field">
              <span>Password</span>
              <input class="login-input" type="password" name="password" autocomplete="current-password" required />
            </label>
            <button class="primary-button" type="submit">Sign in with Jellyfin →</button>
          </form>
          <div class="login-divider">or</div>
          <a class="login-alt-link" href="/login">Sign in as administrator</a>
        </div>
      </div>
    </main>
  </body>
</html>

<%- include('partials/head', { pageTitle: title || 'Settings — Curatorr', extraCss: extraCss || ['/styles-layout.css', '/styles-settings.css'] }) %>
<body class="dash-body">
  <div class="dash-frame<%= sidebarCollapsed ? ' sidebar-collapsed' : '' %>">
    <aside class="dash-sidebar">
      <div class="dash-brand">
        <span class="dash-logo">
          <img class="nav-icon app-icon" src="/icons/curatorr-icon.svg" alt="Curatorr" onerror="this.style.display='none'" />
        </span>
        <div><div class="dash-title">Curatorr</div></div>
      </div>
      <div class="dash-nav">
        <%- include('partials/nav-categories', { navActivePage: 'settings', role: role }) %>
      </div>
      <%- include('partials/user-menu') %>
    </aside>

    <section class="dash-main">
      <div class="main-window-bar">
        <button class="sidebar-toggle main-toggle left-toggle" type="button" aria-label="Toggle sidebar">
          <img class="toggle-icon" src="/icons/sidebar-toggle.svg" alt="" />
        </button>
        <div class="main-window-title">
          <img class="main-window-icon" src="/icons/settings.svg" alt="" />
          <span class="main-window-app">Curatorr</span>
          <span class="main-window-rest">| Settings</span>
        </div>
        <div class="main-window-spacer"></div>
        <div class="main-window-status">
          <span class="status-dot"></span>
        </div>
      </div>

      <div class="dash-content">
        <% const _tab = tab || 'general'; %>
        <% const canManageServiceConfig = actualRole === 'admin'; %>
        <% const safeJson = (value) => JSON.stringify(value)
          .replace(/</g, '\\u003c')
          .replace(/\u2028/g, '\\u2028')
          .replace(/\u2029/g, '\\u2029'); %>

        <% if (success) { %>
          <div class="settings-debug" style="border-color:rgba(74,222,128,.35);background:rgba(74,222,128,.1);color:#4ade80;margin-bottom:0">Settings saved successfully.</div>
        <% } %>
        <% if (error) { %>
          <div class="settings-debug" style="margin-bottom:0"><%= error %></div>
        <% } %>

        <style>
          .playlist-preset-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin-top:10px; align-items:stretch; }
          .playlist-preset-card { position:relative; overflow:hidden; display:flex; flex-direction:column; min-height:100%; border:1px solid rgba(255,255,255,.12); border-radius:16px; background:linear-gradient(180deg,rgba(14,18,27,.92),rgba(11,15,24,.82)); color:#f8fafc; padding:12px; text-align:left; cursor:pointer; transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease; box-shadow:0 14px 34px rgba(15,23,42,.18); }
          .playlist-preset-card:hover { transform:translateY(-1px); border-color:rgba(255,255,255,.22); }
          .playlist-preset-card.is-active { border-color:rgba(245,158,11,.92); box-shadow:0 0 0 1px rgba(245,158,11,.28), 0 12px 30px rgba(0,0,0,.26); }
          .playlist-preset-card.is-disabled,
          .playlist-preset-card:disabled { opacity:.48; cursor:not-allowed; transform:none; box-shadow:none; filter:saturate(.6); }
          .playlist-preset-card__art { display:block; position:relative; overflow:hidden; height:104px; border-radius:12px; margin-bottom:12px; border:1px solid rgba(255,255,255,.10); box-shadow:inset 0 1px 0 rgba(255,255,255,.08), inset 0 -24px 36px rgba(15,23,42,.22); }
          .playlist-preset-card__art::before,
          .playlist-preset-card__art::after { content:""; position:absolute; pointer-events:none; }
          .playlist-preset-card__art::before { inset:0; background:linear-gradient(180deg,rgba(255,255,255,.14),transparent 26%,rgba(15,23,42,.26)); }
          .playlist-preset-card__art::after { right:-10%; bottom:-26%; width:72%; height:72%; border-radius:999px; border:1px solid rgba(255,255,255,.20); box-shadow:0 0 0 16px rgba(255,255,255,.05), 0 0 0 36px rgba(255,255,255,.03); opacity:.7; transform:rotate(-18deg); }
          .playlist-preset-card__eyebrow { display:block; font-size:11px; letter-spacing:.12em; text-transform:uppercase; color:rgba(255,255,255,.5); margin-bottom:4px; }
          .playlist-preset-card__title { display:block; font-weight:700; margin-bottom:4px; color:#f8fafc; }
          .playlist-preset-card__desc { display:block; font-size:12px; color:rgba(255,255,255,.74); line-height:1.45; }
          .playlist-preset-card__meta { display:block; margin-top:7px; font-size:11px; color:rgba(255,255,255,.58); }
          .playlist-preset-card--none .playlist-preset-card__art { background:
            linear-gradient(135deg,rgba(255,255,255,.06) 0 12%,transparent 12% 100%),
            linear-gradient(135deg,#111827,#1f2937); }
          .playlist-preset-card--club .playlist-preset-card__art { background:
            radial-gradient(circle at 20% 25%,rgba(236,72,153,.95),transparent 35%),
            radial-gradient(circle at 80% 20%,rgba(59,130,246,.9),transparent 34%),
            linear-gradient(135deg,#140c1c,#312e81 54%,#0f172a); }
          .playlist-preset-card--club .playlist-preset-card__art::after { right:-8%; bottom:-18%; width:82%; height:82%; border-color:rgba(244,114,182,.34); box-shadow:0 0 0 16px rgba(59,130,246,.10), 0 0 0 36px rgba(236,72,153,.10); }
          .playlist-preset-card--driving .playlist-preset-card__art { background:
            linear-gradient(180deg,rgba(251,191,36,.98),rgba(249,115,22,.88) 44%,rgba(30,41,59,.98)),
            linear-gradient(120deg,#1e3a8a,#0f172a); }
          .playlist-preset-card--driving .playlist-preset-card__art::after { right:-2%; bottom:-22%; width:56%; height:110%; border-radius:28px; border-color:rgba(255,255,255,.30); box-shadow:0 0 0 10px rgba(255,255,255,.06), inset 0 0 0 1px rgba(255,255,255,.08); transform:skewX(-18deg); }
          .playlist-preset-card--workout .playlist-preset-card__art { background:
            linear-gradient(135deg,rgba(239,68,68,.98),rgba(249,115,22,.92) 42%,rgba(17,24,39,.98)); }
          .playlist-preset-card--workout .playlist-preset-card__art::after { right:-14%; bottom:-30%; width:74%; height:88%; border-color:rgba(254,215,170,.28); box-shadow:0 0 0 16px rgba(249,115,22,.10), 0 0 0 34px rgba(239,68,68,.08); transform:rotate(-10deg); }
          .playlist-preset-card--chill .playlist-preset-card__art { background:
            radial-gradient(circle at 25% 20%,rgba(125,211,252,.85),transparent 28%),
            linear-gradient(135deg,#0f172a,#1d4ed8 55%,#164e63); }
          .playlist-preset-card--chill .playlist-preset-card__art::after { right:-4%; bottom:-24%; width:68%; height:76%; border-color:rgba(186,230,253,.26); box-shadow:0 0 0 14px rgba(125,211,252,.08), 0 0 0 32px rgba(14,165,233,.05); transform:rotate(-6deg); }
          .playlist-preset-card--harmonic .playlist-preset-card__art { background:
            radial-gradient(circle at center,rgba(255,255,255,.16) 0,rgba(255,255,255,.06) 24%,transparent 25%),
            conic-gradient(from 45deg,#f59e0b,#f97316,#ef4444,#8b5cf6,#3b82f6,#14b8a6,#f59e0b); }
          .playlist-preset-card--harmonic .playlist-preset-card__art::after { right:10%; bottom:12%; width:34%; height:34%; border-color:rgba(255,255,255,.28); box-shadow:0 0 0 12px rgba(255,255,255,.08), 0 0 0 24px rgba(255,255,255,.04); transform:none; }
          .playlist-preset-card--downtempo .playlist-preset-card__art { background:
            linear-gradient(135deg,#0f172a,#334155 45%,#475569); }
          .playlist-preset-card--downtempo .playlist-preset-card__art::after { right:-10%; bottom:-28%; width:72%; height:72%; border-color:rgba(226,232,240,.18); box-shadow:0 0 0 16px rgba(148,163,184,.08), 0 0 0 34px rgba(71,85,105,.06); }
          .playlist-feature-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:12px; margin-top:14px; align-items:end; }
          .playlist-feature-grid .field { display:flex; flex-direction:column; gap:6px; min-width:0; }
          .playlist-feature-grid .field span { font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.08em; color:var(--muted,#94a3b8); }
          .playlist-feature-grid .field input,
          .playlist-feature-grid .field select { width:100%; min-height:44px; box-sizing:border-box; border-radius:10px; border:1px solid var(--border, rgba(255,255,255,.15)); background:var(--surface-1,#1e1e1e); color:var(--text,#e5e7eb); padding:9px 12px; }
          .playlist-feature-note { margin-top:10px; font-size:12px; line-height:1.55; color:var(--muted,#a0aec0); }
          .playlist-feature-note strong { color:var(--text,#f8fafc); }
          .settings-inline-code { display:inline-flex; align-items:center; padding:2px 6px; border-radius:5px; font-size:11px; line-height:1.35; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.08); color:inherit; }
          [data-theme="day"] .playlist-preset-card { background:linear-gradient(180deg,#ffffff,#eef3f8); border-color:rgba(10,20,30,.12); color:#223043; box-shadow:0 16px 36px rgba(15,23,42,.10); }
          [data-theme="day"] .playlist-preset-card:hover { border-color:rgba(var(--brand-rgb), .24); box-shadow:0 18px 40px rgba(15,23,42,.14); }
          [data-theme="day"] .playlist-preset-card.is-active { border-color:rgba(245,158,11,.92); box-shadow:0 0 0 1px rgba(245,158,11,.18), 0 18px 42px rgba(245,158,11,.14); }
          [data-theme="day"] .playlist-preset-card__art { border-color:rgba(10,20,30,.10); box-shadow:inset 0 1px 0 rgba(255,255,255,.18), inset 0 -24px 36px rgba(15,23,42,.12); }
          [data-theme="day"] .playlist-preset-card__eyebrow { color:#738297; }
          [data-theme="day"] .playlist-preset-card__title { color:#223043; }
          [data-theme="day"] .playlist-preset-card__desc { color:#4f5f73; }
          [data-theme="day"] .playlist-preset-card__meta { color:#6b7a8d; }
          [data-theme="day"] .playlist-feature-grid .field span { color:#6b7a8d; }
          [data-theme="day"] .playlist-feature-grid .field input,
          [data-theme="day"] .playlist-feature-grid .field select { background:linear-gradient(180deg,#ffffff,#f6f8fb); color:#223043; border-color:rgba(10,20,30,.12); }
          [data-theme="day"] .playlist-feature-note { color:#5e6d80; }
          [data-theme="day"] .playlist-feature-note strong { color:#1f2d3d; }
          [data-theme="day"] .settings-inline-code { background:rgba(var(--brand-rgb), .09); border-color:rgba(var(--brand-rgb), .14); color:#223043; }
          @media (max-width: 860px) {
            .playlist-feature-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
          }
          @media (max-width: 560px) {
            .playlist-preset-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
            .playlist-feature-grid { grid-template-columns:1fr; }
          }
        </style>

        <div class="settings-tabs" role="tablist" aria-label="Settings tabs">
          <button class="settings-tab-btn<%= _tab === 'general' ? ' is-active' : '' %>" type="button" data-tab="general">
            <img class="settings-tab-icon" src="/icons/settings.svg" alt="" />
            <span class="settings-tab-text">General</span>
          </button>
          <% if (mediaServerType === 'plex' || !mediaServerType) { %>
          <button class="settings-tab-btn<%= _tab === 'plex' ? ' is-active' : '' %>" type="button" data-tab="plex">
            <img class="settings-tab-icon settings-tab-icon--app" src="/icons/plex.png" alt="" />
            <span class="settings-tab-text">Plex</span>
          </button>
          <button class="settings-tab-btn<%= _tab === 'tautulli' ? ' is-active' : '' %>" type="button" data-tab="tautulli">
            <img class="settings-tab-icon settings-tab-icon--app" src="/icons/tautulli.png" alt="" />
            <span class="settings-tab-text">Tautulli</span>
          </button>
          <% } else if (mediaServerType === 'jellyfin') { %>
          <button class="settings-tab-btn<%= _tab === 'jellyfin' ? ' is-active' : '' %>" type="button" data-tab="jellyfin">
            <img class="settings-tab-icon settings-tab-icon--app" src="/icons/jellyfin.png" alt="" />
            <span class="settings-tab-text">Jellyfin</span>
          </button>
          <% } else if (mediaServerType === 'emby') { %>
          <button class="settings-tab-btn<%= _tab === 'emby' ? ' is-active' : '' %>" type="button" data-tab="emby">
            <img class="settings-tab-icon settings-tab-icon--app" src="/icons/emby.png" alt="" />
            <span class="settings-tab-text">Emby</span>
          </button>
          <% } %>
          <% if (actualRole === 'admin') { %>
            <button class="settings-tab-btn<%= _tab === 'lidarr' ? ' is-active' : '' %>" type="button" data-tab="lidarr">
              <img class="settings-tab-icon settings-tab-icon--app" src="/icons/lidarr.png" alt="" />
              <span class="settings-tab-text">Lidarr</span>
            </button>
          <% } %>
          <button class="settings-tab-btn<%= _tab === 'smart-playlist' ? ' is-active' : '' %>" type="button" data-tab="smart-playlist">
            <img class="settings-tab-icon" src="/icons/music.svg" alt="" />
            <span class="settings-tab-text">Playlists</span>
          </button>
          <button class="settings-tab-btn<%= _tab === 'discovery' ? ' is-active' : '' %>" type="button" data-tab="discovery">
            <img class="settings-tab-icon" src="/icons/search.svg" alt="" />
            <span class="settings-tab-text">Discovery</span>
          </button>

          <button class="settings-tab-btn<%= _tab === 'users' ? ' is-active' : '' %>" type="button" data-tab="users">
            <img class="settings-tab-icon" src="/icons/user-profile.svg" alt="" />
            <span class="settings-tab-text">Users</span>
          </button>
          <button class="settings-tab-btn<%= _tab === 'logs' ? ' is-active' : '' %>" type="button" data-tab="logs">
            <img class="settings-tab-icon" src="/icons/activity-queue.svg" alt="" />
            <span class="settings-tab-text">Logs</span>
          </button>
          <button class="settings-tab-btn<%= _tab === 'about' ? ' is-active' : '' %>" type="button" data-tab="about">
            <img class="settings-tab-icon" src="/icons/about.svg" alt="" />
            <span class="settings-tab-text">About</span>
          </button>
          <% if (actualRole === 'admin') { %>
            <button class="settings-tab-btn<%= _tab === 'jobs' ? ' is-active' : '' %>" type="button" data-tab="jobs">
              <img class="settings-tab-icon" src="/icons/activity-queue.svg" alt="" />
              <span class="settings-tab-text">Jobs</span>
            </button>
          <% } %>
          <button class="settings-tab-btn<%= _tab === 'appearance' ? ' is-active' : '' %>" type="button" data-tab="appearance">
            <img class="settings-tab-icon" src="/icons/sun.svg" alt="" />
            <span class="settings-tab-text">Themes</span>
          </button>
        </div>

        <%# ── General ──────────────────────────────────────────────────────── %>
        <div class="settings-tab-panel<%= _tab === 'general' ? ' is-active' : '' %>" data-tab="general">
          <div class="dash-panel">
            <form method="post" action="/settings/general" class="settings-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <div class="settings-card">
                <div class="settings-card-title">Server Identity</div>
                <div class="settings-card-sub">Remote URL is used for external links and webhook callbacks. Local URL is preferred for LAN Plex SSO. Use Base URL Path when Curatorr is served behind a subpath (for example <code class="settings-inline-code">/curatorr</code>).</div>
                <label class="field">
                  <span>Server name</span>
                  <input type="text" name="serverName" value="<%= config.general?.serverName || 'Curatorr' %>" placeholder="Curatorr" />
                </label>
                <label class="field">
                  <span>Remote URL</span>
                  <input type="text" name="remoteUrl" value="<%= config.general?.remoteUrl || '' %>" placeholder="https://curatorr.example.com" />
                </label>
                <label class="field">
                  <span>Local URL</span>
                  <input type="text" name="localUrl" value="<%= config.general?.localUrl || '' %>" placeholder="http://192.168.0.x:7676" />
                </label>
                <label class="field">
                  <span>Base URL Path</span>
                  <input type="text" name="basePath" value="<%= config.general?.basePath || '' %>" placeholder="/curatorr" />
                </label>
                <% if (mediaServerType === 'plex' || !mediaServerType) { %>
                <label class="field">
                  <span>Live playback source</span>
                  <select name="playbackSource">
                    <option value="plex" <%= (config.general?.playbackSource || 'plex') === 'plex' ? 'selected' : '' %>>Plex webhooks (recommended)</option>
                    <option value="tautulli" <%= config.general?.playbackSource === 'tautulli' ? 'selected' : '' %>>Tautulli webhooks</option>
                  </select>
                </label>
                <div class="settings-card-sub" style="margin-top:2px">Controls which webhook source writes live play events to Curatorr. Tautulli daily sync can still be used separately as gap-fill backup.</div>
                <% } %>
                <label class="settings-toggle" style="margin-top:4px">
                  <input type="checkbox" name="restrictGuests" value="1" <%= config.general?.restrictGuests ? 'checked' : '' %> />
                  <span class="settings-toggle-slider" aria-hidden="true"></span>
                  <span class="settings-toggle-text">Restrict guest users</span>
                </label>
              </div>
              <div class="settings-card">
                <div class="settings-card-title">Track Analysis Import</div>
                <div class="settings-card-sub">Curatorr writes BPM, musical key, Camelot key, energy, and danceability into the shared track enrichment store. For Docker installs, <strong>Analyzer sidecar</strong> is the normal mode.</div>
                <div class="settings-card-sub" style="margin-top:8px">Docker installs should normally keep the default paths in <code class="settings-inline-code">/app/data</code>. Sidecar mode should normally use <code class="settings-inline-code">http://127.0.0.1:8765</code>.</div>
                <label class="field">
                  <span>Feature manifest path</span>
                  <input type="text" name="featuresImportPath" value="<%= config.analysis?.featuresImportPath || '/app/data/track-features.json' %>" placeholder="/app/data/track-features.json" />
                </label>
                <label class="field">
                  <span>Analyzer results path</span>
                  <input type="text" name="analyzerResultsPath" value="<%= config.analysis?.analyzerResultsPath || '/app/data/track-features.results.json' %>" placeholder="/app/data/track-features.results.json" />
                </label>
                <label class="field">
                  <span>Analyzer mode</span>
                  <select name="analyzerMode" id="analyzerModeSelect">
                    <option value="sidecar" <%= (config.analysis?.analyzerMode || 'sidecar') === 'sidecar' ? 'selected' : '' %>>Analyzer sidecar</option>
                    <option value="custom" <%= (config.analysis?.analyzerMode || 'sidecar') === 'custom' ? 'selected' : '' %>>Custom command</option>
                  </select>
                </label>
                <div class="settings-card-sub" id="analyzerModeHelp" style="margin-top:4px">Analyzer sidecar is recommended for Docker installs. Custom command is for advanced external pipelines.</div>
                <label class="field" data-analyzer-mode-field="sidecar">
                  <span>Analyzer sidecar URL</span>
                  <input type="text" name="analyzerSidecarUrl" value="<%= config.analysis?.analyzerSidecarUrl || 'http://127.0.0.1:8765' %>" placeholder="http://127.0.0.1:8765" />
                </label>
                <label class="field" data-analyzer-mode-field="custom">
                  <span>Analyzer command</span>
                  <textarea name="analyzerCommand" rows="4" placeholder="python3 /analysis/run.py --input \"$CURATORR_FEATURE_TEMPLATE\" --output \"$CURATORR_ANALYZER_OUTPUT\""><%= config.analysis?.analyzerCommand || '' %></textarea>
                </label>
                <label class="field" data-analyzer-mode-field="custom">
                  <span>Analyzer working directory</span>
                  <input type="text" name="analyzerWorkingDir" value="<%= config.analysis?.analyzerWorkingDir || '' %>" placeholder="/analysis" />
                </label>
                <label class="field" data-analyzer-mode-field="custom">
                  <span>Analyzer output format</span>
                  <select name="analyzerInputFormat">
                    <option value="auto" <%= (config.analysis?.analyzerInputFormat || 'auto') === 'auto' ? 'selected' : '' %>>Auto-detect</option>
                    <option value="json" <%= config.analysis?.analyzerInputFormat === 'json' ? 'selected' : '' %>>JSON</option>
                    <option value="csv" <%= config.analysis?.analyzerInputFormat === 'csv' ? 'selected' : '' %>>CSV</option>
                  </select>
                </label>
                <label class="settings-toggle" style="margin-top:4px">
                  <input type="checkbox" name="analyzerOverwriteExisting" value="1" <%= config.analysis?.analyzerOverwriteExisting ? 'checked' : '' %> />
                  <span class="settings-toggle-slider" aria-hidden="true"></span>
                  <span class="settings-toggle-text">Allow analyzer results to overwrite existing imported feature values</span>
                </label>
                <div class="settings-card-sub" style="margin-top:8px">Accepted JSON formats: an array of track objects, a root object with <code class="settings-inline-code">tracks</code>, or an object keyed by rating key. Matching uses <code class="settings-inline-code">ratingKey</code>, then <code class="settings-inline-code">recordingMbid</code>, then <code class="settings-inline-code">filePath</code>.</div>
                <div class="settings-card-sub" style="margin-top:8px">Custom command mode is optional and intended for advanced external pipelines. Most Docker installs should leave it unused and stay on the sidecar mode.</div>
              </div>
              <div class="settings-card-actions settings-card-actions--full">
                <button class="primary-button" type="submit">Save general settings</button>
              </div>
            </form>
          </div>
        </div>

        <%# ── Plex ─────────────────────────────────────────────────────────── %>
        <div class="settings-tab-panel<%= _tab === 'plex' ? ' is-active' : '' %>" data-tab="plex">
          <div class="dash-panel">
            <form method="post" action="/settings/plex" class="settings-form">
              <fieldset <%= canManageServiceConfig ? '' : 'disabled' %> style="border:0;padding:0;margin:0;min-inline-size:0">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <div class="settings-card">
                <div class="settings-card-title">App URLs</div>
                <div class="settings-card-sub">Local URL is used inside your network. Remote URL is used for external access. Local URL is preferred when set.</div>
                <label class="field">
                  <span>Local URL</span>
                  <input type="text" name="plexLocalUrl" value="<%= config.plex?.localUrl || config.plex?.url || '' %>" placeholder="http://192.168.1.x:32400" />
                </label>
                <label class="field">
                  <span>Remote URL</span>
                  <input type="text" name="plexRemoteUrl" value="<%= config.plex?.remoteUrl || '' %>" placeholder="https://plex.example.com" />
                </label>
              </div>
              <div class="settings-card plex-settings-card">
                <div class="settings-card-title">Plex Access</div>
                <div class="settings-card-sub">Uses the Local URL first, then the Remote URL. Plex is the primary source for Now Playing and live play events.</div>
                <div class="plex-settings-fields">
                  <label class="field field-with-action">
                    <span>Plex Token</span>
                    <div class="field-action-row">
                      <input id="plex-token-input" type="password" name="plexToken" value="<%= config.plex?.token || '' %>" placeholder="<%= config.plex?.tokenSet ? '(saved — leave blank to keep)' : 'Enter Plex token' %>" data-plex-field="token" />
                      <button class="icon-button" type="button" aria-label="Show Plex token" data-visibility-toggle="plex-token-input" data-visibility-state="hidden">
                        <img src="/icons/view-off.svg" alt="" />
                      </button>
                    </div>
                  </label>
                  <label class="field field-with-action">
                    <span>Machine ID</span>
                    <div class="field-action-row">
                      <input id="plex-machine-input" type="password" name="machineId" value="<%= config.plex?.machineId || '' %>" placeholder="Plex server machine identifier" data-plex-field="machine" />

                <% if ((allMoods || []).length) { %>
                <div class="gp-filter-section">
                  <div class="gp-filter-label">Moods <span class="gp-filter-hint">(none = all)</span></div>
                  <div class="gp-checklist-wrap">
                    <input type="text" class="gp-checklist-search" placeholder="Filter moods…" data-target="gp-moods-list" />
                    <div class="gp-checklist" id="gp-moods-list">
                      <% (allMoods || []).forEach(function(m) { %>
                      <label class="gp-checklist-item">
                        <input type="checkbox" class="gp-mood-cb" value="<%= m %>" />
                        <span><%= m %></span>
                      </label>
                      <% }); %>
                    </div>
                  </div>
                </div>
                <% } %>

                <% if ((allLastfmTags || []).length) { %>
                <div class="gp-filter-section">
                  <div class="gp-filter-label">Last.fm Tags <span class="gp-filter-hint">(none = all)</span></div>
                  <div class="gp-checklist-wrap">
                    <input type="text" class="gp-checklist-search" placeholder="Filter tags… e.g. britpop" data-target="gp-tags-list" />
                    <div class="gp-checklist" id="gp-tags-list">
                      <% (allLastfmTags || []).forEach(function(t) { %>
                      <label class="gp-checklist-item">
                        <input type="checkbox" class="gp-tag-cb" value="<%= t %>" />
                        <span><%= t %></span>
                      </label>
                      <% }); %>
                    </div>
                  </div>
                </div>
                <% } %>

                <div class="gp-filter-section gp-filter-section--inline">
                  <label class="field" style="flex:1">
                    <span>Top N per artist</span>
                    <input type="number" id="gp-top-n" min="1" max="999" placeholder="All tracks" />
                  </label>
                  <label class="field" style="flex:1">
                    <span>Max total tracks</span>
                    <input type="number" id="gp-max-tracks" min="1" placeholder="No limit" />
                  </label>
                  <label class="field" style="flex:1">
                    <span>Sort tracks by</span>
                    <select id="gp-sort-by">
                      <option value="ratingCount">Global rating count</option>
                      <option value="tierWeight">Tier weight</option>
                      <option value="playCount">Play count</option>
                      <option value="bpmAsc">BPM low to high</option>
                      <option value="bpmDesc">BPM high to low</option>
                      <option value="energyAsc">Energy low to high</option>
                      <option value="energyDesc">Energy high to low</option>
                      <option value="danceabilityDesc">Danceability high to low</option>
                      <option value="camelot">Camelot wheel</option>
                      <option value="djFlow">DJ flow (Camelot + BPM)</option>
                    </select>
                  </label>
                </div>
              </div>

              <%# Blend %>
              <% if ((blendableUsers || []).length > 1) { %>
              <div class="gp-filter-section gp-blend-section">
                <div class="gp-filter-label">
                  Blend users
                  <span class="gp-filter-hint">(combine multiple users' listening data)</span>
                </div>
                <div class="blend-slots" id="gp-blend-picker-rows"></div>
                <button class="blend-add-btn" id="gp-blend-add-btn" type="button">+ Add user</button>
                <div id="gp-blend-mode-wrap" style="display:none">
                  <div class="gp-filter-label" style="margin-top:10px">Blend mode</div>
                  <div class="gp-blend-modes">
                    <label class="gp-blend-mode-option">
                      <input type="radio" name="gp-blend-mode" value="average" checked />
                      <span class="gp-blend-mode-name">Average</span>
                      <span class="gp-blend-mode-desc">Average each user's artist scores and track ratings together. Tracks rise or fall based on combined opinion — a shared favourite scores higher, a polarising track lands in the middle.</span>
                    </label>
                    <label class="gp-blend-mode-option">
                      <input type="radio" name="gp-blend-mode" value="intersection" />
                      <span class="gp-blend-mode-name">Intersection</span>
                      <span class="gp-blend-mode-desc">Only include tracks that <em>every</em> selected user qualifies individually. The safest choice for shared listening — nothing appears unless everyone would have included it.</span>
                    </label>
                    <label class="gp-blend-mode-option">
                      <input type="radio" name="gp-blend-mode" value="union" />
                      <span class="gp-blend-mode-name">Union</span>
                      <span class="gp-blend-mode-desc">Include tracks that <em>any</em> selected user qualifies. The broadest result — a track only needs one fan to make the cut. Great for discovery across tastes.</span>
                    </label>
                    <label class="gp-blend-mode-option">
                      <input type="radio" name="gp-blend-mode" value="veto" />
                      <span class="gp-blend-mode-name">Veto</span>
                      <span class="gp-blend-mode-desc">Start with the union (anything any user likes), then remove tracks that <em>any</em> user has skipped. Nobody gets music they hate, but everyone's favourites are still represented.</span>
                    </label>
                  </div>
                </div>
              </div>
              <% } %>

              <%# Track filters %>
              <div class="tf-details" style="margin-top:12px">
                <div class="tf-summary" style="cursor:default">
                  Filters
                  <span class="tf-rule-count" id="gp-filter-count"></span>
                </div>
                <div class="tf-body">
                  <%# Pattern rules %>
                  <div class="settings-field-label" style="margin-bottom:4px">Pattern rules (album / title / artist)</div>
                  <div class="tf-rules-list" id="tf-list-gp"></div>
                  <button type="button" class="btn btn-sm btn-ghost" style="margin-top:6px" onclick="tfAddRule('gp')">+ Add Rule</button>

                  <%# Include folders %>
                  <div class="settings-field-label" style="margin-top:14px;margin-bottom:4px">Include folders — if any selected, only tracks from these folders are kept</div>
                  <div class="gp-folder-browser" id="gp-include-browser">
                    <div class="gp-browser-header">
                      <span class="gp-browser-path" id="gp-include-path">/</span>
                      <button type="button" class="btn btn-sm btn-ghost gp-browser-add-current" id="gp-include-add-current" style="display:none">+ Add this folder</button>
                    </div>
                    <div class="gp-browser-list" id="gp-include-list"></div>
                  </div>
                  <div class="gp-folder-chips" id="gp-include-chips"></div>

                  <%# Exclude folders %>
                  <div class="settings-field-label" style="margin-top:14px;margin-bottom:4px">Exclude folders — tracks from these folders are removed</div>
                  <div class="gp-folder-browser" id="gp-exclude-browser">
                    <div class="gp-browser-header">
                      <span class="gp-browser-path" id="gp-exclude-path">/</span>
                      <button type="button" class="btn btn-sm btn-ghost gp-browser-add-current" id="gp-exclude-add-current" style="display:none">+ Add this folder</button>
                    </div>
                    <div class="gp-browser-list" id="gp-exclude-list"></div>
                  </div>
                  <div class="gp-folder-chips" id="gp-exclude-chips"></div>

                  <%# MBID dedup %>
                  <div style="margin-top:12px">
                    <label class="settings-toggle">
                      <input type="checkbox" id="gp-dedup-mbid" />
                      <span class="settings-toggle-slider" aria-hidden="true"></span>
                      <span class="settings-toggle-text">Deduplicate by MusicBrainz recording ID</span>
                    </label>
                  </div>
                </div>
              </div>

              <%# Preview %>
              <div class="gp-preview-bar">
                <div class="gp-preview-left">
                  <span class="gp-preview-label">Preview for</span>
                  <select id="gp-preview-user" class="settings-select gp-preview-select">
                    <option value="">— All users (avg) —</option>
                    <% (allUserIds || []).forEach(function(uid) { %>
                    <option value="<%= uid %>"><%= uid %></option>
                    <% }); %>
                  </select>
                </div>
                <div class="gp-preview-counts" id="gp-preview-counts">
                  <span class="gp-preview-stat"><span class="gp-preview-num" id="gp-prev-artists">—</span> <span class="gp-preview-unit">artists</span></span>
                  <span class="gp-preview-sep">·</span>
                  <span class="gp-preview-stat"><span class="gp-preview-num" id="gp-prev-tracks">—</span> <span class="gp-preview-unit">tracks</span></span>
                  <span class="gp-preview-avg" id="gp-prev-avg-wrap" style="display:none">
                    <span class="gp-preview-sep">·</span> avg across all users: <strong id="gp-prev-avg"></strong>
                  </span>
                </div>
              </div>

              <div class="gp-builder-actions">
                <button class="primary-button" id="gp-create-btn" type="button">Create Playlist</button>
                <button class="btn btn-sm btn-ghost" id="gp-cancel-edit-btn" type="button" style="display:none">Cancel</button>
                <span class="gp-create-msg" id="gp-create-msg"></span>
              </div>
            </div>

            <%# Existing global playlists %>
            <div id="gp-list">
              <% (globalPlaylists || []).forEach(function(gp) { %>
              <div class="settings-card gp-card" data-gp-id="<%= gp.id %>">
                <div class="gp-card-header">
                  <span class="settings-card-title gp-card-name"><%= gp.name %></span>
                  <div class="gp-card-actions">
                    <label class="gp-toggle-wrap" title="<%= gp.enabled ? 'Enabled' : 'Disabled' %>">
                      <input type="checkbox" class="gp-toggle" data-gp-id="<%= gp.id %>" <%= gp.enabled ? 'checked' : '' %> />
                      <span class="gp-toggle-label"><%= gp.enabled ? 'Enabled' : 'Disabled' %></span>
                    </label>
                    <button class="btn btn-sm btn-ghost gp-edit-btn" data-gp-id="<%= gp.id %>">Edit</button>
                    <button class="btn btn-sm btn-ghost-danger gp-delete-btn" data-gp-id="<%= gp.id %>">Delete</button>
                  </div>
                </div>
                <div class="gp-card-rules">
                  <% const _at = (gp.rules?.artistTiers || []); const _tt = (gp.rules?.trackTiers || []); const _gr = (gp.rules?.genres || []); const _mo = (gp.rules?.moods || []); const _tg = (gp.rules?.tags || []); %>
                  <span class="gp-rule-chip">Artists: <%= _at.length ? _at.join(', ') : 'all' %></span>
                  <span class="gp-rule-chip">Tracks: <%= _tt.length ? _tt.join(', ') : 'all' %></span>
                  <% if (_gr.length) { %><span class="gp-rule-chip">Genres: <%= _gr.join(', ') %></span><% } %>
                  <% if (_mo.length) { %><span class="gp-rule-chip">Moods: <%= _mo.join(', ') %></span><% } %>
                  <% if (_tg.length) { %><span class="gp-rule-chip">Tags: <%= _tg.join(', ') %></span><% } %>
                  <% if (gp.rules?.featurePreset && gp.rules.featurePreset !== 'none') { %><span class="gp-rule-chip">Preset: <%= gp.rules.featurePreset %></span><% } %>
                  <% if (gp.rules?.bpmMin != null || gp.rules?.bpmMax != null) { %><span class="gp-rule-chip">BPM: <%= gp.rules?.bpmMin != null ? gp.rules.bpmMin : 'any' %> - <%= gp.rules?.bpmMax != null ? gp.rules.bpmMax : 'any' %></span><% } %>
                  <% if (gp.rules?.energyMin != null || gp.rules?.energyMax != null) { %><span class="gp-rule-chip">Energy: <%= gp.rules?.energyMin != null ? gp.rules.energyMin : 'any' %> - <%= gp.rules?.energyMax != null ? gp.rules.energyMax : 'any' %></span><% } %>
                  <% if (gp.rules?.danceabilityMin != null || gp.rules?.danceabilityMax != null) { %><span class="gp-rule-chip">Danceability: <%= gp.rules?.danceabilityMin != null ? gp.rules.danceabilityMin : 'any' %> - <%= gp.rules?.danceabilityMax != null ? gp.rules.danceabilityMax : 'any' %></span><% } %>
                  <% if (gp.rules?.camelotFocus) { %><span class="gp-rule-chip">Camelot: <%= gp.rules.camelotFocus %> (<%= gp.rules.camelotMode || 'exact' %>)</span><% } %>
                  <% if (gp.rules?.topNPerArtist) { %><span class="gp-rule-chip">Top <%= gp.rules.topNPerArtist %>/artist</span><% } %>
                  <% if (gp.rules?.maxTracks) { %><span class="gp-rule-chip">Max <%= gp.rules.maxTracks %> tracks</span><% } %>
                  <% if ((gp.rules?.blendUsers || []).length) { %>
                  <span class="gp-rule-chip gp-rule-chip--blend">Blend (<%= gp.rules.blendMode || 'average' %>): <%= gp.rules.blendUsers.join(', ') %></span>
                  <% } %>
                </div>
              </div>
              <% }); %>
              <% if (!(globalPlaylists || []).length) { %>
              <div class="cur-empty" id="gp-empty">No global playlists yet. Create one with the wizard below.</div>
              <% } %>
            </div>
            <div class="settings-card-actions settings-card-actions--full" style="margin-top:14px;justify-content:flex-start">
              <a class="primary-button" href="/playlists?wizardTarget=global">Create Playlist</a>
              <span class="settings-card-sub" style="margin:0">Create and edit global playlists in the main playlist wizard.</span>
            </div>

            <script>
            (function() {
              var _csrf = '<%= csrfToken %>';
              var previewTimer = null;
              var _editingGpId = null;
              var GP_DATA = <%- JSON.stringify(globalPlaylists || []) %>;
              var GP_FEATURE_PRESETS = {
                none: { bpmMin: '', bpmMax: '', energyMin: '', energyMax: '', danceabilityMin: '', danceabilityMax: '', camelotFocus: '', camelotMode: 'exact' },
                club: { bpmMin: '118', bpmMax: '132', energyMin: '0.70', energyMax: '', danceabilityMin: '0.55', danceabilityMax: '', camelotFocus: '', camelotMode: 'exact' },
                driving: { bpmMin: '110', bpmMax: '145', energyMin: '0.60', energyMax: '', danceabilityMin: '', danceabilityMax: '', camelotFocus: '', camelotMode: 'exact' },
                workout: { bpmMin: '124', bpmMax: '150', energyMin: '0.72', energyMax: '', danceabilityMin: '0.55', danceabilityMax: '', camelotFocus: '', camelotMode: 'exact' },
                chill: { bpmMin: '', bpmMax: '105', energyMin: '', energyMax: '0.45', danceabilityMin: '', danceabilityMax: '', camelotFocus: '', camelotMode: 'exact' },
                harmonic: { bpmMin: '', bpmMax: '', energyMin: '', energyMax: '', danceabilityMin: '', danceabilityMax: '', camelotFocus: '8A', camelotMode: 'harmonic' },
                downtempo: { bpmMin: '70', bpmMax: '100', energyMin: '', energyMax: '0.40', danceabilityMin: '', danceabilityMax: '0.65', camelotFocus: '', camelotMode: 'exact' },
              };

              function gpSetPresetSelection(preset) {
                var value = GP_FEATURE_PRESETS[preset] ? preset : 'none';
                document.getElementById('gp-feature-preset').value = value;
                document.querySelectorAll('#gp-preset-grid .playlist-preset-card').forEach(function(card) {
                  card.classList.toggle('is-active', card.dataset.preset === value);
                });
              }

              function gpApplyPresetDefaults(preset) {
                var defaults = GP_FEATURE_PRESETS[preset] || GP_FEATURE_PRESETS.none;
                gpSetPresetSelection(preset);
                document.getElementById('gp-bpm-min').value = defaults.bpmMin;
                document.getElementById('gp-bpm-max').value = defaults.bpmMax;
                document.getElementById('gp-energy-min').value = defaults.energyMin;
                document.getElementById('gp-energy-max').value = defaults.energyMax;
                document.getElementById('gp-danceability-min').value = defaults.danceabilityMin;
                document.getElementById('gp-danceability-max').value = defaults.danceabilityMax;
                document.getElementById('gp-camelot-focus').value = defaults.camelotFocus;
                document.getElementById('gp-camelot-mode').value = defaults.camelotMode;
                schedulePreview();
              }

              function gpLoadFeatureRules(rules) {
                var preset = rules.featurePreset || 'none';
                gpSetPresetSelection(preset);
                document.getElementById('gp-bpm-min').value = rules.bpmMin != null ? rules.bpmMin : '';
                document.getElementById('gp-bpm-max').value = rules.bpmMax != null ? rules.bpmMax : '';
                document.getElementById('gp-energy-min').value = rules.energyMin != null ? rules.energyMin : '';
                document.getElementById('gp-energy-max').value = rules.energyMax != null ? rules.energyMax : '';
                document.getElementById('gp-danceability-min').value = rules.danceabilityMin != null ? rules.danceabilityMin : '';
                document.getElementById('gp-danceability-max').value = rules.danceabilityMax != null ? rules.danceabilityMax : '';
                document.getElementById('gp-camelot-focus').value = rules.camelotFocus || '';
                document.getElementById('gp-camelot-mode').value = rules.camelotMode || 'exact';
              }

              function gpFeatureSummaryHtml(rules) {
                var chips = [];
                if (rules.featurePreset && rules.featurePreset !== 'none') {
                  chips.push('<span class="gp-rule-chip">Preset: ' + rules.featurePreset + '</span>');
                }
                if (rules.bpmMin != null || rules.bpmMax != null) {
                  chips.push('<span class="gp-rule-chip">BPM: ' + (rules.bpmMin != null ? rules.bpmMin : 'any') + ' - ' + (rules.bpmMax != null ? rules.bpmMax : 'any') + '</span>');
                }
                if (rules.energyMin != null || rules.energyMax != null) {
                  chips.push('<span class="gp-rule-chip">Energy: ' + (rules.energyMin != null ? rules.energyMin : 'any') + ' - ' + (rules.energyMax != null ? rules.energyMax : 'any') + '</span>');
                }
                if (rules.danceabilityMin != null || rules.danceabilityMax != null) {
                  chips.push('<span class="gp-rule-chip">Danceability: ' + (rules.danceabilityMin != null ? rules.danceabilityMin : 'any') + ' - ' + (rules.danceabilityMax != null ? rules.danceabilityMax : 'any') + '</span>');
                }
                if (rules.camelotFocus) {
                  chips.push('<span class="gp-rule-chip">Camelot: ' + rules.camelotFocus + ' (' + (rules.camelotMode || 'exact') + ')</span>');
                }
                return chips.join('');
              }

              function gpLoadIntoBuilder(gp) {
                var rules = gp.rules || {};
                document.getElementById('gp-name').value = gp.name || '';
                var artistTiers = rules.artistTiers || [];
                if (artistTiers.length) {
                  document.querySelector('.gp-artist-tier-all').checked = false;
                  document.querySelectorAll('.gp-artist-tier').forEach(function(c) { c.checked = artistTiers.indexOf(c.value) !== -1; });
                } else {
                  document.querySelector('.gp-artist-tier-all').checked = true;
                  document.querySelectorAll('.gp-artist-tier').forEach(function(c) { c.checked = false; });
                }
                var trackTiers = rules.trackTiers || [];
                if (trackTiers.length) {
                  document.querySelector('.gp-track-tier-all').checked = false;
                  document.querySelectorAll('.gp-track-tier').forEach(function(c) { c.checked = trackTiers.indexOf(c.value) !== -1; });
                } else {
                  document.querySelector('.gp-track-tier-all').checked = true;
                  document.querySelectorAll('.gp-track-tier').forEach(function(c) { c.checked = false; });
                }
                var genres = rules.genres || [];
                document.querySelectorAll('.gp-genre-cb').forEach(function(c) { c.checked = genres.indexOf(c.value) !== -1; });
                var moods = rules.moods || [];
                document.querySelectorAll('.gp-mood-cb').forEach(function(c) { c.checked = moods.indexOf(c.value) !== -1; });
                var tags = rules.tags || [];
                document.querySelectorAll('.gp-tag-cb').forEach(function(c) { c.checked = tags.indexOf(c.value) !== -1; });
                document.getElementById('gp-top-n').value = rules.topNPerArtist || '';
                document.getElementById('gp-max-tracks').value = rules.maxTracks || '';
                document.getElementById('gp-sort-by').value = rules.sortBy || 'ratingCount';
                if (window.gpSetBlendUsers) window.gpSetBlendUsers(rules.blendUsers || [], rules.blendMode || 'average');
                gpLoadFeatureRules(rules);
                // Populate track filters
                var tfList = document.getElementById('tf-list-gp');
                tfList.innerHTML = '';
                var tf = gp.trackFilters || {};
                (tf.rules || []).forEach(function(rule) {
                  var row = document.createElement('div');
                  row.className = 'tf-rule-row';
                  row.innerHTML =
                    '<select name="gp_rule_field" class="tf-select" onchange="tfUpdateVal(this,\'gp\')">' + tfMakeFieldOpts(_TF_FIELDS_CR_CU, rule.field) + '</select>' +
                    '<select name="gp_rule_op" class="tf-select" onchange="tfUpdateOp(this,\'gp\')">' + tfMakeOpOpts(rule.operator, rule.field) + '</select>' +
                    tfMakeValInput('gp', rule.field, rule.value, [], rule.operator) +
                    '<label class="tf-cs-label"><input type="checkbox" name="gp_rule_cs" value="on"' + (rule.caseSensitive ? ' checked' : '') + ' /><span>Aa</span></label>' +
                    '<button type="button" class="tf-remove-btn" onclick="this.closest(\'.tf-rule-row\').remove()">×</button>';
                  tfList.appendChild(row);
                });
                document.getElementById('gp-dedup-mbid').checked = !!(tf.deduplicateByMbid);
                // Populate folder filters
                var incChips = document.getElementById('gp-include-chips');
                var excChips = document.getElementById('gp-exclude-chips');
                if (incChips) { incChips.innerHTML = ''; (tf.includeFolders || []).forEach(function(f) { gpAddFolderChip('include', f); }); }
                if (excChips) { excChips.innerHTML = ''; (tf.excludeFolders || []).forEach(function(f) { gpAddFolderChip('exclude', f); }); }
                updateBlendModeVisibility();
                schedulePreview();
              }

              function gpCancelEdit() {
                _editingGpId = null;
                document.getElementById('gp-create-btn').textContent = 'Create Playlist';
                document.getElementById('gp-cancel-edit-btn').style.display = 'none';
                document.getElementById('gp-name').value = '';
                document.querySelector('.gp-artist-tier-all').checked = true;
                document.querySelectorAll('.gp-artist-tier').forEach(function(c) { c.checked = false; });
                document.querySelector('.gp-track-tier-all').checked = true;
                document.querySelectorAll('.gp-track-tier').forEach(function(c) { c.checked = false; });
                document.querySelectorAll('.gp-genre-cb, .gp-mood-cb, .gp-tag-cb').forEach(function(c) { c.checked = false; });
                document.getElementById('gp-top-n').value = '';
                document.getElementById('gp-max-tracks').value = '';
                document.getElementById('gp-sort-by').value = 'ratingCount';
                if (window.gpSetBlendUsers) window.gpSetBlendUsers([], 'average');
                gpApplyPresetDefaults('none');
                document.getElementById('tf-list-gp').innerHTML = '';
                var _ic = document.getElementById('gp-include-chips'); if (_ic) _ic.innerHTML = '';
                var _ec = document.getElementById('gp-exclude-chips'); if (_ec) _ec.innerHTML = '';
                _gpFolderNav = { include: [], exclude: [] };
                gpRenderFolderBrowser('include');
                gpRenderFolderBrowser('exclude');
                document.getElementById('gp-dedup-mbid').checked = false;
                updateBlendModeVisibility();
                schedulePreview();
              }

              function gpCardRulesHtml(r) {
                var at = r.artistTiers || [], tt = r.trackTiers || [];
                var gr = r.genres || [], mo = r.moods || [], tg = r.tags || [];
                var bu = r.blendUsers || [], bm = r.blendMode || 'average';
                return '<span class="gp-rule-chip">Artists: ' + (at.length ? at.join(', ') : 'all') + '</span>'
                  + '<span class="gp-rule-chip">Tracks: ' + (tt.length ? tt.join(', ') : 'all') + '</span>'
                  + (gr.length ? '<span class="gp-rule-chip">Genres: ' + gr.join(', ') + '</span>' : '')
                  + (mo.length ? '<span class="gp-rule-chip">Moods: ' + mo.join(', ') + '</span>' : '')
                  + (tg.length ? '<span class="gp-rule-chip">Tags: ' + tg.join(', ') + '</span>' : '')
                  + gpFeatureSummaryHtml(r)
                  + (r.topNPerArtist ? '<span class="gp-rule-chip">Top ' + r.topNPerArtist + '/artist</span>' : '')
                  + (r.maxTracks ? '<span class="gp-rule-chip">Max ' + r.maxTracks + ' tracks</span>' : '')
                  + (bu.length ? '<span class="gp-rule-chip gp-rule-chip--blend">Blend (' + bm + '): ' + bu.join(', ') + '</span>' : '');
              }

              function getBuilderRules() {
                var artistTiers = [];
                if (!document.querySelector('.gp-artist-tier-all').checked) {
                  document.querySelectorAll('.gp-artist-tier:checked').forEach(function(c) { artistTiers.push(c.value); });
                }
                var trackTiers = [];
                if (!document.querySelector('.gp-track-tier-all').checked) {
                  document.querySelectorAll('.gp-track-tier:checked').forEach(function(c) { trackTiers.push(c.value); });
                }
                var genres = [];
                document.querySelectorAll('.gp-genre-cb:checked').forEach(function(c) { genres.push(c.value); });
                var moods = [];
                document.querySelectorAll('.gp-mood-cb:checked').forEach(function(c) { moods.push(c.value); });
                var tags = [];
                document.querySelectorAll('.gp-tag-cb:checked').forEach(function(c) { tags.push(c.value); });
                var blendModeEl = document.querySelector('input[name="gp-blend-mode"]:checked');
                return {
                  artistTiers: artistTiers,
                  trackTiers: trackTiers,
                  genres: genres,
                  moods: moods,
                  tags: tags,
                  topNPerArtist: document.getElementById('gp-top-n').value ? parseInt(document.getElementById('gp-top-n').value) : null,
                  maxTracks: document.getElementById('gp-max-tracks').value ? parseInt(document.getElementById('gp-max-tracks').value) : null,
                  sortBy: document.getElementById('gp-sort-by').value,
                  blendUsers: window.gpGetBlendUsers ? window.gpGetBlendUsers() : [],
                  blendMode: blendModeEl ? blendModeEl.value : 'average',
                  featurePreset: document.getElementById('gp-feature-preset').value || 'none',
                  bpmMin: document.getElementById('gp-bpm-min').value || null,
                  bpmMax: document.getElementById('gp-bpm-max').value || null,
                  energyMin: document.getElementById('gp-energy-min').value || null,
                  energyMax: document.getElementById('gp-energy-max').value || null,
                  danceabilityMin: document.getElementById('gp-danceability-min').value || null,
                  danceabilityMax: document.getElementById('gp-danceability-max').value || null,
                  camelotFocus: document.getElementById('gp-camelot-focus').value || '',
                  camelotMode: document.getElementById('gp-camelot-mode').value || 'exact',
                };
              }

              function gpAddFolderChip(type, val, triggerPreview) {
                var chips = document.getElementById('gp-' + type + '-chips');
                if (!chips || !val) return;
                if (Array.from(chips.querySelectorAll('[data-folder]')).some(function(c) { return c.dataset.folder === val; })) return;
                var chip = document.createElement('span');
                chip.className = 'gp-folder-chip';
                chip.dataset.folder = val;
                chip.textContent = val;
                var rm = document.createElement('button');
                rm.type = 'button'; rm.className = 'gp-folder-chip-remove'; rm.textContent = '×';
                rm.addEventListener('click', function() { chip.remove(); schedulePreview(); });
                chip.appendChild(rm);
                chips.appendChild(chip);
                if (triggerPreview) schedulePreview();
              }

              // ── Folder browser ──────────────────────────────────────────
              var _GP_FOLDER_TREE = (function() {
                var tree = {};
                for (var i = 0; i < _TF_PATH_SEGMENTS.length; i++) {
                  var parts = _TF_PATH_SEGMENTS[i].split('/');
                  var node = tree;
                  for (var j = 0; j < parts.length; j++) {
                    if (!node[parts[j]]) node[parts[j]] = {};
                    node = node[parts[j]];
                  }
                }
                return tree;
              })();

              var _gpFolderNav = { include: [], exclude: [] };

              function gpRenderFolderBrowser(type) {
                var path = _gpFolderNav[type];
                var node = _GP_FOLDER_TREE;
                for (var i = 0; i < path.length; i++) node = node[path[i]] || {};
                var children = Object.keys(node).sort(function(a, b) { return a.localeCompare(b); });

                var pathEl = document.getElementById('gp-' + type + '-path');
                if (pathEl) pathEl.textContent = path.length ? path.join('/') : '/';

                var addCurBtn = document.getElementById('gp-' + type + '-add-current');
                if (addCurBtn) addCurBtn.style.display = path.length ? '' : 'none';

                var listEl = document.getElementById('gp-' + type + '-list');
                if (!listEl) return;
                listEl.innerHTML = '';

                if (!_TF_PATH_SEGMENTS.length) {
                  listEl.innerHTML = '<div class="tf-empty-hint">Refresh your library cache to see folders.</div>';
                  return;
                }

                if (path.length) {
                  var upRow = document.createElement('div');
                  upRow.className = 'gp-browser-row gp-browser-up';
                  upRow.innerHTML = '<span class="gp-browser-up-icon">↩</span><span class="gp-browser-up-label">..</span>';
                  upRow.addEventListener('click', function() {
                    _gpFolderNav[type] = path.slice(0, -1);
                    gpRenderFolderBrowser(type);
                  });
                  listEl.appendChild(upRow);
                }

                if (!children.length) {
                  var noSub = document.createElement('div');
                  noSub.className = 'tf-empty-hint'; noSub.style.padding = '6px 10px';
                  noSub.textContent = 'No subfolders.';
                  listEl.appendChild(noSub);
                  return;
                }

                children.forEach(function(child) {
                  var childNode = node[child];
                  var drillable = Object.keys(childNode).length > 0;
                  var row = document.createElement('div');
                  row.className = 'gp-browser-row';

                  var nameSpan = document.createElement('span');
                  nameSpan.className = 'gp-browser-row-name' + (drillable ? ' gp-browser-drillable' : '');
                  nameSpan.textContent = child;
                  if (drillable) {
                    nameSpan.addEventListener('click', function() {
                      _gpFolderNav[type] = path.concat([child]);
                      gpRenderFolderBrowser(type);
                    });
                  }
                  row.appendChild(nameSpan);

                  if (drillable) {
                    var arrow = document.createElement('span');
                    arrow.className = 'gp-browser-arrow';
                    arrow.textContent = '›';
                    arrow.addEventListener('click', function() {
                      _gpFolderNav[type] = path.concat([child]);
                      gpRenderFolderBrowser(type);
                    });
                    row.appendChild(arrow);
                  }

                  var addBtn = document.createElement('button');
                  addBtn.type = 'button';
                  addBtn.className = 'btn btn-sm btn-ghost gp-browser-add-btn';
                  addBtn.textContent = '+ Add';
                  (function(c) {
                    addBtn.addEventListener('click', function() {
                      gpAddFolderChip(type, path.concat([c]).join('/'), true);
                    });
                  })(child);
                  row.appendChild(addBtn);

                  listEl.appendChild(row);
                });
              }

              document.getElementById('gp-include-add-current').addEventListener('click', function() {
                var p = _gpFolderNav['include'];
                if (p.length) gpAddFolderChip('include', p.join('/'), true);
              });
              document.getElementById('gp-exclude-add-current').addEventListener('click', function() {
                var p = _gpFolderNav['exclude'];
                if (p.length) gpAddFolderChip('exclude', p.join('/'), true);
              });

              gpRenderFolderBrowser('include');
              gpRenderFolderBrowser('exclude');

              function getGpFilters() {
                var rules = [];
                document.querySelectorAll('#tf-list-gp .tf-rule-row').forEach(function(row) {
                  var field = (row.querySelector('[name="gp_rule_field"]') || {}).value || '';
                  var op    = (row.querySelector('[name="gp_rule_op"]')    || {}).value || '';
                  var val   = (row.querySelector('[name="gp_rule_val"]')   || {}).value || '';
                  var cs    = !!(row.querySelector('[name="gp_rule_cs"]')  || {}).checked;
                  if (field && op && val) rules.push({ field: field, operator: op, value: val, caseSensitive: cs });
                });
                var includeFolders = [];
                document.querySelectorAll('#gp-include-chips [data-folder]').forEach(function(c) { includeFolders.push(c.dataset.folder); });
                var excludeFolders = [];
                document.querySelectorAll('#gp-exclude-chips [data-folder]').forEach(function(c) { excludeFolders.push(c.dataset.folder); });
                var dedupe = !!(document.getElementById('gp-dedup-mbid') || {}).checked;
                return { rules: rules, includeFolders: includeFolders, excludeFolders: excludeFolders, deduplicateByMbid: dedupe };
              }

              // Show/hide blend mode selector and preview user dropdown based on blend slots
              function updateBlendModeVisibility() {
                var pickerRows = document.getElementById('gp-blend-picker-rows');
                var anyRows = pickerRows && pickerRows.querySelectorAll('.blend-slot').length > 0;
                var wrap = document.getElementById('gp-blend-mode-wrap');
                if (wrap) wrap.style.display = anyRows ? '' : 'none';
                var previewLeft = document.querySelector('.gp-preview-left');
                if (previewLeft) previewLeft.style.display = anyRows ? 'none' : '';
              }
              document.querySelectorAll('input[name="gp-blend-mode"]').forEach(function(r) {
                r.addEventListener('change', schedulePreview);
              });

              // Blend picker initialisation (if blend section exists)
              (function() {
                var GP_BLEND_USERS = <%- JSON.stringify((blendableUsers || []).map(function(u) { return { id: u.id, avatar: u.avatarUrl || u.avatar || '' }; })) %>;
                var slotsEl = document.getElementById('gp-blend-picker-rows');
                var addBtn = document.getElementById('gp-blend-add-btn');
                if (!slotsEl || !addBtn) return;

                function escH(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
                function avatarSrc(u) { return (u && u.avatar) || '/icons/user-profile.svg'; }

                function buildOptionsList(selId) {
                  return GP_BLEND_USERS.map(function(u) {
                    return '<button class="blend-slot__option' + (u.id === selId ? ' is-active' : '') + '" type="button" data-uid="' + escH(u.id) + '">' +
                      '<img class="blend-slot__opt-avatar" src="' + escH(avatarSrc(u)) + '" alt="" onerror="this.onerror=null;this.src=\'/icons/user-profile.svg\';" />' +
                      '<span class="blend-slot__optname">' + escH(u.id) + '</span>' +
                    '</button>';
                  }).join('');
                }

                function gpCreateSlot(userId) {
                  var user = GP_BLEND_USERS.find(function(u) { return u.id === userId; }) || { id: userId, avatar: '' };
                  var slot = document.createElement('div');
                  slot.className = 'blend-slot';
                  slot.dataset.uid = userId;
                  slot.innerHTML =
                    '<details class="blend-slot__menu">' +
                      '<summary class="blend-slot__summary">' +
                        '<img class="blend-slot__avatar" src="' + escH(avatarSrc(user)) + '" alt="" onerror="this.onerror=null;this.src=\'/icons/user-profile.svg\';" />' +
                        '<span class="blend-slot__name">' + escH(user.id) + '</span>' +
                        '<span class="blend-slot__chev" aria-hidden="true"></span>' +
                      '</summary>' +
                      '<div class="blend-slot__list">' + buildOptionsList(userId) + '</div>' +
                    '</details>' +
                    '<button class="blend-slot__remove" type="button" aria-label="Remove">×</button>';
                  var menu = slot.querySelector('.blend-slot__menu');
                  slot.querySelectorAll('.blend-slot__option').forEach(function(btn) {
                    btn.addEventListener('click', function() {
                      var uid = btn.dataset.uid;
                      var chosen = GP_BLEND_USERS.find(function(u) { return u.id === uid; }) || { id: uid, avatar: '' };
                      slot.dataset.uid = uid;
                      slot.querySelector('.blend-slot__avatar').src = avatarSrc(chosen);
                      slot.querySelector('.blend-slot__name').textContent = uid;
                      slot.querySelectorAll('.blend-slot__option').forEach(function(b) { b.classList.toggle('is-active', b === btn); });
                      menu.removeAttribute('open');
                      updateBlendModeVisibility(); schedulePreview();
                    });
                  });
                  slot.querySelector('.blend-slot__remove').addEventListener('click', function() {
                    slot.remove();
                    updateBlendModeVisibility(); schedulePreview();
                  });
                  document.addEventListener('click', function(e) { if (!slot.contains(e.target)) menu.removeAttribute('open'); });
                  return slot;
                }

                window.gpGetBlendUsers = function() {
                  return Array.from(slotsEl.querySelectorAll('.blend-slot')).map(function(s) { return s.dataset.uid; });
                };

                window.gpSetBlendUsers = function(userIds, mode) {
                  slotsEl.innerHTML = '';
                  (userIds || []).forEach(function(uid) { slotsEl.appendChild(gpCreateSlot(uid)); });
                  if (mode) {
                    var radio = document.querySelector('input[name="gp-blend-mode"][value="' + mode + '"]');
                    if (radio) radio.checked = true;
                  }
                  updateBlendModeVisibility();
                };

                addBtn.addEventListener('click', function() {
                  var first = GP_BLEND_USERS[0];
                  if (first) { slotsEl.appendChild(gpCreateSlot(first.id)); updateBlendModeVisibility(); schedulePreview(); }
                });

                updateBlendModeVisibility();
              })();

              function runPreview() {
                var rules = getBuilderRules();
                var userId = document.getElementById('gp-preview-user').value;
                var tf = getGpFilters();
                var url = '/api/playlists/global/preview?rules=' + encodeURIComponent(JSON.stringify(rules))
                  + '&trackFilters=' + encodeURIComponent(JSON.stringify(tf));
                if (userId) url += '&userId=' + encodeURIComponent(userId);
                document.getElementById('gp-feature-match-count').textContent = '…';
                fetch(url).then(function(r) { return r.json(); }).then(function(data) {
                  if (!data.ok) return;
                  if (data.forUser) {
                    document.getElementById('gp-prev-artists').textContent = data.forUser.artistCount;
                    document.getElementById('gp-prev-tracks').textContent = data.forUser.trackCount;
                    document.getElementById('gp-feature-match-count').textContent = Number(data.featureTrackCount || 0).toLocaleString();
                    document.getElementById('gp-prev-avg-wrap').style.display = 'none';
                  } else if (data.average) {
                    document.getElementById('gp-prev-artists').textContent = data.average.artistCount;
                    document.getElementById('gp-prev-tracks').textContent = data.average.trackCount;
                    document.getElementById('gp-feature-match-count').textContent = Number(data.featureTrackCount || 0).toLocaleString();
                    document.getElementById('gp-prev-avg-wrap').style.display = 'none';
                  }
                }).catch(function() {
                  document.getElementById('gp-feature-match-count').textContent = '?';
                });
              }

              function schedulePreview() {
                clearTimeout(previewTimer);
                previewTimer = setTimeout(runPreview, 400);
              }

              document.querySelector('.gp-artist-tier-all').addEventListener('change', function() {
                if (this.checked) document.querySelectorAll('.gp-artist-tier').forEach(function(c) { c.checked = false; });
                schedulePreview();
              });
              document.querySelector('.gp-track-tier-all').addEventListener('change', function() {
                if (this.checked) document.querySelectorAll('.gp-track-tier').forEach(function(c) { c.checked = false; });
                schedulePreview();
              });
              document.querySelectorAll('.gp-artist-tier').forEach(function(c) {
                c.addEventListener('change', function() {
                  if (this.checked) document.querySelector('.gp-artist-tier-all').checked = false;
                  schedulePreview();
                });
              });
              document.querySelectorAll('.gp-track-tier').forEach(function(c) {
                c.addEventListener('change', function() {
                  if (this.checked) document.querySelector('.gp-track-tier-all').checked = false;
                  schedulePreview();
                });
              });
              ['gp-top-n','gp-max-tracks','gp-sort-by','gp-preview-user'].forEach(function(id) {
                var el = document.getElementById(id);
                if (el) el.addEventListener('change', schedulePreview);
                if (el && el.tagName === 'INPUT') el.addEventListener('input', schedulePreview);
              });
              ['gp-bpm-min','gp-bpm-max','gp-energy-min','gp-energy-max','gp-danceability-min','gp-danceability-max','gp-camelot-focus','gp-camelot-mode'].forEach(function(id) {
                var el = document.getElementById(id);
                if (!el) return;
                el.addEventListener('change', schedulePreview);
                if (el.tagName === 'INPUT') el.addEventListener('input', schedulePreview);
              });
              document.querySelectorAll('#gp-preset-grid .playlist-preset-card').forEach(function(card) {
                card.addEventListener('click', function() {
                  gpApplyPresetDefaults(card.dataset.preset || 'none');
                });
              });
              document.querySelectorAll('.gp-genre-cb, .gp-mood-cb, .gp-tag-cb').forEach(function(c) {
                c.addEventListener('change', schedulePreview);
              });
              var _dedupEl = document.getElementById('gp-dedup-mbid');
              if (_dedupEl) _dedupEl.addEventListener('change', schedulePreview);
              document.querySelectorAll('.gp-checklist-search').forEach(function(input) {
                input.addEventListener('input', function() {
                  var q = input.value.toLowerCase();
                  var list = document.getElementById(input.dataset.target);
                  if (!list) return;
                  list.querySelectorAll('.gp-checklist-item').forEach(function(item) {
                    item.style.display = item.querySelector('span').textContent.toLowerCase().includes(q) ? '' : 'none';
                  });
                });
              });

              document.querySelectorAll('.gp-card').forEach(function(card) {
                attachCardListeners(card, card.dataset.gpId);
              });

              document.getElementById('gp-cancel-edit-btn').addEventListener('click', gpCancelEdit);

              function attachCardListeners(card, id) {
                card.querySelector('.gp-edit-btn').addEventListener('click', function() {
                  window.location.href = '/playlists?editGlobal=' + encodeURIComponent(id);
                });
                card.querySelector('.gp-delete-btn').addEventListener('click', function() {
                  if (!confirm('Delete this global playlist? It will no longer be synced to Plex.')) return;
                  fetch('/api/playlists/global/' + id, { method: 'DELETE', headers: { 'X-CSRF-Token': _csrf } })
                    .then(function(r) { return r.json(); }).then(function(d) { if (d.ok) card.remove(); });
                });
                card.querySelector('.gp-toggle').addEventListener('change', function() {
                  var t = card.querySelector('.gp-toggle'); var lbl = card.querySelector('.gp-toggle-label');
                  fetch('/api/playlists/global/' + id, { method: 'PUT', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': _csrf }, body: JSON.stringify({ enabled: t.checked }) })
                    .then(function(r) { return r.json(); }).then(function(r2) { if (r2.ok && lbl) lbl.textContent = t.checked ? 'Enabled' : 'Disabled'; });
                });
              }

              document.getElementById('gp-create-btn').addEventListener('click', function() {
                var name = document.getElementById('gp-name').value.trim();
                var msg = document.getElementById('gp-create-msg');
                if (!name) { msg.textContent = 'Please enter a name.'; msg.className = 'gp-create-msg gp-msg--error'; return; }
                var rules = getBuilderRules();
                if (_editingGpId) {
                  var editId = _editingGpId;
                  fetch('/api/playlists/global/' + editId, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': _csrf },
                    body: JSON.stringify({ name: name, artistTiers: rules.artistTiers, trackTiers: rules.trackTiers, genres: rules.genres, moods: rules.moods, tags: rules.tags, topNPerArtist: rules.topNPerArtist, maxTracks: rules.maxTracks, sortBy: rules.sortBy, blendUsers: rules.blendUsers, blendMode: rules.blendMode, featurePreset: rules.featurePreset, bpmMin: rules.bpmMin, bpmMax: rules.bpmMax, energyMin: rules.energyMin, energyMax: rules.energyMax, danceabilityMin: rules.danceabilityMin, danceabilityMax: rules.danceabilityMax, camelotFocus: rules.camelotFocus, camelotMode: rules.camelotMode, trackFilters: getGpFilters() }),
                  }).then(function(r) { return r.json(); }).then(function(d) {
                    if (!d.ok) { msg.textContent = d.error || 'Error updating playlist.'; msg.className = 'gp-create-msg gp-msg--error'; return; }
                    var card = document.querySelector('.gp-card[data-gp-id="' + editId + '"]');
                    if (card) {
                      card.querySelector('.gp-card-name').textContent = d.playlist.name;
                      card.querySelector('.gp-card-rules').innerHTML = gpCardRulesHtml(d.playlist.rules || {});
                    }
                    var gpIdx = GP_DATA.findIndex(function(p) { return p.id === editId; });
                    if (gpIdx !== -1) GP_DATA[gpIdx] = d.playlist;
                    msg.textContent = 'Updated!';
                    msg.className = 'gp-create-msg gp-msg--success';
                    gpCancelEdit();
                  });
                  return;
                }
                fetch('/api/playlists/global', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': _csrf },
                  body: JSON.stringify({ name: name, artistTiers: rules.artistTiers, trackTiers: rules.trackTiers, genres: rules.genres, moods: rules.moods, tags: rules.tags, topNPerArtist: rules.topNPerArtist, maxTracks: rules.maxTracks, sortBy: rules.sortBy, blendUsers: rules.blendUsers, blendMode: rules.blendMode, featurePreset: rules.featurePreset, bpmMin: rules.bpmMin, bpmMax: rules.bpmMax, energyMin: rules.energyMin, energyMax: rules.energyMax, danceabilityMin: rules.danceabilityMin, danceabilityMax: rules.danceabilityMax, camelotFocus: rules.camelotFocus, camelotMode: rules.camelotMode, trackFilters: getGpFilters() }),
                }).then(function(r) { return r.json(); }).then(function(d) {
                  if (!d.ok) { msg.textContent = d.error || 'Error creating playlist.'; msg.className = 'gp-create-msg gp-msg--error'; return; }
                  msg.textContent = 'Created! It will sync on the next job run.';
                  msg.className = 'gp-create-msg gp-msg--success';
                  var empty = document.getElementById('gp-empty');
                  if (empty) empty.remove();
                  var card = document.createElement('div');
                  card.className = 'settings-card gp-card'; card.dataset.gpId = d.playlist.id;
                  card.innerHTML = '<div class="gp-card-header"><span class="settings-card-title gp-card-name">' + d.playlist.name + '</span>'
                    + '<div class="gp-card-actions"><label class="gp-toggle-wrap"><input type="checkbox" class="gp-toggle" data-gp-id="' + d.playlist.id + '" checked /><span class="gp-toggle-label">Enabled</span></label>'
                    + '<button class="btn btn-sm btn-ghost gp-edit-btn" data-gp-id="' + d.playlist.id + '">Edit</button>'
                    + '<button class="btn btn-sm btn-ghost-danger gp-delete-btn" data-gp-id="' + d.playlist.id + '">Delete</button></div></div>'
                    + '<div class="gp-card-rules">' + gpCardRulesHtml(d.playlist.rules || {}) + '</div>';
                  document.getElementById('gp-list').appendChild(card);
                  GP_DATA.push(d.playlist);
                  attachCardListeners(card, d.playlist.id);
                  document.getElementById('gp-name').value = '';
                });
              });

              // Auto-trigger edit if ?edit=<id> is in the URL
              (function() {
                var params = new URLSearchParams(window.location.search);
                var editId = params.get('edit');
                if (!editId) return;
                window.location.replace('/playlists?editGlobal=' + encodeURIComponent(editId));
              })();

              runPreview();
            })();
            </script>
            <% } %>

          </div>
        </div>


        <%# ── Discovery ─────────────────────────────────────────────────────── %>
        <div class="settings-tab-panel<%= _tab === 'discovery' ? ' is-active' : '' %>" data-tab="discovery">
          <div class="dash-panel">
            <form method="post" action="/settings/discovery" class="settings-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <div class="settings-card">
                <div class="settings-card-title">Last.fm Integration</div>
                <div class="settings-card-sub">Powers the Trending Artists, Trending Tracks, and Similar Artists carousels on the Discover page. Get a free API key at <a href="https://www.last.fm/api/account/create" target="_blank" rel="noopener">last.fm/api</a>. Leave blank to hide all carousels.</div>
                <label class="field">
                  <span>API Key</span>
                  <input type="text" name="lastfmApiKey" value="<%= config.discovery?.lastfmApiKey || '' %>" placeholder="Your Last.fm API key" autocomplete="off" />
                </label>
                <% const _lastfmRegion = String(config.discovery?.region || 'united kingdom').trim().toLowerCase() || 'united kingdom'; %>
                <label class="field">
                  <span>Region / Country</span>
                  <select class="settings-select" name="region">
                    <% (lastfmRegionOptions || []).forEach(function(regionOption) { %>
                      <option value="<%= regionOption.value %>" <%= _lastfmRegion === regionOption.value ? 'selected' : '' %>><%= regionOption.label %></option>
                    <% }) %>
                  </select>
                  <small class="settings-card-sub" style="margin-top:4px;display:block">Used for Last.fm regional charts on Discover.</small>
                </label>
              </div>
              <div class="settings-card">
                <div class="settings-card-title">Visible Carousels</div>
                <div class="settings-card-sub">Choose which carousels appear on the Discover page.</div>
                <input type="hidden" name="showTrendingArtists" value="" />
                <label class="settings-toggle">
                  <input type="checkbox" name="showTrendingArtists" value="1" <%= (config.discovery?.showTrendingArtists ?? true) ? 'checked' : '' %> />
                  <span class="settings-toggle-slider" aria-hidden="true"></span>
                  <span class="settings-toggle-text">Trending Artists</span>
                </label>
                <input type="hidden" name="showTrendingTracks" value="" />
                <label class="settings-toggle">
                  <input type="checkbox" name="showTrendingTracks" value="1" <%= (config.discovery?.showTrendingTracks ?? true) ? 'checked' : '' %> />
                  <span class="settings-toggle-slider" aria-hidden="true"></span>
                  <span class="settings-toggle-text">Trending Tracks</span>
                </label>
                <input type="hidden" name="showSimilarArtists" value="" />
                <label class="settings-toggle">
                  <input type="checkbox" name="showSimilarArtists" value="1" <%= (config.discovery?.showSimilarArtists ?? true) ? 'checked' : '' %> />
                  <span class="settings-toggle-slider" aria-hidden="true"></span>
                  <span class="settings-toggle-text">Because You Like… (similar artists)</span>
                </label>
              </div>
              <div class="settings-card-actions settings-card-actions--full">
                <button class="primary-button" type="submit">Save discovery settings</button>
              </div>
            </form>
          </div>
        </div>

        <%# ── Users ────────────────────────────────────────────────────────── %>
        <div class="settings-tab-panel<%= _tab === 'users' ? ' is-active' : '' %>" data-tab="users">
          <div class="dash-panel">
            <div class="settings-form settings-users">
              <%
                const _users = Array.isArray(users) ? users : [];
                const usersQueryError = _tab === 'users' ? String(error || '') : '';
                const localUsersResultMap = {
                  '1': 'Curatorr user settings updated.',
                };
                const usersQuerySuccess = _tab === 'users' ? String(success || '') : '';
                const localUsersNote = usersQueryError || localUsersResultMap[usersQuerySuccess] || 'Create local Curatorr users and manage access roles.';
              %>
              <div class="settings-card">
                <div class="settings-card-title">Curatorr Users</div>
                <div class="settings-card-sub">Local accounts can sign in directly and use role-based access.</div>
                <div class="settings-users-actions">
                  <span class="settings-users-note<%= usersQueryError ? ' settings-users-note--error' : '' %>"><%= localUsersNote %></span>
                </div>
                <form method="post" action="/settings/local-users/add" class="settings-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <label class="field">
                    <span>Username</span>
                    <input type="text" name="username" placeholder="localuser" required />
                  </label>
                  <label class="field">
                    <span>Email (optional)</span>
                    <input type="email" name="email" placeholder="user@example.com" />
                  </label>
                  <label class="field">
                    <span>Password</span>
                    <input type="password" name="password" placeholder="Min <%= localAuthMinPassword %> with upper/lower/number/symbol" minlength="<%= localAuthMinPassword %>" required />
                  </label>
                  <label class="field">
                    <span>Role</span>
                    <select class="settings-select" name="role">
                      <option value="guest">Guest</option>
                      <option value="user" selected>User</option>
                      <option value="power-user">Power user</option>
                      <option value="co-admin">Co-admin</option>
                      <option value="admin">Admin</option>
                      <option value="disabled">Disabled</option>
                    </select>
                  </label>
                  <button class="primary-button" type="submit">Add Curatorr user</button>
                </form>
                <div class="settings-users-table">
                  <div class="settings-users-row settings-users-row--local settings-users-head">
                    <div class="settings-users-head-cell settings-users-col-user">
                      <img class="settings-head-icon" src="/icons/name.svg" alt="" />
                      <span>User</span>
                    </div>
                    <div class="settings-users-head-cell settings-users-col-email">
                      <span>Email</span>
                    </div>
                    <div class="settings-users-head-cell settings-users-col-last">
                      <span>Last Curatorr login</span>
                    </div>
                    <div class="settings-users-head-cell settings-users-col-role">
                      <img class="settings-head-icon" src="/icons/role.svg" alt="" />
                      <span>Role</span>
                    </div>
                    <div class="settings-users-head-cell settings-users-head-cell--delete settings-users-col-delete">
                      <img class="settings-head-icon" src="/icons/delete.svg" alt="" />
                      <span>Delete</span>
                    </div>
                  </div>
                  <% if (_users.length) { %>
                    <% _users.forEach(function(localUser) { %>
                      <%
                        const localLogin = localUser.lastCuratorrLogin && !Number.isNaN(Date.parse(localUser.lastCuratorrLogin))
                          ? new Date(localUser.lastCuratorrLogin).toLocaleString()
                          : '—';
                      %>
                      <div class="settings-users-row settings-users-row--local">
                        <div class="settings-users-name settings-users-col-user" data-label="User">
                          <%= localUser.username %>
                          <% if (localUser.isOwnerAccount) { %>
                            <span class="settings-users-locked">Setup admin</span>
                          <% } else if (localUser.isCurrentSessionUser) { %>
                            <span class="settings-users-locked">Current session</span>
                          <% } %>
                        </div>
                        <div class="settings-users-login settings-users-col-email" data-label="Email"><%= localUser.email || '—' %></div>
                        <div class="settings-users-login settings-users-col-last" data-label="Last Curatorr login" title="<%= localUser.lastCuratorrLogin || '' %>"><%= localLogin %></div>
                        <div class="settings-users-role settings-users-col-role" data-label="Role">
                          <form method="post" action="/settings/local-users/role" class="settings-role-inline-form">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <input type="hidden" name="username" value="<%= localUser.username %>" />
                            <select name="role">
                              <option value="guest" <%= localUser.role === 'guest' ? 'selected' : '' %>>Guest</option>
                              <option value="user" <%= localUser.role === 'user' ? 'selected' : '' %>>User</option>
                              <option value="power-user" <%= localUser.role === 'power-user' ? 'selected' : '' %>>Power user</option>
                              <option value="co-admin" <%= localUser.role === 'co-admin' ? 'selected' : '' %>>Co-admin</option>
                              <option value="admin" <%= localUser.role === 'admin' ? 'selected' : '' %>>Admin</option>
                              <option value="disabled" <%= localUser.role === 'disabled' ? 'selected' : '' %>>Disabled</option>
                            </select>
                            <button class="primary-button" type="submit">Save</button>
                          </form>
                        </div>
                        <div class="settings-users-delete settings-users-col-delete" data-label="Delete">
                          <form
                            method="post"
                            action="/settings/local-users/remove"
                            class="local-user-delete-form"
                            onsubmit="return confirm('Delete this Curatorr user? This cannot be undone.');"
                          >
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <input type="hidden" name="username" value="<%= localUser.username %>" />
                            <button
                              class="local-user-delete"
                              type="submit"
                              <%= localUser.canDelete ? '' : 'disabled' %>
                              title="<%= localUser.isOwnerAccount ? 'Setup admin account cannot be deleted' : (localUser.isCurrentSessionUser ? 'You cannot delete your current session account' : 'Delete Curatorr user') %>"
                              aria-label="Delete Curatorr user"
                            >
                              <img src="/icons/delete.svg" alt="" />
                            </button>
                          </form>
                        </div>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <div class="settings-users-row settings-users-row--local">
                      <div class="settings-users-login settings-users-col-user">No local Curatorr users found.</div>
                      <div class="settings-users-login settings-users-col-email">—</div>
                      <div class="settings-users-login settings-users-col-last">—</div>
                      <div class="settings-users-login settings-users-col-role">—</div>
                      <div class="settings-users-login settings-users-col-delete">—</div>
                    </div>
                  <% } %>
                </div>
              </div>

              <%
                const _msTypeUsers = String(mediaServerType || 'plex').toLowerCase();
                const _msLabelUsers = _msTypeUsers === 'jellyfin' ? 'Jellyfin' : _msTypeUsers === 'emby' ? 'Emby' : 'Plex';
                const _msUsersEndpoint = _msTypeUsers === 'plex' ? '/settings/plex-users' : '/settings/ms-users';
                const _msLastSeenLabel = _msTypeUsers === 'plex' ? 'Last seen (Plex)' : 'Last play';
              %>
              <div class="settings-card">
                <div class="settings-card-title"><%= _msLabelUsers %> Users</div>
                <div class="settings-card-sub">Pull users from <%= _msLabelUsers %> and assign Curatorr roles.</div>
                <div class="settings-users-actions">
                  <button class="primary-button" type="button" id="fetchPlexUsersBtn">Fetch users</button>
                  <button class="primary-button" type="button" id="savePlexRolesBtn" disabled>Save roles</button>
                  <span class="settings-users-note" id="plexUsersNote">Pull the user list from <%= _msLabelUsers %> to assign roles.</span>
                </div>
                <div class="settings-users-table">
                  <div class="settings-users-row settings-users-head">
                    <div class="settings-users-head-cell settings-users-sort" data-sort-key="name" role="button" tabindex="0">
                      <img class="settings-head-icon" src="/icons/name.svg" alt="" />
                      <span>Name</span>
                    </div>
                    <div class="settings-users-head-cell settings-users-sort" data-sort-key="plex" role="button" tabindex="0">
                      <span><%= _msLastSeenLabel %></span>
                    </div>
                    <div class="settings-users-head-cell settings-users-sort" data-sort-key="curatorr" role="button" tabindex="0">
                      <span>Last Curatorr login</span>
                    </div>
                    <div class="settings-users-head-cell settings-users-sort" data-sort-key="role" role="button" tabindex="0">
                      <img class="settings-head-icon" src="/icons/role.svg" alt="" />
                      <span>Role</span>
                    </div>
                  </div>
                  <div id="plexUsersBody"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <%# ── Logs ─────────────────────────────────────────────────────────── %>
        <div class="settings-tab-panel<%= _tab === 'logs' ? ' is-active' : '' %>" data-tab="logs">
          <div class="dash-panel">
            <form method="post" action="/settings/logs" class="settings-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <div class="settings-card">
                <div class="settings-card-title">Retention</div>
                <div class="settings-card-sub">Logs are stored on disk and pruned by these limits.</div>
                <div class="settings-log-row">
                  <label class="field">
                    <span>Max Entries</span>
                    <input type="number" min="50" max="5000" step="50" name="log_max_entries" value="<%= logSettings?.maxEntries || 500 %>" />
                  </label>
                  <label class="field">
                    <span>Max Days</span>
                    <input type="number" min="1" max="365" step="1" name="log_max_days" value="<%= logSettings?.maxDays || 30 %>" />
                  </label>
                  <label class="field">
                    <span>Visible Rows</span>
                    <input type="number" min="3" max="100" step="1" name="log_visible_rows" value="<%= logSettings?.visibleRows || 25 %>" />
                  </label>
                  <button class="primary-button" type="submit">Save log settings</button>
                </div>
              </div>
            </form>
          </div>

          <div class="dash-panel">
            <div class="settings-card">
              <div class="settings-card-title">Activity</div>
              <div class="settings-card-sub">Use this to trace playlist syncs, ListenBrainz imports, wizard events, and Lidarr automation decisions.</div>
              <div class="log-toolbar">
                <div class="log-filter">
                  <span class="log-filter-label">App</span>
                  <select class="settings-select" id="settingsLogApp">
                    <option value="">All</option>
                    <option value="system">System</option>
                    <option value="settings">Settings</option>
                    <option value="wizard">Wizard</option>
                    <option value="plex">Plex</option>
                    <option value="tautulli">Tautulli</option>
                    <option value="webhook">Webhook</option>
                    <option value="music">Music</option>
                    <option value="playlist">Playlist</option>
                    <option value="listenbrainz">ListenBrainz</option>
                    <option value="recommendations">Recommendations</option>
                    <option value="lastfm">Last.fm Tags</option>
                    <option value="lastfm-sync">Last.fm Sync</option>
                    <option value="lastfm-backfill">Last.fm Backfill</option>
                    <option value="lidarr">Lidarr</option>
                    <option value="client">Client</option>
                  </select>
                </div>
                <div class="log-filter">
                  <span class="log-filter-label">Level</span>
                  <select class="settings-select" id="settingsLogLevel">
                    <option value="">All</option>
                    <option value="info">Info</option>
                    <option value="warn">Warn</option>
                    <option value="error">Error</option>
                  </select>
                </div>
                <button class="primary-button log-refresh" type="button" id="settingsLogRefresh">Refresh</button>
                <span class="log-status" id="settingsLogStatus">Loading...</span>
              </div>
              <div class="log-list" id="settingsLogList" style="--log-visible-rows:<%= logSettings?.visibleRows || 25 %>"></div>
            </div>
          </div>
        </div>

        <%# ── About ─────────────────────────────────────────────────────────── %>
        <div class="settings-tab-panel<%= _tab === 'about' ? ' is-active' : '' %>" data-tab="about">
          <div class="dash-panel">
            <div class="settings-card">
              <div class="settings-card-title">About Curatorr</div>
              <div class="settings-card-sub">Build, support links, and recent release notes.</div>
              <div class="settings-about-table">
                <div class="settings-about-row">
                  <span>Version</span>
                  <div class="settings-about-value">
                    <span class="settings-about-version" id="settingsAboutVersion"><%= aboutCurrentVersion || 'Unknown' %></span>
                    <span class="settings-about-pill" id="settingsAboutVersionState">Checking...</span>
                  </div>
                </div>
                <div class="settings-about-row">
                  <span>Latest Release</span>
                  <div class="settings-about-value">
                    <span id="settingsAboutLatest"><%= aboutLatestVersion || 'Unknown' %></span>
                  </div>
                </div>
                <div class="settings-about-row">
                  <span>Data Directory</span>
                  <div class="settings-about-value">
                    <code class="settings-about-code"><%= aboutDataDirectory || '/data' %></code>
                  </div>
                </div>
                <div class="settings-about-row">
                  <span>Time Zone</span>
                  <div class="settings-about-value">
                    <span id="settingsAboutTimeZone">Detecting...</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="dash-panel">
            <div class="settings-card">
              <div class="settings-card-title">Getting Support</div>
              <div class="settings-about-link-grid">
                <div class="settings-about-link-row">
                  <span>Documentation</span>
                  <a href="https://github.com/MickyGX/curatorr/wiki" target="_blank" rel="noreferrer noopener">https://github.com/MickyGX/curatorr/wiki</a>
                </div>
                <div class="settings-about-link-row">
                  <span>Discussions</span>
                  <a href="https://github.com/MickyGX/curatorr/discussions" target="_blank" rel="noreferrer noopener">https://github.com/MickyGX/curatorr/discussions</a>
                </div>
                <div class="settings-about-link-row">
                  <span>Discord</span>
                  <a href="https://discord.gg/TvrxJWD4PK" target="_blank" rel="noreferrer noopener">https://discord.gg/TvrxJWD4PK</a>
                </div>
              </div>
            </div>
          </div>

          <div class="dash-panel">
            <div class="settings-card">
              <div class="settings-card-title">Support Curatorr</div>
              <div class="settings-about-link-grid">
                <div class="settings-about-link-row">
                  <span>Buy Me a Coffee</span>
                  <a href="https://buymeacoffee.com/mickygx" target="_blank" rel="noreferrer noopener">https://buymeacoffee.com/mickygx</a>
                </div>
              </div>
            </div>
          </div>

          <div class="dash-panel">
            <div class="settings-card">
              <div class="settings-card-title">Releases</div>
              <div class="settings-card-sub">Click a release to view a short changelog summary.</div>
              <% const aboutReleaseEntries = Array.isArray(aboutReleases) ? aboutReleases : []; %>
              <div class="settings-release-list" id="settingsReleaseList">
                <% if (aboutReleaseEntries.length) { %>
                  <% aboutReleaseEntries.forEach((release, index) => { %>
                    <div class="settings-release-row">
                      <div class="settings-release-copy">
                        <div class="settings-release-head">
                          <span class="settings-release-age" data-release-published-at="<%= release.publishedAt || '' %>">Recently</span>
                          <strong class="settings-release-title">Release <%= release.tag %></strong>
                          <% if (release.isLatest) { %>
                            <span class="settings-about-pill settings-about-pill--ok">Latest</span>
                          <% } %>
                          <% if (release.isCurrent) { %>
                            <span class="settings-about-pill">Current</span>
                          <% } %>
                        </div>
                        <div class="settings-release-summary"><%= release.summary || 'Release notes are available.' %></div>
                      </div>
                      <button class="primary-button settings-release-open" type="button" data-release-index="<%= index %>">View Changelog</button>
                    </div>
                  <% }) %>
                <% } else { %>
                  <div class="settings-release-empty">No release notes were found in <code>docs/release/releases</code>.</div>
                <% } %>
              </div>
            </div>
          </div>

          <div id="settingsReleaseModalBackdrop" class="plex-modal-backdrop plex-hidden">
            <div class="plex-modal settings-release-modal" role="dialog" aria-modal="true" aria-labelledby="settingsReleaseModalTitle">
              <button class="plex-modal-close" type="button" aria-label="Close">✕</button>
              <div class="plex-modal-header">
                <div class="plex-modal-title" id="settingsReleaseModalTitle">Release Notes</div>
                <div class="plex-modal-subtitle" id="settingsReleaseModalSubtitle">Changelog summary</div>
              </div>
              <div class="plex-modal-body settings-release-modal-body">
                <div class="plex-modal-scroll settings-release-modal-scroll">
                  <div class="settings-release-modal-summary" id="settingsReleaseModalSummary"></div>
                  <ul class="settings-release-modal-list" id="settingsReleaseModalList"></ul>
                </div>
              </div>
              <div class="plex-modal-footer">
                <a class="plex-modal-link" id="settingsReleaseModalLink" href="#" target="_blank" rel="noreferrer noopener">Full Release</a>
                <button class="plex-modal-link settings-release-modal-close" type="button">Close</button>
              </div>
            </div>
          </div>
        </div>

        <%# ── Appearance ────────────────────────────────────────────────────── %>
        <div class="settings-tab-panel<%= _tab === 'appearance' ? ' is-active' : '' %>" data-tab="appearance">
          <div class="dash-panel">
            <div class="settings-card settings-card--themes">
              <div class="settings-card-title">Themes</div>
              <div class="settings-card-sub">Choose a preset theme for Curatorr.</div>
              <div class="theme-presets" id="themePresets">
                <button class="theme-preset-card" type="button" data-brand-theme="curatorr" style="--preset-color:#8b5cf6;--preset-rgb:139,92,246">
                  <span class="theme-preset-chip" style="--theme-color:#8b5cf6"></span>
                  <span class="theme-preset-name">Curatorr</span>
                  <span class="theme-preset-meta">Purple</span>
                </button>
                <button class="theme-preset-card" type="button" data-brand-theme="launcharr" style="--preset-color:#6d7a86;--preset-rgb:109,122,134">
                  <span class="theme-preset-chip" style="--theme-color:#6d7a86"></span>
                  <span class="theme-preset-name">Launcharr</span>
                  <span class="theme-preset-meta">Gunmetal</span>
                </button>
                <button class="theme-preset-card" type="button" data-brand-theme="rocketship" style="--preset-color:#b8c1ca;--preset-rgb:184,193,202">
                  <span class="theme-preset-chip" style="--theme-color:#b8c1ca"></span>
                  <span class="theme-preset-name">Rocketship</span>
                  <span class="theme-preset-meta">Silver</span>
                </button>
                <button class="theme-preset-card" type="button" data-brand-theme="pulsarr" style="--preset-color:#1cc6c2;--preset-rgb:28,198,194">
                  <span class="theme-preset-chip" style="--theme-color:#1cc6c2"></span>
                  <span class="theme-preset-name">Pulsarr</span>
                  <span class="theme-preset-meta">Pulsarr teal</span>
                </button>
                <button class="theme-preset-card" type="button" data-brand-theme="plex" style="--preset-color:#f9ad2f;--preset-rgb:249,173,47">
                  <span class="theme-preset-chip" style="--theme-color:#f9ad2f"></span>
                  <span class="theme-preset-name">Plex</span>
                  <span class="theme-preset-meta">Plex orange</span>
                </button>
                <button class="theme-preset-card" type="button" data-brand-theme="radarr" style="--preset-color:#f4c542;--preset-rgb:244,197,66">
                  <span class="theme-preset-chip" style="--theme-color:#f4c542"></span>
                  <span class="theme-preset-name">Radarr</span>
                  <span class="theme-preset-meta">Radarr yellow</span>
                </button>
                <button class="theme-preset-card" type="button" data-brand-theme="sonarr" style="--preset-color:#3d7bfd;--preset-rgb:61,123,253">
                  <span class="theme-preset-chip" style="--theme-color:#3d7bfd"></span>
                  <span class="theme-preset-name">Sonarr</span>
                  <span class="theme-preset-meta">Sonarr blue</span>
                </button>
                <button class="theme-preset-card" type="button" data-brand-theme="lidarr" style="--preset-color:#53b86a;--preset-rgb:83,184,106">
                  <span class="theme-preset-chip" style="--theme-color:#53b86a"></span>
                  <span class="theme-preset-name">Lidarr</span>
                  <span class="theme-preset-meta">Lidarr green</span>
                </button>
                <button class="theme-preset-card" type="button" data-brand-theme="readarr" style="--preset-color:#d84a4a;--preset-rgb:216,74,74">
                  <span class="theme-preset-chip" style="--theme-color:#d84a4a"></span>
                  <span class="theme-preset-name">Readarr</span>
                  <span class="theme-preset-meta">Readarr red</span>
                </button>
                <button class="theme-preset-card" type="button" data-brand-theme="custom" style="--preset-color:#8b5cf6;--preset-rgb:139,92,246">
                  <span class="theme-preset-chip theme-preset-chip--custom" data-custom-chip style="--theme-color:#8b5cf6">
                    <input class="theme-chip-picker" id="customThemeColor" type="color" value="#8b5cf6" aria-label="Choose custom colour" />
                  </span>
                  <span class="theme-preset-name">Custom</span>
                  <span class="theme-preset-meta">Colour wheel</span>
                </button>
              </div>
              <div class="theme-options" id="themeOptions">
                <label class="settings-toggle theme-option">
                  <input id="themeSidebarInvert" type="checkbox" />
                  <span class="settings-toggle-slider" aria-hidden="true"></span>
                  <span class="theme-option-copy">
                    <strong>Invert sidebar colours</strong>
                    <small>Swap sidebar dark/theme emphasis.</small>
                  </span>
                </label>
                <label class="settings-toggle theme-option">
                  <input id="themeSquareCorners" type="checkbox" />
                  <span class="settings-toggle-slider" aria-hidden="true"></span>
                  <span class="theme-option-copy">
                    <strong>Square corners</strong>
                    <small>Remove rounded corners across the UI.</small>
                  </span>
                </label>
                <label class="settings-toggle theme-option">
                  <input id="themeBgMotion" type="checkbox" checked />
                  <span class="settings-toggle-slider" aria-hidden="true"></span>
                  <span class="theme-option-copy">
                    <strong>Animated space background</strong>
                    <small>Theme-linked moving star field.</small>
                  </span>
                </label>
                <label class="settings-toggle theme-option">
                  <input id="themeCarouselFreeScroll" type="checkbox" />
                  <span class="settings-toggle-slider" aria-hidden="true"></span>
                  <span class="theme-option-copy">
                    <strong>Free carousel scroll</strong>
                    <small>Disable index snapping and allow fast horizontal swipe scrolling.</small>
                  </span>
                </label>
                <label class="settings-toggle theme-option">
                  <input id="themeHideScrollbars" type="checkbox" />
                  <span class="settings-toggle-slider" aria-hidden="true"></span>
                  <span class="theme-option-copy">
                    <strong>Hide scrollbars</strong>
                    <small>Hide scrollbar rails while keeping scroll behaviour.</small>
                  </span>
                </label>
              </div>
              <%
                const themeDefaultsResultMap = {
                  saved: 'Default theme saved.',
                };
                const themeDefaultsNote = themeDefaultsError
                  ? themeDefaultsError
                  : (themeDefaultsResultMap[themeDefaultsResult] || '');
              %>
              <form method="post" action="/settings/theme-defaults" class="settings-card-actions" id="themeDefaultForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="theme_mode" id="themeDefaultMode" />
                <input type="hidden" name="theme_brand_theme" id="themeDefaultBrandTheme" />
                <input type="hidden" name="theme_custom_color" id="themeDefaultCustomColor" />
                <input type="hidden" name="theme_sidebar_invert" id="themeDefaultSidebarInvert" />
                <input type="hidden" name="theme_square_corners" id="themeDefaultSquareCorners" />
                <input type="hidden" name="theme_bg_motion" id="themeDefaultBgMotion" />
                <input type="hidden" name="theme_carousel_free_scroll" id="themeDefaultCarouselFreeScroll" />
                <input type="hidden" name="theme_hide_scrollbars" id="themeDefaultHideScrollbars" />
                <button class="primary-button" type="submit">Save current theme as default</button>
              </form>
              <% if (themeDefaultsNote) { %>
                <span class="settings-users-note<%= themeDefaultsError ? ' settings-users-note--error' : '' %>"><%= themeDefaultsNote %></span>
              <% } %>
            </div>
          </div>
        </div>

        <%# ── Jobs (admin only) ─────────────────────────────────────────────── %>
        <% if (actualRole === 'admin') { %>
        <div class="settings-tab-panel<%= _tab === 'jobs' ? ' is-active' : '' %>" data-tab="jobs">
          <div class="dash-panel">
            <div class="settings-card">
              <div class="settings-card-title">Scheduled Jobs</div>
              <div class="settings-card-sub">Configure and manually trigger system-wide background jobs. Changes take effect immediately without restart.</div>
            </div>
            <form method="post" action="/settings/jobs" class="settings-form" id="jobsSettingsForm">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <%
                const _jobsCfg = config.jobs || {};
                const _jobIds = Object.keys(jobDefs || {});
              %>
              <% for (const _jid of _jobIds) { %>
              <%
                const _jdef = jobDefs[_jid];
                const _jcfg = _jobsCfg[_jid] || {};
                const _jstat = jobStatus[_jid] || {};
                const _jEnabled = _jcfg.enabled !== false;
                const _jInterval = _jcfg.intervalMinutes || _jdef.defaultIntervalMinutes;
                const _jStatus = _jstat.status || 'idle';
                const _jLastRun = _jstat.lastRunAt;
                const _jMsg = _jstat.message || '';
              %>
              <div class="settings-card settings-job-card" data-job-id="<%= _jid %>">
                <div class="settings-job-card-header">
                  <div class="settings-job-card-meta">
                    <div class="settings-card-title" style="margin-bottom:4px"><%= _jdef.label %></div>
                    <div class="settings-card-sub" style="margin-bottom:0"><%= _jdef.description %></div>
                  </div>
                  <div class="settings-job-card-actions">
                    <span class="settings-job-status-badge settings-job-status-badge--<%= _jStatus %>" data-job-status="<%= _jid %>"><%= _jStatus %></span>
                    <button type="button" class="ghost-button settings-job-run-btn" data-job-id="<%= _jid %>"><%= _jdef.manualOnly ? 'Run Batch' : 'Run Now' %></button>
                  </div>
                </div>
                <div class="settings-job-last-run" data-job-last-run="<%= _jid %>">
                  <% if (_jLastRun) { %>
                    Last run: <span class="settings-job-time" data-ts="<%= _jLastRun %>"></span>
                    <% if (_jMsg) { %><span class="settings-job-msg"> — <%= _jMsg %></span><% } %>
                  <% } else { %>
                    Never run
                  <% } %>
                </div>
                <% if (!_jdef.manualOnly) { %>
                <div class="settings-job-controls">
                  <label class="field" style="flex:0 0 auto;min-width:0">
                    <span>Interval (minutes)</span>
                    <input type="number" name="<%= _jid %>_interval" value="<%= _jInterval %>" min="1" max="1440" style="width:90px" />
                  </label>
                  <label class="settings-smart-toggle-field" style="align-self:flex-end;padding-bottom:2px">
                    <span class="settings-smart-toggle-field-title">Enabled</span>
                    <span class="settings-toggle">
                      <input id="job_enabled_<%= _jid %>" type="checkbox" name="<%= _jid %>_enabled" value="1" <%= _jEnabled ? 'checked' : '' %> />
                      <span class="settings-toggle-slider" aria-hidden="true"></span>
                    </span>
                  </label>
                </div>
                <% } %>
              </div>
              <% } %>
              <div class="settings-card-actions settings-card-actions--full" style="margin-top:4px">
                <button type="submit" class="primary-button">Save Job Settings</button>
              </div>
            </form>

            <%# ── Playlist maintenance (Plex only) ── %>
            <% if (mediaServerType === 'plex' || !mediaServerType) { %>
            <div class="settings-card" style="margin-top:20px">
              <div class="settings-card-title">Playlist Account Maintenance</div>
              <div class="settings-card-sub">
                If generated playlists (Curatorr, Crescive, Curative, Daily Mix) appear under the wrong Plex account in Plexamp,
                use this to delete the misowned copies from Plex and re-register them so the next sync recreates
                each playlist under the correct user's account.
              </div>
              <div style="margin-top:14px; display:flex; align-items:center; gap:12px">
                <button type="button" class="ghost-button" id="reassignPlaylistsBtn" onclick="reassignPlaylists()">Reassign All Playlists</button>
                <span id="reassignPlaylistsStatus" class="settings-sub-label"></span>
              </div>
            </div>
            <% } %>
          </div>
        </div>
        <% } %>

      </div>
    </section>
  </div>

  <script src="/sidebar.js?v=<%= assetVersion %>"></script>
  <script src="/user-menu.js?v=<%= assetVersion %>"></script>
  <script src="/version-badge.js?v=<%= assetVersion %>"></script>
  <script src="/brand-menu.js?v=<%= assetVersion %>"></script>
  <script src="/starfield-3d.js"></script>
  <script>
  // ── Tab switching ──────────────────────────────────────────────────────────
  (function() {
    var tabBtns = Array.from(document.querySelectorAll('.settings-tab-btn'));
    var tabPanels = Array.from(document.querySelectorAll('.settings-tab-panel'));
    function activateTab(id) {
      tabBtns.forEach(function(b) { b.classList.toggle('is-active', b.dataset.tab === id); });
      tabPanels.forEach(function(p) { p.classList.toggle('is-active', p.dataset.tab === id); });
      try { localStorage.setItem('curatorr-settings-tab', id); } catch(e) {}
    }
    tabBtns.forEach(function(btn) {
      btn.addEventListener('click', function() { activateTab(btn.dataset.tab); });
    });
    var serverTab = '<%= _tab %>';
    var savedTab = '';
    try { savedTab = localStorage.getItem('curatorr-settings-tab') || ''; } catch(e) {}
    var initialTab = serverTab || savedTab || 'general';
    if (!tabBtns.some(function(btn) { return btn.dataset.tab === initialTab; })) initialTab = 'general';
    activateTab(initialTab);
  })();

  // ── Analyzer mode form visibility ────────────────────────────────────────
  (function() {
    var modeSelect = document.getElementById('analyzerModeSelect');
    if (!modeSelect) return;
    var help = document.getElementById('analyzerModeHelp');
    var helpCopy = {
      sidecar: 'Analyzer sidecar is recommended for Docker installs. Curatorr sends analysis jobs to the companion analyzer service at http://127.0.0.1:8765.',
      custom: 'Custom command is an advanced escape hatch. Curatorr exports the manifest, runs your command, then imports the analyzer output.'
    };
    function setFieldState(wrapper, visible) {
      wrapper.hidden = !visible;
      wrapper.querySelectorAll('input, textarea, select').forEach(function(field) {
        field.disabled = !visible;
      });
    }
    function updateAnalyzerModeUi() {
      var mode = String(modeSelect.value || 'sidecar').trim().toLowerCase();
      document.querySelectorAll('[data-analyzer-mode-field]').forEach(function(node) {
        setFieldState(node, node.dataset.analyzerModeField === mode);
      });
      if (help) help.textContent = helpCopy[mode] || helpCopy.sidecar;
    }
    modeSelect.addEventListener('change', updateAnalyzerModeUi);
    updateAnalyzerModeUi();
  })();

  // ── Jobs ──────────────────────────────────────────────────────────────────
  (function() {
    function fmtRelTime(ts) {
      if (!ts) return 'Never';
      var diff = Math.floor((Date.now() - ts) / 1000);
      if (diff < 60) return 'just now';
      if (diff < 3600) return Math.floor(diff / 60) + 'm ago';
      if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
      return Math.floor(diff / 86400) + 'd ago';
    }

    function applyStatus(data) {
      Object.keys(data).forEach(function(jobId) {
        var s = data[jobId];
        var badge = document.querySelector('[data-job-status="' + jobId + '"]');
        var lastRunEl = document.querySelector('[data-job-last-run="' + jobId + '"]');
        if (badge) {
          badge.textContent = s.status;
          badge.className = 'settings-job-status-badge settings-job-status-badge--' + s.status;
        }
        if (lastRunEl && s.lastRunAt) {
          var msg = s.message ? ' \u2014 ' + s.message : '';
          lastRunEl.innerHTML = 'Last run: <span class="settings-job-time">' + fmtRelTime(s.lastRunAt) + '</span>' + (msg ? '<span class="settings-job-msg">' + msg + '</span>' : '');
        } else if (lastRunEl && !s.lastRunAt) {
          lastRunEl.textContent = 'Never run';
        }
      });
    }

    // Relative timestamps on page load
    document.querySelectorAll('.settings-job-time[data-ts]').forEach(function(el) {
      el.textContent = fmtRelTime(Number(el.dataset.ts));
    });

    // Poll status while any job is running
    var pollTimer = null;
    function startPolling() {
      if (pollTimer) return;
      pollTimer = setInterval(function() {
        fetch('/api/jobs/status').then(function(r) { return r.json(); }).then(function(data) {
          applyStatus(data);
          var anyRunning = Object.values(data).some(function(s) { return s.status === 'running'; });
          if (!anyRunning) { clearInterval(pollTimer); pollTimer = null; }
        }).catch(function() {});
      }, 2000);
    }

    // Run Now buttons
    document.querySelectorAll('.settings-job-run-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var jobId = btn.dataset.jobId;
        var badge = document.querySelector('[data-job-status="' + jobId + '"]');
        if (badge) { badge.textContent = 'running'; badge.className = 'settings-job-status-badge settings-job-status-badge--running'; }
        fetch('/api/jobs/' + jobId + '/run', { method: 'POST', headers: { 'X-CSRF-Token': document.querySelector('[name=_csrf]')?.value || '' } })
          .then(function() { startPolling(); })
          .catch(function() {});
      });
    });
  })();

  function reassignPlaylists() {
    var btn = document.getElementById('reassignPlaylistsBtn');
    var status = document.getElementById('reassignPlaylistsStatus');
    btn.disabled = true;
    status.textContent = 'Deleting misowned playlists from Plex…';
    fetch('/api/admin/playlists/reassign', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('[name=_csrf]')?.value || '' },
    }).then(function(r) { return r.json(); })
      .then(function(data) {
        if (!data.ok) throw new Error(data.error || 'Failed');
        if (data.reassigned > 0) {
          status.textContent = data.reassigned + ' playlist(s) reassigned. Trigger a Smart Playlist Sync job to recreate them under each user\'s account.';
        } else {
          status.textContent = 'No playlists found to reassign.';
        }
        if (data.errors && data.errors.length) {
          status.textContent += ' Errors: ' + data.errors.join(', ');
        }
        btn.disabled = false;
      })
      .catch(function(err) {
        status.textContent = 'Error: ' + (err.message || 'Unknown');
        btn.disabled = false;
      });
  }

  // ── Logs ──────────────────────────────────────────────────────────────────
  (function() {
    var settingsLogList = document.getElementById('settingsLogList');
    var settingsLogStatus = document.getElementById('settingsLogStatus');
    var settingsLogRefresh = document.getElementById('settingsLogRefresh');
    var settingsLogApp = document.getElementById('settingsLogApp');
    var settingsLogLevel = document.getElementById('settingsLogLevel');
    var logAppNames = {
      system: 'System',
      settings: 'Settings',
      wizard: 'Wizard',
      plex: 'Plex',
      tautulli: 'Tautulli',
      webhook: 'Webhook',
      music: 'Music',
      playlist: 'Playlist',
      listenbrainz: 'ListenBrainz',
      recommendations: 'Recommendations',
      lastfm: 'Last.fm Tags',
      'lastfm-sync': 'Last.fm Sync',
      'lastfm-backfill': 'Last.fm Backfill',
      lidarr: 'Lidarr',
      client: 'Client'
    };
    var settingsLogs = [];

    function escapeLogHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function formatLogTime(value) {
      var date = value ? new Date(value) : null;
      if (!date || Number.isNaN(date.getTime())) return '';
      return date.toLocaleString();
    }

    function renderSettingsLogs() {
      if (!settingsLogList) return;
      var appFilter = String(settingsLogApp && settingsLogApp.value || '').trim().toLowerCase();
      var levelFilter = String(settingsLogLevel && settingsLogLevel.value || '').trim().toLowerCase();
      var filtered = settingsLogs.filter(function(entry) {
        if (appFilter && String(entry.app || '').toLowerCase() !== appFilter) return false;
        if (levelFilter && String(entry.level || '').toLowerCase() !== levelFilter) return false;
        return true;
      });
      if (!filtered.length) {
        settingsLogList.innerHTML = '<div class="log-empty">No logs yet.</div>';
        return;
      }
      settingsLogList.innerHTML = filtered.map(function(entry) {
        var appId = String(entry.app || 'system').toLowerCase();
        var appName = logAppNames[appId] || appId;
        var level = String(entry.level || 'info').toLowerCase();
        var action = String(entry.action || 'event');
        var message = String(entry.message || '');
        var meta = entry.meta && typeof entry.meta === 'object'
          ? '<div class="log-meta">' + escapeLogHtml(JSON.stringify(entry.meta)) + '</div>'
          : '';
        return '' +
          '<div class="log-row log-row--' + escapeLogHtml(level) + '" data-app="' + escapeLogHtml(appId) + '">' +
            '<div class="log-time">' + escapeLogHtml(formatLogTime(entry.ts)) + '</div>' +
            '<div class="log-message">' +
              '<div class="log-title">' +
                '<span class="log-app-pill" data-app="' + escapeLogHtml(appId) + '">' + escapeLogHtml(appName) + '</span>' +
                escapeLogHtml(action) +
              '</div>' +
              '<div class="log-text">' + escapeLogHtml(message) + '</div>' +
              meta +
            '</div>' +
          '</div>';
      }).join('');
    }

    async function loadSettingsLogs() {
      if (!settingsLogList || !settingsLogStatus) return;
      settingsLogStatus.textContent = 'Loading...';
      var params = new URLSearchParams();
      params.set('limit', '250');
      if (settingsLogApp && settingsLogApp.value) params.set('appId', settingsLogApp.value);
      if (settingsLogLevel && settingsLogLevel.value) params.set('level', settingsLogLevel.value);
      try {
        var response = await fetch('/api/logs?' + params.toString());
        var payload = response.ok ? await response.json() : { items: [] };
        settingsLogs = Array.isArray(payload.items) ? payload.items : [];
        renderSettingsLogs();
        settingsLogStatus.textContent = new Date().toLocaleTimeString();
      } catch (_err) {
        settingsLogStatus.textContent = 'Failed to load logs';
      }
    }

    if (settingsLogRefresh) settingsLogRefresh.addEventListener('click', loadSettingsLogs);
    if (settingsLogApp) settingsLogApp.addEventListener('change', loadSettingsLogs);
    if (settingsLogLevel) settingsLogLevel.addEventListener('change', loadSettingsLogs);
    loadSettingsLogs();
  })();

  // ── About ─────────────────────────────────────────────────────────────────
  (function() {
    try {
      var settingsAboutVersion = document.getElementById('settingsAboutVersion');
      var settingsAboutLatest = document.getElementById('settingsAboutLatest');
      var settingsAboutVersionState = document.getElementById('settingsAboutVersionState');
      var settingsAboutTimeZone = document.getElementById('settingsAboutTimeZone');
      var settingsReleaseModalBackdrop = document.getElementById('settingsReleaseModalBackdrop');
      var settingsReleaseModalTitle = document.getElementById('settingsReleaseModalTitle');
      var settingsReleaseModalSubtitle = document.getElementById('settingsReleaseModalSubtitle');
      var settingsReleaseModalSummary = document.getElementById('settingsReleaseModalSummary');
      var settingsReleaseModalList = document.getElementById('settingsReleaseModalList');
      var settingsReleaseModalLink = document.getElementById('settingsReleaseModalLink');
      var settingsReleaseOpenButtons = Array.from(document.querySelectorAll('.settings-release-open'));
      var releaseModalCloseButtons = settingsReleaseModalBackdrop
        ? Array.from(settingsReleaseModalBackdrop.querySelectorAll('.settings-release-modal-close, .plex-modal-close'))
        : [];
      var aboutReleaseEntriesRaw = <%- safeJson(aboutReleases || []) %>;
      var aboutReleaseEntries = Array.isArray(aboutReleaseEntriesRaw) ? aboutReleaseEntriesRaw : [];

      if (settingsReleaseModalBackdrop && settingsReleaseModalBackdrop.parentElement !== document.body) {
        document.body.appendChild(settingsReleaseModalBackdrop);
      }

      var normalizeVersionTag = function(value) {
        var raw = String(value || '').trim();
        if (!raw) return '';
        return raw.startsWith('v') ? raw : ('v' + raw);
      };
      var escapeHtml = function(value) {
        return String(value || '').replace(/[&<>\"']/g, function(char) {
          return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[char];
        });
      };
      var parseHighlight = function(value) {
        var raw = String(value || '').trim();
        if (!raw) return null;
        var match = raw.match(/^([A-Za-z][A-Za-z\\s]+):\\s*(.+)$/);
        if (!match) return { section: 'Update', detail: raw };
        return {
          section: String(match[1] || '').trim() || 'Update',
          detail: String(match[2] || '').trim() || raw,
        };
      };
      var formatRelativeTime = function(value) {
        var date = value ? new Date(value) : null;
        if (!date || Number.isNaN(date.getTime())) return 'Recently';
        var seconds = Math.max(0, Math.floor((Date.now() - date.getTime()) / 1000));
        if (seconds < 60) return 'Just now';
        var minutes = Math.floor(seconds / 60);
        if (minutes < 60) return minutes + ' minute' + (minutes === 1 ? '' : 's') + ' ago';
        var hours = Math.floor(minutes / 60);
        if (hours < 24) return hours + ' hour' + (hours === 1 ? '' : 's') + ' ago';
        var days = Math.floor(hours / 24);
        if (days < 30) return days + ' day' + (days === 1 ? '' : 's') + ' ago';
        var months = Math.floor(days / 30);
        if (months < 12) return months + ' month' + (months === 1 ? '' : 's') + ' ago';
        var years = Math.floor(months / 12);
        return years + ' year' + (years === 1 ? '' : 's') + ' ago';
      };
      var updateReleaseRelativeTimes = function() {
        document.querySelectorAll('[data-release-published-at]').forEach(function(node) {
          var publishedAt = String(node.getAttribute('data-release-published-at') || '').trim();
          node.textContent = formatRelativeTime(publishedAt);
        });
      };
      var setVersionState = function(text, tone) {
        if (!settingsAboutVersionState) return;
        settingsAboutVersionState.textContent = String(text || '').trim();
        settingsAboutVersionState.classList.remove('settings-about-pill--ok', 'settings-about-pill--warn');
        if (tone === 'ok') settingsAboutVersionState.classList.add('settings-about-pill--ok');
        if (tone === 'warn') settingsAboutVersionState.classList.add('settings-about-pill--warn');
      };
      var closeReleaseModal = function() {
        if (!settingsReleaseModalBackdrop) return;
        settingsReleaseModalBackdrop.classList.add('plex-hidden');
        window.removeEventListener('keydown', onReleaseModalKeydown);
      };
      var onReleaseModalKeydown = function(event) {
        if (event.key === 'Escape') closeReleaseModal();
      };
      var openReleaseModal = function(release) {
        if (!settingsReleaseModalBackdrop || !release) return;
        var releaseTag = normalizeVersionTag(release.tag || 'Release');
        var subtitle = release.publishedAt ? formatRelativeTime(release.publishedAt) : 'Changelog summary';
        var highlights = (Array.isArray(release.highlights) ? release.highlights : [])
          .map(parseHighlight)
          .filter(Boolean)
          .slice(0, 3);
        var summary = String(release.summary || '').trim()
          || (highlights[0] ? highlights[0].detail : 'Release notes are available.');
        if (settingsReleaseModalTitle) settingsReleaseModalTitle.textContent = 'Release ' + releaseTag;
        if (settingsReleaseModalSubtitle) settingsReleaseModalSubtitle.textContent = subtitle;
        if (settingsReleaseModalSummary) settingsReleaseModalSummary.textContent = summary;
        if (settingsReleaseModalList) {
          settingsReleaseModalList.innerHTML = highlights.length
            ? highlights.map(function(item) {
              return '<li class="settings-release-modal-item">'
                + '<span class="settings-release-modal-tag">' + escapeHtml(item.section) + '</span>'
                + '<span class="settings-release-modal-text">' + escapeHtml(item.detail) + '</span>'
                + '</li>';
            }).join('')
            : '<li class="settings-release-modal-item"><span class="settings-release-modal-text">No highlight entries were found for this release.</span></li>';
        }
        if (settingsReleaseModalLink) {
          settingsReleaseModalLink.href = String(release.releaseNotesUrl || '#').trim() || '#';
        }
        settingsReleaseModalBackdrop.classList.remove('plex-hidden');
        window.addEventListener('keydown', onReleaseModalKeydown);
      };

      settingsReleaseOpenButtons.forEach(function(button) {
        button.addEventListener('click', function() {
          var index = Number(button.dataset.releaseIndex);
          if (!Number.isFinite(index)) return;
          var release = aboutReleaseEntries[index];
          if (!release) return;
          openReleaseModal(release);
        });
      });
      if (settingsReleaseModalBackdrop) {
        settingsReleaseModalBackdrop.addEventListener('click', function(event) {
          if (event.target === settingsReleaseModalBackdrop) closeReleaseModal();
        });
      }
      releaseModalCloseButtons.forEach(function(button) {
        button.addEventListener('click', closeReleaseModal);
      });

      updateReleaseRelativeTimes();
      if (settingsAboutTimeZone) {
        var tz = String(Intl.DateTimeFormat().resolvedOptions().timeZone || '').trim();
        settingsAboutTimeZone.textContent = tz || 'Unknown';
      }

      var fallbackCurrent = normalizeVersionTag(settingsAboutVersion && settingsAboutVersion.textContent || '');
      var fallbackLatest = normalizeVersionTag(settingsAboutLatest && settingsAboutLatest.textContent || '');
      if (fallbackLatest && settingsAboutLatest) settingsAboutLatest.textContent = fallbackLatest;
      if (fallbackCurrent && settingsAboutVersion) settingsAboutVersion.textContent = fallbackCurrent;
      if (fallbackCurrent && fallbackLatest && fallbackCurrent === fallbackLatest) {
        setVersionState('Up to Date', 'ok');
      } else if (fallbackLatest) {
        setVersionState('Update Available', 'warn');
      } else {
        setVersionState('Unknown', '');
      }

      fetch('/api/version')
        .then(function(response) { return response.ok ? response.json() : null; })
        .then(function(payload) {
          if (!payload) return;
          var current = normalizeVersionTag(payload.current || fallbackCurrent);
          var latest = normalizeVersionTag(payload.latest || fallbackLatest);
          if (settingsAboutVersion && current) settingsAboutVersion.textContent = current;
          if (settingsAboutLatest && latest) settingsAboutLatest.textContent = latest;
          if (current && latest && current === latest) {
            setVersionState('Up to Date', 'ok');
          } else if (current && latest && current !== latest) {
            setVersionState('Update Available', 'warn');
          } else {
            setVersionState('Version Info', '');
          }
        })
        .catch(function() {
          setVersionState('Version Info', '');
        });
    } catch (err) {
      console.error('[Curatorr] About settings init failed', err);
    }
  })();

  // ── Appearance ─────────────────────────────────────────────────────────────
  (function() {
    var root = document.documentElement;
    var themePresetButtons = Array.from(document.querySelectorAll('.theme-preset-card'));
    var customThemeColorInput = document.getElementById('customThemeColor');
    var customThemeChip = document.querySelector('[data-custom-chip]');
    var themeSidebarInvertToggle = document.getElementById('themeSidebarInvert');
    var themeSquareCornersToggle = document.getElementById('themeSquareCorners');
    var themeBgMotionToggle = document.getElementById('themeBgMotion');
    var themeCarouselFreeScrollToggle = document.getElementById('themeCarouselFreeScroll');
    var themeHideScrollbarsToggle = document.getElementById('themeHideScrollbars');
    var themeDefaultForm = document.getElementById('themeDefaultForm');
    var themeDefaultModeInput = document.getElementById('themeDefaultMode');
    var themeDefaultBrandThemeInput = document.getElementById('themeDefaultBrandTheme');
    var themeDefaultCustomColorInput = document.getElementById('themeDefaultCustomColor');
    var themeDefaultSidebarInvertInput = document.getElementById('themeDefaultSidebarInvert');
    var themeDefaultSquareCornersInput = document.getElementById('themeDefaultSquareCorners');
    var themeDefaultBgMotionInput = document.getElementById('themeDefaultBgMotion');
    var themeDefaultCarouselFreeScrollInput = document.getElementById('themeDefaultCarouselFreeScroll');
    var themeDefaultHideScrollbarsInput = document.getElementById('themeDefaultHideScrollbars');
    var allowedBrandThemes = new Set(['custom', 'curatorr', 'launcharr', 'rocketship', 'pulsarr', 'plex', 'radarr', 'sonarr', 'lidarr', 'readarr']);
    var customColorStorageKey = 'curatorr-custom-color';
    var serverThemeDefaults = <%- JSON.stringify(themeDefaults || {}) %>;
    var themeOptionStorageKeys = {
      sidebarInvert: 'curatorr-sidebar-invert',
      squareCorners: 'curatorr-square-corners',
      bgMotion: 'curatorr-bg-motion',
      carouselFreeScroll: 'curatorr-carousel-free-scroll',
      hideScrollbars: 'curatorr-hide-scrollbars',
    };
    var safeStorage = {
      get: function(key) {
        try { return localStorage.getItem(key); } catch (_err) { return null; }
      },
      set: function(key, value) {
        try { localStorage.setItem(key, value); } catch (_err) {}
      }
    };
    var resolveBrandTheme = function(value) {
      var raw = String(value || '').trim().toLowerCase();
      return allowedBrandThemes.has(raw) ? raw : 'curatorr';
    };
    var parseStoredBool = function(key, defaultValue) {
      var raw = safeStorage.get(key);
      if (raw === null || raw === undefined) return Boolean(defaultValue);
      return raw === '1' || raw === 'true';
    };
    var applyThemeOptions = function(options) {
      var sidebarInvert = Boolean(options && options.sidebarInvert);
      var squareCorners = Boolean(options && options.squareCorners);
      var bgMotion = !options || options.bgMotion !== false;
      var carouselFreeScroll = Boolean(options && options.carouselFreeScroll);
      var hideScrollbars = Boolean(options && options.hideScrollbars);
      root.dataset.sidebarInvert = sidebarInvert ? '1' : '0';
      root.dataset.squareCorners = squareCorners ? '1' : '0';
      root.dataset.bgMotion = bgMotion ? '1' : '0';
      root.dataset.carouselFreeScroll = carouselFreeScroll ? '1' : '0';
      root.dataset.hideScrollbars = hideScrollbars ? '1' : '0';
      safeStorage.set(themeOptionStorageKeys.sidebarInvert, sidebarInvert ? '1' : '0');
      safeStorage.set(themeOptionStorageKeys.squareCorners, squareCorners ? '1' : '0');
      safeStorage.set(themeOptionStorageKeys.bgMotion, bgMotion ? '1' : '0');
      safeStorage.set(themeOptionStorageKeys.carouselFreeScroll, carouselFreeScroll ? '1' : '0');
      safeStorage.set(themeOptionStorageKeys.hideScrollbars, hideScrollbars ? '1' : '0');
      if (themeSidebarInvertToggle) themeSidebarInvertToggle.checked = sidebarInvert;
      if (themeSquareCornersToggle) themeSquareCornersToggle.checked = squareCorners;
      if (themeBgMotionToggle) themeBgMotionToggle.checked = bgMotion;
      if (themeCarouselFreeScrollToggle) themeCarouselFreeScrollToggle.checked = carouselFreeScroll;
      if (themeHideScrollbarsToggle) themeHideScrollbarsToggle.checked = hideScrollbars;
      syncThemeDefaultForm();
    };
    var syncThemeOptionsFromInputs = function() {
      applyThemeOptions({
        sidebarInvert: Boolean(themeSidebarInvertToggle && themeSidebarInvertToggle.checked),
        squareCorners: Boolean(themeSquareCornersToggle && themeSquareCornersToggle.checked),
        bgMotion: Boolean(themeBgMotionToggle && themeBgMotionToggle.checked),
        carouselFreeScroll: Boolean(themeCarouselFreeScrollToggle && themeCarouselFreeScrollToggle.checked),
        hideScrollbars: Boolean(themeHideScrollbarsToggle && themeHideScrollbarsToggle.checked),
      });
    };
    var parseHexColor = function(value) {
      var raw = String(value || '').trim();
      var normalized = raw.startsWith('#') ? raw : ('#' + raw);
      return /^#[0-9a-fA-F]{6}$/.test(normalized) ? normalized.toLowerCase() : '#8b5cf6';
    };
    var hexToRgb = function(hex) {
      return {
        r: Number.parseInt(hex.slice(1, 3), 16),
        g: Number.parseInt(hex.slice(3, 5), 16),
        b: Number.parseInt(hex.slice(5, 7), 16),
      };
    };
    var rgbToHex = function(r, g, b) {
      return '#' + [r, g, b].map(function(value) {
        return Math.max(0, Math.min(255, Math.round(value))).toString(16).padStart(2, '0');
      }).join('');
    };
    var mixRgb = function(base, target, amount) {
      return {
        r: base.r + (target.r - base.r) * amount,
        g: base.g + (target.g - base.g) * amount,
        b: base.b + (target.b - base.b) * amount,
      };
    };
    var clearCustomThemeVars = function() {
      ['--teal', '--teal-dark', '--brand-rgb', '--brand-btn-start', '--brand-btn-mid', '--brand-btn-end', '--brand-btn-shadow', '--on-brand', '--on-brand-muted', '--on-brand-icon-filter'].forEach(function(name) {
        root.style.removeProperty(name);
      });
    };
    var applyCustomColor = function(inputHex) {
      var hex = parseHexColor(inputHex);
      var base = hexToRgb(hex);
      var dark = mixRgb(base, { r: 0, g: 0, b: 0 }, 0.4);
      var start = mixRgb(base, { r: 255, g: 255, b: 255 }, 0.35);
      var end = mixRgb(base, { r: 0, g: 0, b: 0 }, 0.2);
      var shadow = mixRgb(base, { r: 0, g: 0, b: 0 }, 0.28);
      var toLinear = function(channel) {
        var value = channel / 255;
        return value <= 0.03928 ? value / 12.92 : Math.pow((value + 0.055) / 1.055, 2.4);
      };
      var luminance = 0.2126 * toLinear(base.r) + 0.7152 * toLinear(base.g) + 0.0722 * toLinear(base.b);
      var contrastWhite = 1.05 / (luminance + 0.05);
      var contrastBlack = (luminance + 0.05) / 0.05;
      var onBrand = contrastWhite >= contrastBlack ? '#ffffff' : '#081013';
      var onBrandMuted = contrastWhite >= contrastBlack ? 'rgba(255,255,255,.78)' : 'rgba(8,16,19,.72)';
      var onBrandIconFilter = contrastWhite >= contrastBlack ? 'brightness(0) saturate(100%) invert(1)' : 'brightness(0) saturate(100%)';
      root.style.setProperty('--teal', hex);
      root.style.setProperty('--teal-dark', rgbToHex(dark.r, dark.g, dark.b));
      root.style.setProperty('--brand-rgb', Math.round(base.r) + ',' + Math.round(base.g) + ',' + Math.round(base.b));
      root.style.setProperty('--brand-btn-start', rgbToHex(start.r, start.g, start.b));
      root.style.setProperty('--brand-btn-mid', hex);
      root.style.setProperty('--brand-btn-end', rgbToHex(end.r, end.g, end.b));
      root.style.setProperty('--brand-btn-shadow', Math.round(shadow.r) + ',' + Math.round(shadow.g) + ',' + Math.round(shadow.b));
      root.style.setProperty('--on-brand', onBrand);
      root.style.setProperty('--on-brand-muted', onBrandMuted);
      root.style.setProperty('--on-brand-icon-filter', onBrandIconFilter);
      if (customThemeChip) customThemeChip.style.setProperty('--theme-color', hex);
      return hex;
    };
    var applyBrandTheme = function(theme) {
      var normalized = allowedBrandThemes.has(theme) ? theme : 'curatorr';
      root.dataset.brandTheme = normalized;
      safeStorage.set('curatorr-brand-theme', normalized);
      if (normalized === 'custom') {
        var savedCustomHex = parseHexColor(safeStorage.get(customColorStorageKey) || serverThemeDefaults.customColor || '#8b5cf6');
        var appliedHex = applyCustomColor(savedCustomHex);
        if (customThemeColorInput) customThemeColorInput.value = appliedHex;
      } else {
        clearCustomThemeVars();
      }
      themePresetButtons.forEach(function(btn) {
        var isActive = btn.dataset.brandTheme === normalized;
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
      syncThemeDefaultForm();
    };
    function syncThemeDefaultForm() {
      if (!themeDefaultForm) return;
      if (themeDefaultModeInput) {
        themeDefaultModeInput.value = root.dataset.theme === 'day' ? 'day' : 'night';
      }
      if (themeDefaultBrandThemeInput) {
        themeDefaultBrandThemeInput.value = resolveBrandTheme(root.dataset.brandTheme || serverThemeDefaults.brandTheme);
      }
      if (themeDefaultCustomColorInput) {
        themeDefaultCustomColorInput.value = parseHexColor(safeStorage.get(customColorStorageKey) || serverThemeDefaults.customColor || '#8b5cf6');
      }
      if (themeDefaultSidebarInvertInput) {
        themeDefaultSidebarInvertInput.value = themeSidebarInvertToggle && themeSidebarInvertToggle.checked ? '1' : '0';
      }
      if (themeDefaultSquareCornersInput) {
        themeDefaultSquareCornersInput.value = themeSquareCornersToggle && themeSquareCornersToggle.checked ? '1' : '0';
      }
      if (themeDefaultBgMotionInput) {
        themeDefaultBgMotionInput.value = themeBgMotionToggle && themeBgMotionToggle.checked ? '1' : '0';
      }
      if (themeDefaultCarouselFreeScrollInput) {
        themeDefaultCarouselFreeScrollInput.value = themeCarouselFreeScrollToggle && themeCarouselFreeScrollToggle.checked ? '1' : '0';
      }
      if (themeDefaultHideScrollbarsInput) {
        themeDefaultHideScrollbarsInput.value = themeHideScrollbarsToggle && themeHideScrollbarsToggle.checked ? '1' : '0';
      }
    }
    var initialThemeOptions = {
      sidebarInvert: parseStoredBool(themeOptionStorageKeys.sidebarInvert, serverThemeDefaults.sidebarInvert === true),
      squareCorners: parseStoredBool(themeOptionStorageKeys.squareCorners, serverThemeDefaults.squareCorners === true),
      bgMotion: parseStoredBool(themeOptionStorageKeys.bgMotion, serverThemeDefaults.bgMotion === undefined ? true : serverThemeDefaults.bgMotion === true),
      carouselFreeScroll: parseStoredBool(themeOptionStorageKeys.carouselFreeScroll, serverThemeDefaults.carouselFreeScroll === true),
      hideScrollbars: parseStoredBool(themeOptionStorageKeys.hideScrollbars, serverThemeDefaults.hideScrollbars === true),
    };
    applyThemeOptions(initialThemeOptions);
    themeSidebarInvertToggle && themeSidebarInvertToggle.addEventListener('change', syncThemeOptionsFromInputs);
    themeSquareCornersToggle && themeSquareCornersToggle.addEventListener('change', syncThemeOptionsFromInputs);
    themeBgMotionToggle && themeBgMotionToggle.addEventListener('change', syncThemeOptionsFromInputs);
    themeCarouselFreeScrollToggle && themeCarouselFreeScrollToggle.addEventListener('change', syncThemeOptionsFromInputs);
    themeHideScrollbarsToggle && themeHideScrollbarsToggle.addEventListener('change', syncThemeOptionsFromInputs);
    if (themePresetButtons.length) {
      var initialCustomHex = parseHexColor(safeStorage.get(customColorStorageKey) || serverThemeDefaults.customColor || '#8b5cf6');
      if (customThemeColorInput) customThemeColorInput.value = initialCustomHex;
      if (customThemeChip) customThemeChip.style.setProperty('--theme-color', initialCustomHex);
      var storedBrandTheme = safeStorage.get('curatorr-brand-theme');
      var fallbackBrandTheme = resolveBrandTheme(serverThemeDefaults.brandTheme);
      applyBrandTheme(allowedBrandThemes.has(storedBrandTheme) ? storedBrandTheme : fallbackBrandTheme);
      themePresetButtons.forEach(function(btn) {
        btn.addEventListener('click', function(event) {
          if (btn.dataset.brandTheme === 'custom' && event.target === customThemeColorInput) return;
          applyBrandTheme(btn.dataset.brandTheme);
        });
      });
      customThemeColorInput && customThemeColorInput.addEventListener('input', function() {
        var hex = parseHexColor(customThemeColorInput.value);
        safeStorage.set(customColorStorageKey, hex);
        applyBrandTheme('custom');
      });
    }
    syncThemeDefaultForm();
    themeDefaultForm && themeDefaultForm.addEventListener('submit', function() {
      syncThemeDefaultForm();
    });
  })();

  // ── Plex field visibility toggles ──────────────────────────────────────────
  (function() {
    document.querySelectorAll('[data-visibility-toggle]').forEach(function(btn) {
      var inputId = btn.dataset.visibilityToggle;
      var input = inputId ? document.getElementById(inputId) : null;
      var img = btn.querySelector('img');
      if (!input) return;
      btn.addEventListener('click', function() {
        var isHidden = input.type === 'password';
        input.type = isHidden ? 'text' : 'password';
        btn.dataset.visibilityState = isHidden ? 'visible' : 'hidden';
        btn.setAttribute('aria-label', isHidden ? 'Hide value' : 'Show value');
        if (img) img.src = isHidden ? '/icons/view.svg' : '/icons/view-off.svg';
      });
    });
  })();

  // ── Plex auto-fetch actions ─────────────────────────────────────────────────
  (function() {
    var plexButtons = Array.from(document.querySelectorAll('[data-plex-action]'));
    if (!plexButtons.length) return;
    var runPlexAction = function(button) {
      var action = String(button.dataset.plexAction || '').trim().toLowerCase();
      if (action !== 'token' && action !== 'machine') return;
      var form = button.closest('form');
      if (!form) return;
      var targetInput = form.querySelector('[data-plex-field="' + action + '"]');
      if (!targetInput) return;
      button.disabled = true;
      var endpoint = action === 'token' ? '/api/plex/token' : '/api/plex/machine';
      fetch(endpoint)
        .then(function(r) { return r.json().then(function(d) { return { ok: r.ok, data: d }; }); })
        .then(function(res) {
          if (action === 'token') {
            if (!res.ok || res.data.error) throw new Error(res.data.error || 'Failed to fetch Plex token.');
            targetInput.value = String(res.data.token || '').trim();
          } else {
            if (!res.ok) throw new Error(res.data.error || 'Failed to fetch Plex machine.');
            targetInput.value = res.data.machineId || '';
          }
        })
        .catch(function(err) { console.error('[Curatorr] Plex ' + action + ' fetch failed', err); })
        .finally(function() { button.disabled = false; });
    };
    plexButtons.forEach(function(btn) {
      btn.addEventListener('click', function() { runPlexAction(btn); });
    });
  })();

  // ── Plex webhook registration ────────────────────────────────────────────
  (function() {
    var btn = document.getElementById('plex-register-webhook-btn');
    var status = document.getElementById('plex-webhook-status');
    if (!btn || !status) return;
    var _csrf = '<%= csrfToken %>';
    btn.addEventListener('click', function() {
      btn.disabled = true;
      status.textContent = 'Registering…';
      fetch('/api/wizard/configure-plex-webhook', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': _csrf },
      })
        .then(function(r) { return r.json().then(function(d) { return { ok: r.ok, data: d }; }); })
        .then(function(res) {
          if (!res.ok || !res.data.ok) {
            status.textContent = res.data.error || res.data.reason || 'Registration failed.';
            status.style.color = 'var(--color-error, #f87171)';
          } else if (res.data.created === false) {
            status.textContent = 'Webhook already registered in Plex.';
            status.style.color = '';
          } else {
            status.textContent = 'Webhook registered successfully.';
            status.style.color = 'var(--color-success, #4ade80)';
          }
        })
        .catch(function() {
          status.textContent = 'Request failed — check Plex URL and token are saved.';
          status.style.color = 'var(--color-error, #f87171)';
        })
        .finally(function() { btn.disabled = false; });
    });
  })();


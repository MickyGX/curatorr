                  </label>

                </div>
              </div>
              <script>
              var SMART_PRESET_VALUES = {
                cautious:   { skipThresholdSeconds: 20, completionThresholdSeconds: 20, skipWeight: -0.5, belterWeight: 0.5,  artistSkipRank: 1, artistBelterRank: 9, songSkipLimit: 3 },
                measured:   { skipThresholdSeconds: 30, completionThresholdSeconds: 30, skipWeight: -1,   belterWeight: 1,    artistSkipRank: 2, artistBelterRank: 8, songSkipLimit: 2 },
                aggressive: { skipThresholdSeconds: 40, completionThresholdSeconds: 40, skipWeight: -1.5, belterWeight: 1.5,  artistSkipRank: 3, artistBelterRank: 7, songSkipLimit: 1 },
              };

              function applyPresetDefaults(preset) {
                var p = SMART_PRESET_VALUES[preset];
                if (!p) return;
                var fields = ['skipThresholdSeconds','completionThresholdSeconds','skipWeight','belterWeight','artistSkipRank','artistBelterRank'];
                fields.forEach(function(f) {
                  var el = document.querySelector('[name=' + f + ']');
                  if (el) { el.value = p[f]; el.dispatchEvent(new Event('input')); }
                });
                // Also update songSkipLimit select
                var sl = document.querySelector('[name=songSkipLimit]');
                if (sl) sl.value = String(p.songSkipLimit);
              }

              (function(){
                function updateDerived() {
                  var sw = parseFloat(document.querySelector('[name=skipWeight]').value) || -1;
                  var bw = parseFloat(document.querySelector('[name=belterWeight]').value) || 1;
                  var hd = document.getElementById('cur-hd-weight');
                  var dc = document.getElementById('cur-decent-weight');
                  if (hd) hd.textContent = +(sw / 2).toFixed(2);
                  if (dc) dc.textContent = +(bw / 2).toFixed(2);
                }
                ['skipWeight','belterWeight'].forEach(function(f) {
                  var el = document.querySelector('[name='+f+']');
                  if (el) el.addEventListener('input', updateDerived);
                });
              })();
              </script>
              <div class="settings-card-actions settings-card-actions--full">
                <button class="primary-button" type="submit">Save Curatorr rules</button>
              </div>
            </form>

            <%# ── Crescive / Curative playlist settings ──────────────────── %>
            <% if (actualRole === 'admin') { %>
            <form method="post" action="/settings/smart-playlist-types" class="settings-form settings-playlist-types-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <%
                const _dm = config.smartPlaylist?.dailyMix || {};
                const _ct = config.smartPlaylist?.curatorr || {};
                const _cr = config.smartPlaylist?.crescive || {};
                const _cu = config.smartPlaylist?.curative || {};
                function _capPct(val, def) { return Math.round(((val ?? def ?? 1.0) * 100)); }

                const _TF_FIELDS = [
                  { value: 'albumName',  label: 'Album name' },
                  { value: 'trackTitle', label: 'Track title' },
                  { value: 'artistName', label: 'Artist name' },
                  { value: 'trackYear', label: 'Track year' },
                  { value: 'originalReleaseDate', label: 'Original release date' },
                  { value: 'bpm', label: 'BPM' },
                  { value: 'musicalKey', label: 'Musical key' },
                  { value: 'camelotKey', label: 'Camelot key' },
                  { value: 'energy', label: 'Energy' },
                  { value: 'danceability', label: 'Danceability' },
                ];
                const _TF_FIELDS_GP = [
                  ..._TF_FIELDS,
                  { value: 'filePath', label: 'File path (folder)' },
                ];
                const _TF_TEXT_OPS = [
                  { value: 'contains',        label: 'contains' },
                  { value: 'not_contains',    label: 'does not contain' },
                  { value: 'equals',          label: 'is' },
                  { value: 'not_equals',      label: 'is not' },
                  { value: 'starts_with',     label: 'starts with' },
                  { value: 'not_starts_with', label: 'does not start with' },
                  { value: 'ends_with',       label: 'ends with' },
                  { value: 'not_ends_with',   label: 'does not end with' },
                  { value: 'regex',           label: 'matches regex' },
                  { value: 'not_regex',       label: 'does not match regex' },
                ];
                const _TF_TYPED_OPS = [
                  { value: 'equals', label: 'is' },
                  { value: 'not_equals', label: 'is not' },
                  { value: 'gt', label: 'is greater than' },
                  { value: 'gte', label: 'is at least' },
                  { value: 'lt', label: 'is less than' },
                  { value: 'lte', label: 'is at most' },
                  { value: 'between', label: 'is between' },
                ];
                function _tfOpsForField(field) {
                  return ['trackYear', 'originalReleaseDate', 'bpm', 'energy', 'danceability'].includes(field) ? _TF_TYPED_OPS : _TF_TEXT_OPS;
                }

                function _tfFieldOpts(current, fields) {
                  return (fields || _TF_FIELDS).map(f => `<option value="${f.value}"${current === f.value ? ' selected' : ''}>${f.label}</option>`).join('');
                }
                function _tfOpOpts(current, field) {
                  return _tfOpsForField(field).map(o => `<option value="${o.value}"${current === o.value ? ' selected' : ''}>${o.label}</option>`).join('');
                }
                function _tfValInput(rule, prefix, segments) {
                  if (rule.field === 'filePath' && segments && segments.length) {
                    const opts = segments.map(s => `<option value="${s}"${rule.value === s ? ' selected' : ''}>${s}</option>`).join('');
                    return `<select name="${prefix}_rule_val" class="tf-select tf-val-select"><option value="">— select folder —</option>${opts}</select>`;
                  }
                  const placeholder = rule.field === 'trackYear'
                    ? (rule.operator === 'between' ? '1990..1999' : '1998')
                    : (rule.field === 'originalReleaseDate'
                      ? (rule.operator === 'between' ? '1998-01-01..1998-12-31' : '1998-04-20')
                      : (rule.field === 'bpm'
                        ? (rule.operator === 'between' ? '118..124' : '122')
                        : (rule.field === 'energy' || rule.field === 'danceability'
                          ? (rule.operator === 'between' ? '0.4..0.8' : '0.65')
                          : (rule.field === 'camelotKey'
                            ? '8A'
                            : (rule.field === 'musicalKey' ? 'G minor' : 'value'))))
                      );
                  return `<input type="text" name="${prefix}_rule_val" value="${(rule.value||'').replace(/"/g,'&quot;')}" class="tf-val" placeholder="${placeholder}" />`;
                }
                function _renderTrackFilters(prefix, filterCfg, libs, segments) {
                  const rules = Array.isArray(filterCfg?.rules) ? filterCfg.rules : [];
                  const exclude = Array.isArray(filterCfg?.excludeLibraryKeys) ? filterCfg.excludeLibraryKeys : [];
                  const dedupe = Boolean(filterCfg?.deduplicateByMbid);
                  const hasRules = rules.length > 0 || exclude.some(k => k);
                  let html = `<details class="tf-details"${hasRules ? ' open' : ''}><summary class="tf-summary">Exclusion Filters<span class="tf-rule-count">${rules.length ? ` (${rules.length} rule${rules.length > 1 ? 's' : ''})` : ''}</span></summary><div class="tf-body">`;
                  // Rule rows
                  html += `<div class="tf-rules-list" id="tf-list-${prefix}">`;
                  for (const rule of rules) {
                    html += `<div class="tf-rule-row">`;
                    html += `<select name="${prefix}_rule_field" class="tf-select" onchange="tfUpdateVal(this,'${prefix}',${JSON.stringify(segments||[])})">` + _tfFieldOpts(rule.field) + `</select>`;
                    html += `<select name="${prefix}_rule_op" class="tf-select" onchange="tfUpdateOp(this,'${prefix}')">` + _tfOpOpts(rule.operator, rule.field) + `</select>`;
                    html += _tfValInput(rule, prefix, rule.field === 'filePath' ? segments : []);
                    html += `<label class="tf-cs-label"><input type="checkbox" name="${prefix}_rule_cs" value="on"${rule.caseSensitive ? ' checked' : ''} /><span>Aa</span></label>`;
                    html += `<button type="button" class="tf-remove-btn" onclick="this.closest('.tf-rule-row').remove()">×</button>`;
                    html += `</div>`;
                  }
                  html += `</div>`;
                  html += `<button type="button" class="btn btn-sm btn-ghost" style="margin-top:6px" onclick="tfAddRule('${prefix}',${JSON.stringify(segments||[])})">+ Add Rule</button>`;
                  // Library exclusions
                  if (libs && libs.length) {
                    html += `<div style="margin-top:12px"><div class="settings-field-label" style="margin-bottom:6px">Exclude Libraries</div><div class="settings-checklist" style="display:flex;flex-direction:column;gap:6px">`;
                    for (const lib of libs) {
                      const chk = exclude.includes(lib.key) ? ' checked' : '';
                      html += `<label class="settings-toggle"><input type="checkbox" name="${prefix}_excludeLibraryKeys" value="${lib.key}"${chk} /><span class="settings-toggle-slider" aria-hidden="true"></span><span class="settings-toggle-text">${lib.title}</span></label>`;
                    }
                    html += `</div></div>`;
                  }
                  // MBID dedup
                  html += `<div style="margin-top:10px"><label class="settings-toggle"><input type="checkbox" name="${prefix}_deduplicateByMbid" value="on"${dedupe ? ' checked' : ''} /><span class="settings-toggle-slider" aria-hidden="true"></span><span class="settings-toggle-text">Deduplicate by MusicBrainz recording ID</span></label></div>`;
                  html += `</div></details>`;
                  return html;
                }
              %>

              <%# How it works %>
              <div class="settings-card">
                <div class="settings-card-title">How Smart Playlists Work</div>
                <div class="settings-card-sub">
                  Each artist has a <strong>score out of 10</strong> that rises when you complete a track and falls on skips.
                  That score is used directly as the percentage of their tracks included — a score of 9.5 means 95% of their songs appear in your playlist.
                  The <strong>size cap</strong> below scales this further: 50% halves every artist's share across the board.
                  Within each artist, tracks are ordered by Curatorr tier (Belter &gt; Decent &gt; Half-Decent) then by Plex play count,
                  so your most-loved songs are always favoured.
                  Tracks marked <em>Excluded from Smart</em> are always skipped; tracks marked <em>Manual Include</em> are always added regardless of score.
                  Additions and subtractions happen automatically on every sync as scores change — no manual rules needed.
                </div>
              </div>


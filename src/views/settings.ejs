                  <label class="field"><span>Max tracks</span><input type="number" name="dm_maxTracks" value="<%= Number(_dm.maxTracks ?? 24) %>" min="1" max="200" /></label>
                  <label class="field"><span>Max tracks per artist</span><input type="number" name="dm_maxTracksPerArtist" value="<%= Number(_dm.maxTracksPerArtist ?? 1) %>" min="1" max="5" /></label>

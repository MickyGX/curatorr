                    <button class="ghost-button" type="button" data-plex-action="token">Get Plex Token</button>
                    <button class="ghost-button" type="button" data-plex-action="machine">Get Plex Machine</button>
                  </div>
                </div>
                <% if (canViewServiceSecrets && webhookUrls?.plex) { %>
                  <div class="plex-settings-note">Curatorr can register the Plex account webhook automatically and will also enable Plex server webhooks. Current target: <code class="settings-inline-code"><%= webhookUrls.plex %></code>.</div>

          <div class="dash-panel">
            <div class="settings-card">
              <div class="settings-card-title">Getting Support</div>
              <div class="settings-about-link-grid">
                <div class="settings-about-link-row">
                  <span>Documentation</span>
                  <a href="https://github.com/MickyGX/curatorr/wiki" target="_blank" rel="noreferrer noopener">https://github.com/MickyGX/curatorr/wiki</a>
                </div>
                <div class="settings-about-link-row">
                  <span>Discussions</span>
                  <a href="https://github.com/MickyGX/curatorr/discussions" target="_blank" rel="noreferrer noopener">https://github.com/MickyGX/curatorr/discussions</a>
                </div>
                <div class="settings-about-link-row">
                  <span>Discord</span>
                  <a href="https://discord.gg/TvrxJWD4PK" target="_blank" rel="noreferrer noopener">https://discord.gg/TvrxJWD4PK</a>
                </div>
              </div>
            </div>
          </div>

          <div class="dash-panel">
            <div class="settings-card">
              <div class="settings-card-title">Support Curatorr</div>
              <div class="settings-about-link-grid">
                <div class="settings-about-link-row">
                  <span>Buy Me a Coffee</span>
                  <a href="https://buymeacoffee.com/mickygx" target="_blank" rel="noreferrer noopener">https://buymeacoffee.com/mickygx</a>
                </div>
              </div>
            </div>
          </div>

          <div class="dash-panel">
            <div class="settings-card">
              <div class="settings-card-title">Releases</div>
              <div class="settings-card-sub">Click a release to view a short changelog summary.</div>
              <% const aboutReleaseEntries = Array.isArray(aboutReleases) ? aboutReleases : []; %>
              <div class="settings-release-list" id="settingsReleaseList">
                <% if (aboutReleaseEntries.length) { %>
                  <% aboutReleaseEntries.forEach((release, index) => { %>
                    <div class="settings-release-row">
                      <div class="settings-release-copy">
                        <div class="settings-release-head">
                          <span class="settings-release-age" data-release-published-at="<%= release.publishedAt || '' %>">Recently</span>
                          <strong class="settings-release-title">Release <%= release.tag %></strong>
                          <% if (release.isLatest) { %>
                            <span class="settings-about-pill settings-about-pill--ok">Latest</span>
                          <% } %>
                          <% if (release.isCurrent) { %>
                            <span class="settings-about-pill">Current</span>
                          <% } %>
                        </div>
                        <div class="settings-release-summary"><%= release.summary || 'Release notes are available.' %></div>
                      </div>
                      <button class="primary-button settings-release-open" type="button" data-release-index="<%= index %>">View Changelog</button>
                    </div>
                  <% }) %>
                <% } else { %>
                  <div class="settings-release-empty">No release notes were found in <code>docs/release/releases</code>.</div>
                <% } %>
              </div>
            </div>
          </div>

          <div id="settingsReleaseModalBackdrop" class="plex-modal-backdrop plex-hidden">
            <div class="plex-modal settings-release-modal" role="dialog" aria-modal="true" aria-labelledby="settingsReleaseModalTitle">
              <button class="plex-modal-close" type="button" aria-label="Close">✕</button>
              <div class="plex-modal-header">
                <div class="plex-modal-title" id="settingsReleaseModalTitle">Release Notes</div>
                <div class="plex-modal-subtitle" id="settingsReleaseModalSubtitle">Changelog summary</div>
              </div>
              <div class="plex-modal-body settings-release-modal-body">
                <div class="plex-modal-scroll settings-release-modal-scroll">

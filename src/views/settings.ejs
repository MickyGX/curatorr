    var themeDefaultModeInput = document.getElementById('themeDefaultMode');
    var themeDefaultBrandThemeInput = document.getElementById('themeDefaultBrandTheme');
    var themeDefaultCustomColorInput = document.getElementById('themeDefaultCustomColor');
    var themeDefaultSidebarInvertInput = document.getElementById('themeDefaultSidebarInvert');
    var themeDefaultSquareCornersInput = document.getElementById('themeDefaultSquareCorners');
    var themeDefaultBgMotionInput = document.getElementById('themeDefaultBgMotion');
    var themeDefaultCarouselFreeScrollInput = document.getElementById('themeDefaultCarouselFreeScroll');
    var themeDefaultHideScrollbarsInput = document.getElementById('themeDefaultHideScrollbars');
    var allowedBrandThemes = new Set(['custom', 'curatorr', 'launcharr', 'rocketship', 'pulsarr', 'plex', 'radarr', 'sonarr', 'lidarr', 'readarr']);
    var customColorStorageKey = 'curatorr-custom-color';

                  <label class="field"><span>Sonic strategy</span><select name="dm_sonicStrategy"><option value="balanced" <%= (_dm.sonicStrategy || 'balanced') === 'balanced' ? 'selected' : '' %>>Balanced</option><option value="favor-favorites" <%= _dm.sonicStrategy === 'favor-favorites' ? 'selected' : '' %>>Favor favourites</option><option value="favor-discovery" <%= _dm.sonicStrategy === 'favor-discovery' ? 'selected' : '' %>>Favor discovery</option></select></label>
                </div>
                <div class="settings-card-sub" style="margin-top:14px">Optional loudness smoothing uses Plex loudness data to reduce abrupt jumps between adjacent tracks. It only applies after selection, and after sonic ordering when both are enabled.</div>
                <div class="settings-type-grid">

              <%
                const themeDefaultsResultMap = {
                  saved: 'Default theme saved.',
                };
                const themeDefaultsNote = themeDefaultsError
                  ? themeDefaultsError
                  : (themeDefaultsResultMap[themeDefaultsResult] || '');
              %>
              <form method="post" action="/settings/theme-defaults" class="settings-card-actions" id="themeDefaultForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="theme_mode" id="themeDefaultMode" />
                <input type="hidden" name="theme_brand_theme" id="themeDefaultBrandTheme" />
                <input type="hidden" name="theme_custom_color" id="themeDefaultCustomColor" />
                <input type="hidden" name="theme_sidebar_invert" id="themeDefaultSidebarInvert" />
                <input type="hidden" name="theme_square_corners" id="themeDefaultSquareCorners" />
                <input type="hidden" name="theme_bg_motion" id="themeDefaultBgMotion" />
                <input type="hidden" name="theme_carousel_free_scroll" id="themeDefaultCarouselFreeScroll" />
                <input type="hidden" name="theme_hide_scrollbars" id="themeDefaultHideScrollbars" />
                <button class="primary-button" type="submit">Save current theme as default</button>
              </form>
              <% if (themeDefaultsNote) { %>
                <span class="settings-users-note<%= themeDefaultsError ? ' settings-users-note--error' : '' %>"><%= themeDefaultsNote %></span>
              <% } %>

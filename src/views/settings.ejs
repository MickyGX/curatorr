      if (themeHideScrollbarsToggle) themeHideScrollbarsToggle.checked = hideScrollbars;
      syncThemeDefaultForm();
    };
    var syncThemeOptionsFromInputs = function() {
      applyThemeOptions({
        sidebarInvert: Boolean(themeSidebarInvertToggle && themeSidebarInvertToggle.checked),
        squareCorners: Boolean(themeSquareCornersToggle && themeSquareCornersToggle.checked),
        bgMotion: Boolean(themeBgMotionToggle && themeBgMotionToggle.checked),
        carouselFreeScroll: Boolean(themeCarouselFreeScrollToggle && themeCarouselFreeScrollToggle.checked),
        hideScrollbars: Boolean(themeHideScrollbarsToggle && themeHideScrollbarsToggle.checked),
      });
    };
    var parseHexColor = function(value) {
      var raw = String(value || '').trim();
      var normalized = raw.startsWith('#') ? raw : ('#' + raw);
      return /^#[0-9a-fA-F]{6}$/.test(normalized) ? normalized.toLowerCase() : '#8b5cf6';
    };
    var hexToRgb = function(hex) {
      return {
        r: Number.parseInt(hex.slice(1, 3), 16),
        g: Number.parseInt(hex.slice(3, 5), 16),

            <script>
            (function() {
              var INPUT_MAP = {
                cr: { cap: 'cr_capMultiplier', favArtist: 'cr_favArtistTrackPct', favGenreArt: 'cr_favGenreArtistPct', favGenreTrack: 'cr_favGenreTrackPct', otherArt: 'cr_otherArtistPct', otherTrack: 'cr_otherTrackPct' },
                cu: { cap: 'cu_capMultiplier', favArtist: 'cu_favArtistTrackPct', favGenreArt: 'cu_favGenreArtistPct', favGenreTrack: 'cu_favGenreTrackPct', otherArt: 'cu_otherArtistPct', otherTrack: 'cu_otherTrackPct' },
              };
              function getVal(name) { var el = document.querySelector('[name="' + name + '"]'); return el ? (parseFloat(el.value) || 0) / 100 : 1; }
              function fetchPreview(prefix) {
                var m = INPUT_MAP[prefix];
                var params = new URLSearchParams({
                  capMultiplier:    getVal(m.cap),
                  favArtistTrackPct: getVal(m.favArtist),
                  favGenreArtistPct: getVal(m.favGenreArt),
                  favGenreTrackPct:  getVal(m.favGenreTrack),
                  otherArtistPct:    getVal(m.otherArt),
                  otherTrackPct:     getVal(m.otherTrack),
                });
                fetch('/api/playlists/smart/preview?' + params)
                  .then(function(r) { return r.json(); })
                  .then(function(data) {
                    if (!data.ok) return;
                    document.getElementById(prefix + '-prev-artists').textContent = data.artistCount;
                    document.getElementById(prefix + '-prev-tracks').textContent = data.trackCount;
                  }).catch(function() {});
              }
              ['cr', 'cu'].forEach(function(prefix) {
                var slider = document.getElementById(prefix + '_capRange');
                var num    = document.getElementById(prefix + '_capNum');
                var timer  = null;
                function schedule() { clearTimeout(timer); timer = setTimeout(function() { fetchPreview(prefix); }, 400); }
                slider.addEventListener('input', function() { num.value = slider.value; schedule(); });
                num.addEventListener('input', function() {
                  var v = Math.max(0, Math.min(100, parseInt(num.value, 10) || 0));
                  slider.value = v; schedule();
                });
                // Also trigger when any of the 5 category inputs change
                var m = INPUT_MAP[prefix];
                [m.favArtist, m.favGenreArt, m.favGenreTrack, m.otherArt, m.otherTrack].forEach(function(name) {
                  var el = document.querySelector('[name="' + name + '"]');
                  if (el) el.addEventListener('input', schedule);
                });
                fetchPreview(prefix);
              });
            })();
            </script>

            <script>
            // ── Track filter helpers (crescive / curative) ────────────────────
            var _TF_FIELDS_CR_CU = [
              { value: 'albumName',  label: 'Album name' },
              { value: 'trackTitle', label: 'Track title' },
              { value: 'artistName', label: 'Artist name' },
              { value: 'trackYear', label: 'Track year' },
              { value: 'originalReleaseDate', label: 'Original release date' },
              { value: 'bpm', label: 'BPM' },
              { value: 'musicalKey', label: 'Musical key' },
              { value: 'camelotKey', label: 'Camelot key' },
              { value: 'energy', label: 'Energy' },
              { value: 'danceability', label: 'Danceability' },
            ];
            var _TF_TEXT_OPS = [
              { value: 'contains',       label: 'contains' },
              { value: 'not_contains',   label: 'does not contain' },
              { value: 'equals',         label: 'is' },
              { value: 'not_equals',     label: 'is not' },
              { value: 'starts_with',    label: 'starts with' },
              { value: 'not_starts_with',label: 'does not start with' },
              { value: 'ends_with',      label: 'ends with' },
              { value: 'not_ends_with',  label: 'does not end with' },
              { value: 'regex',          label: 'matches regex' },
              { value: 'not_regex',      label: 'does not match regex' },
            ];
            var _TF_TYPED_OPS = [
              { value: 'equals', label: 'is' },
              { value: 'not_equals', label: 'is not' },
              { value: 'gt', label: 'is greater than' },
              { value: 'gte', label: 'is at least' },
              { value: 'lt', label: 'is less than' },
              { value: 'lte', label: 'is at most' },
              { value: 'between', label: 'is between' },
            ];
            var _TF_PATH_SEGMENTS = <%- JSON.stringify(allPathSegments || []) %>;
            function tfOpsForField(field) {
              return ['trackYear', 'originalReleaseDate', 'bpm', 'energy', 'danceability'].includes(field) ? _TF_TYPED_OPS : _TF_TEXT_OPS;
            }

            function tfMakeFieldOpts(fields, current) {
              return fields.map(function(f) {
                return '<option value="' + f.value + '"' + (f.value === current ? ' selected' : '') + '>' + f.label + '</option>';
              }).join('');
            }
            function tfMakeOpOpts(current, field) {
              return tfOpsForField(field).map(function(o) {
                return '<option value="' + o.value + '"' + (o.value === current ? ' selected' : '') + '>' + o.label + '</option>';
              }).join('');
            }
            function tfMakeValInput(prefix, field, value, segments, operator) {
              if (field === 'filePath' && segments && segments.length) {
                var opts = '<option value="">— select folder —</option>' + segments.map(function(s) {
                  return '<option value="' + s + '"' + (s === value ? ' selected' : '') + '>' + s + '</option>';
                }).join('');
                return '<select name="' + prefix + '_rule_val" class="tf-select tf-val-select">' + opts + '</select>';
              }
              var placeholder = field === 'trackYear'
                ? (operator === 'between' ? '1990..1999' : '1998')
                : (field === 'originalReleaseDate'
                  ? (operator === 'between' ? '1998-01-01..1998-12-31' : '1998-04-20')
                  : (field === 'bpm'
                    ? (operator === 'between' ? '118..124' : '122')
                    : (field === 'energy' || field === 'danceability'
                      ? (operator === 'between' ? '0.4..0.8' : '0.65')
                      : (field === 'camelotKey'
                        ? '8A'
                        : (field === 'musicalKey' ? 'G minor' : 'value')))));
              return '<input type="text" name="' + prefix + '_rule_val" value="' + (value || '').replace(/"/g, '&quot;') + '" class="tf-val" placeholder="' + placeholder + '" />';
            }
            function tfAddRule(prefix, segments) {
              var fields = _TF_FIELDS_CR_CU;
              var row = document.createElement('div');
              row.className = 'tf-rule-row';
              var defaultField = fields[0].value;
              row.innerHTML =
                '<select name="' + prefix + '_rule_field" class="tf-select" onchange="tfUpdateVal(this,\'' + prefix + '\')">' + tfMakeFieldOpts(fields, defaultField) + '</select>' +
                '<select name="' + prefix + '_rule_op" class="tf-select" onchange="tfUpdateOp(this,\'' + prefix + '\')">' + tfMakeOpOpts('contains', defaultField) + '</select>' +
                tfMakeValInput(prefix, defaultField, '', segments, 'contains') +
                '<label class="tf-cs-label"><input type="checkbox" name="' + prefix + '_rule_cs" value="on" /><span>Aa</span></label>' +
                '<button type="button" class="tf-remove-btn" onclick="this.closest(\'.tf-rule-row\').remove()">×</button>';
              document.getElementById('tf-list-' + prefix).appendChild(row);
            }
            function tfUpdateVal(select, prefix) {
              var row = select.closest('.tf-rule-row');
              var field = select.value;
              var segments = field === 'filePath' ? _TF_PATH_SEGMENTS : [];
              var opSelect = row.querySelector('[name="' + prefix + '_rule_op"]');
              var currentOp = opSelect ? opSelect.value : '';
              var allowedOps = tfOpsForField(field).map(function(op) { return op.value; });
              var nextOp = allowedOps.includes(currentOp) ? currentOp : allowedOps[0];
              if (opSelect) opSelect.innerHTML = tfMakeOpOpts(nextOp, field);
              var old = row.querySelector('[name="' + prefix + '_rule_val"]');
              if (old) {
                var newEl = document.createElement('div');
                newEl.innerHTML = tfMakeValInput(prefix, field, '', segments, nextOp);
                old.replaceWith(newEl.firstChild);
              }
            }
            function tfUpdateOp(select, prefix) {
              var row = select.closest('.tf-rule-row');
              var fieldEl = row.querySelector('[name="' + prefix + '_rule_field"]');
              var field = fieldEl ? fieldEl.value : '';
              var old = row.querySelector('[name="' + prefix + '_rule_val"]');
              if (old && ['trackYear', 'originalReleaseDate', 'bpm', 'energy', 'danceability', 'musicalKey', 'camelotKey'].includes(field)) {
                var newEl = document.createElement('div');
                newEl.innerHTML = tfMakeValInput(prefix, field, '', [], select.value);
                old.replaceWith(newEl.firstChild);
              }
            }
            </script>


<%- include('partials/head', { pageTitle: title || 'My Settings — Curatorr', extraCss: extraCss || ['/styles-layout.css', '/styles-settings.css'] }) %>
<body class="dash-body">
  <div class="dash-frame<%= sidebarCollapsed ? ' sidebar-collapsed' : '' %>">
    <aside class="dash-sidebar">
      <div class="dash-brand">
        <span class="dash-logo">
          <img class="nav-icon app-icon" src="/icons/curatorr-icon.svg" alt="Curatorr" onerror="this.style.display='none'" />
        </span>
        <div><div class="dash-title">Curatorr</div></div>
      </div>

      <div class="dash-nav">
        <%- include('partials/nav-categories', { navActivePage: '', role: role }) %>
      </div>

      <%- include('partials/user-menu') %>
    </aside>

    <section class="dash-main">
      <div class="main-window-bar">
        <button class="sidebar-toggle main-toggle left-toggle" type="button" aria-label="Toggle sidebar">
          <img class="toggle-icon" src="/icons/sidebar-toggle.svg" alt="" />
        </button>
        <div class="main-window-title">
          <img class="main-window-icon" src="/icons/user-profile.svg" alt="" />
          <span class="main-window-app">User Profile</span>
        </div>
        <div class="main-window-spacer"></div>
        <div class="main-window-status">
          <span class="status-dot"></span>
        </div>
      </div>

      <div class="dash-panel">
        <div class="panel-header">
          <h2>User Profile</h2>
          <span class="panel-sub">Profile settings</span>
        </div>

        <%
          const isLocalUser = String(user?.source || '').toLowerCase() === 'local';
          const profileRole = isLocalUser ? (user?.role || actualRole || role) : (role || 'user');
          const profileAvatarFallback = user?.avatarFallback || '/icons/user-profile.svg';
          const profileAvatarSrc = user?.avatar || profileAvatarFallback;
          const successMap = {
            'password-changed': 'Password changed successfully.',
            'avatar-updated': 'Avatar updated.',
            'theme-updated': 'Theme saved.',
            'filters-updated': 'Artist filters updated.',
            'preset-updated': 'Curation style saved.',
            'lastfm-updated': 'Last.fm username saved.',
            'listenbrainz-updated': 'ListenBrainz settings saved.',
            'backfill-reset': 'Backfill reset — trigger Last.fm History Backfill in Jobs to restart.',
          };
          const profileNote = error
            ? error
            : (successMap[success] || (isLocalUser
              ? 'Update your Curatorr account details.'
              : 'This profile is managed by your ' + (String(user?.source || 'plex').charAt(0).toUpperCase() + String(user?.source || 'plex').slice(1)) + ' account.'));
        %>

        <div class="settings-form">
          <div class="settings-card">
            <div class="settings-profile-head">
              <div class="settings-profile-head-copy">
                <div class="settings-card-title">Profile</div>
                <% var _srcLabel = isLocalUser ? 'Curatorr' : (String(user?.source || 'plex').charAt(0).toUpperCase() + String(user?.source || 'plex').slice(1)); %>
                <div class="settings-card-sub"><%= _srcLabel %> account details</div>
              </div>
              <strong class="settings-role-pill settings-role-pill--profile">
                <img class="settings-role-pill-icon" src="/icons/role.svg" alt="" />
                <%= profileRole %>
              </strong>
            </div>

            <div class="settings-profile-avatar">
              <img
                class="settings-profile-avatar-image"
                id="profileAvatarPreview"
                src="<%= profileAvatarSrc %>"
                alt="Current avatar"
                onerror="this.onerror=null;this.src='<%= profileAvatarFallback %>';"
              />
              <div class="settings-profile-avatar-meta">
                <strong class="settings-profile-avatar-label">Current avatar</strong>
                <span class="settings-profile-avatar-help">PNG, JPG, or WEBP up to 2 MB.</span>
              </div>
            </div>

            <span class="settings-users-note<%= error ? ' settings-users-note--error' : '' %>"><%= profileNote %></span>

            <div class="settings-card-lines">
              <div class="settings-card-line">
                <span>Username</span>
                <strong><%= user?.username || '' %></strong>
              </div>
              <% if (user?.email) { %>
                <div class="settings-card-line">
                  <span>Email</span>
                  <strong><%= user.email %></strong>
                </div>
              <% } %>
              <div class="settings-card-line">
                <span>Account source</span>
                <strong><%= isLocalUser ? 'Curatorr local' : _srcLabel %></strong>
              </div>
            </div>

            <form method="post" action="/user-settings/avatar" class="settings-form" id="avatarForm">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="avatarData" id="avatarData" />
              <label class="field">
                <span>Avatar image (optional)</span>
                <input class="settings-icon-file" type="file" id="avatarFile" accept="image/png,image/jpeg,image/webp" />
              </label>
              <span class="settings-users-note settings-users-note--error" id="avatarUploadError" hidden></span>
              <button class="primary-button" type="submit" id="avatarSaveBtn" hidden>Save avatar</button>
            </form>
          </div>

          <% if (isLocalUser) { %>
            <div class="settings-card">
              <div class="settings-card-title">Password</div>
              <div class="settings-card-sub">Change your Curatorr local account password.</div>
              <form method="post" action="/user-settings/password" class="settings-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label class="field">
                  <span>Current password</span>
                  <input type="password" name="currentPassword" required autocomplete="current-password" />
                </label>
                <label class="field">
                  <span>New password</span>
                  <input type="password" name="newPassword" required autocomplete="new-password" />
                </label>
                <label class="field">
                  <span>Confirm new password</span>
                  <input type="password" name="confirmPassword" required autocomplete="new-password" />
                </label>
                <button class="primary-button" type="submit">Save new password</button>
              </form>
            </div>
          <% } %>

          <%
            const themeResultMap = {
              'theme-updated': 'Theme preference saved.',
            };
            const themeNote = success === 'theme-updated' ? themeResultMap[success] : '';
          %>
          <div class="settings-card settings-card--themes">
            <div class="settings-card-title">Theme</div>
            <div class="settings-card-sub">Customize your personal Curatorr appearance.</div>
            <div class="theme-presets" id="profileThemePresets">
              <button class="theme-preset-card" type="button" data-brand-theme="curatorr" style="--preset-color:#8b5cf6;--preset-rgb:139,92,246">
                <span class="theme-preset-chip" style="--theme-color:#8b5cf6;"></span>
                <span class="theme-preset-name">Curatorr</span>
                <span class="theme-preset-meta">Purple</span>
              </button>
              <button class="theme-preset-card" type="button" data-brand-theme="launcharr" style="--preset-color:#6d7a86;--preset-rgb:109,122,134">
                <span class="theme-preset-chip" style="--theme-color:#6d7a86;"></span>
                <span class="theme-preset-name">Launcharr</span>
                <span class="theme-preset-meta">Gunmetal</span>
              </button>
              <button class="theme-preset-card" type="button" data-brand-theme="rocketship" style="--preset-color:#b8c1ca;--preset-rgb:184,193,202">
                <span class="theme-preset-chip" style="--theme-color:#b8c1ca;"></span>
                <span class="theme-preset-name">Rocketship</span>
                <span class="theme-preset-meta">Silver</span>
              </button>
              <button class="theme-preset-card" type="button" data-brand-theme="pulsarr" style="--preset-color:#1cc6c2;--preset-rgb:28,198,194">
                <span class="theme-preset-chip" style="--theme-color:#1cc6c2;"></span>
                <span class="theme-preset-name">Pulsarr</span>
                <span class="theme-preset-meta">Pulsarr teal</span>
              </button>
              <button class="theme-preset-card" type="button" data-brand-theme="plex" style="--preset-color:#f9ad2f;--preset-rgb:249,173,47">
                <span class="theme-preset-chip" style="--theme-color:#f9ad2f;"></span>
                <span class="theme-preset-name">Plex</span>
                <span class="theme-preset-meta">Plex orange</span>
              </button>
              <button class="theme-preset-card" type="button" data-brand-theme="radarr" style="--preset-color:#f4c542;--preset-rgb:244,197,66">
                <span class="theme-preset-chip" style="--theme-color:#f4c542;"></span>
                <span class="theme-preset-name">Radarr</span>
                <span class="theme-preset-meta">Radarr yellow</span>
              </button>
              <button class="theme-preset-card" type="button" data-brand-theme="sonarr" style="--preset-color:#3d7bfd;--preset-rgb:61,123,253">
                <span class="theme-preset-chip" style="--theme-color:#3d7bfd;"></span>
                <span class="theme-preset-name">Sonarr</span>
                <span class="theme-preset-meta">Sonarr blue</span>
              </button>
              <button class="theme-preset-card" type="button" data-brand-theme="lidarr" style="--preset-color:#53b86a;--preset-rgb:83,184,106">
                <span class="theme-preset-chip" style="--theme-color:#53b86a;"></span>
                <span class="theme-preset-name">Lidarr</span>
                <span class="theme-preset-meta">Lidarr green</span>
              </button>
              <button class="theme-preset-card" type="button" data-brand-theme="readarr" style="--preset-color:#d84a4a;--preset-rgb:216,74,74">
                <span class="theme-preset-chip" style="--theme-color:#d84a4a;"></span>
                <span class="theme-preset-name">Readarr</span>
                <span class="theme-preset-meta">Readarr red</span>
              </button>
              <button class="theme-preset-card" type="button" data-brand-theme="custom" style="--preset-color:#8b5cf6;--preset-rgb:139,92,246">
                <span class="theme-preset-chip theme-preset-chip--custom" data-profile-custom-chip style="--theme-color:#8b5cf6;">
                  <input class="theme-chip-picker" id="profileCustomThemeColor" type="color" value="#8b5cf6" aria-label="Choose custom theme color" />
                </span>
                <span class="theme-preset-name">Custom</span>
                <span class="theme-preset-meta">Colour wheel</span>
              </button>
            </div>
            <div class="theme-options" id="profileThemeOptions">
              <label class="settings-toggle theme-option">
                <input id="profileThemeSidebarInvert" type="checkbox" />
                <span class="settings-toggle-slider" aria-hidden="true"></span>
                <span class="theme-option-copy">
                  <strong>Invert sidebar colours</strong>
                  <small>Swap sidebar dark/theme emphasis.</small>
                </span>
              </label>
              <label class="settings-toggle theme-option">
                <input id="profileThemeSquareCorners" type="checkbox" />
                <span class="settings-toggle-slider" aria-hidden="true"></span>
                <span class="theme-option-copy">
                  <strong>Square corners</strong>
                  <small>Remove rounded corners across the UI.</small>
                </span>
              </label>
              <label class="settings-toggle theme-option">
                <input id="profileThemeBgMotion" type="checkbox" checked />
                <span class="settings-toggle-slider" aria-hidden="true"></span>
                <span class="theme-option-copy">
                  <strong>Animated space background</strong>
                  <small>Theme-linked moving star field.</small>
                </span>
              </label>
              <label class="settings-toggle theme-option">
                <input id="profileThemeCarouselFreeScroll" type="checkbox" />
                <span class="settings-toggle-slider" aria-hidden="true"></span>
                <span class="theme-option-copy">
                  <strong>Free carousel scroll</strong>
                  <small>Disable index snapping and allow fast horizontal swipe scrolling.</small>
                </span>
              </label>
              <label class="settings-toggle theme-option">
                <input id="profileThemeHideScrollbars" type="checkbox" />
                <span class="settings-toggle-slider" aria-hidden="true"></span>
                <span class="theme-option-copy">
                  <strong>Hide scrollbars</strong>
                  <small>Hide scrollbar rails while keeping scroll behaviour.</small>
                </span>
              </label>
            </div>
            <form method="post" action="/user-settings/theme" class="settings-card-actions settings-card-actions--full" id="profileThemeSaveForm">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="theme_mode" id="profileThemeMode" />
              <input type="hidden" name="theme_brand_theme" id="profileThemeBrandTheme" />
              <input type="hidden" name="theme_custom_color" id="profileThemeCustomColor" />
              <input type="hidden" name="theme_sidebar_invert" id="profileThemeSidebarInvertValue" />
              <input type="hidden" name="theme_square_corners" id="profileThemeSquareCornersValue" />
              <input type="hidden" name="theme_bg_motion" id="profileThemeBgMotionValue" />
              <input type="hidden" name="theme_carousel_free_scroll" id="profileThemeCarouselFreeScrollValue" />
              <input type="hidden" name="theme_hide_scrollbars" id="profileThemeHideScrollbarsValue" />
              <button class="primary-button" type="submit">Save my theme</button>
            </form>
            <% if (themeNote) { %>
              <span class="settings-users-note"><%= themeNote %></span>
            <% } %>
          </div>

          <div class="settings-card">
            <form method="post" action="/user-settings/filters" class="settings-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <%
                const _filterArtists = Array.isArray(filterArtists) ? filterArtists : [];
                const _mustIncludeArtists = Array.isArray(mustIncludeArtists) ? mustIncludeArtists : [];
                const _neverIncludeArtists = Array.isArray(neverIncludeArtists) ? neverIncludeArtists : [];
                const _selectedFilterArtists = new Set([].concat(_mustIncludeArtists, _neverIncludeArtists));
              %>
              <div class="settings-filter-card-head">
                <div>
                  <div class="settings-card-title">Artist Filters</div>
                  <div class="settings-card-sub">Manage your personal always-include and never-include artists here. The wizard uses these same saved lists.</div>
                </div>
                <a class="ghost-button" href="/wizard/user">Run wizard</a>
              </div>

              <div class="settings-filter-grid" data-filter-manager>
                <section class="settings-filter-card" data-filter-group="include">
                  <div class="settings-filter-card-head">
                    <div>
                      <div class="settings-filter-title">Always include</div>
                      <div class="settings-filter-help">These artists always appear in your playlist regardless of skip count.</div>
                    </div>
                  </div>
                  <details class="settings-filter-picker">
                    <summary class="settings-filter-picker-toggle">Add artists</summary>
                    <div class="settings-filter-picker-panel">
                      <input type="search" class="settings-filter-search" placeholder="Search artists…" data-filter-search="include" />
                      <div class="settings-filter-options" data-filter-options="include">
                        <% _filterArtists.forEach(function(artist) { if (!_selectedFilterArtists.has(artist.name)) { %>
                          <label class="settings-filter-option" data-filter-option data-name="<%= artist.name.toLowerCase() %>">
                            <input type="checkbox" value="<%= artist.name %>" data-filter-option-input="include" />
                            <span class="settings-filter-thumb"><img src="<%= artist.thumb %>" alt="" loading="lazy" onerror="this.style.visibility='hidden'" /></span>
                            <span class="settings-filter-option-name"><%= artist.name %></span>
                          </label>
                        <% } }) %>
                      </div>
                      <div class="settings-filter-picker-actions">
                        <button class="ghost-button" type="button" data-filter-add="include">Add selected</button>
                      </div>
                    </div>
                  </details>

                  <div class="settings-filter-hidden" data-filter-hidden="include">
                    <% _mustIncludeArtists.forEach(function(name) { %>
                      <input type="hidden" name="mustIncludeArtists" value="<%= name %>" />
                    <% }) %>
                  </div>

                  <div class="settings-filter-table-wrap">
                    <table class="settings-filter-table">
                      <thead>
                        <tr>
                          <th class="settings-filter-check-col"><input type="checkbox" data-filter-select-all="include" /></th>
                          <th>Artist</th>
                        </tr>
                      </thead>
                      <tbody data-filter-table="include">
                        <% if (_mustIncludeArtists.length) { %>
                          <% _mustIncludeArtists.forEach(function(name) { %>
                            <tr data-filter-row data-name="<%= name %>">
                              <td class="settings-filter-check-col"><input type="checkbox" data-filter-row-check="include" value="<%= name %>" /></td>
                              <td>
                                <div class="settings-filter-row-artist">
                                  <span class="settings-filter-thumb"><img src="/api/music/thumb/artist/<%= encodeURIComponent(name) %>?v=user-settings-artist-thumb-1" alt="" loading="lazy" onerror="this.style.visibility='hidden'" /></span>
                                  <span><%= name %></span>
                                </div>
                              </td>
                            </tr>
                          <% }) %>
                        <% } else { %>
                          <tr data-filter-empty="include">
                            <td colspan="2" class="settings-filter-empty">No artists selected.</td>
                          </tr>
                        <% } %>
                      </tbody>
                    </table>
                  </div>
                  <div class="settings-filter-table-actions">
                    <button class="ghost-button" type="button" data-filter-remove="include">Remove selected</button>
                  </div>
                </section>

                <section class="settings-filter-card" data-filter-group="exclude">
                  <div class="settings-filter-card-head">
                    <div>
                      <div class="settings-filter-title">Never include</div>
                      <div class="settings-filter-help">These artists are always blocked from your playlist.</div>
                    </div>
                  </div>
                  <details class="settings-filter-picker">
                    <summary class="settings-filter-picker-toggle">Add artists</summary>
                    <div class="settings-filter-picker-panel">
                      <input type="search" class="settings-filter-search" placeholder="Search artists…" data-filter-search="exclude" />
                      <div class="settings-filter-options" data-filter-options="exclude">
                        <% _filterArtists.forEach(function(artist) { if (!_selectedFilterArtists.has(artist.name)) { %>
                          <label class="settings-filter-option" data-filter-option data-name="<%= artist.name.toLowerCase() %>">
                            <input type="checkbox" value="<%= artist.name %>" data-filter-option-input="exclude" />
                            <span class="settings-filter-thumb"><img src="<%= artist.thumb %>" alt="" loading="lazy" onerror="this.style.visibility='hidden'" /></span>
                            <span class="settings-filter-option-name"><%= artist.name %></span>
                          </label>
                        <% } }) %>
                      </div>
                      <div class="settings-filter-picker-actions">
                        <button class="ghost-button" type="button" data-filter-add="exclude">Add selected</button>
                      </div>
                    </div>
                  </details>

                  <div class="settings-filter-hidden" data-filter-hidden="exclude">
                    <% _neverIncludeArtists.forEach(function(name) { %>
                      <input type="hidden" name="neverIncludeArtists" value="<%= name %>" />
                    <% }) %>
                  </div>

                  <div class="settings-filter-table-wrap">
                    <table class="settings-filter-table">
                      <thead>
                        <tr>
                          <th class="settings-filter-check-col"><input type="checkbox" data-filter-select-all="exclude" /></th>
                          <th>Artist</th>
                        </tr>
                      </thead>
                      <tbody data-filter-table="exclude">
                        <% if (_neverIncludeArtists.length) { %>
                          <% _neverIncludeArtists.forEach(function(name) { %>
                            <tr data-filter-row data-name="<%= name %>">
                              <td class="settings-filter-check-col"><input type="checkbox" data-filter-row-check="exclude" value="<%= name %>" /></td>
                              <td>
                                <div class="settings-filter-row-artist">
                                  <span class="settings-filter-thumb"><img src="/api/music/thumb/artist/<%= encodeURIComponent(name) %>?v=user-settings-artist-thumb-1" alt="" loading="lazy" onerror="this.style.visibility='hidden'" /></span>
                                  <span><%= name %></span>
                                </div>
                              </td>
                            </tr>
                          <% }) %>
                        <% } else { %>
                          <tr data-filter-empty="exclude">
                            <td colspan="2" class="settings-filter-empty">No artists selected.</td>
                          </tr>
                        <% } %>
                      </tbody>
                    </table>
                  </div>
                  <div class="settings-filter-table-actions">
                    <button class="ghost-button" type="button" data-filter-remove="exclude">Remove selected</button>
                  </div>
                </section>
              </div>
              <button class="primary-button" type="submit">Save my filters</button>
            </form>
          </div>

          <div class="settings-card">
            <div class="settings-card-title">Curation Style</div>
            <div class="settings-card-sub">Choose how aggressively your smart playlist curates tracks based on your listening habits.</div>
            <form method="post" action="/user-settings/preset" class="settings-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <label class="field">
                <span>Playlist style</span>
                <select name="preset">
                  <option value="cautious" <%= (locals.userPreset || 'measured') === 'cautious' ? 'selected' : '' %>>Cautious — larger playlist, wide range of artists</option>
                  <option value="measured" <%= (locals.userPreset || 'measured') === 'measured' ? 'selected' : '' %>>Measured — medium playlist, good mix of artists</option>
                  <option value="aggressive" <%= (locals.userPreset || 'measured') === 'aggressive' ? 'selected' : '' %>>Aggressive — smaller playlist, I know what I like</option>
                </select>
              </label>
              <button class="primary-button" type="submit">Save my style</button>
            </form>
          </div>

          <div class="settings-card settings-integration-card settings-integration-card--lastfm">
            <div class="settings-integration-head">
              <div>
                <div class="settings-card-title">Last.fm</div>
                <div class="settings-card-sub">Connect your Last.fm account to sync your scrobble history into Curatorr. Requires Last.fm History Sync to be enabled in Jobs settings.</div>
              </div>
              <span class="settings-integration-tag">History + Stations</span>
            </div>
            <form method="post" action="/user-settings/lastfm" class="settings-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <label class="field">
                <span>Last.fm username</span>
                <input type="text" name="lastfmUsername" value="<%= lastfmUsername || '' %>" placeholder="your-lastfm-username" autocomplete="off" />
              </label>
              <% if (lastfmUsername) { %>
                <div class="settings-form" style="margin-top:0.75rem;">
                  <div class="field-group-label">Last.fm Full History Backfill</div>
                  <div class="settings-card-sub" style="margin-bottom:0.5rem;">
                    <% if (lastfmBackfillCursor === -1) { %>
                      Backfill is complete. Reset to re-run from the beginning, then run the backfill again.
                    <% } else if (lastfmBackfillCursor > 0) { %>
                      Backfill is in progress — run again to continue from where it left off.
                    <% } else { %>
                      Import your full scrobble history from Last.fm. Large histories require multiple runs.
                    <% } %>
                  </div>
                  <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
                    <button class="ghost-button" type="button" id="lastfmRunBackfillBtn">
                      <%= lastfmBackfillCursor > 0 ? 'Continue backfill' : 'Run backfill' %>
                    </button>
                    <% if (lastfmBackfillCursor === -1) { %>
                      <button
                        class="ghost-button"
                        type="submit"
                        formaction="/user-settings/lastfm/reset-backfill"
                        formmethod="post"
                      >
                        Reset backfill
                      </button>
                    <% } %>
                  </div>
                  <div id="lastfmBackfillStatus" style="margin-top:0.4rem;font-size:0.8rem;color:var(--text-muted);display:none;"></div>
                </div>
                <div class="field-group-label" style="margin-top:1rem;">Last.fm Station Playlists</div>
                <div class="settings-card-sub" style="margin-bottom:0.75rem;">Sync Last.fm's generated stations as playlists in your media server. Updated with each playlist sync.</div>
                <% [['recommended','Recommended'],['mix','Mix'],['library','Library'],['neighbours','Neighbours'],['loved','Loved']].forEach(([key, label]) => { %>
                  <div class="settings-access-row">
                    <label class="settings-toggle">
                      <input type="checkbox" name="lastfmStations" value="<%= key %>" <%= (lastfmEnabledStations || []).includes(key) ? 'checked' : '' %> />
                      <span class="settings-toggle-slider" aria-hidden="true"></span>
                      <span class="settings-toggle-text">Last.fm <%= label %></span>
                    </label>
                    <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;margin-left:auto">
                      <select class="settings-select" name="lastfmSort_<%= key %>">
                        <option value="source" <%= (lastfmStationSorts?.[key] || 'source') === 'source' ? 'selected' : '' %>>Source order</option>
                        <option value="ratingCount" <%= lastfmStationSorts?.[key] === 'ratingCount' ? 'selected' : '' %>>Global rating count</option>
                        <option value="tierWeight" <%= lastfmStationSorts?.[key] === 'tierWeight' ? 'selected' : '' %>>Tier weight</option>
                        <option value="playCount" <%= lastfmStationSorts?.[key] === 'playCount' ? 'selected' : '' %>>Play count</option>
                        <option value="bpmAsc" <%= lastfmStationSorts?.[key] === 'bpmAsc' ? 'selected' : '' %>>BPM low to high</option>
                        <option value="bpmDesc" <%= lastfmStationSorts?.[key] === 'bpmDesc' ? 'selected' : '' %>>BPM high to low</option>
                        <option value="energyAsc" <%= lastfmStationSorts?.[key] === 'energyAsc' ? 'selected' : '' %>>Energy low to high</option>
                        <option value="energyDesc" <%= lastfmStationSorts?.[key] === 'energyDesc' ? 'selected' : '' %>>Energy high to low</option>
                        <option value="danceabilityDesc" <%= lastfmStationSorts?.[key] === 'danceabilityDesc' ? 'selected' : '' %>>Danceability high to low</option>
                        <option value="camelot" <%= lastfmStationSorts?.[key] === 'camelot' ? 'selected' : '' %>>Camelot wheel</option>
                        <option value="djFlow" <%= lastfmStationSorts?.[key] === 'djFlow' ? 'selected' : '' %>>DJ flow</option>
                      </select>
                      <select class="settings-select" name="lastfmFinalOrdering_<%= key %>">
                        <option value="none" <%= (lastfmStationFinalOrderings?.[key] || 'none') === 'none' ? 'selected' : '' %>>No final ordering</option>
                        <option value="plexSonic" <%= lastfmStationFinalOrderings?.[key] === 'plexSonic' ? 'selected' : '' %>>Plex sonic</option>
                        <option value="loudness" <%= lastfmStationFinalOrderings?.[key] === 'loudness' ? 'selected' : '' %>>Loudness smoothing</option>
                        <option value="plexSonicLoudness" <%= lastfmStationFinalOrderings?.[key] === 'plexSonicLoudness' ? 'selected' : '' %>>Plex sonic then loudness</option>
                      </select>
                    </div>
                  </div>
                <% }) %>
                <% var topTracksStation = (lastfmEnabledStations || []).find(function(s) { return s.startsWith('topTracks:'); }); %>
                <% var topTracksPeriod = topTracksStation ? topTracksStation.slice('topTracks:'.length) : ''; %>
                <% var _lastfmTopTracksSortMap = {
                  overall: lastfmStationSorts?.['topTracks:overall'] || 'source',
                  '7day': lastfmStationSorts?.['topTracks:7day'] || 'source',
                  '1month': lastfmStationSorts?.['topTracks:1month'] || 'source',
                  '3month': lastfmStationSorts?.['topTracks:3month'] || 'source',
                  '6month': lastfmStationSorts?.['topTracks:6month'] || 'source',
                  '12month': lastfmStationSorts?.['topTracks:12month'] || 'source',
                }; %>
                <% var _lastfmTopTracksFinalOrderingMap = {
                  overall: lastfmStationFinalOrderings?.['topTracks:overall'] || 'none',
                  '7day': lastfmStationFinalOrderings?.['topTracks:7day'] || 'none',
                  '1month': lastfmStationFinalOrderings?.['topTracks:1month'] || 'none',
                  '3month': lastfmStationFinalOrderings?.['topTracks:3month'] || 'none',
                  '6month': lastfmStationFinalOrderings?.['topTracks:6month'] || 'none',
                  '12month': lastfmStationFinalOrderings?.['topTracks:12month'] || 'none',
                }; %>
                <div class="settings-access-row" style="flex-wrap:wrap;gap:0.5rem;">
                  <label class="settings-toggle" style="flex-shrink:0;">
                    <input type="checkbox" id="topTracksToggle" <%= topTracksPeriod ? 'checked' : '' %> />
                    <span class="settings-toggle-slider" aria-hidden="true"></span>
                    <span class="settings-toggle-text">Last.fm Top Tracks</span>
                  </label>
                  <select class="settings-select" name="lastfmTopTracks" id="topTracksPeriodSelect" style="margin-left:0.5rem;" <%= topTracksPeriod ? '' : 'disabled' %>>
                    <option value="">Disabled</option>
                    <option value="overall" <%= topTracksPeriod === 'overall' ? 'selected' : '' %>>All Time</option>
                    <option value="7day" <%= topTracksPeriod === '7day' ? 'selected' : '' %>>Last 7 Days</option>
                    <option value="1month" <%= topTracksPeriod === '1month' ? 'selected' : '' %>>Last Month</option>
                    <option value="3month" <%= topTracksPeriod === '3month' ? 'selected' : '' %>>Last 3 Months</option>
                    <option value="6month" <%= topTracksPeriod === '6month' ? 'selected' : '' %>>Last 6 Months</option>
                    <option value="12month" <%= topTracksPeriod === '12month' ? 'selected' : '' %>>Last Year</option>
                  </select>
                  <% const _topTracksSortKey = topTracksPeriod ? `topTracks:${topTracksPeriod}` : 'topTracks:overall'; %>
                  <select class="settings-select" name="lastfmTopTracksSort" id="topTracksSortSelect" data-sort-map='<%- JSON.stringify(_lastfmTopTracksSortMap) %>'>
                    <option value="source" <%= (lastfmStationSorts?.[_topTracksSortKey] || 'source') === 'source' ? 'selected' : '' %>>Source order</option>
                    <option value="ratingCount" <%= lastfmStationSorts?.[_topTracksSortKey] === 'ratingCount' ? 'selected' : '' %>>Global rating count</option>
                    <option value="tierWeight" <%= lastfmStationSorts?.[_topTracksSortKey] === 'tierWeight' ? 'selected' : '' %>>Tier weight</option>
                    <option value="playCount" <%= lastfmStationSorts?.[_topTracksSortKey] === 'playCount' ? 'selected' : '' %>>Play count</option>
                    <option value="bpmAsc" <%= lastfmStationSorts?.[_topTracksSortKey] === 'bpmAsc' ? 'selected' : '' %>>BPM low to high</option>
                    <option value="bpmDesc" <%= lastfmStationSorts?.[_topTracksSortKey] === 'bpmDesc' ? 'selected' : '' %>>BPM high to low</option>
                    <option value="energyAsc" <%= lastfmStationSorts?.[_topTracksSortKey] === 'energyAsc' ? 'selected' : '' %>>Energy low to high</option>
                    <option value="energyDesc" <%= lastfmStationSorts?.[_topTracksSortKey] === 'energyDesc' ? 'selected' : '' %>>Energy high to low</option>
                    <option value="danceabilityDesc" <%= lastfmStationSorts?.[_topTracksSortKey] === 'danceabilityDesc' ? 'selected' : '' %>>Danceability high to low</option>
                    <option value="camelot" <%= lastfmStationSorts?.[_topTracksSortKey] === 'camelot' ? 'selected' : '' %>>Camelot wheel</option>
                    <option value="djFlow" <%= lastfmStationSorts?.[_topTracksSortKey] === 'djFlow' ? 'selected' : '' %>>DJ flow</option>
                  </select>
                  <select class="settings-select" name="lastfmTopTracksFinalOrdering" id="topTracksFinalOrderingSelect" data-final-ordering-map='<%- JSON.stringify(_lastfmTopTracksFinalOrderingMap) %>'>
                    <option value="none" <%= (lastfmStationFinalOrderings?.[_topTracksSortKey] || 'none') === 'none' ? 'selected' : '' %>>No final ordering</option>
                    <option value="plexSonic" <%= lastfmStationFinalOrderings?.[_topTracksSortKey] === 'plexSonic' ? 'selected' : '' %>>Plex sonic</option>
                    <option value="loudness" <%= lastfmStationFinalOrderings?.[_topTracksSortKey] === 'loudness' ? 'selected' : '' %>>Loudness smoothing</option>
                    <option value="plexSonicLoudness" <%= lastfmStationFinalOrderings?.[_topTracksSortKey] === 'plexSonicLoudness' ? 'selected' : '' %>>Plex sonic then loudness</option>
                  </select>
                </div>
              <% } %>
              <button class="primary-button" type="submit">Save Last.fm settings</button>
            </form>
          </div>

          <div class="settings-card settings-integration-card settings-integration-card--listenbrainz">
            <div class="settings-integration-head">
              <div>
                <div class="settings-card-title">ListenBrainz</div>
                <div class="settings-card-sub">Sync ListenBrainz generated playlists into Plex. This only imports playlist suggestions for now, not historical listens.</div>
              </div>
              <span class="settings-integration-tag">Playlist Suggestions</span>
            </div>
            <form method="post" action="/user-settings/listenbrainz" class="settings-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <label class="field">
                <span>ListenBrainz username</span>
                <input type="text" name="listenbrainzUsername" value="<%= listenbrainzUsername || '' %>" placeholder="your-listenbrainz-username" autocomplete="off" />
              </label>
              <label class="field">
                <span>API token (optional)</span>
                <input type="password" name="listenbrainzToken" value="<%= listenbrainzToken || '' %>" placeholder="listenbrainz-api-token" autocomplete="off" />
              </label>
              <% [['daily-jams','Daily Jams'],['weekly-jams','Weekly Jams'],['weekly-exploration','Weekly Exploration']].forEach(([key, label]) => { %>
                <div class="settings-access-row">
                  <label class="settings-toggle">
                    <input type="checkbox" name="listenbrainzPlaylists" value="<%= key %>" <%= (listenbrainzEnabledPlaylists || []).includes(key) ? 'checked' : '' %> />
                    <span class="settings-toggle-slider" aria-hidden="true"></span>

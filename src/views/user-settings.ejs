                  <div style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;margin-left:auto">
                    <select class="settings-select" name="listenbrainzSort_<%= key %>">
                      <option value="source" <%= (listenbrainzPlaylistSorts?.[key] || 'source') === 'source' ? 'selected' : '' %>>Source order</option>
                      <option value="ratingCount" <%= listenbrainzPlaylistSorts?.[key] === 'ratingCount' ? 'selected' : '' %>>Global rating count</option>
                      <option value="tierWeight" <%= listenbrainzPlaylistSorts?.[key] === 'tierWeight' ? 'selected' : '' %>>Tier weight</option>
                      <option value="playCount" <%= listenbrainzPlaylistSorts?.[key] === 'playCount' ? 'selected' : '' %>>Play count</option>
                      <option value="bpmAsc" <%= listenbrainzPlaylistSorts?.[key] === 'bpmAsc' ? 'selected' : '' %>>BPM low to high</option>
                      <option value="bpmDesc" <%= listenbrainzPlaylistSorts?.[key] === 'bpmDesc' ? 'selected' : '' %>>BPM high to low</option>
                      <option value="energyAsc" <%= listenbrainzPlaylistSorts?.[key] === 'energyAsc' ? 'selected' : '' %>>Energy low to high</option>
                      <option value="energyDesc" <%= listenbrainzPlaylistSorts?.[key] === 'energyDesc' ? 'selected' : '' %>>Energy high to low</option>
                      <option value="danceabilityDesc" <%= listenbrainzPlaylistSorts?.[key] === 'danceabilityDesc' ? 'selected' : '' %>>Danceability high to low</option>
                      <option value="camelot" <%= listenbrainzPlaylistSorts?.[key] === 'camelot' ? 'selected' : '' %>>Camelot wheel</option>
                      <option value="djFlow" <%= listenbrainzPlaylistSorts?.[key] === 'djFlow' ? 'selected' : '' %>>DJ flow</option>
                    </select>
                    <select class="settings-select" name="listenbrainzFinalOrdering_<%= key %>">
                      <option value="none" <%= (listenbrainzPlaylistFinalOrderings?.[key] || 'none') === 'none' ? 'selected' : '' %>>No final ordering</option>
                      <option value="plexSonic" <%= listenbrainzPlaylistFinalOrderings?.[key] === 'plexSonic' ? 'selected' : '' %>>Plex sonic</option>
                      <option value="loudness" <%= listenbrainzPlaylistFinalOrderings?.[key] === 'loudness' ? 'selected' : '' %>>Loudness smoothing</option>
                      <option value="plexSonicLoudness" <%= listenbrainzPlaylistFinalOrderings?.[key] === 'plexSonicLoudness' ? 'selected' : '' %>>Plex sonic then loudness</option>
                    </select>
                  </div>
                </div>
              <% }) %>
              <button class="primary-button" type="submit">Save ListenBrainz settings</button>
            </form>
          </div>

          <div class="settings-card settings-integration-card">
            <div class="settings-integration-head">
              <div>
                <div class="settings-card-title">Spotify Import</div>
                <div class="settings-card-sub">Connect Spotify so Curatorr can browse your playlists and prepare imports into your local library.</div>
              </div>
              <span class="settings-integration-tag"><%= spotifyConnected ? 'Connected' : 'Optional' %></span>
            </div>
            <div class="settings-form">
              <div class="settings-card-sub" style="margin-bottom:0.75rem">
                <% if (spotifyConnected) { %>
                  Connected as <strong><%= spotifyDisplayName || spotifyUserId %></strong><% if (spotifyUserId) { %> (<code><%= spotifyUserId %></code>)<% } %>.
                <% } else { %>
                  Spotify is not connected yet. Once connected, the Playlists page will be able to list your Spotify playlists for import.
                <% } %>
              </div>
              <div class="settings-access-row" style="justify-content:flex-start;gap:0.75rem;">
                <a class="primary-button" href="/user-settings/spotify/connect">Connect Spotify</a>
                <% if (spotifyConnected) { %>
                  <form method="post" action="/user-settings/spotify/disconnect" style="margin:0">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button class="primary-button secondary-button" type="submit">Disconnect</button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>
  </div>

  <script>
    (function() {
      var root = document.documentElement;
      var profileThemePresetButtons = Array.from(document.querySelectorAll('#profileThemePresets .theme-preset-card'));
      var profileCustomThemeColorInput = document.getElementById('profileCustomThemeColor');
      var profileCustomThemeChip = document.querySelector('[data-profile-custom-chip]');
      var profileThemeSidebarInvertToggle = document.getElementById('profileThemeSidebarInvert');
      var profileThemeSquareCornersToggle = document.getElementById('profileThemeSquareCorners');
      var profileThemeBgMotionToggle = document.getElementById('profileThemeBgMotion');
      var profileThemeCarouselFreeScrollToggle = document.getElementById('profileThemeCarouselFreeScroll');
      var profileThemeHideScrollbarsToggle = document.getElementById('profileThemeHideScrollbars');
      var profileThemeSaveForm = document.getElementById('profileThemeSaveForm');
      var profileThemeModeInput = document.getElementById('profileThemeMode');
      var profileThemeBrandThemeInput = document.getElementById('profileThemeBrandTheme');
      var profileThemeCustomColorInput = document.getElementById('profileThemeCustomColor');
      var profileThemeSidebarInvertValueInput = document.getElementById('profileThemeSidebarInvertValue');
      var profileThemeSquareCornersValueInput = document.getElementById('profileThemeSquareCornersValue');
      var profileThemeBgMotionValueInput = document.getElementById('profileThemeBgMotionValue');
      var profileThemeCarouselFreeScrollValueInput = document.getElementById('profileThemeCarouselFreeScrollValue');
      var profileThemeHideScrollbarsValueInput = document.getElementById('profileThemeHideScrollbarsValue');
      var allowedBrandThemes = new Set(['custom', 'curatorr', 'launcharr', 'rocketship', 'pulsarr', 'plex', 'radarr', 'sonarr', 'lidarr', 'readarr']);
      var customColorStorageKey = 'curatorr-custom-color';
      var serverThemeDefaults = <%- JSON.stringify(themeDefaults || {}) %>;
      var themeOptionStorageKeys = {
        sidebarInvert: 'curatorr-sidebar-invert',
        squareCorners: 'curatorr-square-corners',
        bgMotion: 'curatorr-bg-motion',
        carouselFreeScroll: 'curatorr-carousel-free-scroll',
        hideScrollbars: 'curatorr-hide-scrollbars',
      };
      var safeStorage = {
        get: function(key) {
          try { return localStorage.getItem(key); } catch (_err) { return null; }
        },
        set: function(key, value) {
          try { localStorage.setItem(key, value); } catch (_err) {}
        },
      };
      if (!profileThemePresetButtons.length || !profileThemeSaveForm) return;

      var resolveBrandTheme = function(value) {
        var raw = String(value || '').trim().toLowerCase();
        return allowedBrandThemes.has(raw) ? raw : 'curatorr';
      };
      var parseStoredBool = function(key, defaultValue) {
        var raw = safeStorage.get(key);
        if (raw === null || raw === undefined) return Boolean(defaultValue);
        return raw === '1' || raw === 'true';
      };
      var parseHexColor = function(value) {
        var raw = String(value || '').trim();
        var normalized = raw.startsWith('#') ? raw : ('#' + raw);
        return /^#[0-9a-fA-F]{6}$/.test(normalized) ? normalized.toLowerCase() : '#8b5cf6';
      };
      var hexToRgb = function(hex) {
        return {
          r: Number.parseInt(hex.slice(1, 3), 16),
          g: Number.parseInt(hex.slice(3, 5), 16),
          b: Number.parseInt(hex.slice(5, 7), 16),
        };
      };
      var rgbToHex = function(r, g, b) {
        return '#' + [r, g, b].map(function(value) {
          return Math.max(0, Math.min(255, Math.round(value))).toString(16).padStart(2, '0');
        }).join('');
      };
      var mixRgb = function(base, target, amount) {
        return {
          r: base.r + (target.r - base.r) * amount,
          g: base.g + (target.g - base.g) * amount,
          b: base.b + (target.b - base.b) * amount,
        };
      };
      var clearCustomThemeVars = function() {
        ['--teal', '--teal-dark', '--brand-rgb', '--brand-btn-start', '--brand-btn-mid', '--brand-btn-end', '--brand-btn-shadow', '--on-brand', '--on-brand-muted', '--on-brand-icon-filter'].forEach(function(name) {
          root.style.removeProperty(name);
        });
      };
      var applyCustomColor = function(inputHex) {
        var hex = parseHexColor(inputHex);
        var base = hexToRgb(hex);
        var dark = mixRgb(base, { r: 0, g: 0, b: 0 }, 0.4);
        var start = mixRgb(base, { r: 255, g: 255, b: 255 }, 0.35);
        var end = mixRgb(base, { r: 0, g: 0, b: 0 }, 0.2);
        var shadow = mixRgb(base, { r: 0, g: 0, b: 0 }, 0.28);
        var toLinear = function(channel) {
          var value = channel / 255;
          return value <= 0.03928 ? value / 12.92 : Math.pow((value + 0.055) / 1.055, 2.4);
        };
        var luminance = 0.2126 * toLinear(base.r) + 0.7152 * toLinear(base.g) + 0.0722 * toLinear(base.b);
        var contrastWhite = 1.05 / (luminance + 0.05);
        var contrastBlack = (luminance + 0.05) / 0.05;
        var onBrand = contrastWhite >= contrastBlack ? '#ffffff' : '#081013';
        var onBrandMuted = contrastWhite >= contrastBlack ? 'rgba(255,255,255,.78)' : 'rgba(8,16,19,.72)';
        var onBrandIconFilter = contrastWhite >= contrastBlack ? 'brightness(0) saturate(100%) invert(1)' : 'brightness(0) saturate(100%)';
        root.style.setProperty('--teal', hex);
        root.style.setProperty('--teal-dark', rgbToHex(dark.r, dark.g, dark.b));
        root.style.setProperty('--brand-rgb', Math.round(base.r) + ',' + Math.round(base.g) + ',' + Math.round(base.b));
        root.style.setProperty('--brand-btn-start', rgbToHex(start.r, start.g, start.b));
        root.style.setProperty('--brand-btn-mid', hex);
        root.style.setProperty('--brand-btn-end', rgbToHex(end.r, end.g, end.b));
        root.style.setProperty('--brand-btn-shadow', Math.round(shadow.r) + ',' + Math.round(shadow.g) + ',' + Math.round(shadow.b));
        root.style.setProperty('--on-brand', onBrand);
        root.style.setProperty('--on-brand-muted', onBrandMuted);
        root.style.setProperty('--on-brand-icon-filter', onBrandIconFilter);
        if (profileCustomThemeChip) profileCustomThemeChip.style.setProperty('--theme-color', hex);
        return hex;
      };
      var syncProfileThemeForm = function() {
        if (profileThemeModeInput) {
          profileThemeModeInput.value = root.dataset.theme === 'day' ? 'day' : (serverThemeDefaults.mode || 'night');
        }
        if (profileThemeBrandThemeInput) {
          profileThemeBrandThemeInput.value = resolveBrandTheme(root.dataset.brandTheme || serverThemeDefaults.brandTheme);
        }
        if (profileThemeCustomColorInput) {
          profileThemeCustomColorInput.value = parseHexColor(safeStorage.get(customColorStorageKey) || serverThemeDefaults.customColor || '#8b5cf6');
        }
        if (profileThemeSidebarInvertValueInput) {
          profileThemeSidebarInvertValueInput.value = profileThemeSidebarInvertToggle && profileThemeSidebarInvertToggle.checked ? '1' : '0';
        }
        if (profileThemeSquareCornersValueInput) {
          profileThemeSquareCornersValueInput.value = profileThemeSquareCornersToggle && profileThemeSquareCornersToggle.checked ? '1' : '0';
        }
        if (profileThemeBgMotionValueInput) {
          profileThemeBgMotionValueInput.value = profileThemeBgMotionToggle && profileThemeBgMotionToggle.checked ? '1' : '0';
        }
        if (profileThemeCarouselFreeScrollValueInput) {
          profileThemeCarouselFreeScrollValueInput.value = profileThemeCarouselFreeScrollToggle && profileThemeCarouselFreeScrollToggle.checked ? '1' : '0';
        }
        if (profileThemeHideScrollbarsValueInput) {
          profileThemeHideScrollbarsValueInput.value = profileThemeHideScrollbarsToggle && profileThemeHideScrollbarsToggle.checked ? '1' : '0';
        }
      };
      var applyThemeOptions = function(options) {
        var sidebarInvert = Boolean(options && options.sidebarInvert);
        var squareCorners = Boolean(options && options.squareCorners);
        var bgMotion = !options || options.bgMotion !== false;
        var carouselFreeScroll = Boolean(options && options.carouselFreeScroll);
        var hideScrollbars = Boolean(options && options.hideScrollbars);
        root.dataset.sidebarInvert = sidebarInvert ? '1' : '0';
        root.dataset.squareCorners = squareCorners ? '1' : '0';
        root.dataset.bgMotion = bgMotion ? '1' : '0';
        root.dataset.carouselFreeScroll = carouselFreeScroll ? '1' : '0';
        root.dataset.hideScrollbars = hideScrollbars ? '1' : '0';
        safeStorage.set(themeOptionStorageKeys.sidebarInvert, sidebarInvert ? '1' : '0');
        safeStorage.set(themeOptionStorageKeys.squareCorners, squareCorners ? '1' : '0');
        safeStorage.set(themeOptionStorageKeys.bgMotion, bgMotion ? '1' : '0');
        safeStorage.set(themeOptionStorageKeys.carouselFreeScroll, carouselFreeScroll ? '1' : '0');
        safeStorage.set(themeOptionStorageKeys.hideScrollbars, hideScrollbars ? '1' : '0');
        if (profileThemeSidebarInvertToggle) profileThemeSidebarInvertToggle.checked = sidebarInvert;
        if (profileThemeSquareCornersToggle) profileThemeSquareCornersToggle.checked = squareCorners;
        if (profileThemeBgMotionToggle) profileThemeBgMotionToggle.checked = bgMotion;
        if (profileThemeCarouselFreeScrollToggle) profileThemeCarouselFreeScrollToggle.checked = carouselFreeScroll;
        if (profileThemeHideScrollbarsToggle) profileThemeHideScrollbarsToggle.checked = hideScrollbars;
        syncProfileThemeForm();
      };
      var syncThemeOptionsFromInputs = function() {
        applyThemeOptions({
          sidebarInvert: Boolean(profileThemeSidebarInvertToggle && profileThemeSidebarInvertToggle.checked),
          squareCorners: Boolean(profileThemeSquareCornersToggle && profileThemeSquareCornersToggle.checked),
          bgMotion: Boolean(profileThemeBgMotionToggle && profileThemeBgMotionToggle.checked),
          carouselFreeScroll: Boolean(profileThemeCarouselFreeScrollToggle && profileThemeCarouselFreeScrollToggle.checked),
          hideScrollbars: Boolean(profileThemeHideScrollbarsToggle && profileThemeHideScrollbarsToggle.checked),
        });
      };
      var applyBrandTheme = function(theme) {
        var normalized = resolveBrandTheme(theme);
        root.dataset.brandTheme = normalized;
        safeStorage.set('curatorr-brand-theme', normalized);
        if (normalized === 'custom') {
          var savedCustomHex = parseHexColor(safeStorage.get(customColorStorageKey) || serverThemeDefaults.customColor || '#8b5cf6');
          var appliedHex = applyCustomColor(savedCustomHex);
          if (profileCustomThemeColorInput) profileCustomThemeColorInput.value = appliedHex;
        } else {
          clearCustomThemeVars();
        }
        profileThemePresetButtons.forEach(function(btn) {
          var isActive = btn.dataset.brandTheme === normalized;
          btn.classList.toggle('is-active', isActive);
          btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
        syncProfileThemeForm();
      };
      var initialThemeOptions = {
        sidebarInvert: parseStoredBool(themeOptionStorageKeys.sidebarInvert, serverThemeDefaults.sidebarInvert === true),
        squareCorners: parseStoredBool(themeOptionStorageKeys.squareCorners, serverThemeDefaults.squareCorners === true),
        bgMotion: parseStoredBool(themeOptionStorageKeys.bgMotion, serverThemeDefaults.bgMotion === undefined ? true : serverThemeDefaults.bgMotion === true),
        carouselFreeScroll: parseStoredBool(themeOptionStorageKeys.carouselFreeScroll, serverThemeDefaults.carouselFreeScroll === true),
        hideScrollbars: parseStoredBool(themeOptionStorageKeys.hideScrollbars, serverThemeDefaults.hideScrollbars === true),
      };
      applyThemeOptions(initialThemeOptions);
      var initialCustomHex = parseHexColor(safeStorage.get(customColorStorageKey) || serverThemeDefaults.customColor || '#8b5cf6');
      if (profileCustomThemeColorInput) profileCustomThemeColorInput.value = initialCustomHex;
      if (profileCustomThemeChip) profileCustomThemeChip.style.setProperty('--theme-color', initialCustomHex);
      var storedBrandTheme = safeStorage.get('curatorr-brand-theme');
      var fallbackBrandTheme = resolveBrandTheme(serverThemeDefaults.brandTheme);
      applyBrandTheme(allowedBrandThemes.has(storedBrandTheme) ? storedBrandTheme : fallbackBrandTheme);
      profileThemePresetButtons.forEach(function(btn) {
        btn.addEventListener('click', function(event) {
          if (btn.dataset.brandTheme === 'custom' && event.target === profileCustomThemeColorInput) return;
          applyBrandTheme(btn.dataset.brandTheme);
        });
      });
      if (profileCustomThemeColorInput) {
        profileCustomThemeColorInput.addEventListener('input', function() {
          var hex = parseHexColor(profileCustomThemeColorInput.value);
          safeStorage.set(customColorStorageKey, hex);
          applyBrandTheme('custom');
        });
      }
      profileThemeSidebarInvertToggle && profileThemeSidebarInvertToggle.addEventListener('change', syncThemeOptionsFromInputs);
      profileThemeSquareCornersToggle && profileThemeSquareCornersToggle.addEventListener('change', syncThemeOptionsFromInputs);
      profileThemeBgMotionToggle && profileThemeBgMotionToggle.addEventListener('change', syncThemeOptionsFromInputs);
      profileThemeCarouselFreeScrollToggle && profileThemeCarouselFreeScrollToggle.addEventListener('change', syncThemeOptionsFromInputs);
      profileThemeHideScrollbarsToggle && profileThemeHideScrollbarsToggle.addEventListener('change', syncThemeOptionsFromInputs);
      profileThemeSaveForm.addEventListener('submit', function() {
        syncProfileThemeForm();
      });
      syncProfileThemeForm();
    })();

    (function() {
      var toggle = document.getElementById('topTracksToggle');
      var select = document.getElementById('topTracksPeriodSelect');
      var sortSelect = document.getElementById('topTracksSortSelect');
      var finalOrderingSelect = document.getElementById('topTracksFinalOrderingSelect');
      if (toggle && select) {
        var parseMap = function(raw, fallback) {
          try {
            var parsed = JSON.parse(raw || '{}');
            return parsed && typeof parsed === 'object' ? parsed : fallback;
          } catch (_err) {
            return fallback;
          }
        };
        var sortMap = parseMap(sortSelect ? sortSelect.dataset.sortMap : '', {});
        var finalOrderingMap = parseMap(finalOrderingSelect ? finalOrderingSelect.dataset.finalOrderingMap : '', {});
        var syncTopTracksControls = function() {
          var period = select.value || 'overall';
          if (sortSelect) sortSelect.value = sortMap[period] || 'source';
          if (finalOrderingSelect) finalOrderingSelect.value = finalOrderingMap[period] || 'none';
        };
        toggle.addEventListener('change', function() {
          select.disabled = !toggle.checked;
          if (!toggle.checked) select.value = '';
          else if (!select.value) select.value = 'overall';
          syncTopTracksControls();
        });
        select.addEventListener('change', syncTopTracksControls);
        syncTopTracksControls();
      }
    })();
    (function() {
      var btn = document.getElementById('lastfmRunBackfillBtn');
      var status = document.getElementById('lastfmBackfillStatus');
      if (!btn) return;
      btn.addEventListener('click', function() {
        btn.disabled = true;
        btn.textContent = 'Running…';
        if (status) { status.textContent = 'Backfill started — this runs in the background. Refresh this page in a minute to see the updated status.'; status.style.display = ''; }
        fetch('/user-settings/lastfm/run-backfill', {
          method: 'POST',
          headers: { 'X-CSRF-Token': '<%= csrfToken %>' },
        }).catch(function() {
          if (status) status.textContent = 'Failed to start backfill.';
          btn.disabled = false;
          btn.textContent = 'Run backfill';
        });
      });
    })();
  </script>

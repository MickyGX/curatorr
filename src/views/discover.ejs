<%- include('partials/head', { pageTitle: title || 'Discover — Curatorr', extraCss: extraCss || ['/styles-layout.css', '/styles-curatorr.css'] }) %>
<body class="dash-body cur-discover-page">
  <style>
    @media (max-width: 980px) {
      .cur-discover-page .dash-frame,
      .cur-discover-page .dash-main,
      .cur-discover-page .dash-content,
      .cur-discover-page .plex-module,
      .cur-discover-page .plex-topbar,
      .cur-discover-page .plex-panel,
      .cur-discover-page .cur-panel,
      .cur-discover-page .cur-panel-header,
      .cur-discover-page .cur-panel-body,
      .cur-discover-page .main-window-bar {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        box-sizing: border-box;
      }

      .cur-discover-page .main-window-bar {
        margin: 0;
        left: 0;
        right: 0;
      }

      .cur-discover-page .cur-discover-searchbar,
      .cur-discover-page .cur-discover-searchbar > * {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        box-sizing: border-box;
      }
    }
  </style>
  <div class="dash-frame<%= sidebarCollapsed ? ' sidebar-collapsed' : '' %>">
    <aside class="dash-sidebar">
      <div class="dash-brand">
        <span class="dash-logo">
          <img class="nav-icon app-icon" src="/icons/curatorr-icon.svg" alt="Curatorr" onerror="this.style.display='none'" />
        </span>
        <div><div class="dash-title">Curatorr</div></div>
      </div>
      <div class="dash-nav">
        <%- include('partials/nav-categories', { navActivePage: 'discover', role: role }) %>
      </div>
      <%- include('partials/user-menu') %>
    </aside>

    <section class="dash-main">
      <div class="main-window-bar">
        <button class="sidebar-toggle main-toggle left-toggle" type="button" aria-label="Toggle sidebar">
          <img class="toggle-icon" src="/icons/sidebar-toggle.svg" alt="" />
        </button>
        <div class="main-window-title">
          <img class="main-window-icon" src="/icons/search.svg" alt="" />
          <span class="main-window-app">Curatorr</span>
          <span class="main-window-rest">| Discover</span>
        </div>
        <div class="main-window-spacer"></div>
        <div class="main-window-status">
          <span class="status-dot"></span>
        </div>
      </div>

      <div class="dash-content plex-overview">
        <%- include('partials/plex-banner') %>
        <%
          const _lidarrAutomationEligible = Boolean(lidarrAutomationEligible);
          const _lidarrQuota = lidarrQuota && typeof lidarrQuota === 'object' ? lidarrQuota : null;

          function fmtQuota(metric, label) {
            if (!metric) return '';
            if (metric.unlimited) return '\u221e';
            return metric.used + '/' + metric.limit;
          }
          function fmtQuotaLabel(metric, label) {
            if (!metric) return '';
            return label + ' ' + fmtQuota(metric, label);
          }
        %>

        <%
          const _recentAddedAlbums = Array.isArray(recentAddedAlbums) ? recentAddedAlbums : [];
          const _recentRequestedAlbums = Array.isArray(recentRequestedAlbums) ? recentRequestedAlbums : [];
          const _disc = locals.discoveryConfig || {};
        %>

        <section class="plex-module cur-discover-module">
          <div class="plex-topbar">
            <h3 class="plex-title">Recently Added Albums</h3>
            <div class="plex-topbar-actions">
              <span id="recentAddedAlbumsStatus" class="plex-topbar-meta"><%= _recentAddedAlbums.length ? `${_recentAddedAlbums.length} album${_recentAddedAlbums.length === 1 ? '' : 's'}.` : '' %></span>
              <button class="btn btn-sm btn-ghost cur-nav-button cur-nav-button--compact" type="button" id="recentAddedAlbumsPrev" aria-label="Previous recently added albums">
                <span class="cur-nav-chev cur-nav-chev--left" aria-hidden="true"></span>
              </button>
              <button class="btn btn-sm btn-ghost cur-nav-button cur-nav-button--compact" type="button" id="recentAddedAlbumsNext" aria-label="Next recently added albums">
                <span class="cur-nav-chev cur-nav-chev--right" aria-hidden="true"></span>
              </button>
            </div>
          </div>
          <div class="plex-panel">
            <div class="cur-discover-artist-viewport plex-carousel-viewport" id="recentAddedAlbumsViewport">
              <div id="recentAddedAlbumsList" class="cur-empty"><%= _recentAddedAlbums.length ? 'Loading…' : 'No recent added albums yet.' %></div>
            </div>
          </div>
        </section>

        <section class="plex-module cur-discover-module">
          <div class="plex-topbar">
            <h3 class="plex-title">Recently Requested</h3>
            <div class="plex-topbar-actions">
              <span id="recentRequestedAlbumsStatus" class="plex-topbar-meta"><%= _recentRequestedAlbums.length ? `${_recentRequestedAlbums.length} album${_recentRequestedAlbums.length === 1 ? '' : 's'}.` : '' %></span>
              <button class="btn btn-sm btn-ghost cur-nav-button cur-nav-button--compact" type="button" id="recentRequestedAlbumsPrev" aria-label="Previous recently requested albums">
                <span class="cur-nav-chev cur-nav-chev--left" aria-hidden="true"></span>
              </button>
              <button class="btn btn-sm btn-ghost cur-nav-button cur-nav-button--compact" type="button" id="recentRequestedAlbumsNext" aria-label="Next recently requested albums">
                <span class="cur-nav-chev cur-nav-chev--right" aria-hidden="true"></span>
              </button>
            </div>
          </div>
          <div class="plex-panel">
            <div class="cur-discover-artist-viewport plex-carousel-viewport" id="recentRequestedAlbumsViewport">
              <div id="recentRequestedAlbumsList" class="cur-empty"><%= _recentRequestedAlbums.length ? 'Loading…' : 'No recent requests yet.' %></div>
            </div>
          </div>
        </section>

        <% if (_disc.showTrendingArtists || _disc.showTrendingTracks || _disc.showSimilarArtists) { %>

          <% if (_disc.showTrendingArtists) { %>
          <section class="plex-module cur-discover-module">
            <div class="plex-topbar">
              <h3 class="plex-title">Trending Artists</h3>
              <div class="plex-topbar-actions">
                <span id="trendingArtistsStatus" class="plex-topbar-meta"></span>
                <button class="btn btn-sm btn-ghost cur-nav-button cur-nav-button--compact" type="button" id="trendingArtistsPrev" aria-label="Previous">
                  <span class="cur-nav-chev cur-nav-chev--left" aria-hidden="true"></span>
                </button>
                <button class="btn btn-sm btn-ghost cur-nav-button cur-nav-button--compact" type="button" id="trendingArtistsNext" aria-label="Next">
                  <span class="cur-nav-chev cur-nav-chev--right" aria-hidden="true"></span>
                </button>
              </div>
            </div>
            <div class="plex-panel">
              <div class="cur-discover-artist-viewport plex-carousel-viewport" id="trendingArtistsViewport">
                <div id="trendingArtistsList" class="cur-empty">Loading…</div>
              </div>
            </div>
          </section>
          <% } %>

          <% if (_disc.showTrendingTracks) { %>
          <section class="plex-module cur-discover-module">
            <div class="plex-topbar">
              <h3 class="plex-title">Trending Tracks</h3>
              <div class="plex-topbar-actions">
                <span id="trendingTracksStatus" class="plex-topbar-meta"></span>
                <button class="btn btn-sm btn-ghost cur-nav-button cur-nav-button--compact" type="button" id="trendingTracksPrev" aria-label="Previous">
                  <span class="cur-nav-chev cur-nav-chev--left" aria-hidden="true"></span>
                </button>
                <button class="btn btn-sm btn-ghost cur-nav-button cur-nav-button--compact" type="button" id="trendingTracksNext" aria-label="Next">
                  <span class="cur-nav-chev cur-nav-chev--right" aria-hidden="true"></span>
                </button>
              </div>
            </div>
            <div class="plex-panel">
              <div class="cur-discover-artist-viewport plex-carousel-viewport" id="trendingTracksViewport">
                <div id="trendingTracksList" class="cur-empty">Loading…</div>
              </div>
            </div>
          </section>
          <% } %>

          <% if (_disc.showSimilarArtists) { %>
          <section class="plex-module cur-discover-module">
            <div class="plex-topbar">
              <h3 class="plex-title" id="similarCarouselTitle">Because You Like...</h3>
              <div class="plex-topbar-actions">
                <span id="similarArtistsStatus" class="plex-topbar-meta"></span>
                <button class="btn btn-sm btn-ghost cur-nav-button cur-nav-button--compact" type="button" id="similarArtistsPrev" aria-label="Previous">
                  <span class="cur-nav-chev cur-nav-chev--left" aria-hidden="true"></span>
                </button>
                <button class="btn btn-sm btn-ghost cur-nav-button cur-nav-button--compact" type="button" id="similarArtistsNext" aria-label="Next">
                  <span class="cur-nav-chev cur-nav-chev--right" aria-hidden="true"></span>
                </button>
              </div>
            </div>
            <div class="plex-panel">
              <div class="cur-discover-panel-subtitle" id="similarCarouselArtists"></div>
              <div class="cur-discover-artist-viewport plex-carousel-viewport" id="similarArtistsViewport">
                <div id="similarArtistsList" class="cur-empty">Loading…</div>
              </div>
            </div>
          </section>
          <% } %>

        <% } %>

        <div class="cur-panel cur-panel--manual-discovery">
          <div class="cur-panel-header">
            <h3 class="cur-panel-title">Manual Discovery</h3>
            <div class="cur-panel-actions">
              <% if (_lidarrAutomationEligible && _lidarrQuota) { %>
                <span class="cur-status-chip" title="Artists this week"><img src="/icons/user-profile.svg" alt="Artists" style="width:12px;height:12px;opacity:.7;vertical-align:middle;margin-right:3px" /><strong><%= fmtQuota(_lidarrQuota.weeklyArtists) %></strong></span>
                <span class="cur-status-chip" title="Albums this week"><img src="/icons/vinyl-record.svg" alt="Albums" style="width:12px;height:12px;opacity:.7;vertical-align:middle;margin-right:3px" /><strong><%= fmtQuota(_lidarrQuota.weeklyAlbums) %></strong></span>
              <% } %>
            </div>
          </div>
          <div class="cur-panel-body">
            <details class="cur-score-explainer">
              <summary>What is this?</summary>
              <div class="cur-score-explainer-body">
                <p>Search for any artist and add them to your music library. Search freely — once your quota is full, new requests move into your queue automatically.</p>
                <ul>
                  <li>The <img src="/icons/user-profile.svg" alt="" style="width:11px;height:11px;vertical-align:middle;opacity:.7" /> and <img src="/icons/vinyl-record.svg" alt="" style="width:11px;height:11px;vertical-align:middle;opacity:.7" /> counters in the header show your weekly artist and album allowance. ∞ means no limit for your account role.</li>
                  <li>Select an artist from the results, then choose a specific album or let Curatorr pick the best one for you.</li>
                  <li>Requests that can't be processed immediately are held in the Queue below and worked through automatically.</li>
                </ul>
              </div>
            </details>
            <div class="cur-discover-search">
              <% if (_lidarrAutomationEligible) { %>
                <div class="cur-discover-searchbar">
                  <input id="manualArtistSearch" class="cur-search cur-search--discover" type="search" placeholder="Search for an artist to add…" autocomplete="off" />
                  <button class="btn btn-primary" type="button" id="manualArtistSearchBtn">Search</button>
                </div>
              <% } else { %>
                <div class="cur-empty">Manual add is only available when music automation is enabled for your account.</div>
              <% } %>
            </div>
            <div class="cur-discover-stack">
              <div class="cur-discover-results">
                <div class="cur-panel-header cur-panel-header--discover">
                  <h3 class="cur-panel-subtitle"><img src="/icons/user-profile.svg" alt="Artist Results" title="Artist Results" style="width:16px;height:16px;opacity:.7;vertical-align:middle" /></h3>
                  <div class="cur-panel-actions">
                    <div id="manualSearchStatus" class="cur-panel-meta"></div>
                    <button class="btn btn-sm btn-ghost cur-nav-button cur-nav-button--compact" type="button" id="discoverArtistPrev" aria-label="Previous artists">
                      <span class="cur-nav-chev cur-nav-chev--left" aria-hidden="true"></span>
                    </button>
                    <button class="btn btn-sm btn-ghost cur-nav-button cur-nav-button--compact" type="button" id="discoverArtistNext" aria-label="Next artists">
                      <span class="cur-nav-chev cur-nav-chev--right" aria-hidden="true"></span>
                    </button>
                  </div>
                </div>
                <div class="cur-discover-artist-viewport plex-carousel-viewport" id="manualSearchViewport" style="display:none">
                  <div id="manualSearchResults" class="cur-empty">Search results will appear here.</div>
                </div>
              </div>
              <div class="cur-discover-preview" id="manualAlbumPanel" style="display:none">
                <div class="cur-panel-header cur-panel-header--discover">
                  <h3 class="cur-panel-subtitle"><img src="/icons/vinyl-record.svg" alt="Album Choice" title="Album Choice" style="width:16px;height:16px;opacity:.7;vertical-align:middle" /></h3>
                  <div id="manualAlbumSelectionBar" class="pl-selection-bar" style="display:none">
                    <span id="manualAlbumSelectionCount" class="pl-selection-count"></span>
                    <button class="btn btn-sm btn-ghost pl-selection-clear" type="button" onclick="clearManualAlbumSelection()">Clear</button>
                    <button class="btn btn-sm btn-primary" type="button" id="manualAlbumAddSelectedBtn" onclick="addSelectedManualAlbums()">Add Selected</button>
                  </div>
                  <div class="cur-panel-actions">
                    <div id="manualAlbumStatus" class="cur-panel-meta"></div>
                    <button class="btn btn-sm btn-ghost cur-nav-button cur-nav-button--compact" type="button" id="manualAlbumPrev" aria-label="Previous albums">
                      <span class="cur-nav-chev cur-nav-chev--left" aria-hidden="true"></span>
                    </button>
                    <button class="btn btn-sm btn-ghost cur-nav-button cur-nav-button--compact" type="button" id="manualAlbumNext" aria-label="Next albums">
                      <span class="cur-nav-chev cur-nav-chev--right" aria-hidden="true"></span>
                    </button>
                  </div>
                </div>
                <div class="cur-discover-artist-viewport plex-carousel-viewport" id="manualAlbumViewport" style="display:none">
                  <div id="manualAlbumResults" class="cur-empty">Select an artist to preview albums.</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <%
          const _suggestedArtists = Array.isArray(suggestedArtists) ? suggestedArtists : [];
        %>
        <% if (_suggestedArtists.length || _lidarrAutomationEligible) { %>
        <div class="cur-panel cur-panel--artist-pipeline">
          <div class="cur-panel-header">
            <h3 class="cur-panel-title">Artist Pipeline <span class="cur-count"><%= _suggestedArtists.length %></span></h3>
            <div class="cur-panel-actions">
              <% if (_lidarrAutomationEligible && _lidarrQuota) { %>
                <span class="cur-status-chip" title="Artists this week"><img src="/icons/user-profile.svg" alt="Artists" style="width:12px;height:12px;opacity:.7;vertical-align:middle;margin-right:3px" /><strong><%= fmtQuota(_lidarrQuota.weeklyArtists) %></strong></span>
                <span class="cur-status-chip" title="Albums this week"><img src="/icons/vinyl-record.svg" alt="Albums" style="width:12px;height:12px;opacity:.7;vertical-align:middle;margin-right:3px" /><strong><%= fmtQuota(_lidarrQuota.weeklyAlbums) %></strong></span>
              <% } %>
            </div>
          </div>
          <div class="cur-panel-body">
            <details class="cur-score-explainer">
              <summary>What is this table?</summary>
              <div class="cur-score-explainer-body">
                <p>One row per artist Curatorr has recommended for your library. Artists move through four states:</p>
                <ul>
                  <li><strong>Suggested</strong> — Curatorr recommends this artist. No Lidarr action has started yet. Click <strong>Add to library</strong> to begin acquisition.</li>
                  <li><strong>In progress</strong> — The artist has been sent to Lidarr. A starter album is being monitored or downloaded.</li>
                  <li><strong>Stuck</strong> — Lidarr couldn't find files, or your weekly quota was reached. Dismiss and retry later, or check Lidarr directly.</li>
                  <li><strong>In your library</strong> — A starter album was successfully acquired. Artists age off this list after 14 days.</li>
                </ul>
                <p><strong>How is the score calculated?</strong> Artist Score = Genre Fit + Behaviour + Editorial</p>
                <ul>
                  <li><strong>Genre Fit</strong> — how closely the artist's genres match your listening affinity. Up to 3 genres contribute, weighted by how heavily you listen to each genre.</li>
                  <li><strong>Behaviour</strong> — artists you've never played score highest (+4). Artists played only a little get a smaller boost; heavily played artists score lower, making room for genuine discoveries.</li>
                  <li><strong>Editorial</strong> — bonus for artists with multiple albums (+0.75) or large catalogues (+0.5), a liked-genre match (+1), and a Last.fm similarity boost of up to +6 when the artist is closely related to your top artists.</li>
                </ul>
                <p>Artists sourced from <strong>Last.fm</strong> now use the same scoring model as catalog artists. Curatorr derives genre context from the related seed artists and enriches stronger Last.fm candidates with Last.fm top tags.</p>
              </div>
            </details>
            <% if (_suggestedArtists.length) { %>
              <ul class="cur-list">
                <% _suggestedArtists.forEach(function(a) {
                  var _sk = a.lidarrStatusKey;
                  var _topGenres = [...new Set((Array.isArray(a.reason?.topGenres) ? a.reason.topGenres : []).filter(Boolean).flatMap(function(g){ return g.split(';').map(function(s){ return s.trim(); }).filter(function(s){ return s && !/^\d+$/.test(s); }); }))].slice(0, 3);
                  var _lastfmTags = (a.source === 'lastfm-similar' && Array.isArray(a.reason?.lastfmTags)) ? a.reason.lastfmTags.filter(Boolean).slice(0, 3) : [];
                  var _similarTo = (a.source === 'lastfm-similar' && Array.isArray(a.reason?.similarTo)) ? a.reason.similarTo.filter(Boolean).slice(0, 2) : [];
                  var _sourceLabel = a.lidarrStatusSourceLabel ? a.lidarrStatusSourceLabel.toLowerCase() : '';
                  var _isLastfm = a.source === 'lastfm-similar';
                  var _subText = _topGenres.length
                    ? _topGenres.join(' · ')
                    : (_lastfmTags.length
                      ? _lastfmTags.join(' · ')
                      : (_similarTo.length
                        ? 'Similar to ' + _similarTo.join(', ')
                        : (_sourceLabel ? 'Via ' + _sourceLabel : '')));
                  var _isSuggested = _sk === 'suggested' && _lidarrAutomationEligible;
                  var _isStuck = _sk === 'stuck' && _lidarrAutomationEligible;
                %>
                  <li class="cur-list-item cur-suggest-item">
                    <span class="cur-list-thumb cur-overview-trigger" role="button" tabindex="0" data-cur-overview-kind="artist" data-cur-overview-name="<%= a.artistName %>">
                      <img src="/api/music/thumb/artist/<%= encodeURIComponent(a.artistName) %>" alt="" loading="lazy" onerror="this.style.visibility='hidden'" />
                    </span>
                    <span class="cur-list-primary">
                      <span class="cur-list-name cur-overview-trigger" role="button" tabindex="0" data-cur-overview-kind="artist" data-cur-overview-name="<%= a.artistName %>"><%= a.artistName %><% if (_isLastfm) { %> <img class="cur-suggest-source-icon" src="https://upload.wikimedia.org/wikipedia/commons/thumb/b/b7/Last.fm_favicon.png/250px-Last.fm_favicon.png" alt="Last.fm" title="Suggested from Last.fm similar artists" loading="lazy" referrerpolicy="no-referrer" /><% } %></span>
                      <% if (_subText) { %><span class="cur-list-sub"><%= _subText %></span><% } %>
                    </span>
                    <span class="cur-list-meta cur-suggest-score"><% if (Number.isFinite(Number(a.totalScore)) && Number(a.totalScore) > 0) { %>Score <strong><%= Number(a.totalScore || 0).toFixed(1) %></strong><% } else { %><span class="cur-muted">—</span><% } %></span>
                    <span class="cur-badge cur-badge--<%= a.lidarrStatusTone || 'curatorr' %>"><%= a.lidarrStatusLabel || a.status || 'Suggested' %></span>
                    <span class="cur-cell-actions cur-suggest-actions">
                      <span class="cur-suggest-menu-wrap">
                        <button class="cur-suggest-dots" type="button" title="Options" onclick="event.stopPropagation(); toggleSuggestMenu(this)">⋯</button>
                        <div class="pl-card-menu cur-suggest-menu" style="display:none">
                          <% if (_isStuck) { %>
                            <button type="button" onclick="closeSuggestMenus(); queueSuggestedArtist('<%= encodeURIComponent(a.artistName) %>')">Retry add to library</button>
                          <% } else { %>
                            <button type="button" <%= _isSuggested ? '' : 'disabled' %> onclick="closeSuggestMenus(); browseSuggestedArtist('<%= encodeURIComponent(a.artistName) %>')">Browse albums</button>
                            <button type="button" <%= _isSuggested ? '' : 'disabled' %> onclick="closeSuggestMenus(); curatorrPickSuggestedArtist('<%= encodeURIComponent(a.artistName) %>')">Curatorr pick</button>
                          <% } %>
                          <button type="button" onclick="closeSuggestMenus(); dismissSuggestedArtist('<%= encodeURIComponent(a.artistName) %>')">Dismiss</button>
                        </div>
                      </span>
                    </span>
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <div class="cur-empty">No artist pipeline rows right now.</div>
            <% } %>
            <div class="cur-panel-foot">
              <span id="artistSuggestionStatus" class="cur-panel-meta"></span>
            </div>
          </div>
        </div>
        <% } %>

      </div>
    </section>
  </div>

  <script src="/sidebar.js?v=<%= assetVersion %>"></script>
  <script src="/user-menu.js?v=<%= assetVersion %>"></script>
  <script src="/version-badge.js?v=<%= assetVersion %>"></script>
  <script src="/brand-menu.js?v=<%= assetVersion %>"></script>
  <script src="/curatorr-overview.js?v=<%= assetVersion %>"></script>
  <script src="/starfield-3d.js"></script>
  <script>
    function closeSuggestMenus() {
      document.querySelectorAll('.cur-suggest-menu').forEach(function(m) {
        m.style.display = 'none';
        m.classList.remove('cur-suggest-menu--down');
      });
    }

    function toggleSuggestMenu(btn) {
      var wrap = btn && btn.closest('.cur-suggest-menu-wrap');
      var menu = wrap && wrap.querySelector('.cur-suggest-menu');
      if (!menu) return;
      var isOpen = menu.style.display === 'block';
      closeSuggestMenus();
      if (!isOpen) {
        var panelBody = btn.closest('.cur-panel-body');
        var panelTop = panelBody ? panelBody.getBoundingClientRect().top : 0;
        var buttonRect = btn.getBoundingClientRect();
        var spaceAbove = buttonRect.top - panelTop;
        var estimatedMenuHeight = 84;
        if (spaceAbove < estimatedMenuHeight) {
          menu.classList.add('cur-suggest-menu--down');
        }
        menu.style.display = 'block';
      }
    }

    document.addEventListener('click', function() { closeSuggestMenus(); });

    function queueSuggestedArtist(encodedName) {
      // Used for stuck/retry only — bypasses album selection.
      var status = document.getElementById('artistSuggestionStatus');
      if (status) status.textContent = 'Retrying Lidarr add…';
      fetch('/api/music/suggestions/artists/' + encodedName + '/queue', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
      }).then(function(r) { return r.json().then(function(data) { return { ok: r.ok, data: data }; }); })
        .then(function(result) {
          if (!result.ok || !result.data.ok) throw new Error(result.data.error || 'Failed to add artist.');
          if (status) status.textContent = 'Artist queued.';
          location.reload();
        })
        .catch(function(err) {
          if (status) status.textContent = err.message || 'Failed to add artist.';
        });
    }

    function browseSuggestedArtist(encodedName) {
      var artistName = decodeURIComponent(encodedName);
      // Populate search bar so the user knows which artist is loaded
      var searchInput = document.getElementById('manualArtistSearch');
      if (searchInput) searchInput.value = artistName;
      // Inject a synthetic artist card so the viewport always shows which artist's albums are being browsed
      var searchViewport = document.getElementById('manualSearchViewport');
      var searchResults = document.getElementById('manualSearchResults');
      if (searchResults) {
        var thumbSrc = '/api/music/thumb/artist/' + encodedName;
        searchResults.className = '';
        searchResults.innerHTML =
          '<button class="plex-card cur-discover-result-card is-active" type="button" ' +
            'data-artist-name="' + escHtml(artistName) + '" ' +
            'data-foreign-artist-id="" ' +
            'onclick="selectManualArtist(this)">' +
            '<span class="plex-poster-wrap cur-discover-poster-wrap">' +
              '<span class="plex-poster-well cur-discover-result-art">' +
                '<img src="' + escHtml(thumbSrc) + '" alt="" loading="lazy" onerror="handleDiscoveryImageError(this)" />' +
              '</span>' +
            '</span>' +
            '<span class="plex-footer cur-discover-result-main">' +
              '<span class="plex-name cur-discover-result-name">' + escHtml(artistName) + '</span>' +
              '<span class="plex-meta cur-discover-result-meta">Artist pipeline suggestion</span>' +
            '</span>' +
          '</button>';
      }
      if (searchViewport) searchViewport.style.display = '';
      // Load album panel (calls loadManualAlbumPreview which sets currentArtistSelection)
      loadManualAlbumPreview(
        { artistName: artistName, foreignArtistId: '' },
        { statusMessage: 'Loading albums for ' + artistName + '\u2026' }
      );
      // Defer scroll one tick so the panel display update has been applied
      var panel = document.querySelector('.cur-panel--manual-discovery');
      if (panel) setTimeout(function() { panel.scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 50);
    }

    async function curatorrPickSuggestedArtist(encodedName) {
      var artistName = decodeURIComponent(encodedName);
      if (!confirm('Let Curatorr pick the best album for ' + artistName + '?\n\nIt will select the highest-ranked starter album and send it to Lidarr automatically.')) return;
      currentArtistSelection = { artistName: artistName, foreignArtistId: '' };
      var status = document.getElementById('artistSuggestionStatus');
      if (status) status.textContent = 'Finding best album for ' + artistName + '\u2026';
      try {
        var result = await submitManualRequest(true, '', { silent: true });
        if (status) status.textContent = (result && result.queued ? 'Queued for Lidarr.' : 'Added to Lidarr.');
        location.reload();
      } catch (err) {
        if (status) status.textContent = err.message || 'Curatorr pick failed.';
      }
    }

    function dismissSuggestedArtist(encodedName) {
      var name = decodeURIComponent(encodedName);
      if (!confirm('Dismiss ' + name + '?\n\nThey will be removed from your pipeline. You can re-add them later via the manual search.')) return;
      var status = document.getElementById('artistSuggestionStatus');
      if (status) status.textContent = 'Dismissing artist…';
      fetch('/api/music/suggestions/artists/' + encodedName + '/dismiss', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
      }).then(function(r) { return r.json().then(function(data) { return { ok: r.ok, data: data }; }); })
        .then(function(result) {
          if (!result.ok || !result.data.ok) throw new Error(result.data.error || 'Failed to dismiss artist.');
          if (status) status.textContent = 'Artist dismissed.';
          location.reload();
        })
        .catch(function(err) {
          if (status) status.textContent = err.message || 'Failed to dismiss artist.';
        });
    }

    function retryLidarrRequest(id, btn) {
      if (btn) btn.disabled = true;
      fetch('/api/music/lidarr/requests/' + id + '/retry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
      }).then(function(r) { return r.json().then(function(data) { return { ok: r.ok, data: data }; }); })
        .then(function(result) {
          if (!result.ok || !result.data.ok) throw new Error(result.data.error || 'Retry failed.');
          location.reload();
        })
        .catch(function(err) {
          if (btn) btn.disabled = false;
          var msg = err.message || 'Retry failed.';
          var status = document.getElementById('artistSuggestionStatus');
          if (status) { status.textContent = msg; } else { alert(msg); }
        });
    }

    var currentArtistSelection = null;

    function escHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function setStatus(id, message) {
      var el = document.getElementById(id);
      if (el) el.textContent = message || '';
    }

    function fmtClientDate(value) {
      if (!value) return '—';
      try {
        return new Date(value).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
      } catch (_err) {
        return '—';
      }
    }

    function fmtClientReleaseDate(value) {
      var raw = String(value || '').trim();
      if (!raw) return '';
      var isoDate = raw.match(/^(\d{4}-\d{2}-\d{2})T/);
      if (isoDate) return isoDate[1];
      return raw;
    }

    async function runArtistSearch() {
      var input = document.getElementById('manualArtistSearch');
      var term = input ? input.value.trim() : '';
      var list = document.getElementById('manualSearchResults');
      if (!term || term.length < 2) {
        setStatus('manualSearchStatus', 'Enter at least 2 characters.');
        return;
      }
      setStatus('manualSearchStatus', 'Searching Lidarr...');
      list.innerHTML = '<div class="cur-empty">Searching…</div>';
      document.getElementById('manualSearchViewport').style.display = '';
      try {
        var res = await fetch('/api/music/lidarr/manual/search?term=' + encodeURIComponent(term), { headers: { Accept: 'application/json' } });
        var data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || 'Search failed.');
        var results = Array.isArray(data.results) ? data.results : [];
        if (!results.length) {
          DISCOVERY_STATE.manualSearchResults = {
            items: [],
            statusId: 'manualSearchStatus',
            viewportId: 'manualSearchViewport',
            makeCard: function () { return ''; },
          };
          list.innerHTML = '<div class="cur-empty">No artists found.</div>';
          setStatus('manualSearchStatus', '');
          return;
        }
        renderDiscoveryCarousel('manualSearchResults', 'manualSearchStatus', 'manualSearchViewport', results, function(item, index) {
          var primarySrc = String(item.image || '').trim();
          var backupSrc = '/api/music/thumb/artist/' + encodeURIComponent(item.artistName || '');
          var image = primarySrc
            ? '<img src="' + escHtml(primarySrc) + '" data-fallback-src="' + escHtml(backupSrc) + '" alt="" loading="lazy" onerror="handleDiscoveryImageError(this)" />'
            : '<img src="' + escHtml(backupSrc) + '" data-fallback-src="" alt="" loading="lazy" onerror="handleDiscoveryImageError(this)" />';
          var meta = [item.disambiguation, (item.genres || []).join(' · '), item.added ? 'Already in Lidarr' : 'New to Lidarr']
            .filter(Boolean).join(' · ');
          return '' +
            '<button class="plex-card cur-discover-result-card' + (index === 0 ? ' is-active' : '') + (item.added ? ' is-in-lidarr' : '') + '" type="button" ' +
              'data-artist-name="' + escHtml(item.artistName) + '" ' +
              'data-foreign-artist-id="' + escHtml(item.foreignArtistId) + '" ' +
              'onclick="selectManualArtist(this)">' +
              '<span class="plex-poster-wrap cur-discover-poster-wrap">' +
                '<span class="plex-poster-well cur-discover-result-art">' + image + '</span>' +
              '</span>' +
              '<span class="plex-footer cur-discover-result-main">' +
                '<span class="plex-name cur-discover-result-name">' + escHtml(item.artistName) + '</span>' +
                '<span class="plex-meta cur-discover-result-meta">' + escHtml(meta || 'Artist result') + '</span>' +
              '</span>' +
            '</button>';
        });
        list.scrollLeft = 0;
        var first = list.querySelector('.cur-discover-result-card');
        if (first) selectManualArtist(first);
      } catch (err) {
        list.innerHTML = '<div class="cur-empty">Search failed.</div>';
        setStatus('manualSearchStatus', err.message || 'Search failed.');
      }
    }

    async function loadManualAlbumPreview(selection, options) {
      var opts = options && typeof options === 'object' ? options : {};
      currentArtistSelection = {
        artistName: String(selection?.artistName || '').trim(),
        foreignArtistId: String(selection?.foreignArtistId || '').trim()
      };
      document.getElementById('manualAlbumPanel').style.display = '';
      setStatus('manualAlbumStatus', opts.statusMessage || 'Loading album choices...');
      document.getElementById('manualAlbumViewport').style.display = '';
      var preview = document.getElementById('manualAlbumResults');
      preview.className = 'cur-empty';
      preview.innerHTML = 'Loading…';
      try {
        var res = await fetch('/api/music/lidarr/manual/albums', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
          body: JSON.stringify(currentArtistSelection)
        });
        var data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || 'Failed to load albums.');
        renderAlbumPreview(data);
        setStatus('manualAlbumStatus', (data.albums || []).length + ' album option' + ((data.albums || []).length === 1 ? '' : 's') + '.');
      } catch (err) {
        preview.className = 'cur-empty';
        preview.innerHTML = 'Album preview failed.';
        setStatus('manualAlbumStatus', err.message || 'Album preview failed.');
      }
    }

    async function selectManualArtist(button) {
      document.querySelectorAll('.cur-discover-result-card').forEach(function(el) { el.classList.remove('is-active'); });
      if (button) button.classList.add('is-active');
      return loadManualAlbumPreview({
        artistName: button.getAttribute('data-artist-name') || '',
        foreignArtistId: button.getAttribute('data-foreign-artist-id') || ''
      });
    }

    function normalizeManualAlbumTitle(value) {
      return String(value || '')
        .trim()
        .toLowerCase()
        .replace(/&/g, ' and ')
        .replace(/[^a-z0-9]+/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();
    }

    function getManualAlbumStatusMeta(statusKey) {
      if (statusKey === 'available') {
        return { key: 'available', label: 'In library', icon: '', selectable: false };
      }
      if (statusKey === 'pending') {
        return { key: 'pending', label: 'Monitored in Lidarr', icon: '', selectable: false };
      }
      return { key: 'missing', label: 'Not in library', icon: '', selectable: true };
    }

    function getManualAlbumCards(albumTitle) {
      var key = normalizeManualAlbumTitle(albumTitle);
      return Array.from(document.querySelectorAll('#manualAlbumResults .cur-discover-album-card')).filter(function(card) {
        return card.dataset.albumKey === key;
      });
    }

    function closeAllManualAlbumMenus() {
      document.querySelectorAll('#manualAlbumResults .pl-card-menu').forEach(function(menu) {
        menu.style.display = 'none';
      });
    }

    function setManualAlbumExcludedState(card, excluded) {
      if (!card) return;
      card.dataset.albumExcluded = excluded ? '1' : '0';
      card.classList.toggle('is-excluded', !!excluded);
      var toggleBtn = card.querySelector('.cur-discover-album-toggle-exclude');
      if (toggleBtn) {
        toggleBtn.classList.toggle('is-active', !!excluded);
        toggleBtn.title = excluded ? 'Include album' : 'Exclude album';
        toggleBtn.setAttribute('aria-pressed', excluded ? 'true' : 'false');
      }
      var menuExcludeBtn = card.querySelector('.cur-discover-card-menu-exclude');
      if (menuExcludeBtn) menuExcludeBtn.textContent = excluded ? 'Include album' : 'Exclude album';
    }

    function toggleManualAlbumCardMenu(btn) {
      if (!btn) return;
      var menu = btn.parentElement.querySelector('.pl-card-menu');
      if (!menu) return;
      var isOpen = menu.style.display !== 'none';
      closeAllManualAlbumMenus();
      if (!isOpen) menu.style.display = '';
    }

    function updateManualAlbumSelectionBar() {
      var checked = Array.from(document.querySelectorAll('#manualAlbumResults .pl-card-checkbox:checked'));
      var count = document.getElementById('manualAlbumSelectionCount');
      var bar = document.getElementById('manualAlbumSelectionBar');
      var addBtn = document.getElementById('manualAlbumAddSelectedBtn');
      if (!count || !bar || !addBtn) return;
      if (!checked.length) {
        bar.style.display = 'none';
        addBtn.disabled = false;
        return;
      }
      count.textContent = checked.length + ' selected';
      bar.style.display = '';
      addBtn.disabled = false;
    }

    function clearManualAlbumSelection() {
      document.querySelectorAll('#manualAlbumResults .pl-card-checkbox:checked').forEach(function(cb) {
        cb.checked = false;
        var card = cb.closest('.cur-discover-album-card');
        if (card) card.classList.remove('is-selected');
      });
      updateManualAlbumSelectionBar();
    }

    function onManualAlbumCheckChange(cb) {
      var card = cb ? cb.closest('.cur-discover-album-card') : null;
      if (!cb || !card) return;
      if (cb.checked) card.classList.add('is-selected');
      else card.classList.remove('is-selected');
      updateManualAlbumSelectionBar();
    }

    function setManualAlbumCardBusy(card, busy) {
      if (!card) return;
      card.classList.toggle('is-busy', !!busy);
      var controls = card.querySelectorAll('.pl-card-btn, .pl-card-checkbox, .cur-discover-card-menu-add, .cur-discover-card-menu-force-search');
      controls.forEach(function(control) {
        if (busy) {
          control.dataset.wasDisabled = control.disabled ? '1' : '0';
          control.disabled = true;
        } else if (control.dataset.wasDisabled === '0') {
          control.disabled = false;
        }
      });
    }

    function applyManualAlbumCardState(card, statusKey) {
      if (!card) return;
      var meta = getManualAlbumStatusMeta(statusKey);
      var isExcluded = String(card.dataset.albumExcluded || '0') === '1';
      card.dataset.albumStatusKey = meta.key;
      card.dataset.albumRequestable = meta.selectable && !isExcluded ? '1' : '0';
      card.classList.remove('is-status-missing', 'is-status-pending', 'is-status-available', 'is-in-lidarr');
      card.classList.add('is-status-' + meta.key);
      if (meta.key !== 'missing') card.classList.add('is-in-lidarr');

      var statusBadge = card.querySelector('.cur-discover-card-status');
      if (statusBadge) {
        statusBadge.className = 'cur-discover-card-status cur-discover-card-status--' + meta.key;
        statusBadge.title = meta.label;
        statusBadge.setAttribute('aria-label', meta.label);
        statusBadge.style.display = meta.key === 'missing' ? 'none' : '';
        var icon = statusBadge.querySelector('.cur-discover-card-status-icon');
        if (icon) icon.textContent = meta.icon;
      }

      var excludeBtn = card.querySelector('.cur-discover-album-toggle-exclude');
      if (excludeBtn) {
        excludeBtn.classList.toggle('is-hidden', !meta.selectable);
        excludeBtn.disabled = !meta.selectable;
      }

      var menuExcludeBtn = card.querySelector('.cur-discover-card-menu-exclude');
      if (menuExcludeBtn) menuExcludeBtn.hidden = !meta.selectable;

      var statusText = card.querySelector('.cur-discover-album-status-text');
      if (statusText) statusText.textContent = meta.label;

      var addMenuBtn = card.querySelector('.cur-discover-card-menu-add');
      if (addMenuBtn) {
        addMenuBtn.disabled = !meta.selectable || isExcluded;
        addMenuBtn.textContent = meta.selectable ? 'Add album' : meta.label;
      }

      var forceSearchBtn = card.querySelector('.cur-discover-card-menu-force-search');
      if (forceSearchBtn) {
        var canForceSearch = Number(card.dataset.albumId || 0) > 0 && meta.key === 'pending';
        forceSearchBtn.hidden = !canForceSearch;
        forceSearchBtn.disabled = !canForceSearch;
      }

      var checkbox = card.querySelector('.pl-card-checkbox');
      var checkboxWrap = card.querySelector('.pl-card-checkbox-wrap');
      if (checkbox) {
        if (!meta.selectable || isExcluded) {
          checkbox.checked = false;
          checkbox.disabled = true;
          card.classList.remove('is-selected');
        } else if (!card.classList.contains('is-busy')) {
          checkbox.disabled = false;
        }
      }
      if (checkboxWrap) checkboxWrap.classList.toggle('is-hidden', !meta.selectable || isExcluded);
      updateManualAlbumSelectionBar();
    }

    async function toggleManualAlbumExcluded(button, nextExcluded) {
      if (!button) return;
      var card = button.closest('.cur-discover-album-card');
      if (!card) return;
      var parsedNextExcluded = nextExcluded;
      if (typeof parsedNextExcluded === 'string') {
        if (parsedNextExcluded === 'true') parsedNextExcluded = true;
        else if (parsedNextExcluded === 'false') parsedNextExcluded = false;
      }
      var excluded = typeof parsedNextExcluded === 'boolean'
        ? parsedNextExcluded
        : String(card.dataset.albumExcluded || '0') !== '1';
      var payload = {
        artistName: currentArtistSelection?.artistName || '',
        albumTitle: card.dataset.albumTitle || '',
        albumType: card.dataset.albumType || '',
        releaseDate: card.dataset.albumReleaseDate || '',
        lidarrAlbumId: card.dataset.albumId || '',
        excluded: excluded,
      };
      button.disabled = true;
      try {
        var res = await fetch('/api/music/lidarr/manual/album-exclusion', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
          body: JSON.stringify(payload)
        });
        var data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || 'Failed to update exclusion.');
        setManualAlbumExcludedState(card, excluded);
        applyManualAlbumCardState(card, card.dataset.albumStatusKey || 'missing');
        setStatus('manualAlbumStatus', excluded ? 'Album excluded.' : 'Album included.');
      } catch (err) {
        setStatus('manualAlbumStatus', err.message || 'Failed to update exclusion.');
      } finally {
        button.disabled = false;
      }
    }

    function markRequestedAlbum(albumTitle, queued) {
      getManualAlbumCards(albumTitle).forEach(function(card) {
        setManualAlbumCardBusy(card, false);
        applyManualAlbumCardState(card, queued ? 'pending' : 'pending');
      });
    }

    async function requestSingleManualAlbum(albumTitle, options) {
      var opts = options && typeof options === 'object' ? options : {};
      var title = String(albumTitle || '').trim();
      if (!currentArtistSelection || !currentArtistSelection.artistName || !title) return { ok: false };
      var cards = getManualAlbumCards(title);
      if (cards.some(function(card) { return String(card.dataset.albumExcluded || '0') === '1'; })) {
        if (!opts.silent) setStatus('manualAlbumStatus', 'Album is excluded from adds.');
        return { ok: false, excluded: true };
      }
      cards.forEach(function(card) { setManualAlbumCardBusy(card, true); });
      if (!opts.silent) setStatus('manualAlbumStatus', 'Submitting album request…');
      try {
        var payload = {
          artistName: currentArtistSelection.artistName,
          foreignArtistId: currentArtistSelection.foreignArtistId,
          preferredAlbumTitle: title,
          useCuratorrPick: false
        };
        var res = await fetch('/api/music/lidarr/manual/request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
          body: JSON.stringify(payload)
        });
        var data = await res.json();
        if (!res.ok && res.status !== 202) throw new Error(data.error || 'Request failed.');
        if (data.queued) {
          markRequestedAlbum(title, true);
          if (!opts.silent) setStatus('manualAlbumStatus', data.message || 'Queued.');
          return { ok: true, queued: true, data: data };
        }
        var resultAlbumTitle = String(data.result?.album?.albumTitle || data.request?.detail?.selectedAlbumTitle || title || '');
        markRequestedAlbum(title, false);
        if (resultAlbumTitle && normalizeManualAlbumTitle(resultAlbumTitle) !== normalizeManualAlbumTitle(title)) {
          markRequestedAlbum(resultAlbumTitle, false);
        }
        if (!opts.silent) setStatus('manualAlbumStatus', 'Monitored in Lidarr.');
        return { ok: true, queued: false, data: data };
      } catch (err) {
        cards.forEach(function(card) { setManualAlbumCardBusy(card, false); });
        if (!opts.silent) setStatus('manualAlbumStatus', err.message || 'Request failed.');
        throw err;
      }
    }

    async function addSelectedManualAlbums() {
      var selected = Array.from(document.querySelectorAll('#manualAlbumResults .pl-card-checkbox:checked'))
        .map(function(cb) { return cb.closest('.cur-discover-album-card'); })
        .filter(Boolean)
        .map(function(card) {
          return {
            kind: String(card.dataset.manualKind || 'album'),
            albumTitle: String(card.dataset.albumTitle || '').trim(),
          };
        })
        .filter(function(item) {
          return item.kind === 'curatorr-pick' || item.albumTitle;
        });
      var selections = [];
      var seen = new Set();
      selected.forEach(function(item) {
        var key = item.kind + '|' + item.albumTitle;
        if (seen.has(key)) return;
        seen.add(key);
        selections.push(item);
      });
      if (!selections.length) return;
      var addBtn = document.getElementById('manualAlbumAddSelectedBtn');
      if (addBtn) addBtn.disabled = true;
      var added = 0;
      var failed = 0;
      for (var i = 0; i < selections.length; i += 1) {
        try {
          if (selections[i].kind === 'curatorr-pick') {
            await submitManualRequest(true, '', { silent: true });
          } else {
            await requestSingleManualAlbum(selections[i].albumTitle, { silent: true });
          }
          added += 1;
        } catch (_err) {
          failed += 1;
        }
      }
      clearManualAlbumSelection();
      if (addBtn) addBtn.disabled = false;
      if (failed) setStatus('manualAlbumStatus', added ? ('Monitored ' + added + ', failed ' + failed + '.') : ('Failed to monitor ' + failed + ' selection' + (failed === 1 ? '' : 's') + '.'));
      else setStatus('manualAlbumStatus', 'Monitored ' + added + ' selection' + (added === 1 ? '' : 's') + ' in Lidarr.');
    }

    function addManualAlbumFromMenu(btn) {
      if (!btn || btn.disabled) return;
      var card = btn.closest('.cur-discover-album-card');
      if (!card) return;
      closeAllManualAlbumMenus();
      if (String(card.dataset.manualKind || 'album') === 'curatorr-pick') {
        submitManualRequest(true);
        return;
      }
      requestSingleManualAlbum(card.dataset.albumTitle || '');
    }

    async function forceSearchManualAlbum(btn) {
      if (!btn || btn.disabled) return;
      var card = btn.closest('.cur-discover-album-card');
      if (!card) return;
      var albumId = Number(card.dataset.albumId || 0) || 0;
      var albumTitle = String(card.dataset.albumTitle || '').trim();
      if (!albumId || !albumTitle) {
        setStatus('manualAlbumStatus', 'This album cannot be searched directly from Lidarr.');
        return;
      }
      closeAllManualAlbumMenus();
      var originalText = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Searching...';
      setManualAlbumCardBusy(card, true);
      setStatus('manualAlbumStatus', 'Queueing Lidarr search...');
      try {
        var res = await fetch('/api/music/lidarr/manual/force-search', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
          body: JSON.stringify({
            artistName: currentArtistSelection?.artistName || '',
            albumTitle: albumTitle,
            lidarrAlbumId: albumId,
            albumType: card.dataset.albumType || '',
            releaseDate: card.dataset.albumReleaseDate || '',
          })
        });
        var data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || 'Force search failed.');
        getManualAlbumCards(albumTitle).forEach(function(albumCard) {
          setManualAlbumCardBusy(albumCard, false);
          applyManualAlbumCardState(albumCard, 'pending');
        });
        btn.textContent = originalText;
        setStatus('manualAlbumStatus', 'Search queued in Lidarr.');
      } catch (err) {
        setManualAlbumCardBusy(card, false);
        btn.disabled = false;
        btn.textContent = originalText;
        setStatus('manualAlbumStatus', err.message || 'Force search failed.');
      }
    }

    window.curatorrOverviewHandleAction = function(kind, payload, button) {
      if (kind === 'manual-discovery-add-curatorr-pick') {
        if (button && button.disabled) return;
        if (button) button.disabled = true;
        submitManualRequest(true, '', { silent: false })
          .then(function() {
            if (button) {
              button.textContent = 'Already added';
              button.classList.add('is-disabled');
            }
          })
          .catch(function() {
            if (button) button.disabled = false;
          });
        return;
      }
      if (kind !== 'manual-discovery-add-album') return;
      if (!payload || !payload.albumTitle || (button && button.disabled)) return;
      if (button) button.disabled = true;
      requestSingleManualAlbum(payload.albumTitle || '', { silent: false })
        .then(function() {
          if (button) {
            button.textContent = 'Already added';
            button.classList.add('is-disabled');
          }
        })
        .catch(function() {
          if (button) button.disabled = false;
        });
    };

    function renderAlbumPreview(data) {
      var preview = document.getElementById('manualAlbumResults');
      var viewport = document.getElementById('manualAlbumViewport');
      var albums = Array.isArray(data.albums) ? data.albums : [];
      var albumImageByTitle = new Map();
      albums.forEach(function(album) {
        var key = normalizeManualAlbumTitle(album && album.title);
        var image = String(album && album.image || '').trim();
        if (key && image && !albumImageByTitle.has(key)) albumImageByTitle.set(key, image);
      });
      var curatorrPickPreview = (Array.isArray(data.curatorrPickPreview) ? data.curatorrPickPreview : [])
        .slice(0, 4)
        .map(function(album) {
          var key = normalizeManualAlbumTitle(album && album.title);
          var fallbackImage = key ? albumImageByTitle.get(key) : '';
          if (!fallbackImage && key) {
            for (var entry of albumImageByTitle.entries()) {
              if (entry[0] === key || entry[0].includes(key) || key.includes(entry[0])) {
                fallbackImage = entry[1];
                break;
              }
            }
          }
          return Object.assign({}, album, {
            image: String(fallbackImage || '').trim() || String(album && album.image || '').trim(),
          });
        });
      if (viewport) viewport.style.display = '';
      var items = [{
        kind: 'fallback',
        title: 'Let Curatorr choose for you',
        meta: 'Prefers greatest hits first, then highest-ranked fallback albums if needed.',
        previewAlbums: curatorrPickPreview
      }].concat(albums.map(function(album) {
        var meta = getManualAlbumStatusMeta(String(album.statusKey || 'missing').trim().toLowerCase());
        return {
          kind: 'album',
          title: album.title || '',
          albumId: album.albumId || '',
          foreignAlbumId: album.foreignAlbumId || '',
          albumType: album.albumType || '',
          releaseDate: album.releaseDate || '',
          source: album.source || '',
          image: album.image || '',
          excluded: album.excluded === true,
          statusKey: meta.key,
          statusLabel: album.statusLabel || meta.label,
          requestable: album.requestable === true || album.requestable === 'true',
          meta: [album.albumType || '', fmtClientReleaseDate(album.releaseDate), album.source || ''].filter(Boolean).join(' · ') || 'Album option',
        };
      }));

      function renderCuratorrPickPreview(albumsForPreview) {
        var slots = Array.isArray(albumsForPreview) ? albumsForPreview.slice(0, 4) : [];
        while (slots.length < 4) slots.push(null);
        return '<span class="cur-discover-fallback-grid">' + slots.map(function(album, index) {
          if (!album || !album.image) {
            return ''
              + '<span class="cur-discover-fallback-slot is-empty" data-slot="' + (index + 1) + '">'
              + '</span>';
          }
          return ''
            + '<span class="cur-discover-fallback-slot" data-slot="' + (index + 1) + '" title="' + escHtml(album.title || ('Pick ' + (index + 1))) + '">'
            +   '<img src="' + escHtml(album.image) + '" alt="" onerror="this.parentElement.classList.add(\'is-empty\');this.remove()" />'
            + '</span>';
        }).join('') + '</span>';
      }

      renderDiscoveryCarousel('manualAlbumResults', 'manualAlbumStatus', 'manualAlbumViewport', items, function(item) {
        if (item.kind === 'fallback') {
          return '' +
            '<div class="plex-card cur-discover-result-card cur-discover-album-card cur-discover-fallback-card" data-manual-kind="curatorr-pick">' +
              '<span class="plex-poster-wrap cur-discover-poster-wrap">' +
                '<span class="plex-poster-well cur-discover-result-art cur-discover-album-art cur-discover-album-art--fallback">' +
                  renderCuratorrPickPreview(item.previewAlbums) +
                  '<label class="pl-card-checkbox-wrap" title="Select Curatorr pick" onclick="event.stopPropagation()">' +
                    '<input type="checkbox" class="pl-card-checkbox" onchange="onManualAlbumCheckChange(this)" />' +
                    '<span class="pl-card-checkbox-ui"></span>' +
                  '</label>' +
                  '<button class="pl-card-btn pl-card-btn--view" type="button" title="View album order" data-cur-overview-kind="manual-curatorr-pick" data-cur-overview-artist="' + escHtml(currentArtistSelection?.artistName || '') + '" data-cur-overview-foreign-artist-id="' + escHtml(currentArtistSelection?.foreignArtistId || '') + '">' +
                    '<img src="/icons/view.svg" alt="View" />' +
                  '</button>' +
                  '<div class="pl-card-dots-wrap">' +
                    '<button class="pl-card-btn pl-card-btn--dots" type="button" title="More options" onclick="event.stopPropagation(); toggleManualAlbumCardMenu(this)">⋯</button>' +
                    '<div class="pl-card-menu" style="display:none">' +
                      '<button type="button" class="cur-discover-card-menu-add" onclick="event.stopPropagation(); addManualAlbumFromMenu(this)">Use Curatorr pick</button>' +
                    '</div>' +
                  '</div>' +
                '</span>' +
              '</span>' +
              '<span class="plex-footer cur-discover-result-main cur-discover-album-main">' +
                '<span class="plex-name cur-discover-result-name cur-discover-album-title">Let <img class="cur-discover-title-icon" src="/icons/curatorr-icon.svg" alt="Curatorr" loading="lazy" /> choose for you</span>' +
                '<span class="plex-meta cur-discover-result-meta cur-discover-album-meta">' + escHtml(item.meta) + '</span>' +
              '</span>' +
            '</div>';
        }
        var statusMeta = getManualAlbumStatusMeta(item.statusKey);
        var art = item.image
          ? '<img src="' + escHtml(item.image) + '" alt="" loading="lazy" />'
          : '';
        var canForceSearch = Number(item.albumId || 0) > 0 && statusMeta.key === 'pending';
        return '' +
          '<div class="plex-card cur-discover-result-card cur-discover-album-card is-status-' + statusMeta.key + (statusMeta.key !== 'missing' ? ' is-in-lidarr' : '') + '"' +
            ' data-album-title="' + escHtml(item.title) + '"' +
            ' data-album-key="' + escHtml(normalizeManualAlbumTitle(item.title)) + '"' +
            ' data-album-id="' + escHtml(item.albumId || '') + '"' +
            ' data-album-type="' + escHtml(item.albumType || '') + '"' +
            ' data-album-release-date="' + escHtml(item.releaseDate || '') + '"' +
            ' data-album-status-key="' + escHtml(statusMeta.key) + '"' +
            ' data-album-requestable="' + (item.requestable ? '1' : '0') + '"' +
            ' data-album-excluded="' + (item.excluded ? '1' : '0') + '">' +
            '<span class="plex-poster-wrap cur-discover-poster-wrap">' +
              '<span class="plex-poster-well cur-discover-result-art cur-discover-album-art' + (item.image ? '' : ' is-empty') + '">' +
                art +
                (statusMeta.selectable
                  ? '<label class="pl-card-checkbox-wrap" title="Select album" onclick="event.stopPropagation()">' +
                      '<input type="checkbox" class="pl-card-checkbox" onchange="onManualAlbumCheckChange(this)" />' +
                      '<span class="pl-card-checkbox-ui"></span>' +
                    '</label>'
                  : '') +
                (statusMeta.key === 'missing' ? '' :
                  '<span class="cur-discover-card-status cur-discover-card-status--' + statusMeta.key + '" title="' + escHtml(item.statusLabel) + '" aria-label="' + escHtml(item.statusLabel) + '">' +
                    '<span class="cur-discover-card-status-icon"></span>' +
                  '</span>') +
                '<button class="pl-card-btn pl-card-btn--view" type="button" title="View album" data-cur-overview-kind="manual-album" data-cur-overview-artist="' + escHtml(currentArtistSelection?.artistName || '') + '" data-cur-overview-album="' + escHtml(item.title) + '" data-cur-overview-album-id="' + escHtml(item.albumId || '') + '" data-cur-overview-foreign-album-id="' + escHtml(item.foreignAlbumId || '') + '" data-cur-overview-source="' + escHtml(item.source || '') + '" data-cur-overview-album-type="' + escHtml(item.albumType || '') + '" data-cur-overview-release-date="' + escHtml(item.releaseDate || '') + '" data-cur-overview-status-key="' + escHtml(statusMeta.key) + '" data-cur-overview-status-label="' + escHtml(item.statusLabel || statusMeta.label) + '" data-cur-overview-thumb="' + escHtml(item.image || '') + '">' +
                  '<img src="/icons/view.svg" alt="View" />' +
                '</button>' +
                '<button class="pl-card-btn pl-card-btn--exclude cur-discover-album-toggle-exclude' + (item.excluded ? ' is-active' : '') + (statusMeta.selectable ? '' : ' is-hidden') + '" type="button" title="' + escHtml(item.excluded ? 'Include album' : 'Exclude album') + '" aria-pressed="' + (item.excluded ? 'true' : 'false') + '" onclick="event.stopPropagation(); toggleManualAlbumExcluded(this)">' +
                  '<img src="/icons/view-off.svg" alt="Exclude" />' +
                '</button>' +
                '<div class="pl-card-dots-wrap">' +
                  '<button class="pl-card-btn pl-card-btn--dots" type="button" title="More options" onclick="event.stopPropagation(); toggleManualAlbumCardMenu(this)">⋯</button>' +
                  '<div class="pl-card-menu" style="display:none">' +
                    '<button type="button" class="cur-discover-card-menu-add" onclick="event.stopPropagation(); addManualAlbumFromMenu(this)"' + (item.requestable ? '' : ' disabled') + '>' + (item.requestable ? 'Add album' : escHtml(item.statusLabel)) + '</button>' +
                    '<button type="button" class="cur-discover-card-menu-force-search"' + (canForceSearch ? '' : ' hidden disabled') + ' onclick="event.stopPropagation(); forceSearchManualAlbum(this)">Force search</button>' +
                    '<button type="button" class="cur-discover-card-menu-exclude"' + (statusMeta.selectable ? '' : ' hidden') + ' onclick="event.stopPropagation(); toggleManualAlbumExcluded(this, ' + (item.excluded ? 'false' : 'true') + ')">' + (item.excluded ? 'Include album' : 'Exclude album') + '</button>' +
                  '</div>' +
                '</div>' +
              '</span>' +
            '</span>' +
            '<span class="plex-footer cur-discover-result-main cur-discover-album-main">' +
              '<span class="plex-name cur-discover-result-name cur-discover-album-title">' + escHtml(item.title) + '</span>' +
              '<span class="plex-meta cur-discover-result-meta cur-discover-album-meta">' + escHtml(item.meta) + '</span>' +
            '</span>' +
          '</div>';
      });

      clearManualAlbumSelection();
      Array.from(document.querySelectorAll('#manualAlbumResults .cur-discover-album-card')).forEach(function(card) {
        if (String(card.dataset.manualKind || 'album') === 'curatorr-pick') return;
        setManualAlbumExcludedState(card, card.dataset.albumExcluded === '1');
        applyManualAlbumCardState(card, card.dataset.albumStatusKey || 'missing');
      });

      if (!albums.length) {
        setStatus('manualAlbumStatus', 'No albums were returned. You can still use Curatorr pick.');
        return;
      }
    }

    async function submitManualRequest(useCuratorrPick, albumTitle, options) {
      var opts = options && typeof options === 'object' ? options : {};
      if (!currentArtistSelection || !currentArtistSelection.artistName) return;
      if (!useCuratorrPick) {
        return requestSingleManualAlbum(albumTitle || '', { silent: !!opts.silent });
      }
      var fallbackCards = Array.from(document.querySelectorAll('#manualAlbumResults .cur-discover-fallback-card'));
      fallbackCards.forEach(function(card) { setManualAlbumCardBusy(card, true); });
      if (!opts.silent) setStatus('manualAlbumStatus', 'Submitting Curatorr pick…');
      try {
        var res = await fetch('/api/music/lidarr/manual/request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
          body: JSON.stringify({
            artistName: currentArtistSelection.artistName,
            foreignArtistId: currentArtistSelection.foreignArtistId,
            preferredAlbumTitle: '',
            useCuratorrPick: true
          })
        });
        var data = await res.json();
        if (!res.ok && res.status !== 202) throw new Error(data.error || 'Request failed.');
        if (!opts.silent) setStatus('manualAlbumStatus', data.queued ? (data.message || 'Queued.') : 'Monitored in Lidarr.');
        var resultAlbumTitle = String(data.result?.album?.albumTitle || data.request?.detail?.selectedAlbumTitle || '');
        if (resultAlbumTitle) markRequestedAlbum(resultAlbumTitle, false);
        clearManualAlbumSelection();
        return { ok: true, queued: !!data.queued, data: data };
      } catch (err) {
        if (!opts.silent) setStatus('manualAlbumStatus', err.message || 'Request failed.');
        throw err;
      } finally {
        fallbackCards.forEach(function(card) { setManualAlbumCardBusy(card, false); });
      }
    }

    var searchBtn = document.getElementById('manualArtistSearchBtn');
    if (searchBtn) searchBtn.addEventListener('click', runArtistSearch);
    var artistPrevBtn = document.getElementById('discoverArtistPrev');
    if (artistPrevBtn) artistPrevBtn.addEventListener('click', function() { scrollDiscovery('manualSearchViewport', -1); });
    var artistNextBtn = document.getElementById('discoverArtistNext');
    if (artistNextBtn) artistNextBtn.addEventListener('click', function() { scrollDiscovery('manualSearchViewport', 1); });
    var albumPrevBtn = document.getElementById('manualAlbumPrev');
    if (albumPrevBtn) albumPrevBtn.addEventListener('click', function() { scrollDiscovery('manualAlbumViewport', -1); });
    var albumNextBtn = document.getElementById('manualAlbumNext');
    if (albumNextBtn) albumNextBtn.addEventListener('click', function() { scrollDiscovery('manualAlbumViewport', 1); });
    var searchInput = document.getElementById('manualArtistSearch');
    if (searchInput) {
      searchInput.addEventListener('keydown', function(event) {
        if (event.key === 'Enter') {
          event.preventDefault();
          runArtistSearch();
        }
      });
    }
    document.addEventListener('click', function(event) {
      if (event.target.closest('#manualAlbumResults .pl-card-dots-wrap, #recentAddedAlbumsList .pl-card-dots-wrap, #recentRequestedAlbumsList .pl-card-dots-wrap')) return;
      closeAllManualAlbumMenus();
      closeRecentAlbumMenus();
    });
    // ── Discovery carousels ────────────────────────────────────────────────
    var DISCOVERY_CONFIG = <%- JSON.stringify(_disc) %>;
    var PRELOADED_DISCOVERY_ALBUMS = {
      recentAdded: <%- JSON.stringify(_recentAddedAlbums) %>,
      recentRequested: <%- JSON.stringify(_recentRequestedAlbums) %>
    };
    var DISCOVERY_STATE = Object.create(null);

    function renderDiscoveryState(listId) {
      var state = DISCOVERY_STATE[listId];
      if (!state) return;
      var list = document.getElementById(listId);
      var status = document.getElementById(state.statusId);
      if (!list) return;

      var items = Array.isArray(state.items) ? state.items : [];
      if (!items.length) {
        list.className = 'cur-empty';
        list.textContent = 'No results available.';
        if (status) status.textContent = '';
        return;
      }

      list.className = 'cur-discover-carousel-list plex-carousel-track';
      list.innerHTML = items.map(function (item, index) {
        return state.makeCard(item, index);
      }).join('');
      if (status) {
        status.textContent = typeof state.statusFormatter === 'function'
          ? state.statusFormatter(items)
          : (items.length + ' result' + (items.length === 1 ? '' : 's') + '.');
      }
      bindDiscoveryDrag(state.viewportId);
    }

    function makeDiscoveryCard(name, sub, imageUrl, fallbackArtistName) {
      var fallbackName = String(fallbackArtistName || name || '').trim();
      var fallbackSrc = fallbackName ? '/api/music/thumb/artist/' + encodeURIComponent(fallbackName) : '';
      var img = imageUrl
        ? '<span class="plex-poster-well cur-discover-result-art"><img src="' + escHtml(imageUrl) + '" data-fallback-src="' + escHtml(fallbackSrc) + '" alt="" onerror="handleDiscoveryImageError(this)" /></span>'
        : (fallbackSrc
          ? '<span class="plex-poster-well cur-discover-result-art"><img src="' + escHtml(fallbackSrc) + '" data-fallback-src="" alt="" onerror="handleDiscoveryImageError(this)" /></span>'
          : '<span class="plex-poster-well cur-discover-result-art is-empty"></span>');
      return '<button class="plex-card cur-discover-result-card" type="button" data-discovery-artist="' + escHtml(name) + '" onclick="prefillDiscoveryArtist(this)">' +
        '<span class="plex-poster-wrap cur-discover-poster-wrap">' +
          img +
        '</span>' +
        '<span class="plex-footer cur-discover-result-main">' +
          '<span class="plex-name cur-discover-result-name">' + escHtml(name) + '</span>' +
          '<span class="plex-meta cur-discover-result-meta">' + escHtml(sub || '') + '</span>' +
        '</span>' +
      '</button>';
    }

    function prefillDiscoveryArtist(btn) {
      var name = btn && btn.getAttribute('data-discovery-artist');
      if (!name) return;
      var input = document.getElementById('manualArtistSearch');
      if (!input) return;
      input.value = name;
      input.scrollIntoView({ behavior: 'smooth', block: 'center' });
      if (typeof runArtistSearch === 'function') runArtistSearch();
    }

    function handleDiscoveryImageError(img) {
      if (!img) return;
      var fallback = String(img.getAttribute('data-fallback-src') || '').trim();
      if (fallback && img.getAttribute('src') !== fallback) {
        img.setAttribute('src', fallback);
        img.setAttribute('data-fallback-src', '');
        return;
      }
      var art = img.parentElement;
      if (art) art.classList.add('is-empty');
      img.remove();
    }

    function bindDiscoveryDrag(viewportId) {
      var vp = document.getElementById(viewportId);
      if (!vp) return;
      if (vp.getAttribute('data-discovery-drag-bound') === '1') return;
      vp.setAttribute('data-discovery-drag-bound', '1');
      var down = false, startX = 0, startScroll = 0, moved = false;
      vp.addEventListener('pointerdown', function(e) {
        if (e.pointerType === 'mouse') return;
        down = true; moved = false; startX = e.clientX; startScroll = vp.scrollLeft;
        vp.classList.add('is-dragging');
        if (vp.setPointerCapture) vp.setPointerCapture(e.pointerId);
      });
      vp.addEventListener('pointermove', function(e) {
        if (!down) return;
        var d = e.clientX - startX;
        if (Math.abs(d) > 6) moved = true;
        vp.scrollLeft = startScroll - d;
      });
      function end(e) {
        if (!down) return; down = false;
        vp.classList.remove('is-dragging');
        if (e && vp.releasePointerCapture) try { vp.releasePointerCapture(e.pointerId); } catch(_) {}
      }
      vp.addEventListener('pointerup', end);
      vp.addEventListener('pointercancel', end);
      vp.addEventListener('pointerleave', function(e) { if (e.pointerType !== 'mouse') end(e); });
      vp.addEventListener('click', function(e) { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } }, true);
    }

    function scrollDiscovery(viewportId, dir) {
      var vp = document.getElementById(viewportId);
      if (vp) vp.scrollBy({ left: dir * Math.max(280, Math.floor(vp.clientWidth * 0.8)), behavior: 'smooth' });
    }

    function renderDiscoveryCarousel(listId, statusId, viewportId, items, makeCard, options) {
      var opts = options && typeof options === 'object' ? options : {};
      DISCOVERY_STATE[listId] = {
        items: Array.isArray(items) ? items : [],
        statusId: statusId,
        viewportId: viewportId,
        makeCard: makeCard,
        statusFormatter: typeof opts.statusFormatter === 'function' ? opts.statusFormatter : null,
      };
      renderDiscoveryState(listId);
    }

    function loadDiscovery(url, listId, statusId, viewportId, makeCard) {
      var controller = new AbortController();
      var timer = setTimeout(function() { controller.abort(); }, 12000);
      fetch(url, { headers: { Accept: 'application/json' }, signal: controller.signal })
        .then(function(r) { clearTimeout(timer); return r.json(); })
        .then(function(data) {
          if (!data.ok) throw new Error(data.error || 'Failed to load.');
          renderDiscoveryCarousel(listId, statusId, viewportId, data.items || [], makeCard);
        })
        .catch(function(err) {
          clearTimeout(timer);
          var list = document.getElementById(listId);
          var msg = err && err.name === 'AbortError' ? 'Timed out — check your Last.fm connection in Settings.' : 'Failed to load results.';
          if (list) { list.className = 'cur-empty'; list.textContent = msg; }
        });
    }

    function bindDiscoveryNav(prevId, nextId, viewportId) {
      var prev = document.getElementById(prevId);
      var next = document.getElementById(nextId);
      if (prev) prev.addEventListener('click', function() { scrollDiscovery(viewportId, -1); });
      if (next) next.addEventListener('click', function() { scrollDiscovery(viewportId,  1); });
    }

    function closeRecentAlbumMenus() {
      document.querySelectorAll('#recentAddedAlbumsList .pl-card-menu, #recentRequestedAlbumsList .pl-card-menu').forEach(function(menu) {
        menu.style.display = 'none';
      });
    }

    function toggleRecentAlbumCardMenu(btn) {
      if (!btn) return;
      var menu = btn.parentElement.querySelector('.pl-card-menu');
      if (!menu) return;
      var isOpen = menu.style.display !== 'none';
      closeAllManualAlbumMenus();
      closeRecentAlbumMenus();
      if (!isOpen) menu.style.display = '';
    }

    function getDiscoveryAlbumCardsByIdentity(artistName, albumTitle) {
      var artistKey = String(artistName || '').trim().toLowerCase();
      var albumKey = normalizeManualAlbumTitle(albumTitle);
      if (!artistKey || !albumKey) return [];
      return Array.from(document.querySelectorAll('.cur-discover-album-card[data-artist-name][data-album-key]')).filter(function(card) {
        return String(card.dataset.artistName || '').trim().toLowerCase() === artistKey
          && String(card.dataset.albumKey || '').trim() === albumKey;
      });
    }

    function markDiscoveryAlbumRequested(artistName, albumTitle, queued) {
      getDiscoveryAlbumCardsByIdentity(artistName, albumTitle).forEach(function(card) {
        setManualAlbumCardBusy(card, false);
        applyManualAlbumCardState(card, queued ? 'pending' : 'pending');
      });
    }

    async function requestRecentAlbumFromCard(card, options) {
      var opts = options && typeof options === 'object' ? options : {};
      if (!card) return { ok: false };
      var artistName = String(card.dataset.artistName || '').trim();
      var albumTitle = String(card.dataset.albumTitle || '').trim();
      if (!artistName || !albumTitle) return { ok: false };
      var matchingCards = getDiscoveryAlbumCardsByIdentity(artistName, albumTitle);
      matchingCards.forEach(function(matchCard) { setManualAlbumCardBusy(matchCard, true); });
      if (!opts.silent) setStatus(opts.statusId || 'artistSuggestionStatus', 'Submitting album request…');
      try {
        var res = await fetch('/api/music/lidarr/manual/request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
          body: JSON.stringify({
            artistName: artistName,
            foreignArtistId: String(card.dataset.foreignArtistId || '').trim(),
            preferredAlbumTitle: albumTitle,
            useCuratorrPick: false
          })
        });
        var data = await res.json();
        if (!res.ok && res.status !== 202) throw new Error(data.error || 'Request failed.');
        markDiscoveryAlbumRequested(artistName, albumTitle, !!data.queued);
        if (!opts.silent) {
          setStatus(opts.statusId || 'artistSuggestionStatus', data.queued ? (data.message || 'Queued.') : 'Monitored in Lidarr.');
        }
        return { ok: true, queued: !!data.queued, data: data };
      } catch (err) {
        matchingCards.forEach(function(matchCard) { setManualAlbumCardBusy(matchCard, false); });
        if (!opts.silent) setStatus(opts.statusId || 'artistSuggestionStatus', err.message || 'Request failed.');
        throw err;
      }
    }

    async function forceSearchRecentAlbum(btn, statusId) {
      if (!btn || btn.disabled) return;
      var card = btn.closest('.cur-discover-album-card');
      if (!card) return;
      var albumId = Number(card.dataset.albumId || 0) || 0;
      var albumTitle = String(card.dataset.albumTitle || '').trim();
      var artistName = String(card.dataset.artistName || '').trim();
      if (!albumId || !albumTitle || !artistName) {
        setStatus(statusId || 'artistSuggestionStatus', 'This album cannot be searched directly from Lidarr.');
        return;
      }
      closeRecentAlbumMenus();
      var originalText = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Searching...';
      var matchingCards = getDiscoveryAlbumCardsByIdentity(artistName, albumTitle);
      matchingCards.forEach(function(matchCard) { setManualAlbumCardBusy(matchCard, true); });
      setStatus(statusId || 'artistSuggestionStatus', 'Queueing Lidarr search...');
      try {
        var res = await fetch('/api/music/lidarr/manual/force-search', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
          body: JSON.stringify({
            artistName: artistName,
            albumTitle: albumTitle,
            lidarrAlbumId: albumId,
            albumType: card.dataset.albumType || '',
            releaseDate: card.dataset.albumReleaseDate || '',
          })
        });
        var data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || 'Force search failed.');
        matchingCards.forEach(function(matchCard) {
          setManualAlbumCardBusy(matchCard, false);
          applyManualAlbumCardState(matchCard, 'pending');
        });
        btn.textContent = originalText;
        setStatus(statusId || 'artistSuggestionStatus', 'Search queued in Lidarr.');
      } catch (err) {
        matchingCards.forEach(function(matchCard) { setManualAlbumCardBusy(matchCard, false); });
        btn.disabled = false;
        btn.textContent = originalText;
        setStatus(statusId || 'artistSuggestionStatus', err.message || 'Force search failed.');
      }
    }

    async function toggleRecentAlbumExcluded(button, nextExcluded, statusId) {
      if (!button) return;
      var card = button.closest('.cur-discover-album-card');
      if (!card) return;
      var parsedNextExcluded = nextExcluded;
      if (typeof parsedNextExcluded === 'string') {
        if (parsedNextExcluded === 'true') parsedNextExcluded = true;
        else if (parsedNextExcluded === 'false') parsedNextExcluded = false;
      }
      var excluded = typeof parsedNextExcluded === 'boolean'
        ? parsedNextExcluded
        : String(card.dataset.albumExcluded || '0') !== '1';
      var payload = {
        artistName: String(card.dataset.artistName || '').trim(),
        albumTitle: card.dataset.albumTitle || '',
        albumType: card.dataset.albumType || '',
        releaseDate: card.dataset.albumReleaseDate || '',
        lidarrAlbumId: card.dataset.albumId || '',
        excluded: excluded,
      };
      button.disabled = true;
      try {
        var res = await fetch('/api/music/lidarr/manual/album-exclusion', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= csrfToken %>' },
          body: JSON.stringify(payload)
        });
        var data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || 'Failed to update exclusion.');
        getDiscoveryAlbumCardsByIdentity(payload.artistName, payload.albumTitle).forEach(function(matchCard) {
          setManualAlbumExcludedState(matchCard, excluded);
          applyManualAlbumCardState(matchCard, matchCard.dataset.albumStatusKey || 'missing');
        });
        setStatus(statusId || 'artistSuggestionStatus', excluded ? 'Album excluded.' : 'Album included.');
      } catch (err) {
        setStatus(statusId || 'artistSuggestionStatus', err.message || 'Failed to update exclusion.');
      } finally {
        button.disabled = false;
      }
    }

    function addRecentAlbumFromMenu(btn, statusId) {
      if (!btn || btn.disabled) return;
      var card = btn.closest('.cur-discover-album-card');
      if (!card) return;
      closeRecentAlbumMenus();
      requestRecentAlbumFromCard(card, { statusId: statusId || 'artistSuggestionStatus' });
    }

    function makeRecentAlbumCard(item, statusId) {
      var statusMeta = getManualAlbumStatusMeta(String(item && item.statusKey || 'missing').trim().toLowerCase());
      var fallbackSrc = item && item.artistName ? '/api/music/thumb/artist/' + encodeURIComponent(item.artistName) : '';
      var art = item && item.image
        ? '<img src="' + escHtml(item.image) + '" data-fallback-src="' + escHtml(fallbackSrc) + '" alt="" loading="lazy" onerror="handleDiscoveryImageError(this)" />'
        : (fallbackSrc
          ? '<img src="' + escHtml(fallbackSrc) + '" data-fallback-src="" alt="" loading="lazy" onerror="handleDiscoveryImageError(this)" />'
          : '');
      var canForceSearch = Number(item && item.albumId || 0) > 0 && statusMeta.key === 'pending';
      return '' +
        '<div class="plex-card cur-discover-result-card cur-discover-album-card cur-discover-top-album-card is-status-' + statusMeta.key + (statusMeta.key !== 'missing' ? ' is-in-lidarr' : '') + '"' +
          ' data-artist-name="' + escHtml(item && item.artistName || '') + '"' +
          ' data-foreign-artist-id="' + escHtml(item && item.foreignArtistId || '') + '"' +
          ' data-album-title="' + escHtml(item && item.albumTitle || '') + '"' +
          ' data-album-key="' + escHtml(normalizeManualAlbumTitle(item && item.albumTitle || '')) + '"' +
          ' data-album-id="' + escHtml(item && item.albumId || '') + '"' +
          ' data-album-type="' + escHtml(item && item.albumType || '') + '"' +
          ' data-album-release-date="' + escHtml(item && item.releaseDate || '') + '"' +
          ' data-album-status-key="' + escHtml(statusMeta.key) + '"' +
          ' data-album-requestable="' + (item && item.requestable ? '1' : '0') + '"' +
          ' data-album-excluded="' + (item && item.excluded ? '1' : '0') + '">' +
          '<span class="plex-poster-wrap cur-discover-poster-wrap">' +
            '<span class="plex-poster-well cur-discover-result-art cur-discover-album-art' + (art ? '' : ' is-empty') + '">' +
              art +
              (statusMeta.key === 'missing' ? '' :
                '<span class="cur-discover-card-status cur-discover-card-status--' + statusMeta.key + '" title="' + escHtml(item && item.statusLabel || statusMeta.label) + '" aria-label="' + escHtml(item && item.statusLabel || statusMeta.label) + '">' +
                  '<span class="cur-discover-card-status-icon"></span>' +
                '</span>') +
              '<button class="pl-card-btn pl-card-btn--view" type="button" title="View album" data-cur-overview-kind="manual-album" data-cur-overview-artist="' + escHtml(item && item.artistName || '') + '" data-cur-overview-album="' + escHtml(item && item.albumTitle || '') + '" data-cur-overview-album-id="' + escHtml(item && item.albumId || '') + '" data-cur-overview-foreign-album-id="' + escHtml(item && item.foreignAlbumId || '') + '" data-cur-overview-source="' + escHtml(item && item.source || '') + '" data-cur-overview-album-type="' + escHtml(item && item.albumType || '') + '" data-cur-overview-release-date="' + escHtml(item && item.releaseDate || '') + '" data-cur-overview-status-key="' + escHtml(statusMeta.key) + '" data-cur-overview-status-label="' + escHtml(item && item.statusLabel || statusMeta.label) + '" data-cur-overview-thumb="' + escHtml(item && item.image || '') + '">' +
                '<img src="/icons/view.svg" alt="View" />' +
              '</button>' +
              '<button class="pl-card-btn pl-card-btn--exclude cur-discover-album-toggle-exclude' + (item && item.excluded ? ' is-active' : '') + (statusMeta.selectable ? '' : ' is-hidden') + '" type="button" title="' + escHtml(item && item.excluded ? 'Include album' : 'Exclude album') + '" aria-pressed="' + (item && item.excluded ? 'true' : 'false') + '" onclick="event.stopPropagation(); toggleRecentAlbumExcluded(this, undefined, \'' + escHtml(statusId) + '\')">' +
                '<img src="/icons/view-off.svg" alt="Exclude" />' +
              '</button>' +
              '<div class="pl-card-dots-wrap">' +
                '<button class="pl-card-btn pl-card-btn--dots" type="button" title="More options" onclick="event.stopPropagation(); toggleRecentAlbumCardMenu(this)">⋯</button>' +
                '<div class="pl-card-menu" style="display:none">' +
                  '<button type="button" class="cur-discover-card-menu-add" onclick="event.stopPropagation(); addRecentAlbumFromMenu(this, \'' + escHtml(statusId) + '\')"' + (item && item.requestable ? '' : ' disabled') + '>' + escHtml(item && item.requestable ? 'Add album' : (item && item.statusLabel || statusMeta.label)) + '</button>' +
                  '<button type="button" class="cur-discover-card-menu-force-search"' + (canForceSearch ? '' : ' hidden disabled') + ' onclick="event.stopPropagation(); forceSearchRecentAlbum(this, \'' + escHtml(statusId) + '\')">Force search</button>' +
                  '<button type="button" class="cur-discover-card-menu-exclude"' + (statusMeta.selectable ? '' : ' hidden') + ' onclick="event.stopPropagation(); toggleRecentAlbumExcluded(this, ' + (item && item.excluded ? 'false' : 'true') + ', \'' + escHtml(statusId) + '\')">' + escHtml(item && item.excluded ? 'Include album' : 'Exclude album') + '</button>' +
                '</div>' +
              '</div>' +
            '</span>' +
          '</span>' +
          '<span class="plex-footer cur-discover-result-main cur-discover-album-main">' +
            '<span class="plex-name cur-discover-result-name cur-discover-album-title">' + escHtml(item && item.albumTitle || '') + '</span>' +
            '<span class="plex-meta cur-discover-result-meta cur-discover-album-meta">' + escHtml(item && item.meta || '') + '</span>' +
          '</span>' +
        '</div>';
    }

    renderDiscoveryCarousel(
      'recentAddedAlbumsList',
      'recentAddedAlbumsStatus',
      'recentAddedAlbumsViewport',
      PRELOADED_DISCOVERY_ALBUMS.recentAdded || [],
      function(item) { return makeRecentAlbumCard(item, 'recentAddedAlbumsStatus'); },
      {
        statusFormatter: function(items) {
          return items.length + ' album' + (items.length === 1 ? '' : 's') + '.';
        }
      }
    );
    renderDiscoveryCarousel(
      'recentRequestedAlbumsList',
      'recentRequestedAlbumsStatus',
      'recentRequestedAlbumsViewport',
      PRELOADED_DISCOVERY_ALBUMS.recentRequested || [],
      function(item) { return makeRecentAlbumCard(item, 'recentRequestedAlbumsStatus'); },
      {
        statusFormatter: function(items) {
          return items.length + ' album' + (items.length === 1 ? '' : 's') + '.';
        }
      }
    );
    bindDiscoveryNav('recentAddedAlbumsPrev', 'recentAddedAlbumsNext', 'recentAddedAlbumsViewport');
    bindDiscoveryNav('recentRequestedAlbumsPrev', 'recentRequestedAlbumsNext', 'recentRequestedAlbumsViewport');

    if (DISCOVERY_CONFIG.showTrendingArtists) {
      loadDiscovery('/api/discovery/trending?type=artists', 'trendingArtistsList', 'trendingArtistsStatus', 'trendingArtistsViewport', function(item) {
        return makeDiscoveryCard(
          item.name,
          item.listeners ? item.listeners.toLocaleString() + ' listeners' : '',
          item.image || '',
          item.name || ''
        );
      });
      bindDiscoveryNav('trendingArtistsPrev', 'trendingArtistsNext', 'trendingArtistsViewport');
    }

    if (DISCOVERY_CONFIG.showTrendingTracks) {
      loadDiscovery('/api/discovery/trending?type=tracks', 'trendingTracksList', 'trendingTracksStatus', 'trendingTracksViewport', function(item) {
        var sub = item.name + (item.listeners ? ' · ' + item.listeners.toLocaleString() + ' listeners' : '');
        return makeDiscoveryCard(item.artistName || item.name, sub, item.image || '', item.artistName || item.name || '');
      });
      bindDiscoveryNav('trendingTracksPrev', 'trendingTracksNext', 'trendingTracksViewport');
    }

    if (DISCOVERY_CONFIG.showSimilarArtists) {
      fetch('/api/discovery/similar', { headers: { Accept: 'application/json' } })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.ok) throw new Error(data.error || 'Failed.');
          var titleEl = document.getElementById('similarCarouselTitle');
          var artistsEl = document.getElementById('similarCarouselArtists');
          if (titleEl) titleEl.textContent = 'Because You Like...';
          if (artistsEl) {
            artistsEl.textContent = data.basedOn && data.basedOn.length
              ? '...' + data.basedOn.join(', ')
              : '';
          }
          renderDiscoveryCarousel('similarArtistsList', 'similarArtistsStatus', 'similarArtistsViewport', data.items || [], function(item) {
            var sub = item.match ? Math.round(item.match * 100) + '% match' : 'Similar artist';
            return makeDiscoveryCard(item.name, sub, item.image || '', item.name || '');
          });
        })
        .catch(function() {
          var list = document.getElementById('similarArtistsList');
          if (list) { list.className = 'cur-empty'; list.textContent = 'Failed to load suggestions.'; }
        });
      bindDiscoveryNav('similarArtistsPrev', 'similarArtistsNext', 'similarArtistsViewport');
    }

  </script>
</body>

            '<button type="button" class="spm-wizard-match-mode-btn' + (currentMode === 'all' ? ' is-selected' : '') + '" data-match-mode-kind="' + kind + '" data-match-mode-value="all">All</button>' +
          '</div>' +
        '</div>';
      }

      function wizardUnavailableContentHint(kind) {
        var adminPrefix = IS_ACTUAL_ADMIN ? 'Run' : 'Ask an admin to run';
        if (kind === 'genre') return adminPrefix + ' Jobs > Master Track Cache Refresh to load ' + mediaServerLabel + ' track genres, then reopen this step.';
        if (kind === 'mood') return adminPrefix + ' Jobs > Master Track Cache Refresh to load ' + mediaServerLabel + ' track moods, then reopen this step.';
        if (kind === 'album-genres') return adminPrefix + ' Jobs > Master Track Cache Refresh to load ' + mediaServerLabel + ' album genres, then reopen this step.';
        if (kind === 'album-styles') return adminPrefix + ' Jobs > Master Track Cache Refresh to load ' + mediaServerLabel + ' album styles, then reopen this step.';
        if (kind === 'album-moods') return adminPrefix + ' Jobs > Master Track Cache Refresh to load ' + mediaServerLabel + ' album moods, then reopen this step.';
        if (kind === 'tag') return adminPrefix + ' Jobs > Last.fm Tag Sync to load artist tags, then reopen this step.';
        if (kind === 'decade') return adminPrefix + ' Jobs > Track Enrichment Sync to backfill release dates and decade tags, then reopen this step.';
        return adminPrefix + ' the relevant metadata sync job, then reopen this step.';
      }

      function renderWizChips(items, stateObj, kind, placeholderSearch) {
        var triState = normaliseUiTriState(stateObj);
        var values = [];
        var seenValues = new Set();
        (Array.isArray(items) ? items : []).concat(triState.include || [], triState.exclude || []).forEach(function(value) {
          var next = String(value || '').trim();
          if (!next || seenValues.has(next)) return;
          seenValues.add(next);
          values.push(next);
        });
        values.sort(function(a, b) { return a.localeCompare(b); });
        var label = escH(placeholderSearch.replace('Filter ','').replace('…',''));

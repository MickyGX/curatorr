    }

    function createSmartPlaylist(nameOverride, rulesOverride, optionsOverride) {
      var name = nameOverride || (document.getElementById('spm-name').value || '').trim();
      var msg = document.getElementById('wiz-msg') || document.getElementById('spm-msg');
      var btn = document.getElementById('wiz-create-btn') || document.getElementById('spm-create-btn');
      if (!name) {
        if (msg) msg.textContent = 'Please enter a playlist name.';
        var nameInput = document.getElementById('wiz-finish-name') || document.getElementById('spm-name');
        if (nameInput) nameInput.focus();
        return;
      }
      var rules = rulesOverride || getSpmRules();
      var options = optionsOverride || {};
      var playlistTarget = options.playlistTarget || 'personal';
      var trackFilters = options.trackFilters || null;
      var editKind = options.editKind || _wizardEditKind || null;
      var editId = options.editId || _wizardEditId || '';
      var allowEmptyDraft = Boolean(options.allowEmptyDraft);
      var importSource = options.importSource || null;
      var removeImportedSourcePlaylistKey = options.removeImportedSourcePlaylistKey || '';
      var artwork = options.artwork || null;
      var isEdit = Boolean(editKind && editId);
      var endpoint = isEdit
        ? (editKind === 'global'
          ? '/api/playlists/global/' + encodeURIComponent(editId)
          : '/api/music/playlists/personal/' + encodeURIComponent(editId))
        : (playlistTarget === 'global' ? '/api/playlists/global' : '/api/music/playlists/personal');
      var payload = Object.assign({ name: name }, rules);
      if (artwork) payload.artwork = artwork;
      if (trackFilters || isEdit) payload.trackFilters = trackFilters || { includeFolders: [], excludeFolders: [], deduplicateByMbid: false, deduplicateByArtistTitle: false, deduplicateByDuration: false, deduplicateIgnoreLikelyVariants: false, deduplicateIgnoreLiveAlbums: false, rules: [] };
      if (allowEmptyDraft) payload.allowEmptyDraft = true;
      if (importSource) payload.importSource = importSource;
      if (removeImportedSourcePlaylistKey) payload.removeImportedSourcePlaylistKey = removeImportedSourcePlaylistKey;
      if (btn) btn.disabled = true;
      if (msg) msg.textContent = isEdit ? 'Saving…' : 'Creating…';
      fetch(endpoint, {
        method: isEdit ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
        body: JSON.stringify(payload),
      })
        .then(function(r) {
          return r.json().catch(function() { return {}; }).then(function(data) {
            if (!r.ok || !data.ok) {
              var err = new Error(data.error || 'Failed');
              err.code = data.code || '';
              err.canSaveDraft = Boolean(data.canSaveDraft);
              throw err;
            }
            return data;
          });
        })
        .then(function(data) {
          if (!data.ok) throw new Error(data.error || 'Failed');
          if (isEdit) {
            closeSmartPlaylistModal();
            window.location.reload();
            return;
          }
          if (data.draft) {
            closeSmartPlaylistModal();
            window.location.reload();
            return;
          }
          if (importSource || data.removedSourcePlaylistKey) {
            closeSmartPlaylistModal();
            window.location.reload();
            return;
          }
          var playlist = data.playlist || {};
          var isGlobal = playlistTarget === 'global';
          var card = buildPlaylistCard({
            plexPlaylistId: data.plexPlaylistId || '',
            playlistKey: data.playlistKey || (isGlobal ? 'global:' + String(playlist.id || '') : 'personal:' + String(playlist.id || '')),
            playlistTitle: data.playlistTitle || playlist.name || name,
            playlistKind: 'generated',
            playlistType: isGlobal ? 'global' : 'personal',
            playlistAudience: isGlobal ? 'global' : (playlistTarget === 'blend' ? 'blend' : 'personal'),
            artworkMode: artwork && artwork.mode || 'auto',
            active: true,
            trackCount: 0,
            updatedAt: playlist.createdAt || Date.now(),
            artPath: '',
            artUrl: '',
          });
          insertPlaylistCardSorted(card);
          closeSmartPlaylistModal();
          selectPlaylist(card);
        })
        .catch(function(err) {
          if (msg) {
            msg.textContent = err.code === 'ZERO_TRACK_PLAYLIST' && err.canSaveDraft
              ? (err.message || 'This setup matches 0 tracks. Review the filters or save it as a draft.')
              : ('Error: ' + (err.message || 'Unknown'));
          }
          if (btn) btn.disabled = false;
        });
    }


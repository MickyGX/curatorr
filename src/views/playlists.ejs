    function setPlaylistCarouselCollapsed(collapsed) {
      var panel = document.getElementById('playlistCarouselPanel');
      if (!panel) return;
      var next = Boolean(collapsed);
      if (_playlistCarouselCollapsed === next) return;
      _playlistCarouselCollapsed = next;
      panel.classList.toggle('is-collapsed', next);
      document.body.classList.toggle('has-collapsed-playlist-carousel', next);
    }

    function getPlaylistTrackScrollContainer() {
      return document.querySelector('#playlistTracksPanel .cur-pl-body');
    }

    function evaluatePlaylistCarouselAutoCollapse() {
      var panel = document.getElementById('playlistCarouselPanel');
      var tracksPanel = document.getElementById('playlistTracksPanel');
      var trackScroller = getPlaylistTrackScrollContainer();
      if (!panel || !tracksPanel) return;
      var scrollTop = trackScroller ? Number(trackScroller.scrollTop || 0) : 0;
      var collapse = _playlistCarouselCollapsed
        ? scrollTop > _playlistCarouselExpandThreshold
        : scrollTop > _playlistCarouselCollapseThreshold;
      if (!_playlistCarouselCollapsed && !collapse) {
        collapse = tracksPanel.getBoundingClientRect().top <= 116;
      }
      setPlaylistCarouselCollapsed(collapse);
    }

    function bindPlaylistCarouselAutoCollapse() {
      var dashContent = document.querySelector('.cur-playlists-page .dash-content');
      var trackScroller = getPlaylistTrackScrollContainer();
      var ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function() {
          ticking = false;
          evaluatePlaylistCarouselAutoCollapse();
        });
      }
      if (dashContent) dashContent.addEventListener('scroll', onScroll, { passive: true });
      if (trackScroller) trackScroller.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      onScroll();
    }

    // ── Playlist selection ────────────────────────────────────────────────────

    function selectPlaylist(el) {
      var plId = el.getAttribute('data-pl-id') || '';
      var plKey = el.getAttribute('data-pl-key') || '';
      var title = el.getAttribute('data-pl-title') || '';
      _currentPlaylistKind = el.getAttribute('data-playlist-kind') || '';
      _currentPlaylistType = el.getAttribute('data-playlist-type') || '';
      _currentPlaylistMissingCount = Number(el.getAttribute('data-playlist-missing-count') || 0);
      document.querySelectorAll('#playlistCarouselTrack .cur-playlist-carousel-card').forEach(function(card) {
        card.classList.remove('is-active');
      });
      el.classList.add('is-active');
      _currentPlexId = plId || null;
      _currentPlexKey = plKey || null;
      updateSelectionSummary(el);
      // Generated playlist not yet synced to Plex — no ID to fetch tracks from
      if (!plId && plKey) {
        _allTracks = []; _offset = 0; _total = 0; _loading = false; _visibleTrackCount = 0;
        document.getElementById('trackList').innerHTML = '';
        document.getElementById('trackListLoading').style.display = 'none';
        document.getElementById('loadMoreWrap').style.display = 'none';
        var emptyEl = document.getElementById('trackListEmpty');
        emptyEl.textContent = (el.getAttribute('data-playlist-kind') || '') === 'draft'
          ? 'Draft saved in Curatorr. Edit the filters or rebuild once the playlist matches tracks.'
          : (isPlaylistCardActive(el)
            ? ('Not yet synced to ' + MS_LABEL + '. It will be created automatically on the next scheduled run.')
            : ('Disabled. Enable this playlist to rebuild and add it back to ' + MS_LABEL + '.'));
        emptyEl.style.display = '';
        return;
      }
      reloadTracks();
      loadImportedMissingPanel(plKey, _currentPlaylistMissingCount);
      evaluatePlaylistCarouselAutoCollapse();
    }

    function reloadTracks() {
      _trackLoadGeneration += 1;
      var generation = _trackLoadGeneration;
      _offset = 0;
      _total = 0;
      _loading = false;
      _loadingAllTracks = false;
      _loadingAllTracksPromise = null;
      _allTracks = [];
      _visibleTrackCount = 0;
      document.getElementById('trackList').innerHTML = '';
      document.getElementById('trackListEmpty').style.display = 'none';
      document.getElementById('trackListLoading').style.display = '';
      document.getElementById('loadMoreWrap').style.display = 'none';
      var trackScroller = getPlaylistTrackScrollContainer();
      if (trackScroller) trackScroller.scrollTop = 0;
      loadTracks(0, null, generation).then(function(data) {
        if (!data || generation !== _trackLoadGeneration) return;
        if (_offset < _total) ensureAllTracksLoaded('', { silent: true, generation: generation });
      });
    }

    // ── Track loading ─────────────────────────────────────────────────────────

    function loadTracks(offset, limitOverride, generationOverride) {
      if (_loading) return Promise.resolve();
      var generation = Number(generationOverride || _trackLoadGeneration);
      _loading = true;
      var limit = Math.max(1, Number(limitOverride || _pageSize));
      var url = '/api/music/playlist/tracks?offset=' + offset + '&limit=' + limit;
      if (_currentPlexId) url += '&plexPlaylistId=' + encodeURIComponent(_currentPlexId);
      return fetch(url)
        .then(function(r) { return r.json(); })
        .then(function(data) {
          _loading = false;
          if (generation !== _trackLoadGeneration) return data;
          document.getElementById('trackListLoading').style.display = 'none';

          if (!data.ok || !data.playlistTitle) {
            var emptyEl = document.getElementById('trackListEmpty');
            emptyEl.style.display = '';
            emptyEl.innerHTML = data.error
              ? 'Error loading tracks: ' + data.error
              : 'No playlist found. <a href="/wizard/user">Complete your personal setup</a> to create your playlist.';
            return data;
          }

          _total = data.total;
          _offset = offset + data.tracks.length;
          var selectedCard = document.querySelector('#playlistCarouselTrack .cur-playlist-carousel-card.is-active');
          if (selectedCard) {
            selectedCard.setAttribute('data-playlist-track-count', String(_total));
            // Sync the visible track count on the carousel card to match the actual Plex count
            var metaEl = selectedCard.querySelector('.cur-playlist-carousel-meta');
            if (metaEl) {
              var missingCount = Number(selectedCard.getAttribute('data-playlist-missing-count') || 0);
              metaEl.textContent = Number(_total).toLocaleString() + ' tracks' + (missingCount > 0 ? (' • ' + missingCount.toLocaleString() + ' missing') : '');
            }
            updateSelectionSummary(selectedCard);
          }

          if (data.tracks.length === 0 && offset === 0) {
            document.getElementById('trackListEmpty').style.display = '';
            return data;
          }

          renderTracks(data.tracks, offset);

          return data;
        })
        .catch(function(err) {
          _loading = false;
          if (generation !== _trackLoadGeneration) return;
          document.getElementById('trackListLoading').style.display = 'none';
          document.getElementById('trackListEmpty').style.display = '';
          document.getElementById('trackListEmpty').textContent = 'Failed to load tracks: ' + err.message;
          console.error('Track load error:', err);
          throw err;
        });
    }

    function loadMore() {
      if (_offset >= _total) {
        var totalFiltered = getSortedFiltered().length;
        if (_visibleTrackCount < totalFiltered) {
          _visibleTrackCount = Math.min(totalFiltered, _visibleTrackCount + _pageSize);
          renderFiltered();
        }
        return;
      }
      loadTracks(_offset);
    }

    function loadAll() {
      ensureAllTracksLoaded('Loading full playlist…').then(function() {
        _visibleTrackCount = getSortedFiltered().length;
        renderFiltered();
      });
    }

    function ensureAllTracksLoaded(message, options) {
      options = options || {};
      var generation = Number(options.generation || _trackLoadGeneration);
      if (_loadingAllTracks && _loadingAllTracksPromise) return _loadingAllTracksPromise;
      if (_offset >= _total || _total === 0) return Promise.resolve();

      _loadingAllTracks = true;
      _loadingAllTracksPromise = Promise.resolve();
      var loadingEl = document.getElementById('trackListLoading');
      var loadMoreBtn = document.getElementById('loadMoreBtn');
      var loadAllBtn = document.getElementById('loadAllBtn');
      if (!options.silent && loadingEl) {
        loadingEl.textContent = message || 'Loading…';
        loadingEl.style.display = '';
      }
      if (!options.silent && loadMoreBtn) loadMoreBtn.disabled = true;
      if (!options.silent && loadAllBtn) loadAllBtn.disabled = true;

      function fetchNext() {
        if (generation !== _trackLoadGeneration) return Promise.resolve();
        if (_offset >= _total) return Promise.resolve();
        return loadTracks(_offset, 200, generation).then(fetchNext);
      }

      _loadingAllTracksPromise = fetchNext()
        .catch(function() {})
        .finally(function() {
          if (generation !== _trackLoadGeneration) return;
          _loadingAllTracks = false;
          _loadingAllTracksPromise = null;
          if (!options.silent && loadingEl) loadingEl.style.display = 'none';
          if (!options.silent && loadMoreBtn) loadMoreBtn.disabled = false;
          if (!options.silent && loadAllBtn) loadAllBtn.disabled = false;
        });
      return _loadingAllTracksPromise;
    }

    // ── Playlist actions ─────────────────────────────────────────────────────

    function rebuildCurrentPlaylist() {
      var card = document.querySelector('#playlistCarouselTrack .cur-playlist-carousel-card.is-active');
      if (card) rebuildCardPlaylist(card);
    }

    function rebuildCardPlaylist(card) {
      if (!card) return;
      closeAllCardMenus();
      if (!isPlaylistCardActive(card)) {
        document.getElementById('syncStatus').textContent = 'Enable this playlist first.';
        return;
      }
      var status = document.getElementById('syncStatus');
      var kind = card.dataset.playlistKind || '';
      var key = card.dataset.plKey || '';
      var importedRefresh = isImportedRefreshPlaylist(card);
      if (!importedRefresh && !canRebuildSelection(kind, card.dataset.playlistType || '')) {
        status.textContent = 'This playlist does not support rebuilding.';
        return;
      }
      status.textContent = importedRefresh ? 'Refreshing import…' : 'Rebuilding…';
      fetch(importedRefresh ? '/api/music/playlists/imported-refresh' : '/api/music/playlists/rebuild', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
        body: JSON.stringify({ playlistKind: kind, playlistKey: key }),
      })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.ok) {
            status.textContent = importedRefresh ? 'Import refreshed.' : 'Rebuilt.';
            var reloadUrl = new URL(window.location.href);
            reloadUrl.searchParams.delete('blend');
            reloadUrl.searchParams.delete('name');
            window.location.href = reloadUrl.toString();
          }
          else { status.textContent = 'Error: ' + (data.error || 'Unknown'); }
        })
        .catch(function() { status.textContent = 'Network error.'; });
    }

    function toggleCardPlaylistActive(card, shouldEnable) {
      if (!card) return;
      closeAllCardMenus();
      var playlistKey = String(card.dataset.plKey || '').trim();
      if (!playlistKey) return;
      var status = document.getElementById('syncStatus');
      status.textContent = shouldEnable ? 'Enabling…' : 'Disabling…';
      fetch('/api/music/playlists/generated/state', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
        body: JSON.stringify({ playlistKey: playlistKey, active: Boolean(shouldEnable) }),
      })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.ok) throw new Error(data.error || 'Unknown error');
          window.location.reload();
        })
        .catch(function(err) {
          status.textContent = 'Error: ' + (err.message || 'Unknown');
        });
    }

    var _importedPlaylistSettingsState = {
      card: null,
    };

    function closeImportedPlaylistSettingsModal() {
      var modal = document.getElementById('importedPlaylistModal');
      if (modal) modal.style.display = 'none';
      _importedPlaylistSettingsState = { card: null };
      var statusEl = document.getElementById('importedPlaylistStatus');
      var saveBtn = document.getElementById('importedPlaylistSaveBtn');
      if (statusEl) statusEl.textContent = '';
      if (saveBtn) saveBtn.disabled = false;
    }

    function openImportedPlaylistSettingsModal(card) {
      if (!card || !isImportedRefreshPlaylist(card)) return;
      var playlistAudience = String(card.dataset.playlistAudience || '').trim().toLowerCase();
      if (playlistAudience === 'global' && !CAN_EDIT_GLOBAL_PLAYLISTS) return;
      _importedPlaylistSettingsState = { card: card };
      var modal = ensureModalAtRoot('importedPlaylistModal');
      if (!modal) return;
      var titleEl = document.getElementById('importedPlaylistTitle');
      var syncEl = document.getElementById('importedPlaylistSyncPeriod');
      var globalEl = document.getElementById('importedPlaylistGlobal');
      var headerEl = document.getElementById('importedPlaylistModalTitle');
      var statusEl = document.getElementById('importedPlaylistStatus');
      var saveBtn = document.getElementById('importedPlaylistSaveBtn');
      if (headerEl) headerEl.textContent = 'Edit Imported Playlist: ' + String(card.dataset.plTitle || 'Playlist');
      if (titleEl) titleEl.value = String(card.dataset.plTitle || '').trim();
      if (syncEl) syncEl.value = normalizeImportedSyncPeriod(card.dataset.playlistImportedSyncPeriod || 'disabled');
      if (globalEl) globalEl.checked = playlistAudience === 'global';
      if (statusEl) statusEl.textContent = '';
      if (saveBtn) saveBtn.disabled = false;
      modal.style.display = '';
    }

    function submitImportedPlaylistSettings() {
      var card = _importedPlaylistSettingsState.card;
      if (!card) return;
      var playlistKey = String(card.dataset.plKey || '').trim();
      if (!playlistKey) return;
      var titleEl = document.getElementById('importedPlaylistTitle');
      var syncEl = document.getElementById('importedPlaylistSyncPeriod');
      var globalEl = document.getElementById('importedPlaylistGlobal');
      var statusEl = document.getElementById('importedPlaylistStatus');
      var saveBtn = document.getElementById('importedPlaylistSaveBtn');
      var nextTitle = String(titleEl && titleEl.value || '').trim();
      var nextSyncPeriod = normalizeImportedSyncPeriod(syncEl && syncEl.value || card.dataset.playlistImportedSyncPeriod || 'disabled');
      var nextAudience = globalEl
        ? (globalEl.checked ? 'global' : 'personal')
        : (String(card.dataset.playlistAudience || '').trim().toLowerCase() === 'global' ? 'global' : 'personal');
      if (!nextTitle) {
        if (statusEl) statusEl.textContent = 'Name is required.';
        return;
      }
      if (saveBtn) saveBtn.disabled = true;
      if (statusEl) statusEl.textContent = 'Saving imported playlist…';
      fetch('/api/music/playlists/imported-settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
        body: JSON.stringify({
          playlistKey: playlistKey,
          title: nextTitle,
          importedSyncPeriod: nextSyncPeriod,
          audience: nextAudience,
        }),
      })
        .then(function(r) { return r.json().catch(function() { return {}; }); })
        .then(function(data) {
          if (!data.ok) throw new Error(data.error || 'Failed to update imported playlist settings.');
          window.location.reload();
        })
        .catch(function(err) {
          if (statusEl) statusEl.textContent = 'Error: ' + (err.message || 'Unknown');
          if (saveBtn) saveBtn.disabled = false;
        });
    }

    function convertImportedPlaylistFromSettings() {
      var card = _importedPlaylistSettingsState.card;
      if (!card) return;
      closeImportedPlaylistSettingsModal();
      openConvertImportedPlaylist(card);
    }


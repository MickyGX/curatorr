    function renderImportPlexSources() {
      if (!document.getElementById('importPlexList')) return;
      var listEl = document.getElementById('importPlexList');
      var statusEl = document.getElementById('importPlexStatus');
      var emptyEl = document.getElementById('importPlexEmpty');
      var search = String(document.getElementById('importPlexSearch').value || '').trim().toLowerCase();
      var visibleItems = _importPlexSources.filter(function(item) {
        if (!search) return true;
        return String(item.title || '').toLowerCase().indexOf(search) !== -1
          || String(item.libraryTitle || '').toLowerCase().indexOf(search) !== -1
          || String(item.kind || '').toLowerCase().indexOf(search) !== -1;
      });
      listEl.innerHTML = '';
      emptyEl.style.display = visibleItems.length ? 'none' : '';
      if (!visibleItems.length) {
        if (statusEl) statusEl.textContent = _importPlexSources.length ? 'No matching Plex sources.' : 'No Plex playlists or collections found.';
        return;
      }
      if (statusEl) statusEl.textContent = visibleItems.length + ' Plex sources available.';
      visibleItems.forEach(function(item) {
        var button = document.createElement('button');
        button.type = 'button';
        button.className = 'import-pl-option' + (_importPlexSelection && _importPlexSelection.kind === item.kind && _importPlexSelection.id === item.id ? ' is-active' : '');
        button.innerHTML =
          '<span class="import-pl-option__top">' +
            '<span class="import-pl-option__title">' + escHtml(item.title || 'Untitled') + '</span>' +
            '<span class="import-pl-option__badge' + (item.kind === 'collection' ? ' import-pl-option__badge--collection' : '') + '">' + escHtml(item.kind) + '</span>' +
          '</span>' +
          '<span class="import-pl-option__meta">' +
            Number(item.trackCount || 0).toLocaleString() + ' tracks' +
            (item.libraryTitle ? ' • ' + escHtml(item.libraryTitle) : '') +
          '</span>';
        button.addEventListener('click', function() {
          _importPlexSelection = item;
          resetImportedTitleField();
          updateImportSubmitButton();
          renderImportPlexSources();
        });
        listEl.appendChild(button);
      });
    }

    function loadImportSpotifySources() {
      var statusEl = document.getElementById('importSpotifyStatus');
      fetch('/api/music/import/spotify/playlists')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.ok) throw new Error(data.error || 'Failed to load Spotify playlists.');
          _importSpotifySources = Array.isArray(data.playlists) ? data.playlists : [];
          _importSpotifySources.sort(function(a, b) {
            return String(a.name || '').localeCompare(String(b.name || ''));
          });
          renderImportSpotifySources();
        })
        .catch(function(err) {
          if (statusEl) statusEl.textContent = 'Error: ' + (err.message || 'Unknown');
        });
    }

    function renderImportSpotifySources() {
      var listEl = document.getElementById('importSpotifyList');
      if (!listEl) return;
      var statusEl = document.getElementById('importSpotifyStatus');
      var emptyEl = document.getElementById('importSpotifyEmpty');

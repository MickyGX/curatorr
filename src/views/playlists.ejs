    function isImportedRefreshPlaylist(card) {
      if (!card || String(card.dataset.playlistType || '').trim().toLowerCase() !== 'custom') return false;
      var sourceType = String(card.dataset.playlistSourceType || '').trim().toLowerCase();
      return sourceType === 'spotify-playlist'
        || sourceType === 'youtube-playlist'
        || sourceType === 'lastfm-station'
        || sourceType === 'listenbrainz-playlist'
        || sourceType === 'plex-playlist'
        || sourceType === 'plex-collection';
    }

    function normalizeImportedSyncPeriod(value) {
      var normalized = String(value || '').trim().toLowerCase();
      return ['disabled', 'daily', 'weekly', 'monthly'].indexOf(normalized) !== -1 ? normalized : 'disabled';
    }

    function formatImportedSyncPeriodLabel(value) {
      var normalized = normalizeImportedSyncPeriod(value);
      if (normalized === 'daily') return 'Auto-refresh every day';
      if (normalized === 'weekly') return 'Auto-refresh every week';
      if (normalized === 'monthly') return 'Auto-refresh every month';
      return 'Auto-refresh disabled';
    }

    function canRebuildSelection(kind, type) {
      if (kind === 'legacy') return true;
      return ['curatorred', 'crescive', 'curative', 'curatorr', 'daily-mix', 'global', 'personal'].indexOf(String(type || '').toLowerCase()) !== -1;
    }

    function updateSelectionButtons() {
      var viewBtn = document.getElementById('playlistViewBtn');
      var canView = Boolean(_currentPlexId && PLEX_MACHINE_ID);
      var activeCard = document.querySelector('#playlistCarouselTrack .cur-playlist-carousel-card.is-active');
      var canRebuild = canRebuildSelection(_currentPlaylistKind, _currentPlaylistType) || isImportedRefreshPlaylist(activeCard);
      if (viewBtn) {
        viewBtn.disabled = !canView;
        viewBtn.title = canView ? ('Open this playlist in ' + MS_LABEL) : ('This playlist is not yet available to open in ' + MS_LABEL + '.');
      }
      document.querySelectorAll('#playlistCarouselTrack .cur-playlist-carousel-rebuild').forEach(function(rebuildBtn) {
        rebuildBtn.disabled = !canRebuild;
        rebuildBtn.title = canRebuild ? 'Rebuild or refresh this playlist in Curatorr' : 'This playlist does not support automatic rebuilding.';
      });
    }

    function updateSelectionSummary(el) {
      if (!el) return;
      updateSelectionButtons();
    }

    function resolvePlaylistAudience(data) {
      var audience = String((data && data.playlistAudience) || '').trim().toLowerCase();
      if (audience === 'global' || audience === 'external' || audience === 'blend' || audience === 'personal' || audience === 'system' || audience === 'imported') return audience;
      var source = String(data && data.sourceType || data && data.playlistSourceType || '').trim().toLowerCase();
      if (source === 'spotify-playlist' || source === 'youtube-playlist' || source === 'lastfm-station' || source === 'listenbrainz-playlist' || source.indexOf('plex-') === 0) return 'imported';
      var type = String(data && data.playlistType || '').trim().toLowerCase();
      if (type === 'global') return 'global';
      if (type === 'lastfm-station' || type === 'listenbrainz-playlist') return 'external';
      if (['legacy', 'curatorred', 'curatorr', 'curative', 'crescive', 'daily-mix'].indexOf(type) !== -1) return 'system';
      return 'personal';
    }

    function playlistAudienceSortRank(audience) {
      if (audience === 'imported') return 1;
      if (audience === 'external') return 2;
      if (audience === 'blend') return 3;
      if (audience === 'global') return 4;
      if (audience === 'system') return 5;
      return 0;
    }

    function isPlaylistCardActive(card) {
      return String(card && card.dataset && card.dataset.playlistActive || 'true') !== 'false';
    }

    function getPlaylistCardSortMeta(source) {
      var dataset = source && source.dataset ? source.dataset : null;
      var playlistAudience = dataset ? resolvePlaylistAudience({ playlistAudience: dataset.playlistAudience, playlistType: dataset.playlistType }) : resolvePlaylistAudience(source);
      var updatedAt = Number(dataset ? dataset.playlistUpdatedAt : source && source.updatedAt || 0);
      var playlistTitle = String(dataset ? dataset.plTitle : source && source.playlistTitle || '').trim();
      return {
        playlistAudience: playlistAudience,
        active: dataset ? String(dataset.playlistActive || 'true') !== 'false' : source && source.active !== false,
        updatedAt: updatedAt,
        playlistTitle: playlistTitle,
      };
    }

    function comparePlaylistCardSortOrder(a, b) {
      var aMeta = getPlaylistCardSortMeta(a);
      var bMeta = getPlaylistCardSortMeta(b);
      var activeDelta = Number(bMeta.active) - Number(aMeta.active);
      if (activeDelta) return activeDelta;
      var audienceDelta = playlistAudienceSortRank(aMeta.playlistAudience) - playlistAudienceSortRank(bMeta.playlistAudience);
      if (audienceDelta) return audienceDelta;
      var updatedDelta = bMeta.updatedAt - aMeta.updatedAt;
      if (updatedDelta) return updatedDelta;
      return aMeta.playlistTitle.localeCompare(bMeta.playlistTitle);
    }

    function insertPlaylistCardSorted(card) {
      var carouselTrack = document.getElementById('playlistCarouselTrack');
      if (!carouselTrack || !card) return;
      var existingCards = carouselTrack.querySelectorAll('.cur-playlist-carousel-card');
      for (var i = 0; i < existingCards.length; i += 1) {
        if (comparePlaylistCardSortOrder(card, existingCards[i]) < 0) {
          carouselTrack.insertBefore(card, existingCards[i]);
          return;
        }
      }
      carouselTrack.appendChild(card);
      applyPlaylistCardFilters({ preserveActive: true, skipReload: true });
    }

    function playlistAudienceTitle(audience, sourceType) {
      var source = String(sourceType || '').trim().toLowerCase();
      if (audience === 'global' && source === 'spotify-playlist') return 'Global Spotify playlist (all users)';
      if (audience === 'global' && source === 'youtube-playlist') return 'Global YouTube playlist (all users)';
      if (audience === 'global' && source === 'lastfm-station') return 'Global Last.fm playlist (all users)';
      if (audience === 'global' && source === 'listenbrainz-playlist') return 'Global ListenBrainz playlist (all users)';
      if (audience === 'global' && source.indexOf('plex-') === 0) return 'Global Plex playlist (all users)';
      if (source === 'spotify-playlist') return 'Imported Spotify playlist';
      if (source === 'youtube-playlist') return 'Imported YouTube playlist';
      if (source === 'lastfm-station') return 'Imported Last.fm playlist';
      if (source === 'listenbrainz-playlist') return 'Imported ListenBrainz playlist';
      if (source.indexOf('plex-') === 0) return 'Imported Plex playlist';
      if (audience === 'imported') return 'Imported playlist';
      if (audience === 'external') return 'External playlist';
      if (audience === 'global') return 'Global playlist';
      if (audience === 'blend') return 'Blend playlist';
      if (audience === 'system') return 'System playlist';
      return 'Personal playlist';
    }


      if (titleEl) titleEl.textContent = 'Playlist Artwork: ' + String(card.dataset.plTitle || 'Playlist');
      if (modeEl) modeEl.value = _playlistArtworkState.mode;
      if (statusEl) statusEl.textContent = _playlistArtworkState.mode === 'custom'
        ? 'Upload a new image or keep the current custom artwork.'
        : (_playlistArtworkState.mode === 'preserve'
          ? 'Curatorr will preserve the current Plex artwork for future syncs.'
          : 'Curatorr will stop managing artwork for this playlist.');
      var saveBtn = document.getElementById('playlistArtworkSaveBtn');
      if (saveBtn) saveBtn.disabled = false;
      if (noteEl) noteEl.textContent = 'PNG, JPG, or WEBP up to 5 MB.';

        if (hasImportedDetectedContent) {
          html += '<button class="btn btn-ghost btn-sm" type="button" id="wiz-toggle-import-detected">' + (importedContentMode === 'detected' ? 'Use recommended chips' : 'Use all detected chips') + '</button>';
        }
        html += '<button class="btn btn-ghost btn-sm" type="button" id="wiz-clear-content-filters">Clear all Step 2 filters</button></div>';
        html += '<div id="wiz-audio-profile-status">' + wizardAudioProfileStatusHtml() + '</div>';
      } else {
        html += '<div style="display:flex;justify-content:flex-start;gap:8px;flex-wrap:wrap;margin:0 0 14px">';
        if (hasImportedDetectedContent) {
          html += '<button class="btn btn-ghost btn-sm" type="button" id="wiz-toggle-import-detected">' + (importedContentMode === 'detected' ? 'Use recommended chips' : 'Use all detected chips') + '</button>';
        }
        html += '<button class="btn btn-ghost btn-sm" type="button" id="wiz-clear-content-filters">Clear all Step 2 filters</button></div>';
      }
      if (hasImportedDetectedContent) {
        var importDetectedBits = [];
        if (importedDetectedCounts.genres) importDetectedBits.push(String(importedDetectedCounts.genres) + ' genres');
        if (importedDetectedCounts.moods) importDetectedBits.push(String(importedDetectedCounts.moods) + ' moods');
        if (importedDetectedCounts.albumGenres) importDetectedBits.push(String(importedDetectedCounts.albumGenres) + ' album genres');
        if (importedDetectedCounts.albumStyles) importDetectedBits.push(String(importedDetectedCounts.albumStyles) + ' album styles');
        if (importedDetectedCounts.albumMoods) importDetectedBits.push(String(importedDetectedCounts.albumMoods) + ' album moods');
        if (importedDetectedCounts.tags) importDetectedBits.push(String(importedDetectedCounts.tags) + ' tags');
        if (importedDetectedCounts.decades) importDetectedBits.push(String(importedDetectedCounts.decades) + ' decades');
        html += '<p style="font-size:12px;color:var(--muted,#888);margin:0 0 14px">Imported conversion can switch between the recommended inferred chips and every detected content value from the matched source tracks' + (importDetectedBits.length ? (' (' + escH(importDetectedBits.join(' · ')) + ')') : '') + '.</p>';
      }
      html += '<p style="font-size:12px;color:var(--muted,#888);margin:0 0 14px">Click once to <span style="color:#4ade80;font-weight:600">include</span>, again to <span style="color:#f87171;font-weight:600">exclude</span>, again to clear. Leave all neutral to allow everything.</p>';

      function renderIncludeModeControl(kind, mode) {
        var currentMode = mode === 'all' ? 'all' : 'any';

        body: JSON.stringify({ playlistKey: _currentPlexKey }),
      })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.ok) throw new Error(data.error || 'Failed to queue selected tracks for Lidarr review.');

    function wizardReplaceAudioState(state, presetId) {
      var nextValues = wizardPresetValues(presetId);
      state.featurePreset = nextValues.featurePreset;
      state.bpmMin = nextValues.bpmMin;
      state.bpmMax = nextValues.bpmMax;
      state.energyMin = nextValues.energyMin;
      state.energyMax = nextValues.energyMax;
      state.danceabilityMin = nextValues.danceabilityMin;
      state.danceabilityMax = nextValues.danceabilityMax;
      state.camelotFocus = nextValues.camelotFocus;
      state.camelotMode = nextValues.camelotMode;

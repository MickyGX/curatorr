    [data-theme="day"] .import-spotify-preview { background:rgba(255,255,255,.9); border-color:rgba(10,20,30,.1); }
    [data-theme="day"] .import-spotify-preview__summary { color:#1f2d3d; }
    [data-theme="day"] .import-spotify-preview__stats { color:#5e6d80; }

    function wizardImportedDetectedContentCounts(state) {
      var detected = state && state.importDetectedContent;
      return {
        genres: normaliseUiTriState(detected && detected.genres).include.length,
        moods: normaliseUiTriState(detected && detected.moods).include.length,
        albumGenres: normaliseUiTriState(detected && detected.albumGenres).include.length,
        albumStyles: normaliseUiTriState(detected && detected.albumStyles).include.length,
        albumMoods: normaliseUiTriState(detected && detected.albumMoods).include.length,
        tags: normaliseUiTriState(detected && detected.tags).include.length,

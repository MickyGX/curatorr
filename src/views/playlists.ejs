            active: true,
            trackCount: Number(data.importedTrackCount || playlist.trackCount || 0),
            missingCount: Number(data.importedMissingCount || playlist.missingCount || 0),
            updatedAt: Number(playlist.updatedAt || playlist.lastSyncedAt || Date.now()),
            artPath: '',
          });
          insertPlaylistCardSorted(card);
          closeImportPlaylistModal();
          selectPlaylist(card);
        })
        .catch(function(err) {
          statusEl.textContent = 'Error: ' + (err.message || 'Unknown');
        })
        .finally(function() {
          updateImportSubmitButton();
        });
    }

    function resetImportedMissingPanel() {
      _importedMissingState = { playlistKey: '', rows: [], selectedCount: 0, missingCount: 0, actionMessage: '' };
    }

    function groupImportedMissingRows(rows) {
      var groups = new Map();
      (Array.isArray(rows) ? rows : []).forEach(function(row) {
        var artistName = String(row.artistName || (Array.isArray(row.artists) ? row.artists[0] : '') || 'Unknown artist').trim() || 'Unknown artist';
        if (!groups.has(artistName)) groups.set(artistName, []);
        groups.get(artistName).push(row);
      });
      return Array.from(groups.entries()).map(function(entry) {
        var artistName = entry[0];
        var items = entry[1];
        return {
          artistName: artistName,
          rows: items,
          selectedCount: items.filter(function(row) { return row.selected; }).length,
        };
      }).sort(function(a, b) {
        if (b.rows.length !== a.rows.length) return b.rows.length - a.rows.length;
        return a.artistName.localeCompare(b.artistName);
      });
    }

    function buildImportedMissingRow(row, fallbackIndex) {
      var displayIndex = Number(row.position || 0) > 0 ? Number(row.position) : Number(fallbackIndex || 0);
      var title = String(row.title || '').trim() || 'Unmatched track';
      var albumTitle = String(row.albumTitle || '').trim();
      var artistNames = Array.isArray(row.artists) && row.artists.length ? row.artists : [row.artistName || 'Unknown artist'];
      var artistText = artistNames.filter(Boolean).join(', ') || 'Unknown artist';
      var albumHtml = albumTitle
        ? escHtml(albumTitle)
        : '<span class="cur-pl-cell-empty">—</span>';

      return '<div class="cur-pl-row imported-missing-row">' +
        '<span class="cur-pl-col-num">' + displayIndex + '</span>' +
        '<span class="cur-pl-col-track"><span class="cur-pl-track-name"><span class="cur-track-titletext">' + escHtml(title) + '</span></span></span>' +
        '<span class="cur-pl-col-album">' + albumHtml + '</span>' +
        '<span class="cur-pl-col-artist">' + escHtml(artistText) + '</span>' +
        '<span class="cur-pl-col-dur">' + fmtDuration(Number(row.durationMs || 0)) + '</span>' +
        '<span class="cur-pl-col-act"><input class="imported-missing-toggle" type="checkbox" ' + (row.selected ? 'checked ' : '') + 'onchange="toggleImportedMissingRow(' + Number(row.id || 0) + ', this.checked)" /></span>' +
      '</div>';
    }

    function loadImportedMissingPanel(playlistKey, expectedMissingCount) {
      if (!playlistKey || Number(expectedMissingCount || 0) <= 0) {
        resetImportedMissingPanel();
        return;
      }
      _importedMissingState = { playlistKey: playlistKey, rows: [], selectedCount: 0, missingCount: Number(expectedMissingCount || 0), actionMessage: '' };
      fetch('/api/music/playlists/imported-unmatched?playlistKey=' + encodeURIComponent(playlistKey))
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.ok) throw new Error(data.error || 'Failed to load missing tracks.');
          if (_currentPlexKey !== playlistKey) return;
          _importedMissingState = {
            playlistKey: playlistKey,
            rows: Array.isArray(data.rows) ? data.rows : [],
            selectedCount: Number(data.selectedCount || 0),
            missingCount: Number(data.missingCount || 0),
            actionMessage: '',
          };
          if (document.getElementById('trackListLoading').style.display === 'none') renderFiltered();
        })
        .catch(function(err) {
          if (_currentPlexKey !== playlistKey) return;
          _importedMissingState.actionMessage = 'Failed to load missing source tracks: ' + err.message;
          if (document.getElementById('trackListLoading').style.display === 'none') renderFiltered();
        });
    }

    function syncImportedMissingSelection(payload) {
      if (!_currentPlexKey) return;
      fetch('/api/music/playlists/imported-unmatched/selection', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
        body: JSON.stringify(Object.assign({ playlistKey: _currentPlexKey }, payload || {})),
      })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.ok) throw new Error(data.error || 'Failed to update selection.');
          if (_currentPlexKey !== String(data.playlistKey || '')) return;
          _importedMissingState.rows = Array.isArray(data.rows) ? data.rows : [];
          _importedMissingState.selectedCount = Number(data.selectedCount || 0);
          _importedMissingState.missingCount = Number(data.missingCount || 0);
          _importedMissingState.actionMessage = '';
          renderFiltered();
        })
        .catch(function(err) {
          _importedMissingState.actionMessage = 'Could not save selection: ' + err.message;
          renderFiltered();
        });
    }

    function setAllImportedMissingSelected(selected) {
      if (!_currentPlexKey) return;
      syncImportedMissingSelection({ selectAll: true, selected: Boolean(selected) });
    }

    function toggleImportedMissingArtist(artistName, selected) {
      if (!_currentPlexKey) return;
      syncImportedMissingSelection({ artistName: String(artistName || ''), selected: Boolean(selected) });
    }

    function toggleImportedMissingRow(id, selected) {
      if (!_currentPlexKey) return;
      syncImportedMissingSelection({ ids: [Number(id || 0)], selected: Boolean(selected) });
    }


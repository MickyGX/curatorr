<%- include('partials/head', { pageTitle: title || 'Playlists — Curatorr', extraCss: extraCss || ['/styles-layout.css', '/styles-curatorr.css'] }) %>
<body class="dash-body cur-playlists-page">
  <div class="dash-frame<%= sidebarCollapsed ? ' sidebar-collapsed' : '' %>">
    <aside class="dash-sidebar">
      <div class="dash-brand">
        <span class="dash-logo">
          <img class="nav-icon app-icon" src="/icons/curatorr-icon.svg" alt="Curatorr" onerror="this.style.display='none'" />
        </span>
        <div><div class="dash-title">Curatorr</div></div>
      </div>
      <div class="dash-nav">
        <%- include('partials/nav-categories', { navActivePage: 'playlists', role: role }) %>
      </div>
      <%- include('partials/user-menu') %>
    </aside>

    <section class="dash-main">
      <div class="main-window-bar">
        <button class="sidebar-toggle main-toggle left-toggle" type="button" aria-label="Toggle sidebar">
          <img class="toggle-icon" src="/icons/sidebar-toggle.svg" alt="" />
        </button>
        <div class="main-window-title">
          <img class="main-window-icon" src="/icons/category.svg" alt="" />
          <span class="main-window-app">Curatorr</span>
          <span class="main-window-rest">| Playlists</span>
        </div>
        <div class="main-window-spacer"></div>
        <div class="main-window-status">
          <span class="status-dot"></span>
        </div>
      </div>

      <%
        const _lastSync = lastSync || null;
        const _playlistCards = Array.isArray(playlistCards) ? playlistCards : [];
        const _plexMachineId = String(plexMachineId || '').trim();
        const _msType = String(typeof mediaServerType !== 'undefined' ? mediaServerType : 'plex').trim().toLowerCase();
        const _msLabel = _msType === 'jellyfin' ? 'Jellyfin' : _msType === 'emby' ? 'Emby' : 'Plex';
        const _isAdmin = ['admin', 'co-admin'].includes(String(role || '').trim().toLowerCase());
        function fmtDate(ts) {
          if (!ts) return '—';
          return new Date(ts).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
        }
        function resolvePlaylistBadgeKind(audience, playlistType, sourceType) {
          const source = String(sourceType || '').trim().toLowerCase();
          if (source === 'spotify-playlist') return 'imported-spotify';
          if (source === 'youtube-playlist') return 'imported-youtube';
          if (source === 'lastfm-station') return 'imported-lastfm';
          if (source === 'listenbrainz-playlist') return 'imported-listenbrainz';
          if (source.startsWith('plex-')) return 'imported-plex';
          const type = String(playlistType || '').trim().toLowerCase();
          if (type === 'lastfm-station' || type === 'listenbrainz-playlist') return 'external';
          return String(audience || 'personal').trim().toLowerCase();
        }
        function playlistAudienceIconMarkup(audience, playlistType, sourceType) {
          const kind = resolvePlaylistBadgeKind(audience, playlistType, sourceType);
          if (audience === 'global' && (kind === 'imported-spotify' || kind === 'imported-youtube' || kind === 'imported-lastfm' || kind === 'imported-listenbrainz' || kind === 'imported-plex')) {
            return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3a15 15 0 0 1 0 18"></path><path d="M12 3a15 15 0 0 0 0 18"></path></svg>';
          }
          if (kind === 'imported-spotify' || kind === 'imported-youtube' || kind === 'imported-lastfm' || kind === 'imported-listenbrainz' || kind === 'imported-plex') {
            return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v10"></path><path d="m8.5 9.5 3.5 3.5 3.5-3.5"></path><path d="M4 16.5V18a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-1.5"></path></svg>';
          }
          if (kind === 'global') {
            return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3a15 15 0 0 1 0 18"></path><path d="M12 3a15 15 0 0 0 0 18"></path></svg>';
          }
          if (kind === 'external') {
            return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6"></path><path d="M10 14 20 4"></path><path d="M20 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h4"></path></svg>';
          }
          if (kind === 'system') {
            return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3.5"></circle><path d="M12 3.5v2.2"></path><path d="M12 18.3v2.2"></path><path d="m18.5 5.5-1.5 1.5"></path><path d="m7 17-1.5 1.5"></path><path d="M20.5 12h-2.2"></path><path d="M5.7 12H3.5"></path><path d="m18.5 18.5-1.5-1.5"></path><path d="M7 7 5.5 5.5"></path></svg>';
          }
          if (kind === 'blend') {
            return '<img src="/icons/blend.svg" alt="" aria-hidden="true" />';
          }
          return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h12"></path><path d="M4 10h9"></path><path d="M4 14h10"></path><path d="M4 18h7"></path><path d="M18.5 8.5 21 10l-2.5 1.5v-3z"></path></svg>';
        }
        function playlistAudienceTitle(audience, playlistType, sourceType) {
          const kind = resolvePlaylistBadgeKind(audience, playlistType, sourceType);
          if (audience === 'global' && kind === 'imported-spotify') return 'Global Spotify playlist (all users)';
          if (audience === 'global' && kind === 'imported-youtube') return 'Global YouTube playlist (all users)';
          if (audience === 'global' && kind === 'imported-lastfm') return 'Global Last.fm playlist (all users)';
          if (audience === 'global' && kind === 'imported-listenbrainz') return 'Global ListenBrainz playlist (all users)';
          if (audience === 'global' && kind === 'imported-plex') return 'Global Plex playlist (all users)';
          if (kind === 'imported-spotify') return 'Imported Spotify playlist';
          if (kind === 'imported-youtube') return 'Imported YouTube playlist';
          if (kind === 'imported-lastfm') return 'Imported Last.fm playlist';
          if (kind === 'imported-listenbrainz') return 'Imported ListenBrainz playlist';
          if (kind === 'imported-plex') return 'Imported Plex playlist';
          if (kind === 'global') return 'Global playlist';
          if (kind === 'blend') return 'Blend playlist';
          if (kind === 'external') return 'External playlist';
          if (kind === 'system') return 'System playlist';
          return 'Personal playlist';
        }
      %>

      <div class="dash-content">
        <%- include('partials/plex-banner') %>
        <div class="cur-panel cur-panel--playlist-carousel cur-panel--playlists-page-carousel" id="playlistCarouselPanel">
          <div class="cur-panel-header cur-panel-header--playlist-carousel">
            <h3 class="cur-panel-title">Playlists</h3>
            <div id="plSelectionBar" class="pl-selection-bar" style="display:none">
              <span id="plSelectionCount" class="pl-selection-count"></span>
              <button class="btn btn-sm pl-toolbar-button pl-selection-clear" type="button" onclick="clearCardSelection()">Clear</button>
              <button class="btn btn-sm pl-toolbar-button" type="button" id="plSelectionEnableBtn" onclick="toggleSelectedPlaylists(true)">Enable Selected</button>
              <button class="btn btn-sm pl-toolbar-button" type="button" id="plSelectionDisableBtn" onclick="toggleSelectedPlaylists(false)">Disable Selected</button>
              <button class="btn btn-sm pl-toolbar-button pl-toolbar-button--danger" type="button" onclick="deleteSelectedPlaylists()">Delete Selected</button>
            </div>
            <div class="cur-panel-actions">
              <span class="cur-sync-status" id="syncStatus"></span>
              <% if (_msType === 'plex' || spotifyConfigured || youtubeConfigured) { %>
              <button class="cur-nav-button cur-nav-button--compact pl-header-icon-button" type="button" aria-label="Import playlist" title="Import playlist" onclick="openImportPlaylistModal()">
                <span class="pl-header-import" aria-hidden="true">⇣</span>
              </button>
              <% } %>
              <button class="cur-nav-button cur-nav-button--compact pl-header-icon-button" type="button" aria-label="Create smart playlist" title="Create smart playlist" onclick="openSmartPlaylistModal()">
                <span class="pl-header-plus" aria-hidden="true">+</span>
              </button>
              <div class="cur-filter-menu pl-filter-menu" data-cur-filter-menu>
                <button class="cur-nav-button cur-nav-button--compact pl-filter-trigger" type="button" data-cur-filter-toggle aria-label="Open playlist filters" title="Filters" aria-haspopup="true" aria-expanded="false">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d="M4 6.5c0-.83.67-1.5 1.5-1.5h13c.83 0 1.5.67 1.5 1.5 0 .35-.12.69-.35.96L14 13.88V18c0 .32-.15.62-.41.81l-2.4 1.8A1 1 0 0 1 9.6 19.8v-5.92L4.35 7.46A1.5 1.5 0 0 1 4 6.5Z" />
                  </svg>
                </button>
                <div class="cur-filter-popover pl-filter-popover" data-cur-filter-popover hidden>
                  <div class="cur-filter-popover-heading">Playlist type</div>
                  <div class="cur-filter-popover-options" role="menu" aria-label="Playlist type filter">
                    <button class="cur-filter-option is-active" type="button" data-playlist-type-filter="all" data-cur-filter-close>
                      <span>All</span>
                      <span class="cur-filter-option-note">Every playlist</span>
                    </button>
                    <button class="cur-filter-option" type="button" data-playlist-type-filter="personal" data-cur-filter-close>
                      <span>Personal</span>
                      <span class="cur-filter-option-note">Your own smart playlists</span>
                    </button>
                    <button class="cur-filter-option" type="button" data-playlist-type-filter="imported" data-cur-filter-close>
                      <span>Imported</span>
                      <span class="cur-filter-option-note">Imported Plex, Spotify, and YouTube playlists</span>
                    </button>
                    <button class="cur-filter-option" type="button" data-playlist-type-filter="external" data-cur-filter-close>
                      <span>External</span>
                      <span class="cur-filter-option-note">Last.fm and ListenBrainz</span>
                    </button>
                    <button class="cur-filter-option" type="button" data-playlist-type-filter="blend" data-cur-filter-close>
                      <span>Blended</span>
                      <span class="cur-filter-option-note">Shared taste mixes</span>
                    </button>
                    <button class="cur-filter-option" type="button" data-playlist-type-filter="global" data-cur-filter-close>
                      <span>Global</span>
                      <span class="cur-filter-option-note">Shared across users</span>
                    </button>
                    <button class="cur-filter-option" type="button" data-playlist-type-filter="system" data-cur-filter-close>
                      <span>System</span>
                      <span class="cur-filter-option-note">Curatorr-managed defaults</span>
                    </button>
                  </div>
                  <div class="cur-filter-popover-heading">Enable status</div>
                  <div class="cur-filter-popover-options" role="menu" aria-label="Playlist enabled status filter">
                    <button class="cur-filter-option is-active" type="button" data-playlist-status-filter="all" data-cur-filter-close>
                      <span>All</span>
                      <span class="cur-filter-option-note">Enabled and disabled</span>
                    </button>
                    <button class="cur-filter-option" type="button" data-playlist-status-filter="enabled" data-cur-filter-close>
                      <span>Enabled</span>
                      <span class="cur-filter-option-note">Active in <%= _msLabel %></span>
                    </button>
                    <button class="cur-filter-option" type="button" data-playlist-status-filter="disabled" data-cur-filter-close>
                      <span>Disabled</span>
                      <span class="cur-filter-option-note">Hidden from <%= _msLabel %></span>
                    </button>
                  </div>
                </div>
              </div>
              <button class="btn btn-sm btn-ghost cur-nav-button cur-nav-button--compact" type="button" id="playlistCarouselPrev" aria-label="Previous">
                <span class="cur-nav-chev cur-nav-chev--left" aria-hidden="true"></span>
              </button>
              <button class="btn btn-sm btn-ghost cur-nav-button cur-nav-button--compact" type="button" id="playlistCarouselNext" aria-label="Next">
                <span class="cur-nav-chev cur-nav-chev--right" aria-hidden="true"></span>
              </button>
            </div>
          </div>
          <div class="cur-panel-body cur-panel-body--playlist-carousel">
            <% if (_playlistCards.length) { %>
              <div class="cur-playlist-carousel-viewport plex-carousel-viewport" id="playlistCarouselViewport">
                <div class="cur-playlist-carousel-track plex-carousel-track" id="playlistCarouselTrack">
                  <% _playlistCards.forEach(function(p, idx) { %>
                    <div class="plex-card cur-discover-result-card cur-playlist-carousel-card<%= idx === 0 ? ' is-active' : '' %><%= p.active === false ? ' is-disabled' : '' %>"
                      role="button"
                      tabindex="0"
                      data-pl-id="<%= p.plexPlaylistId || '' %>"
                      data-pl-key="<%= p.playlistKey || '' %>"
                      data-pl-title="<%= p.playlistTitle || 'Playlist' %>"
                      data-playlist-kind="<%= p.playlistKind || 'generated' %>"
                      data-playlist-type="<%= p.playlistType || '' %>"
                      data-playlist-audience="<%= p.playlistAudience || 'personal' %>"
                      data-playlist-active="<%= p.active === false ? 'false' : 'true' %>"
                      data-playlist-state="<%= p.state || 'pending' %>"
                      data-playlist-track-count="<%= Number(p.trackCount || 0) %>"
                      data-playlist-missing-count="<%= Number(p.missingCount || 0) %>"
                      data-playlist-source-type="<%= p.sourceType || '' %>"
                      data-playlist-imported-sync-period="<%= p.importedSyncPeriod || 'disabled' %>"
                      data-playlist-updated-at="<%= Number(p.curatorrUpdatedAt || 0) %>"
                      data-playlist-art="<%= p.artPath || '' %>"
                      data-playlist-art-url="<%= p.artUrl || '' %>"
                      data-playlist-artwork-mode="<%= p.artworkMode || 'auto' %>"
                      onclick="selectPlaylist(this)"
                      onkeydown="if(event.key==='Enter'||event.key===' ') { event.preventDefault(); selectPlaylist(this); }">
                      <div class="plex-poster-wrap cur-discover-poster-wrap cur-playlist-carousel-poster-wrap">
                        <div class="plex-poster-well cur-discover-result-art cur-playlist-carousel-art<%= p.artUrl ? '' : ' is-empty' %>">
                          <% if (p.artUrl) { %>
                            <img src="<%= p.artUrl %>" alt="" loading="lazy" onerror="this.parentElement.classList.add('is-empty');this.remove()" />
                          <% } %>
                          <% if (p.playlistKey && p.playlistKind !== 'draft') { %>
                          <label class="pl-card-checkbox-wrap" title="Select" onclick="event.stopPropagation()">
                            <input type="checkbox" class="pl-card-checkbox" onchange="onCardCheckChange(this)" />
                            <span class="pl-card-checkbox-ui"></span>
                          </label>
                          <% } %>
                          <button class="pl-card-btn pl-card-btn--view" type="button" title="View playlist" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);padding:9px" onclick="event.stopPropagation(); selectPlaylist(this.closest('.cur-playlist-carousel-card'))">
                            <img src="/icons/view.svg" alt="View" style="display:block;width:23px;height:23px;filter:brightness(0) invert(1)" />
                          </button>
                          <div class="pl-card-audience-badge" title="<%= playlistAudienceTitle(p.playlistAudience, p.playlistType, p.sourceType) %>">
                            <%- playlistAudienceIconMarkup(p.playlistAudience, p.playlistType, p.sourceType) %>
                          </div>
                          <% if (p.playlistType === 'personal') { %>
                          <button class="pl-card-btn pl-card-btn--edit" type="button" title="Edit playlist" style="position:absolute;bottom:8px;left:8px;padding:5px;background:rgba(161,106,0,.85)" onclick="event.stopPropagation(); openEditPlaylistModal(this.closest('.cur-playlist-carousel-card'))">
                            <img src="/icons/edit.svg" alt="Edit" style="display:block;width:18px;height:18px" />
                          </button>
                          <% } else if (p.playlistType === 'global') { %>
                          <button class="pl-card-btn pl-card-btn--edit" type="button" title="Edit playlist" style="position:absolute;bottom:8px;left:8px;padding:5px;background:rgba(161,106,0,.85)" onclick="event.stopPropagation(); openEditGlobalPlaylist(this.closest('.cur-playlist-carousel-card'))">
                            <img src="/icons/edit.svg" alt="Edit" style="display:block;width:18px;height:18px" />
                          </button>
                          <% } else if (p.playlistType === 'custom' && ['spotify-playlist', 'youtube-playlist', 'plex-playlist', 'plex-collection', 'lastfm-station', 'listenbrainz-playlist'].includes(p.sourceType) && (p.playlistAudience !== 'global' || _isAdmin)) { %>
                          <button class="pl-card-btn pl-card-btn--edit" type="button" title="Edit imported playlist" style="position:absolute;bottom:8px;left:8px;padding:5px;background:rgba(161,106,0,.85)" onclick="event.stopPropagation(); openImportedPlaylistSettingsModal(this.closest('.cur-playlist-carousel-card'))">
                            <img src="/icons/edit.svg" alt="Edit" style="display:block;width:18px;height:18px" />
                          </button>
                          <% } %>
                        </div>
                        <div class="pl-card-dots-wrap">
                          <button class="pl-card-btn pl-card-btn--dots" type="button" title="More options" onclick="event.stopPropagation(); toggleCardMenu(this)">⋯</button>
                          <div class="pl-card-menu" style="display:none">
                            <% if (p.playlistType === 'personal') { %>
                            <button type="button" onclick="event.stopPropagation(); openEditPlaylistModal(this.closest('.cur-playlist-carousel-card')); closeAllCardMenus()">Edit</button>
                            <% } else if (p.playlistType === 'global') { %>
                            <button type="button" onclick="event.stopPropagation(); openEditGlobalPlaylist(this.closest('.cur-playlist-carousel-card')); closeAllCardMenus()">Edit</button>
                            <% } else if (p.playlistType === 'custom' && ['spotify-playlist', 'youtube-playlist', 'plex-playlist', 'plex-collection', 'lastfm-station', 'listenbrainz-playlist'].includes(p.sourceType) && (p.playlistAudience !== 'global' || _isAdmin)) { %>
                            <button type="button" onclick="event.stopPropagation(); openImportedPlaylistSettingsModal(this.closest('.cur-playlist-carousel-card')); closeAllCardMenus()">Edit</button>
                            <% } %>
                            <% if (_msType === 'plex' && p.playlistKind !== 'draft' && p.playlistKey && (p.playlistType !== 'global' || _isAdmin)) { %>
                            <button type="button" onclick="event.stopPropagation(); openPlaylistArtworkModal(this.closest('.cur-playlist-carousel-card')); closeAllCardMenus()">Artwork</button>
                            <% } %>
                            <% if (['daily-mix', 'curatorr', 'crescive', 'curative'].includes(p.playlistType)) { %>
                            <button type="button" onclick="event.stopPropagation(); renameCardPlaylist(this.closest('.cur-playlist-carousel-card'))">Rename</button>
                            <% } %>
                            <% if (p.playlistKey && p.playlistKind !== 'draft') { %>
                            <button type="button" onclick="event.stopPropagation(); toggleCardPlaylistActive(this.closest('.cur-playlist-carousel-card'), <%= p.active === false ? 'true' : 'false' %>)"><%= p.active === false ? 'Enable' : 'Disable' %></button>
                            <% } %>
                            <button type="button" <%= p.active === false ? 'disabled title="Enable this playlist first."' : '' %> onclick="event.stopPropagation(); rebuildCardPlaylist(this.closest('.cur-playlist-carousel-card'))"><%= (p.playlistType === 'custom' && ['spotify-playlist', 'youtube-playlist', 'plex-playlist', 'plex-collection', 'lastfm-station', 'listenbrainz-playlist'].includes(p.sourceType)) ? 'Refresh import' : 'Rebuild' %></button>
                            <% if (['personal', 'global', 'custom', 'lastfm-station', 'listenbrainz-playlist'].includes(p.playlistType)) { %>
                            <button type="button" class="pl-card-menu-delete" onclick="event.stopPropagation(); deleteCardPlaylist(this.closest('.cur-playlist-carousel-card'))">Delete</button>
                            <% } %>
                          </div>
                        </div>
                      </div>
                      <div class="plex-footer cur-discover-result-main cur-playlist-carousel-main">
                        <div class="plex-name cur-discover-result-name cur-playlist-carousel-title"><%= p.playlistTitle || 'Playlist' %></div>
                        <div class="plex-meta cur-discover-result-meta cur-playlist-carousel-meta"><%= Number(p.trackCount || 0).toLocaleString() %> tracks<% if (Number(p.missingCount || 0) > 0) { %> • <%= Number(p.missingCount || 0).toLocaleString() %> missing<% } %></div>
                        <div class="plex-meta cur-discover-result-meta cur-playlist-carousel-meta<%= p.active === false ? ' cur-playlist-carousel-meta--disabled' : '' %>"><%= p.active === false ? 'Disabled in Plex' : (p.playlistKind === 'draft' ? 'Draft saved in Curatorr' : 'Curatorr updated ' + fmtDate(p.curatorrUpdatedAt)) %></div>
                        <% if (p.playlistType === 'custom' && ['spotify-playlist', 'youtube-playlist', 'plex-playlist', 'plex-collection', 'lastfm-station', 'listenbrainz-playlist'].includes(p.sourceType)) { %>
                        <div class="plex-meta cur-discover-result-meta cur-playlist-carousel-meta"><%= (p.importedSyncPeriod || 'disabled') === 'daily' ? 'Auto-refresh every day' : ((p.importedSyncPeriod || 'disabled') === 'weekly' ? 'Auto-refresh every week' : ((p.importedSyncPeriod || 'disabled') === 'monthly' ? 'Auto-refresh every month' : 'Auto-refresh disabled')) %></div>
                        <% } %>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% } else { %>
              <div class="cur-empty">No playlists available yet.</div>
            <% } %>
            <div id="playlistFilterEmpty" class="cur-empty" style="display:none">No playlists match the current filters.</div>

            <div id="newPlaylistDialog" class="cur-inline-dialog" style="display:none">
              <div class="cur-inline-dialog-body">
                <input id="newPlaylistTitle" class="cur-input" type="text" placeholder="Playlist name…" maxlength="120" />
                <div class="cur-inline-dialog-actions">
                  <button class="btn btn-sm btn-ghost" type="button" onclick="closeNewPlaylistDialog()">Cancel</button>
                  <button class="btn btn-sm btn-primary" type="button" onclick="createPlaylist()">Create</button>
                </div>
                <div id="newPlaylistStatus" class="cur-panel-meta" style="margin-top:6px"></div>
              </div>
            </div>

            <% if (_msType === 'plex' || spotifyConfigured || youtubeConfigured || lastfmUsername || listenbrainzUsername) { %>
            <div id="importPlModal" class="spm-overlay" style="display:none" onclick="if(event.target===this)closeImportPlaylistModal()">
              <div id="importPlDialog" class="spm-dialog spm-dialog--import" role="dialog" aria-modal="true" aria-label="Import Plex playlist or collection">
                <div id="importPlHeader" class="spm-header">
                  <span class="spm-title">Import Existing Playlist</span>
                  <button class="spm-close" type="button" onclick="closeImportPlaylistModal()" aria-label="Close">✕</button>
                </div>
                <div class="spm-body">
                  <div class="playlist-feature-note">Import an existing Plex, Spotify, URL, Last.fm, or ListenBrainz playlist as a managed custom playlist in Curatorr.</div>
                  <div class="import-pl-tabs" role="tablist" aria-label="Import source">
                    <% if (_msType === 'plex') { %>
                    <button type="button" class="import-pl-tab is-active" id="importPlexTabBtn" onclick="setImportSourceTab('plex')" role="tab" aria-selected="true">Plex</button>
                    <% } %>
                    <% if (spotifyConfigured) { %>
                    <button type="button" class="import-pl-tab<%= _msType === 'plex' ? '' : ' is-active' %>" id="importSpotifyTabBtn" onclick="setImportSourceTab('spotify')" role="tab" aria-selected="<%= _msType === 'plex' ? 'false' : 'true' %>">Spotify</button>
                    <% } %>
                    <% if (spotifyConfigured || youtubeConfigured) { %>
                    <button type="button" class="import-pl-tab<%= _msType === 'plex' || spotifyConfigured ? '' : ' is-active' %>" id="importUrlTabBtn" onclick="setImportSourceTab('url')" role="tab" aria-selected="<%= _msType === 'plex' || spotifyConfigured ? 'false' : 'true' %>">URL</button>
                    <% } %>
                    <% if (lastfmUsername) { %>
                    <button type="button" class="import-pl-tab" id="importLastfmTabBtn" onclick="setImportSourceTab('lastfm')" role="tab" aria-selected="false">Last.fm</button>
                    <% } %>
                    <% if (listenbrainzUsername) { %>
                    <button type="button" class="import-pl-tab" id="importListenbrainzTabBtn" onclick="setImportSourceTab('listenbrainz')" role="tab" aria-selected="false">ListenBrainz</button>
                    <% } %>
                  </div>
                  <% if (_msType === 'plex') { %>
                  <div id="importPlexPanel" class="import-pl-panel">
                    <label class="field import-pl-field">
                      <span>Find a source</span>
                      <input id="importPlexSearch" class="cur-input" type="search" placeholder="Filter playlists or collections…" oninput="renderImportPlexSources()" />
                    </label>
                    <div id="importPlexStatus" class="cur-panel-meta import-pl-status">Loading sources…</div>
                    <div id="importPlexList" class="import-pl-list" aria-live="polite"></div>
                    <div id="importPlexEmpty" class="cur-empty" style="display:none">No Plex playlists or collections match that search.</div>
                  </div>
                  <% } %>
                  <% if (spotifyConfigured) { %>
                  <div id="importSpotifyPanel" class="import-pl-panel" style="display:<%= _msType === 'plex' ? 'none' : 'block' %>">
                    <% if (spotifyConnected) { %>
                    <label class="field import-pl-field">
                      <span>Find a Spotify playlist</span>
                      <input id="importSpotifySearch" class="cur-input" type="search" placeholder="Filter Spotify playlists…" oninput="renderImportSpotifySources()" />
                    </label>
                    <div id="importSpotifyList" class="import-pl-list" aria-live="polite"></div>
                    <div id="importSpotifyEmpty" class="cur-empty" style="display:none">No Spotify playlists match that search.</div>
                    <% } else { %>
                    <div class="cur-empty" style="display:block">Connect Spotify in <a href="/user-settings">User Settings</a> first.</div>
                    <% } %>
                  </div>
                  <% } %>
                  <% if (spotifyConfigured || youtubeConfigured) { %>
                  <div id="importUrlPanel" class="import-pl-panel" style="display:none">
                    <div class="import-url-providers" aria-label="URL import providers">
                      <span class="import-url-provider is-active" id="importUrlProviderBadge">Auto-detecting</span>
                    </div>
                    <div class="cur-panel-meta import-url-note" id="importUrlSupportNote">Supported URLs: Spotify playlist links, URIs, playlist ids<%= youtubeConfigured ? ', and YouTube playlist links' : '' %>.</div>
                    <label class="field import-pl-field">
                      <span>Paste a playlist URL or id</span>
                      <input id="importUrlInput" class="cur-input" type="text" placeholder="https://open.spotify.com/playlist/..." autocomplete="off" oninput="onImportUrlInput()" />
                    </label>
                  </div>
                  <% if (spotifyConfigured || youtubeConfigured || lastfmUsername || listenbrainzUsername) { %>
                  <div id="importPreviewWrap">
                    <div id="importSpotifyStatus" class="cur-panel-meta import-pl-status">Paste a supported playlist URL or id.</div>
                    <div id="importSpotifyPreview" class="import-spotify-preview" style="display:none">
                      <div class="import-spotify-preview__summary" id="importSpotifyPreviewSummary"></div>
                      <div class="import-spotify-preview__stats" id="importSpotifyPreviewStats"></div>
                      <div id="importSpotifyPreviewSections" class="import-spotify-preview__sections" style="display:none">
                        <div class="import-spotify-preview__section" id="importSpotifyMatchedSection" style="display:none">
                          <div class="import-spotify-preview__section-title">Matched locally</div>
                          <div class="import-spotify-preview__list" id="importSpotifyMatchedList"></div>
                        </div>
                        <div class="import-spotify-preview__section" id="importSpotifyUnmatchedArtistsSection" style="display:none">
                          <div class="import-spotify-preview__section-title">Unmatched artists</div>
                          <div class="import-spotify-preview__list" id="importSpotifyUnmatchedArtistsList"></div>
                        </div>
                        <div class="import-spotify-preview__section" id="importSpotifyUnmatchedSection" style="display:none">
                          <div class="import-spotify-preview__section-title">Unmatched track examples</div>
                          <div class="import-spotify-preview__list" id="importSpotifyUnmatchedList"></div>
                        </div>
                        <div class="import-spotify-preview__section" id="importSpotifyDuplicateSection" style="display:none">
                          <div class="import-spotify-preview__section-title">Duplicates skipped</div>
                          <div class="import-spotify-preview__list" id="importSpotifyDuplicateList"></div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <% } %>
                  <% } %>
                  <% if (lastfmUsername) { %>
                  <div id="importLastfmPanel" class="import-pl-panel" style="display:none">
                    <div class="cur-panel-meta import-pl-status">Import from Last.fm for <strong><%= lastfmUsername %></strong>. Matching and ordering uses your saved Last.fm settings.</div>
                    <div id="importLastfmList" class="import-pl-list" aria-live="polite">
                      <% [['recommended','Recommended'],['mix','Mix'],['library','Library'],['neighbours','Neighbours'],['loved','Loved'],['topTracks:overall','Top Tracks · All Time'],['topTracks:7day','Top Tracks · 7 Days'],['topTracks:1month','Top Tracks · 1 Month'],['topTracks:3month','Top Tracks · 3 Months'],['topTracks:6month','Top Tracks · 6 Months'],['topTracks:12month','Top Tracks · 12 Months']].forEach(function(entry) { %>
                      <button type="button" class="import-pl-option" data-lastfm-source-key="<%= entry[0] %>" data-lastfm-source-title="<%= entry[1] %>">
                        <span class="import-pl-option__top">
                          <span class="import-pl-option__title"><%= entry[1] %></span>
                          <span class="import-pl-option__badge">last.fm</span>
                        </span>
                        <span class="import-pl-option__meta">Import as an editable playlist</span>
                      </button>
                      <% }) %>
                    </div>
                    <div id="importLastfmStatus" class="cur-panel-meta import-pl-status">Select a Last.fm source.</div>
                  </div>
                  <% } %>
                  <% if (listenbrainzUsername) { %>
                  <div id="importListenbrainzPanel" class="import-pl-panel" style="display:none">
                    <div class="cur-panel-meta import-pl-status">Import from ListenBrainz for <strong><%= listenbrainzUsername %></strong>. Matching and ordering uses your saved ListenBrainz settings.</div>
                    <div id="importListenbrainzList" class="import-pl-list" aria-live="polite">
                      <% [['daily-jams','Daily Jams'],['weekly-jams','Weekly Jams'],['weekly-exploration','Weekly Exploration']].forEach(function(entry) { %>
                      <button type="button" class="import-pl-option" data-listenbrainz-source-key="<%= entry[0] %>" data-listenbrainz-source-title="<%= entry[1] %>">
                        <span class="import-pl-option__top">
                          <span class="import-pl-option__title"><%= entry[1] %></span>
                          <span class="import-pl-option__badge">listenbrainz</span>
                        </span>
                        <span class="import-pl-option__meta">Import as an editable playlist</span>
                      </button>
                      <% }) %>
                    </div>
                    <div id="importListenbrainzStatus" class="cur-panel-meta import-pl-status">Select a ListenBrainz source.</div>
                  </div>
                  <% } %>
                  <label class="field import-pl-field">
                    <span>New playlist name</span>
                    <input id="importPlexTitle" class="cur-input" type="text" maxlength="120" placeholder="Imported playlist name" oninput="onImportPlexTitleInput()" />
                  </label>
                </div>
                <div class="spm-footer">
                  <% if (_isAdmin) { %>
                  <label class="import-global-toggle" style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted,#94a3b8);margin-right:auto;cursor:pointer">
                    <input type="checkbox" id="importGlobalCheckbox" style="accent-color:var(--brand,#8b5cf6);width:15px;height:15px" />
                    <span>Global playlist <span style="font-size:10px;opacity:.7">(all users)</span></span>
                  </label>
                  <% } %>
                  <button class="btn btn-ghost" type="button" onclick="closeImportPlaylistModal()">Cancel</button>
                  <button class="btn btn-primary" type="button" id="importPlexSubmitBtn" onclick="submitImportPlex()" disabled>Import</button>
                </div>
              </div>
            </div>
            <% } %>
          </div>
        </div>

        <%# ── Track list ───────────────────────────────────────────────── %>
        <div class="cur-panel cur-panel--playlist-tracks" id="playlistTracksPanel">
          <div class="cur-panel-header">
            <h3 class="cur-panel-title">Tracks</h3>
            <div class="cur-panel-actions" style="gap:8px">
              <span class="cur-panel-meta" id="trackCountLabel"></span>
              <input id="trackSearch" class="cur-input cur-input--sm" type="search" placeholder="Filter tracks…" oninput="applyFilter()" style="width:180px" />
            </div>
          </div>
          <div class="cur-panel-body">
            <div class="cur-pl-table">
              <div class="cur-pl-head">
                <button class="cur-pl-head-btn" id="sortIndexBtn" type="button" onclick="applySort('index')"># <span class="cur-pl-sort-arrow" aria-hidden="true"></span></button>
                <button class="cur-pl-head-btn" id="sortTitleBtn" type="button" onclick="applySort('title')">Track <span class="cur-pl-sort-arrow" aria-hidden="true"></span></button>
                <button class="cur-pl-head-btn" id="sortAlbumBtn" type="button" onclick="applySort('albumName')">Album <span class="cur-pl-sort-arrow" aria-hidden="true"></span></button>
                <button class="cur-pl-head-btn" id="sortArtistBtn" type="button" onclick="applySort('artistName')">Artist <span class="cur-pl-sort-arrow" aria-hidden="true"></span></button>
                <button class="cur-pl-head-btn cur-pl-head-btn--right" id="sortDurationBtn" type="button" onclick="applySort('duration')">Duration <span class="cur-pl-sort-arrow" aria-hidden="true"></span></button>
                <span class="cur-pl-col-act"></span>
              </div>
              <div class="cur-pl-body">
                <div id="trackList"></div>

                <div id="loadMoreWrap" style="display:none; text-align:center; padding:16px">
                  <button class="btn btn-ghost" id="loadMoreBtn" onclick="loadMore()">Load more</button>
                  <button class="btn btn-ghost" id="loadAllBtn" onclick="loadAll()" style="margin-left:8px">Load all</button>
                </div>
                <div id="trackListEmpty" class="cur-empty" style="display:none">No tracks found.</div>
                <div id="trackListLoading" class="cur-empty">Loading playlist…</div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>
  </div>

  <style>

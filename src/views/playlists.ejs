      card.dataset.playlistImportedSyncPeriod = normalizeImportedSyncPeriod(data.importedSyncPeriod || 'disabled');
      card.dataset.playlistUpdatedAt = String(Number(data.updatedAt || Date.now()));
      card.dataset.playlistArt = data.artPath || '';
      card.dataset.playlistArtUrl = data.artUrl || '';
      card.dataset.playlistArtworkMode = data.artworkMode || 'auto';
      if (data.active === false) card.classList.add('is-disabled');
      var isDraft = String(data.playlistKind || '').trim().toLowerCase() === 'draft';
      var isPersonal = data.playlistType === 'personal';
      var isGlobal = data.playlistType === 'global';
      var isSystemRenameable = ['daily-mix', 'curatorr', 'crescive', 'curative'].indexOf(data.playlistType || '') !== -1;
      var isActive = data.active !== false;
      var playlistAudience = resolvePlaylistAudience(data);
      var isDeletable = ['personal', 'global', 'custom', 'lastfm-station', 'listenbrainz-playlist'].indexOf(data.playlistType || '') !== -1;

      }

      var seasonalOpen = (_wizardState.activeContentSection || 'genre') === 'seasonal';
      var tiersOpen = (_wizardState.activeContentSection || 'genre') === 'tiers';

      html += renderSourceSection(
        'Curatorr',
        'These values are computed or inferred inside Curatorr. Decades come from stored release dates, while artist and track tiers come from your listening history and skip behaviour.',

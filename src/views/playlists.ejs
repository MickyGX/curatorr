    function submitPlaylistArtwork() {
      var card = _playlistArtworkState.card;
      if (!card) return;
      var playlistKey = String(card.dataset.plKey || '').trim();
      if (!playlistKey) return;
      var mode = String(document.getElementById('playlistArtworkMode') && document.getElementById('playlistArtworkMode').value || 'auto').trim().toLowerCase();
      var statusEl = document.getElementById('playlistArtworkStatus');
      var saveBtn = document.getElementById('playlistArtworkSaveBtn');
      if (mode === 'custom' && !_playlistArtworkState.customArtworkData && String(card.dataset.playlistArtworkMode || '').trim().toLowerCase() !== 'custom') {
        if (statusEl) statusEl.textContent = 'Choose an image for custom artwork.';
        return;
      }
      if (saveBtn) saveBtn.disabled = true;
      if (statusEl) statusEl.textContent = 'Saving artwork…';
      fetch('/api/music/playlists/generated/artwork', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
        body: JSON.stringify({
          playlistKey: playlistKey,
          artwork: {
            mode: mode,
            customArtworkData: _playlistArtworkState.customArtworkData || undefined,
          },
        }),
      })
        .then(function(r) { return r.json().catch(function() { return {}; }); })
        .then(function(data) {
          if (!data.ok) throw new Error(data.error || 'Failed to update artwork.');
          if (statusEl) statusEl.textContent = 'Artwork saved.';
          window.location.reload();
        })
        .catch(function(err) {
          if (statusEl) statusEl.textContent = 'Error: ' + (err.message || 'Unknown');
          if (saveBtn) saveBtn.disabled = false;
        });
    }

    document.addEventListener('change', function(event) {
      if (!event.target || event.target.id !== 'playlistArtworkFile') return;
      var file = event.target.files && event.target.files[0];
      var statusEl = document.getElementById('playlistArtworkStatus');
      if (!file) {
        _playlistArtworkState.customArtworkData = '';
        if (statusEl) statusEl.textContent = '';
        return;
      }
      var allowed = ['image/png', 'image/jpeg', 'image/webp'];
      if (allowed.indexOf(String(file.type || '').toLowerCase()) === -1) {
        event.target.value = '';
        _playlistArtworkState.customArtworkData = '';
        if (statusEl) statusEl.textContent = 'Please choose a PNG, JPG, or WEBP image.';
        return;
      }
      if (Number(file.size || 0) > 5 * 1024 * 1024) {
        event.target.value = '';
        _playlistArtworkState.customArtworkData = '';
        if (statusEl) statusEl.textContent = 'Artwork images must be 5 MB or smaller.';
        return;
      }
      var reader = new FileReader();
      reader.onload = function(loadEvent) {
        _playlistArtworkState.customArtworkData = String(loadEvent && loadEvent.target && loadEvent.target.result || '');
        if (statusEl) statusEl.textContent = 'Ready to save: ' + file.name;
      };
      reader.onerror = function() {
        _playlistArtworkState.customArtworkData = '';
        if (statusEl) statusEl.textContent = 'Could not read the selected image.';
      };
      reader.readAsDataURL(file);
    });


    function wizardAssembleTrackFilters(ws) {
      var includeFolders = Array.isArray(ws.includeFolders) ? ws.includeFolders.filter(Boolean) : [];
      var excludeFolders = Array.isArray(ws.excludeFolders) ? ws.excludeFolders.filter(Boolean) : [];
      var deduplicateByMbid = Boolean(ws.deduplicateByMbid);
      var deduplicateByArtistTitle = Boolean(ws.deduplicateByArtistTitle);
      var deduplicateByDuration = Boolean(ws.deduplicateByDuration);
      var deduplicateIgnoreLikelyVariants = Boolean(ws.deduplicateIgnoreLikelyVariants);
      var deduplicateIgnoreLiveAlbums = Boolean(ws.deduplicateIgnoreLiveAlbums);
      var rules = Array.isArray(ws.advancedRules) ? ws.advancedRules.filter(function(rule) {
        return rule && rule.field && rule.operator && rule.value != null && String(rule.value).trim() !== '';
      }).map(function(rule) {
        return {
          field: String(rule.field),
          operator: String(rule.operator),
          value: String(rule.value),
          caseSensitive: Boolean(rule.caseSensitive),
        };
      }) : [];
      if (!includeFolders.length && !excludeFolders.length && !rules.length && !deduplicateByMbid && !deduplicateByArtistTitle && !deduplicateByDuration && !deduplicateIgnoreLikelyVariants && !deduplicateIgnoreLiveAlbums) return null;
      return {
        includeFolders: includeFolders,
        excludeFolders: excludeFolders,
        deduplicateByMbid: deduplicateByMbid,
        deduplicateByArtistTitle: deduplicateByArtistTitle,
        deduplicateByDuration: deduplicateByDuration,
        deduplicateIgnoreLikelyVariants: deduplicateIgnoreLikelyVariants,

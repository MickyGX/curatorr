          bodyEl.appendChild(temp.firstChild);
        });
        groupEl.appendChild(bodyEl);
        wrapper.appendChild(groupEl);
      });

      frag.appendChild(wrapper);
    }

    // ── Row builder ───────────────────────────────────────────────────────────


    function wizardSuggestedName(state) {
      var parts = [];
      var targetLabel = wizardTargetLabel(state && state.playlistTarget || 'personal');
      if (targetLabel) parts.push(targetLabel);
      var tmpl = wizardFindTemplate(state && state.templateId || 'blank');
      if (tmpl && tmpl.id !== 'blank' && tmpl.name) parts.push(tmpl.name);
      var preset = String(state && state.featurePreset || 'none');
      var presetMeta = WIZARD_FEATURE_PRESET_META[preset] || null;
      if (preset !== 'none' && presetMeta && presetMeta.label) parts.push(presetMeta.label);
      if (parts.length === 1) parts.push('Playlist');
      return parts.join(' ').replace(/\s+/g, ' ').trim();
    }

    function wizardSyncSuggestedName(state, force) {
      if (!state) return;
      if (state.nameManual && !force && state.name) return;
      state.name = wizardSuggestedName(state);

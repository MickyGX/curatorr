        spotifyBtn.classList.toggle('is-active', _importSourceTab === 'spotify');
        spotifyBtn.setAttribute('aria-selected', _importSourceTab === 'spotify' ? 'true' : 'false');
      }
      if (urlBtn) {
        urlBtn.classList.toggle('is-active', _importSourceTab === 'url');
        urlBtn.setAttribute('aria-selected', _importSourceTab === 'url' ? 'true' : 'false');
      }
      if (lastfmBtn) {
        lastfmBtn.classList.toggle('is-active', _importSourceTab === 'lastfm');
        lastfmBtn.setAttribute('aria-selected', _importSourceTab === 'lastfm' ? 'true' : 'false');
      }
      if (listenbrainzBtn) {
        listenbrainzBtn.classList.toggle('is-active', _importSourceTab === 'listenbrainz');
        listenbrainzBtn.setAttribute('aria-selected', _importSourceTab === 'listenbrainz' ? 'true' : 'false');
      }
      if (plexPanel) plexPanel.style.display = _importSourceTab === 'plex' ? 'block' : 'none';
      if (spotifyPanel) spotifyPanel.style.display = _importSourceTab === 'spotify' ? 'block' : 'none';
      if (urlPanel) urlPanel.style.display = _importSourceTab === 'url' ? 'block' : 'none';
      if (lastfmPanel) lastfmPanel.style.display = _importSourceTab === 'lastfm' ? 'block' : 'none';
      if (listenbrainzPanel) listenbrainzPanel.style.display = _importSourceTab === 'listenbrainz' ? 'block' : 'none';
      if (previewWrap) {
        var targetPanel = _importSourceTab === 'spotify'
          ? spotifyPanel
          : (_importSourceTab === 'url'
            ? urlPanel
            : (_importSourceTab === 'lastfm'
              ? lastfmPanel
              : (_importSourceTab === 'listenbrainz' ? listenbrainzPanel : plexPanel)));
        if (targetPanel && targetPanel.parentNode) {
          targetPanel.insertAdjacentElement('afterend', previewWrap);
        }
      }
      resetImportedTitleField();
      if (_importSourceTab === 'spotify' || _importSourceTab === 'url' || _importSourceTab === 'lastfm' || _importSourceTab === 'listenbrainz') {
        renderActiveImportSpotifyPreview();
      } else {
        var previewEl = document.getElementById('importSpotifyPreview');
        var sectionsEl = document.getElementById('importSpotifyPreviewSections');
        if (previewEl) previewEl.style.display = 'none';
        if (sectionsEl) sectionsEl.style.display = 'none';
      }
      if (_importSourceTab === 'lastfm') renderImportLastfmSources();
      if (_importSourceTab === 'listenbrainz') renderImportListenbrainzSources();
      updateImportSubmitButton();
    }

    function getUrlImportEndpoint(provider, mode) {
      if (mode === 'import') {
        if (provider === 'youtube') return '/api/music/import/youtube';
        if (provider === 'lastfm') return '/api/music/import/lastfm';
        if (provider === 'listenbrainz') return '/api/music/import/listenbrainz';
        return '/api/music/import/spotify';
      }
      if (provider === 'youtube') return '/api/music/import/youtube/preview';
      if (provider === 'lastfm') return '/api/music/import/lastfm/preview';
      if (provider === 'listenbrainz') return '/api/music/import/listenbrainz/preview';
      return '/api/music/import/spotify/preview';
    }

    function buildImportPreviewUrl(provider, item, sourceTab) {
      var endpoint = getUrlImportEndpoint(provider, 'preview');
      var params = new URLSearchParams();
      if (provider === 'lastfm' || provider === 'listenbrainz') {
        params.set('sourceKey', String(item && item.sourceKey || item && item.id || '').trim());
      } else {
        params.set('playlistId', String(item && item.id || '').trim());
        if (provider === 'spotify' && sourceTab === 'url') params.set('source', 'url');
      }
      return endpoint + '?' + params.toString();
    }

    function updateImportSubmitButton() {
      var submitBtn = document.getElementById('importPlexSubmitBtn');
      if (!submitBtn) return;
      if (_importSourceTab === 'spotify' || _importSourceTab === 'url') {
        var selection = getImportSpotifySelectionForTab(_importSourceTab);
        var preview = getImportSpotifyPreviewForTab(_importSourceTab);
        var canImportSpotify = Boolean(selection && preview && Number(preview.matchedCount || 0) > 0);
        if (!selection) submitBtn.textContent = _importSourceTab === 'url' ? 'Paste a URL' : 'Select a playlist';
        else if (!preview) submitBtn.textContent = 'Checking matches…';
        else if (preview.partial === true) submitBtn.textContent = 'Import available matches';
        else if (!Number(preview.totalSourceTracks || 0) && Number(selection.trackCount || 0) > 0) submitBtn.textContent = 'Preview unavailable';
        else if (!Number(preview.totalSourceTracks || 0)) submitBtn.textContent = 'Playlist is empty';
        else if (!Number(preview.matchedCount || 0)) submitBtn.textContent = 'No matched tracks';
        else submitBtn.textContent = 'Import matched tracks';
        submitBtn.disabled = !canImportSpotify;
      } else if (_importSourceTab === 'lastfm') {
        submitBtn.textContent = _importLastfmSelection ? 'Import' : 'Select a source';
        submitBtn.disabled = !_importLastfmSelection;
      } else if (_importSourceTab === 'listenbrainz') {
        submitBtn.textContent = _importListenbrainzSelection ? 'Import' : 'Select a source';
        submitBtn.disabled = !_importListenbrainzSelection;
      } else {
        submitBtn.textContent = 'Import';
        submitBtn.disabled = !_importPlexSelection;
      }
    }

    function upsertImportSpotifySource(item) {
      if (!item || !item.id) return null;
      var nextItem = {
        id: String(item.id || '').trim(),
        name: String(item.name || '').trim(),
        description: String(item.description || '').trim(),
        ownerId: String(item.ownerId || '').trim(),
        ownerName: String(item.ownerName || '').trim(),
        public: item.public === true,
        collaborative: item.collaborative === true,
        trackCount: Number(item.trackCount || 0),
        snapshotId: String(item.snapshotId || '').trim(),
        imageUrl: String(item.imageUrl || '').trim(),
        externalUrl: String(item.externalUrl || '').trim(),
      };
      var existingIndex = _importSpotifySources.findIndex(function(entry) {
        return String(entry && entry.id || '') === nextItem.id;
      });
      if (existingIndex === -1) _importSpotifySources.push(nextItem);
      else _importSpotifySources[existingIndex] = nextItem;
      _importSpotifySources.sort(function(a, b) {
        return String(a.name || '').localeCompare(String(b.name || ''));
      });
      return nextItem;
    }

    function parseSpotifyPlaylistIdFromInput(value) {
      var raw = String(value || '').trim();
      if (!raw) return '';
      var uriMatch = raw.match(/^spotify:playlist:([A-Za-z0-9]+)$/i);
      if (uriMatch) return String(uriMatch[1] || '').trim();
      if (/^[A-Za-z0-9]{10,}$/i.test(raw)) return raw;
      try {
        var parsed = new URL(raw);
        if (!String(parsed.hostname || '').toLowerCase().endsWith('spotify.com')) return '';
        var match = String(parsed.pathname || '').match(/\/playlist\/([A-Za-z0-9]+)/i);
        return match ? String(match[1] || '').trim() : '';
      } catch (_err) {
        return '';
      }
    }

    function parseYouTubePlaylistIdFromInput(value) {
      var raw = String(value || '').trim();
      if (!raw) return '';
      if (/^(PL|LL|FL|UU|RD|OLAK5uy)[A-Za-z0-9_-]{10,}$/i.test(raw)) return raw;
      try {
        var parsed = new URL(raw);
        var host = String(parsed.hostname || '').toLowerCase();
        if (!(host.indexOf('youtube.com') !== -1 || host === 'youtu.be')) return '';
        return String(parsed.searchParams.get('list') || '').trim();
      } catch (_err) {
        return '';
      }
    }

    function resetImportedTitleField() {
      var titleInput = document.getElementById('importPlexTitle');
      if (!titleInput) return;
      if (_importSourceTab === 'spotify' && _importSpotifySelection && !_importPlexTitleTouched) {
        titleInput.value = _importSpotifySelection.name || '';
      } else if (_importSourceTab === 'url' && _importUrlSelection && !_importPlexTitleTouched) {
        titleInput.value = _importUrlSelection.name || '';
      } else if (_importSourceTab === 'lastfm' && _importLastfmSelection && !_importPlexTitleTouched) {
        titleInput.value = _importLastfmSelection.title || '';
      } else if (_importSourceTab === 'listenbrainz' && _importListenbrainzSelection && !_importPlexTitleTouched) {
        titleInput.value = _importListenbrainzSelection.title || '';
      } else if (_importSourceTab === 'plex' && _importPlexSelection && !_importPlexTitleTouched) {
        titleInput.value = _importPlexSelection.title || '';
      }
    }

    function onImportUrlInput() {
      var urlInput = document.getElementById('importUrlInput');
      var statusEl = document.getElementById('importSpotifyStatus');
      var previewEl = document.getElementById('importSpotifyPreview');
      var raw = String(urlInput && urlInput.value || '').trim();
      var providerInfo = detectImportUrlProvider(raw);
      updateImportUrlProviderUI(raw);
      clearTimeout(_importUrlDebounce);
      if (!raw) {
        if (_importUrlSelection) {
          _importUrlSelection = null;
          _importUrlPreview = null;
          if (previewEl) previewEl.style.display = 'none';
          renderActiveImportSpotifyPreview();
          updateImportSubmitButton();
        }
        if (statusEl) statusEl.textContent = getImportSpotifyIdleStatus('url');
        return;
      }
      _importUrlDebounce = setTimeout(function() {
        if (!providerInfo.supported) {
          if (statusEl) {
            if (providerInfo.provider === 'spotify' && SPOTIFY_CONFIGURED && !SPOTIFY_CONNECTED) statusEl.textContent = 'Connect Spotify in User Settings first.';
            else if (providerInfo.provider === 'youtube' && !YOUTUBE_CONFIGURED) statusEl.textContent = 'YouTube integration is not configured.';
            else statusEl.textContent = 'Enter a supported playlist URL or id.';
          }
          return;
        }
        var playlistId = providerInfo.provider === 'youtube'
          ? parseYouTubePlaylistIdFromInput(raw)
          : parseSpotifyPlaylistIdFromInput(raw);
        if (!playlistId) {
          if (statusEl) statusEl.textContent = providerInfo.provider === 'youtube'
            ? 'Enter a valid YouTube playlist URL or playlist id.'
            : 'Enter a valid Spotify playlist URL, URI, or playlist id.';
          return;
        }
        _importUrlSelection = {
          id: playlistId,
          name: '',
          ownerName: '',
          trackCount: 0,
          provider: providerInfo.provider,
        };
        _importUrlPreview = null;
        resetImportedTitleField();
        renderActiveImportSpotifyPreview();
        loadImportSpotifyPreview(_importUrlSelection, 'url');
      }, 350);
    }

    function ensureModalAtRoot(modalId) {
      var modal = document.getElementById(modalId);
      if (!modal || !document.body || modal.parentNode === document.body) return modal;
      document.body.appendChild(modal);
      return modal;
    }

    function openImportPlaylistModal() {
      var modal = ensureModalAtRoot('importPlModal');
      if (!modal) return;
      modal.style.display = '';
      modal.scrollTop = 0;
      var dialogEl = document.getElementById('importPlDialog') || modal.querySelector('.spm-dialog--import');
      var bodyEl = modal.querySelector('.spm-body');
      var headerEl = document.getElementById('importPlHeader');
      if (dialogEl) dialogEl.scrollTop = 0;
      if (bodyEl) bodyEl.scrollTop = 0;
      if (headerEl && typeof headerEl.scrollIntoView === 'function') headerEl.scrollIntoView({ block: 'start' });
      requestAnimationFrame(function() {
        modal.scrollTop = 0;
        if (dialogEl) dialogEl.scrollTop = 0;
        if (bodyEl) bodyEl.scrollTop = 0;
        if (headerEl && typeof headerEl.scrollIntoView === 'function') headerEl.scrollIntoView({ block: 'start' });
      });
      setTimeout(function() {
        modal.scrollTop = 0;
        if (dialogEl) dialogEl.scrollTop = 0;
        if (bodyEl) bodyEl.scrollTop = 0;
      }, 0);
      _importPlexSources = [];
      _importPlexSelection = null;
      _importSpotifySources = [];
      _importSpotifySelection = null;
      _importSpotifyPreview = null;
      _importUrlSelection = null;
      _importUrlPreview = null;
      _importLastfmSelection = null;
      _importListenbrainzSelection = null;
      clearTimeout(_importUrlDebounce);
      _importPlexTitleTouched = false;
      var titleInput = document.getElementById('importPlexTitle');
      var searchInput = document.getElementById('importPlexSearch');
      var spotifySearchInput = document.getElementById('importSpotifySearch');
      var urlInput = document.getElementById('importUrlInput');
      var statusEl = document.getElementById('importPlexStatus');
      var spotifyStatusEl = document.getElementById('importSpotifyStatus');
      var submitBtn = document.getElementById('importPlexSubmitBtn');
      if (titleInput) titleInput.value = '';
      if (searchInput) searchInput.value = '';
      if (spotifySearchInput) spotifySearchInput.value = '';
      if (urlInput) urlInput.value = '';
      var globalCheckbox = document.getElementById('importGlobalCheckbox');
      if (globalCheckbox) globalCheckbox.checked = false;
      updateImportUrlProviderUI('');
      if (submitBtn) submitBtn.disabled = true;
      if (statusEl) statusEl.textContent = 'Loading sources…';
      if (spotifyStatusEl) spotifyStatusEl.textContent = getImportSpotifyIdleStatus(IMPORT_HAS_PLEX ? 'spotify' : (SPOTIFY_CONFIGURED ? 'spotify' : 'url'));
      if (document.getElementById('importPlexList')) document.getElementById('importPlexList').innerHTML = '';
      if (document.getElementById('importSpotifyList')) document.getElementById('importSpotifyList').innerHTML = '';
      if (document.getElementById('importPlexEmpty')) document.getElementById('importPlexEmpty').style.display = 'none';
      if (document.getElementById('importSpotifyEmpty')) document.getElementById('importSpotifyEmpty').style.display = 'none';
      if (document.getElementById('importSpotifyPreview')) document.getElementById('importSpotifyPreview').style.display = 'none';
      bindStaticImportSourceButtons();
      setImportSourceTab(IMPORT_HAS_PLEX ? 'plex' : (SPOTIFY_CONFIGURED ? 'spotify' : (LASTFM_USERNAME ? 'lastfm' : (LISTENBRAINZ_USERNAME ? 'listenbrainz' : 'url'))));
      if (IMPORT_HAS_PLEX) loadImportPlexSources();
      if (SPOTIFY_CONFIGURED && SPOTIFY_CONNECTED) loadImportSpotifySources();
      renderImportLastfmSources();
      renderImportListenbrainzSources();
    }

    function loadImportPlexSources() {
      var statusEl = document.getElementById('importPlexStatus');
      fetch('/api/music/import/plex/sources')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.ok) throw new Error(data.error || 'Failed to load Plex sources.');
          var playlists = Array.isArray(data.playlists) ? data.playlists : [];
          var collections = Array.isArray(data.collections) ? data.collections : [];
          _importPlexSources = playlists
            .map(function(item) { return { kind: 'playlist', id: item.id, title: item.title, trackCount: Number(item.trackCount || 0), updatedAt: Number(item.updatedAt || 0), libraryTitle: '' }; })
            .concat(collections.map(function(item) {
              return {
                kind: 'collection',
                id: item.id,
                title: item.title,
                trackCount: Number(item.trackCount || 0),
                updatedAt: Number(item.updatedAt || 0),
                libraryTitle: item.libraryTitle || '',
              };
            }));
          _importPlexSources.sort(function(a, b) {
            if (a.kind !== b.kind) return a.kind === 'playlist' ? -1 : 1;
            return String(a.title || '').localeCompare(String(b.title || ''));
          });
          renderImportPlexSources();
        })
        .catch(function(err) {
          if (statusEl) statusEl.textContent = 'Error: ' + (err.message || 'Unknown');
        });
    }

    function bindStaticImportSourceButtons() {
      document.querySelectorAll('#importLastfmList [data-lastfm-source-key]').forEach(function(button) {
        if (button.dataset.bound === 'true') return;
        button.dataset.bound = 'true';
        button.addEventListener('click', function() {
          _importLastfmSelection = {
            id: String(button.getAttribute('data-lastfm-source-key') || '').trim(),
            sourceKey: String(button.getAttribute('data-lastfm-source-key') || '').trim(),
            title: String(button.getAttribute('data-lastfm-source-title') || '').trim(),
            name: String(button.getAttribute('data-lastfm-source-title') || '').trim(),
            ownerName: LASTFM_USERNAME,
            provider: 'lastfm',
            trackCount: 0,
          };
          _importLastfmPreview = null;
          resetImportedTitleField();
          renderImportLastfmSources();
          renderActiveImportSpotifyPreview();
          loadImportSpotifyPreview(_importLastfmSelection, 'lastfm');
          updateImportSubmitButton();
        });
      });
      document.querySelectorAll('#importListenbrainzList [data-listenbrainz-source-key]').forEach(function(button) {
        if (button.dataset.bound === 'true') return;
        button.dataset.bound = 'true';
        button.addEventListener('click', function() {
          _importListenbrainzSelection = {
            id: String(button.getAttribute('data-listenbrainz-source-key') || '').trim(),
            sourceKey: String(button.getAttribute('data-listenbrainz-source-key') || '').trim(),
            title: String(button.getAttribute('data-listenbrainz-source-title') || '').trim(),
            name: String(button.getAttribute('data-listenbrainz-source-title') || '').trim(),
            ownerName: LISTENBRAINZ_USERNAME,
            provider: 'listenbrainz',
            trackCount: 0,
          };
          _importListenbrainzPreview = null;
          resetImportedTitleField();
          renderImportListenbrainzSources();
          renderActiveImportSpotifyPreview();
          loadImportSpotifyPreview(_importListenbrainzSelection, 'listenbrainz');
          updateImportSubmitButton();
        });
      });

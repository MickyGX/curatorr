    .playlist-preset-card__eyebrow { display:block; font-size:11px; letter-spacing:.12em; text-transform:uppercase; color:rgba(255,255,255,.5); margin-bottom:4px; }
    .playlist-preset-card__title { display:block; font-weight:700; margin-bottom:4px; color:#f8fafc; }
    .playlist-preset-card__desc { display:block; font-size:12px; color:rgba(255,255,255,.74); line-height:1.45; }
    .playlist-preset-card__meta { display:block; margin-top:7px; font-size:11px; color:rgba(255,255,255,.58); }
    .playlist-preset-card--none .playlist-preset-card__art { background:
      linear-gradient(135deg,rgba(255,255,255,.06) 0 12%,transparent 12% 100%),
      linear-gradient(135deg,#111827,#1f2937); }
    .playlist-preset-card--club .playlist-preset-card__art { background:
      radial-gradient(circle at 20% 25%,rgba(236,72,153,.95),transparent 35%),
      radial-gradient(circle at 80% 20%,rgba(59,130,246,.9),transparent 34%),
      linear-gradient(135deg,#140c1c,#312e81 54%,#0f172a); }
    .playlist-preset-card--club .playlist-preset-card__art::after { right:-8%; bottom:-18%; width:82%; height:82%; border-color:rgba(244,114,182,.34); box-shadow:0 0 0 16px rgba(59,130,246,.10), 0 0 0 36px rgba(236,72,153,.10); }
    .playlist-preset-card--driving .playlist-preset-card__art { background:
      linear-gradient(180deg,rgba(251,191,36,.98),rgba(249,115,22,.88) 44%,rgba(30,41,59,.98)),
      linear-gradient(120deg,#1e3a8a,#0f172a); }
    .playlist-preset-card--driving .playlist-preset-card__art::after { right:-2%; bottom:-22%; width:56%; height:110%; border-radius:28px; border-color:rgba(255,255,255,.30); box-shadow:0 0 0 10px rgba(255,255,255,.06), inset 0 0 0 1px rgba(255,255,255,.08); transform:skewX(-18deg); }
    .playlist-preset-card--workout .playlist-preset-card__art { background:
      linear-gradient(135deg,rgba(239,68,68,.98),rgba(249,115,22,.92) 42%,rgba(17,24,39,.98)); }
    .playlist-preset-card--workout .playlist-preset-card__art::after { right:-14%; bottom:-30%; width:74%; height:88%; border-color:rgba(254,215,170,.28); box-shadow:0 0 0 16px rgba(249,115,22,.10), 0 0 0 34px rgba(239,68,68,.08); transform:rotate(-10deg); }
    .playlist-preset-card--chill .playlist-preset-card__art { background:
      radial-gradient(circle at 25% 20%,rgba(125,211,252,.85),transparent 28%),
      linear-gradient(135deg,#0f172a,#1d4ed8 55%,#164e63); }
    .playlist-preset-card--chill .playlist-preset-card__art::after { right:-4%; bottom:-24%; width:68%; height:76%; border-color:rgba(186,230,253,.26); box-shadow:0 0 0 14px rgba(125,211,252,.08), 0 0 0 32px rgba(14,165,233,.05); transform:rotate(-6deg); }
    .playlist-preset-card--harmonic .playlist-preset-card__art { background:
      radial-gradient(circle at center,rgba(255,255,255,.16) 0,rgba(255,255,255,.06) 24%,transparent 25%),
      conic-gradient(from 45deg,#f59e0b,#f97316,#ef4444,#8b5cf6,#3b82f6,#14b8a6,#f59e0b); }
    .playlist-preset-card--harmonic .playlist-preset-card__art::after { right:10%; bottom:12%; width:34%; height:34%; border-color:rgba(255,255,255,.28); box-shadow:0 0 0 12px rgba(255,255,255,.08), 0 0 0 24px rgba(255,255,255,.04); transform:none; }
    .playlist-preset-card--downtempo .playlist-preset-card__art { background:
      linear-gradient(135deg,#0f172a,#334155 45%,#475569); }
    .playlist-preset-card--downtempo .playlist-preset-card__art::after { right:-10%; bottom:-28%; width:72%; height:72%; border-color:rgba(226,232,240,.18); box-shadow:0 0 0 16px rgba(148,163,184,.08), 0 0 0 34px rgba(71,85,105,.06); }
    .playlist-feature-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:10px; margin-top:12px; align-items:end; }
    .playlist-feature-grid .field { display:flex; flex-direction:column; gap:6px; min-width:0; }
    .playlist-feature-grid .field span { font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.08em; color:var(--muted,#94a3b8); }
    .playlist-feature-grid .field input,
    .playlist-feature-grid .field select { width:100%; min-height:40px; box-sizing:border-box; border-radius:10px; border:1px solid var(--border, rgba(255,255,255,.15)); background:var(--surface-1,#1e1e1e); color:var(--text,#e5e7eb); padding:8px 10px; }
    .playlist-feature-note { margin-top:10px; font-size:12px; line-height:1.55; color:var(--muted,#a0aec0); }
    .playlist-feature-note strong { color:var(--text,#f8fafc); }
    .playlist-inline-code { display:inline-flex; align-items:center; padding:2px 6px; border-radius:5px; font-size:11px; line-height:1.35; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.08); color:inherit; }
    [data-theme="day"] .playlist-preset-card { background:linear-gradient(180deg,#ffffff,#eef3f8); border-color:rgba(10,20,30,.12); color:#223043; box-shadow:0 16px 36px rgba(15,23,42,.10); }
    [data-theme="day"] .playlist-preset-card:hover { border-color:rgba(var(--brand-rgb), .24); box-shadow:0 18px 40px rgba(15,23,42,.14); }
    [data-theme="day"] .playlist-preset-card.is-active { border-color:rgba(245,158,11,.92); box-shadow:0 0 0 1px rgba(245,158,11,.18), 0 18px 42px rgba(245,158,11,.14); }
    [data-theme="day"] .playlist-preset-card__art { border-color:rgba(10,20,30,.10); box-shadow:inset 0 1px 0 rgba(255,255,255,.18), inset 0 -24px 36px rgba(15,23,42,.12); }
    [data-theme="day"] .playlist-preset-card__eyebrow { color:#738297; }
    [data-theme="day"] .playlist-preset-card__title { color:#223043; }
    [data-theme="day"] .playlist-preset-card__desc { color:#4f5f73; }
    [data-theme="day"] .playlist-preset-card__meta { color:#6b7a8d; }
    [data-theme="day"] .playlist-feature-grid .field span { color:#6b7a8d; }
    [data-theme="day"] .playlist-feature-grid .field input,
    [data-theme="day"] .playlist-feature-grid .field select { background:linear-gradient(180deg,#ffffff,#f6f8fb); color:#223043; border-color:rgba(10,20,30,.12); }
    [data-theme="day"] .playlist-artwork-field span { color:#6b7a8d; }
    [data-theme="day"] .playlist-artwork-control { background:linear-gradient(180deg,#ffffff,#f6f8fb); color:#223043; border-color:rgba(10,20,30,.12); }
    [data-theme="day"] .playlist-artwork-file { color:#223043; }
    [data-theme="day"] .playlist-artwork-file::file-selector-button { border-color:rgba(10,20,30,.12); background:rgba(15,23,42,.04); color:#223043; }
    [data-theme="day"] .imported-playlist-toggle { background:rgba(15,23,42,.03); border-color:rgba(10,20,30,.1); }
    [data-theme="day"] .imported-playlist-toggle-title { color:#223043; }
    [data-theme="day"] .playlist-feature-note { color:#5e6d80; }
    [data-theme="day"] .playlist-feature-note strong { color:#1f2d3d; }
    [data-theme="day"] .playlist-inline-code { background:rgba(var(--brand-rgb), .09); border-color:rgba(var(--brand-rgb), .14); color:#223043; }
    @media (max-width: 860px) {
      .playlist-feature-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    }
    @media (max-width: 560px) {
      .playlist-preset-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
      .playlist-feature-grid { grid-template-columns:1fr; }
    }
  </style>

  <%# ── Smart Playlist Modal ────────────────────────────────────────────────── %>
  <div id="playlistArtworkModal" class="spm-overlay" style="display:none" onclick="if(event.target===this)closePlaylistArtworkModal()">
    <div class="spm-dialog playlist-artwork-dialog" role="dialog" aria-modal="true" aria-labelledby="playlistArtworkModalTitle">
      <div class="spm-header">
        <span class="spm-title" id="playlistArtworkModalTitle">Playlist Artwork</span>
        <button class="spm-close" type="button" onclick="closePlaylistArtworkModal()" aria-label="Close">✕</button>
      </div>
      <div class="spm-body playlist-artwork-body">
        <div class="playlist-feature-note" id="playlistArtworkModalCopy">Choose how Curatorr should handle artwork for this playlist.</div>
        <label class="playlist-artwork-field">
          <span>Artwork mode</span>
          <select id="playlistArtworkMode" class="playlist-artwork-control" onchange="onPlaylistArtworkModeChange()">
            <option value="auto">Auto-generated</option>
            <option value="preserve">Preserve existing artwork</option>
            <option value="custom">Custom artwork</option>
          </select>
        </label>
        <div id="playlistArtworkPreserveHelp" class="playlist-feature-note" style="display:none">
          Curatorr will snapshot the current Plex playlist image and reapply it after future syncs or playlist recreation when possible.
        </div>
        <div id="playlistArtworkCustomFields" class="playlist-artwork-custom-fields">
          <label class="playlist-artwork-field">
            <span>Custom image</span>
            <input type="file" id="playlistArtworkFile" class="playlist-artwork-file" accept="image/png,image/jpeg,image/webp" />
          </label>
          <div class="playlist-feature-note" id="playlistArtworkFileNote">PNG, JPG, or WEBP up to 5 MB.</div>
        </div>
        <div id="playlistArtworkStatus" class="playlist-feature-note playlist-artwork-status"></div>
      </div>
      <div class="spm-footer">
        <button class="btn btn-ghost" type="button" onclick="closePlaylistArtworkModal()">Cancel</button>
        <button class="btn btn-primary" type="button" id="playlistArtworkSaveBtn" onclick="submitPlaylistArtwork()">Save</button>
      </div>
    </div>
  </div>

  <div id="importedPlaylistModal" class="spm-overlay" style="display:none" onclick="if(event.target===this)closeImportedPlaylistSettingsModal()">
    <div class="spm-dialog imported-playlist-dialog" role="dialog" aria-modal="true" aria-labelledby="importedPlaylistModalTitle">
      <div class="spm-header">
        <span class="spm-title" id="importedPlaylistModalTitle">Edit Imported Playlist</span>
        <button class="spm-close" type="button" onclick="closeImportedPlaylistSettingsModal()" aria-label="Close">✕</button>
      </div>
      <div class="spm-body imported-playlist-body">
        <div class="playlist-feature-note" id="importedPlaylistModalCopy">Update the saved import settings for this playlist or convert it into a smart playlist wizard draft.</div>
        <label class="playlist-artwork-field">
          <span>Name</span>
          <input id="importedPlaylistTitle" class="playlist-artwork-control" type="text" maxlength="120" placeholder="Imported playlist name" />
        </label>
        <label class="playlist-artwork-field">
          <span>Auto-refresh</span>
          <select id="importedPlaylistSyncPeriod" class="playlist-artwork-control">
            <option value="disabled">Disabled</option>
            <option value="daily">Every day</option>
            <option value="weekly">Every week</option>
            <option value="monthly">Every month</option>
          </select>
        </label>
        <% if (_isAdmin) { %>
        <label class="imported-playlist-toggle">
          <input id="importedPlaylistGlobal" type="checkbox" />
          <span class="imported-playlist-toggle-copy">
            <span class="imported-playlist-toggle-title">Global playlist</span>
            <span class="playlist-feature-note imported-playlist-toggle-note">Make this imported playlist available for every user.</span>
          </span>
        </label>
        <% } %>
        <div id="importedPlaylistStatus" class="playlist-feature-note imported-playlist-status"></div>
      </div>
      <div class="spm-footer">
        <div class="imported-playlist-actions">
          <button class="btn btn-ghost" type="button" onclick="convertImportedPlaylistFromSettings()">Convert to Smart</button>
        </div>
        <button class="btn btn-ghost" type="button" onclick="closeImportedPlaylistSettingsModal()">Cancel</button>
        <button class="btn btn-primary" type="button" id="importedPlaylistSaveBtn" onclick="submitImportedPlaylistSettings()">Save</button>
      </div>
    </div>
  </div>

  <div id="smartPlModal" class="spm-overlay" style="display:none" onclick="if(event.target===this)closeSmartPlaylistModal()">
    <div class="spm-dialog" role="dialog" aria-modal="true" aria-label="Create Smart Playlist">
      <div class="spm-header">
        <span class="spm-title" id="spm-modal-title">Create Smart Playlist</span>
        <button class="spm-close" type="button" onclick="closeSmartPlaylistModal()" aria-label="Close">✕</button>
      </div>
      <div class="spm-body">
        <div id="spm-wizard-body" style="display:none"></div>
        <div id="spm-flat-form">
        <div class="field" style="margin-bottom:16px">
          <span style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--muted,#888)">Playlist name</span>
          <input type="text" id="spm-name" class="cur-input" placeholder="e.g. Britpop Belters" style="width:100%;margin-top:4px" />
        </div>

        <div class="spm-filter-section" style="margin-bottom:16px">
          <div class="spm-filter-label">Feature preset <span class="gp-filter-hint">(select a starting point, then tweak the ranges)</span></div>
          <% const _spmPresetCoverage = (playlistFeatureCoverage && playlistFeatureCoverage.presets) || {}; %>
          <input type="hidden" id="spm-feature-preset" value="none" />
          <div class="playlist-preset-grid" id="spm-preset-grid">
            <button type="button" class="playlist-preset-card playlist-preset-card--none is-active" data-preset="none">
              <span class="playlist-preset-card__art" aria-hidden="true"></span>
              <span class="playlist-preset-card__eyebrow">Open brief</span>
              <span class="playlist-preset-card__title">Custom</span>
              <span class="playlist-preset-card__desc">Start clean and shape the playlist yourself.</span>
              <span class="playlist-preset-card__meta"><%= Number(_spmPresetCoverage.none?.readyTrackCount || 0).toLocaleString() %> tracks ready</span>
            </button>
            <button type="button" class="playlist-preset-card playlist-preset-card--club<%= _spmPresetCoverage.club?.enabled ? '' : ' is-disabled' %>" data-preset="club" <%= _spmPresetCoverage.club?.enabled ? '' : 'disabled' %> title="<%= _spmPresetCoverage.club?.reason || '' %>">
              <span class="playlist-preset-card__art" aria-hidden="true"></span>
              <span class="playlist-preset-card__eyebrow">Night out</span>
              <span class="playlist-preset-card__title">Club</span>
              <span class="playlist-preset-card__desc">Fast BPM, strong energy, dancefloor bias.</span>
              <span class="playlist-preset-card__meta"><%= _spmPresetCoverage.club?.enabled ? `${Number(_spmPresetCoverage.club.readyTrackCount || 0).toLocaleString()} tracks ready` : (_spmPresetCoverage.club?.reason || 'Unavailable') %></span>
            </button>
            <button type="button" class="playlist-preset-card playlist-preset-card--driving<%= _spmPresetCoverage.driving?.enabled ? '' : ' is-disabled' %>" data-preset="driving" <%= _spmPresetCoverage.driving?.enabled ? '' : 'disabled' %> title="<%= _spmPresetCoverage.driving?.reason || '' %>">
              <span class="playlist-preset-card__art" aria-hidden="true"></span>
              <span class="playlist-preset-card__eyebrow">Road pace</span>
              <span class="playlist-preset-card__title">Driving</span>
              <span class="playlist-preset-card__desc">Steady tempo and lift without going full cardio.</span>
              <span class="playlist-preset-card__meta"><%= _spmPresetCoverage.driving?.enabled ? `${Number(_spmPresetCoverage.driving.readyTrackCount || 0).toLocaleString()} tracks ready` : (_spmPresetCoverage.driving?.reason || 'Unavailable') %></span>
            </button>
            <button type="button" class="playlist-preset-card playlist-preset-card--workout<%= _spmPresetCoverage.workout?.enabled ? '' : ' is-disabled' %>" data-preset="workout" <%= _spmPresetCoverage.workout?.enabled ? '' : 'disabled' %> title="<%= _spmPresetCoverage.workout?.reason || '' %>">
              <span class="playlist-preset-card__art" aria-hidden="true"></span>
              <span class="playlist-preset-card__eyebrow">High push</span>
              <span class="playlist-preset-card__title">Workout</span>
              <span class="playlist-preset-card__desc">Higher BPM, higher energy, built for momentum.</span>
              <span class="playlist-preset-card__meta"><%= _spmPresetCoverage.workout?.enabled ? `${Number(_spmPresetCoverage.workout.readyTrackCount || 0).toLocaleString()} tracks ready` : (_spmPresetCoverage.workout?.reason || 'Unavailable') %></span>
            </button>
            <button type="button" class="playlist-preset-card playlist-preset-card--chill<%= _spmPresetCoverage.chill?.enabled ? '' : ' is-disabled' %>" data-preset="chill" <%= _spmPresetCoverage.chill?.enabled ? '' : 'disabled' %> title="<%= _spmPresetCoverage.chill?.reason || '' %>">
              <span class="playlist-preset-card__art" aria-hidden="true"></span>
              <span class="playlist-preset-card__eyebrow">Low pressure</span>
              <span class="playlist-preset-card__title">Chill</span>
              <span class="playlist-preset-card__desc">Slower pace, softer energy, easy background flow.</span>
              <span class="playlist-preset-card__meta"><%= _spmPresetCoverage.chill?.enabled ? `${Number(_spmPresetCoverage.chill.readyTrackCount || 0).toLocaleString()} tracks ready` : (_spmPresetCoverage.chill?.reason || 'Unavailable') %></span>
            </button>
            <button type="button" class="playlist-preset-card playlist-preset-card--harmonic<%= _spmPresetCoverage.harmonic?.enabled ? '' : ' is-disabled' %>" data-preset="harmonic" <%= _spmPresetCoverage.harmonic?.enabled ? '' : 'disabled' %> title="<%= _spmPresetCoverage.harmonic?.reason || '' %>">
              <span class="playlist-preset-card__art" aria-hidden="true"></span>
              <span class="playlist-preset-card__eyebrow">Key pocket</span>
              <span class="playlist-preset-card__title">Harmonic</span>
              <span class="playlist-preset-card__desc">Bias the set around a Camelot key neighborhood.</span>
              <span class="playlist-preset-card__meta"><%= _spmPresetCoverage.harmonic?.enabled ? `${Number(_spmPresetCoverage.harmonic.readyTrackCount || 0).toLocaleString()} tracks ready` : (_spmPresetCoverage.harmonic?.reason || 'Unavailable') %></span>
            </button>
          </div>
          <div class="playlist-feature-grid">
            <label class="field">
              <span>BPM min</span>
              <input type="number" id="spm-bpm-min" min="0" step="1" placeholder="Any" />
            </label>
            <label class="field">
              <span>BPM max</span>
              <input type="number" id="spm-bpm-max" min="0" step="1" placeholder="Any" />
            </label>
            <label class="field">
              <span>Energy min</span>
              <input type="number" id="spm-energy-min" min="0" max="1" step="0.01" placeholder="Any" />
            </label>
            <label class="field">
              <span>Energy max</span>
              <input type="number" id="spm-energy-max" min="0" max="1" step="0.01" placeholder="Any" />
            </label>
            <label class="field">
              <span>Danceability min</span>
              <input type="number" id="spm-danceability-min" min="0" max="1" step="0.01" placeholder="Any" />
            </label>
            <label class="field">
              <span>Danceability max</span>
              <input type="number" id="spm-danceability-max" min="0" max="1" step="0.01" placeholder="Any" />
            </label>
            <label class="field">
              <span>Camelot focus</span>
              <input type="text" id="spm-camelot-focus" placeholder="8A, 9A, 10A" />
            </label>
            <label class="field">
              <span>Camelot spread</span>
              <select id="spm-camelot-mode">
                <option value="exact">Exact key</option>
                <option value="adjacent">Adjacent keys</option>
                <option value="relative">Relative major/minor</option>
                <option value="harmonic">Full harmonic set</option>
              </select>
            </label>
          </div>
          <div class="playlist-feature-note">Presets fill these fields for you. Camelot uses DJ wheel notation rather than classical names: <code class="playlist-inline-code">8A</code> is <code class="playlist-inline-code">A minor</code>, and <code class="playlist-inline-code">8B</code> is <code class="playlist-inline-code">C major</code>. Camelot focus accepts one or more keys like <code class="playlist-inline-code">8A</code> or <code class="playlist-inline-code">8A, 9A, 10A</code>. Exact uses only the listed keys. Adjacent adds neighboring numbers on the same letter. Relative adds the same number on the opposite letter. Full harmonic set combines both.</div>
          <div class="playlist-feature-note" id="spm-feature-match-note">Current feature match: <strong id="spm-feature-match-count">—</strong> tracks after your edits.</div>
        </div>

        <div class="spm-tiers-row">
          <div class="spm-filter-section">
            <div class="spm-filter-label">Artist tier</div>
            <div class="spm-filter-chips">
              <% [['belter','Belter','belter'],['decent','Decent','decent'],['halfDecent','Half-Decent','half-decent'],['skip','Skip','skip'],['unranked','Unranked','muted']].forEach(function(t) { %>
              <label class="gp-chip-label">
                <input type="checkbox" class="spm-artist-tier" value="<%= t[0] %>" />
                <span class="cur-badge cur-badge--<%= t[2] %>"><%= t[1] %></span>
              </label>
              <% }); %>
            </div>
          </div>

          <div class="spm-filter-section">
            <div class="spm-filter-label">Track tier</div>
            <div class="spm-filter-chips">
              <% [['belter','Belter','belter'],['decent','Decent','decent'],['halfDecent','Half-Decent','half-decent'],['skip','Skip','skip'],['unplayed','Unplayed','muted']].forEach(function(t) { %>
              <label class="gp-chip-label">
                <input type="checkbox" class="spm-track-tier" value="<%= t[0] %>" />
                <span class="cur-badge cur-badge--<%= t[2] %>"><%= t[1] %></span>
              </label>
              <% }); %>
            </div>
          </div>
        </div>

        <% if ((allGenres || []).length) { %>
        <div class="spm-filter-section">
          <div class="spm-filter-label">Genres <span class="gp-filter-hint">(click once to include, again to exclude, again to clear)</span></div>
          <div class="spm-tristate-wrap">
            <input type="text" class="spm-tristate-search" placeholder="Filter genres…" data-chips="spm-genres-chips" />
            <div class="spm-tristate-chips" id="spm-genres-chips">
              <% (allGenres || []).forEach(function(g) { %>
              <button type="button" class="spm-chip" data-kind="genre" data-value="<%= g %>" data-state="neutral"><%= g %></button>
              <% }); %>
            </div>
            <div class="spm-chip-hint">None selected = include all</div>
          </div>
        </div>
        <% } %>

        <% if ((allMoods || []).length) { %>
        <div class="spm-filter-section">
          <div class="spm-filter-label">Moods <span class="gp-filter-hint">(click once to include, again to exclude, again to clear)</span></div>
          <div class="spm-tristate-wrap">
            <input type="text" class="spm-tristate-search" placeholder="Filter moods…" data-chips="spm-moods-chips" />
            <div class="spm-tristate-chips" id="spm-moods-chips">
              <% (allMoods || []).forEach(function(m) { %>
              <button type="button" class="spm-chip" data-kind="mood" data-value="<%= m %>" data-state="neutral"><%= m %></button>
              <% }); %>
            </div>
            <div class="spm-chip-hint">None selected = include all</div>
          </div>
        </div>
        <% } %>

        <% if ((allLastfmTags || []).length) { %>
        <div class="spm-filter-section">
          <div class="spm-filter-label">Last.fm Tags <span class="gp-filter-hint">(click once to include, again to exclude, again to clear)</span></div>
          <div class="spm-tristate-wrap">
            <input type="text" class="spm-tristate-search" placeholder="Filter tags… e.g. britpop" data-chips="spm-tags-chips" />
            <div class="spm-tristate-chips" id="spm-tags-chips">
              <% (allLastfmTags || []).forEach(function(t) { %>
              <button type="button" class="spm-chip" data-kind="tag" data-value="<%= t %>" data-state="neutral"><%= t %></button>
              <% }); %>
            </div>
            <div class="spm-chip-hint">None selected = include all</div>
          </div>
        </div>
        <% } %>

        <% if ((allTrackDecades || []).length) { %>
        <div class="spm-filter-section">
          <div class="spm-filter-label">Decades <span class="gp-filter-hint">(generated from track release years)</span></div>
          <div class="spm-tristate-wrap">
            <input type="text" class="spm-tristate-search" placeholder="Filter decades… e.g. 2000s" data-chips="spm-decades-chips" />
            <div class="spm-tristate-chips" id="spm-decades-chips">
              <% (allTrackDecades || []).forEach(function(t) { %>
              <button type="button" class="spm-chip" data-kind="decade" data-value="<%= t %>" data-state="neutral"><%= t %></button>
              <% }); %>
            </div>
            <div class="spm-chip-hint">None selected = include all</div>
          </div>
        </div>
        <% } %>

        <div class="spm-filter-section spm-filter-section--inline">
          <label class="field" style="flex:1">
            <span>Max tracks per artist</span>
            <input type="number" id="spm-top-n" min="1" max="999" placeholder="All tracks" />
          </label>
          <label class="field" style="flex:1">
            <span>Max tracks per album</span>
            <input type="number" id="spm-max-album-tracks" min="1" max="999" placeholder="All tracks" />
          </label>
          <label class="field" style="flex:1">
            <span>Max total tracks</span>
            <input type="number" id="spm-max-tracks" min="1" placeholder="No limit" />
          </label>
          <label class="field" style="flex:1">
            <span>Auto-rebuild</span>
            <select id="spm-rebuild-schedule">
              <option value="daily">Daily</option>
              <option value="weekly">Weekly</option>
              <option value="manual">Manual only</option>
            </select>
          </label>
          <label class="field" style="flex:1">
            <span>Sort tracks by</span>
            <select id="spm-sort-by">
              <option value="default">Default playlist order</option>
              <option value="ratingCount">Global rating count</option>
              <option value="tierWeight">Tier weight</option>
              <option value="playCount">Play count</option>
              <option value="random">Random</option>
              <option value="bpmAsc">BPM low to high</option>
              <option value="bpmDesc">BPM high to low</option>
              <option value="energyAsc">Energy low to high</option>
              <option value="energyDesc">Energy high to low</option>
              <option value="danceabilityDesc">Danceability high to low</option>
              <option value="camelot">Camelot wheel</option>
              <option value="djFlow">DJ flow (Camelot + BPM)</option>
            </select>
          </label>
          <label class="field" style="flex:1">
            <span>Final ordering</span>
            <select id="spm-final-ordering">
              <option value="none">None</option>
              <option value="plexSonic">Plex sonic</option>
              <option value="loudness">Loudness smoothing</option>
              <option value="plexSonicLoudness">Plex sonic then loudness</option>
            </select>
          </label>
        </div>

        <% if ((blendableUsers || []).length > 1) { %>
        <div class="spm-filter-section gp-blend-section">
          <div class="spm-filter-label">
            Blend users
            <span class="gp-filter-hint">(combine listening data from other users)</span>
          </div>
          <div class="blend-slots" id="spm-blend-picker-rows"></div>
          <button class="blend-add-btn" id="spm-blend-add-btn" type="button">+ Add user</button>
          <div id="spm-blend-mode-wrap" style="display:none">
            <div class="spm-filter-label" style="margin-top:10px">Blend mode</div>
            <div class="gp-blend-modes">
              <label class="gp-blend-mode-option"><input type="radio" name="spm-blend-mode" value="average" checked /><span class="gp-blend-mode-name">Average</span><span class="gp-blend-mode-desc">Average each user's scores together — shared favourites rise, polarising tracks land in the middle.</span></label>
              <label class="gp-blend-mode-option"><input type="radio" name="spm-blend-mode" value="intersection" /><span class="gp-blend-mode-name">Intersection</span><span class="gp-blend-mode-desc">Only tracks every selected user qualifies. Safest for shared listening.</span></label>
              <label class="gp-blend-mode-option"><input type="radio" name="spm-blend-mode" value="union" /><span class="gp-blend-mode-name">Union</span><span class="gp-blend-mode-desc">Tracks any selected user qualifies. Broadest result — great for discovery.</span></label>
              <label class="gp-blend-mode-option"><input type="radio" name="spm-blend-mode" value="veto" /><span class="gp-blend-mode-name">Veto</span><span class="gp-blend-mode-desc">Union minus any track someone has skipped. Nobody gets music they hate.</span></label>
            </div>
          </div>
        </div>
        <% } %>

        <div class="spm-preview">
          <span class="spm-preview-label">Preview:</span>
          <span id="spm-prev-artists">—</span> artists ·
          <span id="spm-prev-tracks">—</span> tracks
        </div>
        </div><%# /spm-flat-form %>
      </div>

      <div class="spm-footer">
        <div id="spm-flat-footer" style="display:flex;align-items:center;gap:10px;width:100%">
          <button class="btn btn-ghost" type="button" onclick="closeSmartPlaylistModal()">Cancel</button>
          <button class="btn btn-primary" type="button" id="spm-create-btn" onclick="spmSubmit()">Create Playlist</button>
          <span id="spm-msg" style="font-size:13px;margin-left:8px"></span>
        </div>
        <div id="spm-wizard-footer" style="display:none;width:100%"></div>
      </div>
    </div>
  </div>

  <script src="/sidebar.js?v=<%= assetVersion %>"></script>
  <script src="/user-menu.js?v=<%= assetVersion %>"></script>
  <script src="/version-badge.js?v=<%= assetVersion %>"></script>
  <script src="/brand-menu.js?v=<%= assetVersion %>"></script>
  <script src="/curatorr-overview.js?v=<%= assetVersion %>"></script>
  <script src="/starfield-3d.js"></script>
  <script>
    var _offset = 0;
    var _total = 0;
    var _pageSize = 100;
    var _loading = false;
    var _loadingAllTracks = false;
    var _loadingAllTracksPromise = null;
    var _visibleTrackCount = 0;
    var _trackLoadGeneration = 0;
    var _currentPlexId = null;
    var _currentPlexKey = null;
    var _currentPlaylistKind = '';
    var _currentPlaylistType = '';
    var _currentPlaylistMissingCount = 0;
    var _allTracks = [];
    var _importedMissingState = {
      playlistKey: '',
      rows: [],
      selectedCount: 0,
      missingCount: 0,
      actionMessage: '',
    };
    var _sortField = 'index';
    var _sortAsc = true;
    var CSRF = '<%= csrfToken %>';
    var PLEX_MACHINE_ID = '<%= _plexMachineId %>';
    var MS_LABEL = '<%= _msLabel %>';
    var _msType = '<%= _msType %>';
    var CURRENT_USER_ID = <%- JSON.stringify(currentUserId || '') %>;
    var IS_ACTUAL_ADMIN = <%- JSON.stringify(actualRole === 'admin') %>;
    var CAN_EDIT_GLOBAL_PLAYLISTS = <%- JSON.stringify(_isAdmin) %>;
    var ALL_PATH_SEGMENTS = <%- JSON.stringify(allPathSegments || []) %>;
    var SPOTIFY_USER_ID = <%- JSON.stringify(spotifyUserId || '') %>;
    var LASTFM_USERNAME = <%- JSON.stringify(lastfmUsername || '') %>;
    var LISTENBRAINZ_USERNAME = <%- JSON.stringify(listenbrainzUsername || '') %>;
    var SPOTIFY_CONNECTED = <%- JSON.stringify(Boolean(spotifyConnected)) %>;
    var SPOTIFY_CONFIGURED = <%- JSON.stringify(Boolean(spotifyConfigured)) %>;
    var YOUTUBE_CONFIGURED = <%- JSON.stringify(Boolean(youtubeConfigured)) %>;
    var LIDARR_AUTOMATION_ELIGIBLE = <%- JSON.stringify(Boolean(lidarrAutomationEligible)) %>;
    var LIDARR_CONFIGURED = <%- JSON.stringify(Boolean(lidarrConfigured)) %>;
    var IMPORT_HAS_PLEX = <%- JSON.stringify(_msType === 'plex') %>;
    var _importPlexSources = [];
    var _importPlexSelection = null;
    var _importPlexTitleTouched = false;
    var _importSpotifySources = [];
    var _importSpotifySelection = null;
    var _importSpotifyPreview = null;
    var _importUrlSelection = null;
    var _importUrlPreview = null;
    var _importLastfmSelection = null;
    var _importLastfmPreview = null;
    var _importListenbrainzSelection = null;
    var _importListenbrainzPreview = null;
    var _importUrlDebounce = null;
    var _importSourceTab = IMPORT_HAS_PLEX ? 'plex' : (SPOTIFY_CONFIGURED ? 'spotify' : 'url');
    var _playlistCardFilterState = {
      type: 'all',
      status: 'all',
    };
    var _playlistCarouselCollapsed = false;
    var _playlistCarouselCollapseThreshold = 56;
    var _playlistCarouselExpandThreshold = 18;

    function fmtDuration(ms) {
      if (!ms) return '';
      var s = Math.round(ms / 1000);
      var m = Math.floor(s / 60);
      var sec = s % 60;
      return m + ':' + (sec < 10 ? '0' : '') + sec;
    }

    function fmtTotalTime(ms) {
      var h = Math.floor(ms / 3600000);
      var m = Math.floor((ms % 3600000) / 60000);
      if (h > 0) return h + 'h ' + m + 'm';
      return m + ' min';
    }

    function fmtShortDate(ts) {
      if (!ts) return '—';
      return new Date(Number(ts)).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    }

    function escHtml(s) {
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function escAttr(s) {
      return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;');
    }

    function getPlaylistCardElements() {
      return Array.from(document.querySelectorAll('#playlistCarouselTrack .cur-playlist-carousel-card'));
    }

    function isPlaylistCardVisible(card) {
      return Boolean(card) && !card.classList.contains('plex-hidden');
    }

    function resetPlaylistCarouselViewport() {
      var viewport = document.getElementById('playlistCarouselViewport');
      if (!viewport) return;
      try {
        viewport.scrollTo({ left: 0, behavior: 'auto' });
      } catch (_) {
        viewport.scrollLeft = 0;
      }
      viewport.scrollLeft = 0;
      requestAnimationFrame(function() {
        try {
          viewport.scrollTo({ left: 0, behavior: 'auto' });
        } catch (_) {
          viewport.scrollLeft = 0;
        }
        viewport.scrollLeft = 0;
      });
    }

    function syncPlaylistCarouselViewportLayout() {
      var viewport = document.getElementById('playlistCarouselViewport');
      var track = document.getElementById('playlistCarouselTrack');
      if (!viewport || !track) return;
      var trackWidth = Math.ceil(track.getBoundingClientRect().width || 0);
      var viewportWidth = Math.ceil(viewport.clientWidth || 0);
      var fitsViewport = trackWidth > 0 && trackWidth <= viewportWidth;
      viewport.classList.toggle('is-left-flush', fitsViewport);
    }

    function reorderPlaylistCards(visibleCards, hiddenCards) {
      var carouselTrack = document.getElementById('playlistCarouselTrack');
      if (!carouselTrack) return;
      var orderedCards = visibleCards.concat(hiddenCards);
      orderedCards.forEach(function(card) {
        carouselTrack.appendChild(card);
      });
    }

    function cardMatchesPlaylistFilters(card) {
      if (!card) return false;
      var audience = resolvePlaylistAudience({
        playlistAudience: card.dataset.playlistAudience,
        playlistType: card.dataset.playlistType,
      });
      var isActive = isPlaylistCardActive(card);
      var typeMatch = _playlistCardFilterState.type === 'all' || audience === _playlistCardFilterState.type;
      var statusMatch = _playlistCardFilterState.status === 'all'
        || (_playlistCardFilterState.status === 'enabled' && isActive)
        || (_playlistCardFilterState.status === 'disabled' && !isActive);
      return typeMatch && statusMatch;
    }

    function updatePlaylistFilterButtons() {
      document.querySelectorAll('[data-playlist-type-filter]').forEach(function(button) {
        button.classList.toggle('is-active', String(button.getAttribute('data-playlist-type-filter') || 'all') === _playlistCardFilterState.type);
      });
      document.querySelectorAll('[data-playlist-status-filter]').forEach(function(button) {
        button.classList.toggle('is-active', String(button.getAttribute('data-playlist-status-filter') || 'all') === _playlistCardFilterState.status);
      });
      var filterToggle = document.querySelector('.pl-filter-trigger');
      if (filterToggle) {
        var hasActiveFilters = _playlistCardFilterState.type !== 'all' || _playlistCardFilterState.status !== 'all';
        filterToggle.classList.toggle('is-active', hasActiveFilters);
      }
    }

    function showPlaylistFilterEmptyState() {
      var emptyEl = document.getElementById('playlistFilterEmpty');
      if (emptyEl) emptyEl.style.display = '';
      document.getElementById('trackList').innerHTML = '';
      document.getElementById('trackListLoading').style.display = 'none';
      document.getElementById('loadMoreWrap').style.display = 'none';
      document.getElementById('trackCountLabel').textContent = '0 tracks';
      var trackEmpty = document.getElementById('trackListEmpty');
      if (trackEmpty) {
        trackEmpty.textContent = 'No playlists match the current filters.';
        trackEmpty.style.display = '';
      }
      _currentPlexId = null;
      _currentPlexKey = null;
      _currentPlaylistKind = '';
      _currentPlaylistType = '';
      _currentPlaylistMissingCount = 0;
      _allTracks = [];
      resetImportedMissingPanel();
      updateSelectionButtons();
    }

    function applyPlaylistCardFilters(options) {
      options = options || {};
      var cards = getPlaylistCardElements();
      var viewport = document.getElementById('playlistCarouselViewport');
      var visibleCards = [];
      var hiddenCards = [];
      cards.forEach(function(card) {
        var visible = cardMatchesPlaylistFilters(card);
        card.hidden = !visible;
        card.classList.toggle('plex-hidden', !visible);
        if (!visible) {
          hiddenCards.push(card);
          var checkbox = card.querySelector('.pl-card-checkbox');
          if (checkbox && checkbox.checked) {
            checkbox.checked = false;
            card.classList.remove('is-selected');
          }
        } else {
          visibleCards.push(card);
        }
      });
      reorderPlaylistCards(visibleCards, hiddenCards);
      syncPlaylistCarouselViewportLayout();
      updatePlaylistFilterButtons();
      updateSelectionBar();
      var emptyEl = document.getElementById('playlistFilterEmpty');
      if (emptyEl) emptyEl.style.display = visibleCards.length ? 'none' : '';
      var activeCard = document.querySelector('#playlistCarouselTrack .cur-playlist-carousel-card.is-active');
      if (viewport && (options.resetScroll || !activeCard || !isPlaylistCardVisible(activeCard))) {
        resetPlaylistCarouselViewport();
      }
      if (!visibleCards.length) {
        showPlaylistFilterEmptyState();
        syncPlaylistCarouselViewportLayout();
        if (typeof window.updatePlaylistCarouselNav === 'function') window.updatePlaylistCarouselNav();
        return;
      }
      if (!activeCard || !isPlaylistCardVisible(activeCard)) {
        if (options.preserveActive && activeCard && isPlaylistCardVisible(activeCard)) {
          updateSelectionSummary(activeCard);
        } else {
          selectPlaylist(visibleCards[0]);
        }
      } else if (!options.skipReload) {
        updateSelectionSummary(activeCard);
      }
      if (typeof window.updatePlaylistCarouselNav === 'function') window.updatePlaylistCarouselNav();
    }

    // ── Sort & filter ─────────────────────────────────────────────────────────

    function applySort(field) {
      var nextField = field || 'index';
      if (_loading) return;
      if (_sortField === nextField) _sortAsc = !_sortAsc;
      else {
        _sortField = nextField;
        _sortAsc = true;
      }
      if (_sortField !== 'index' && _offset < _total) {
        ensureAllTracksLoaded('Loading full playlist for sorting…')
          .then(function() {
            renderFiltered();
          });
        return;
      }
      renderFiltered();
    }

    function syncSortHeaders() {
      var map = {
        index: document.getElementById('sortIndexBtn'),
        title: document.getElementById('sortTitleBtn'),
        albumName: document.getElementById('sortAlbumBtn'),
        artistName: document.getElementById('sortArtistBtn'),
        duration: document.getElementById('sortDurationBtn'),
      };

      Object.keys(map).forEach(function(field) {
        var btn = map[field];
        if (!btn) return;
        var active = _sortField === field;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-sort', active ? (_sortAsc ? 'ascending' : 'descending') : 'none');
        var arrow = btn.querySelector('.cur-pl-sort-arrow');
        if (arrow) arrow.textContent = active ? (_sortAsc ? '↑' : '↓') : '↕';
      });
    }

    function applyFilter() {
      renderFiltered();
    }

    function getTrackSearchQuery() {
      return String(document.getElementById('trackSearch').value || '').toLowerCase().trim();
    }

    function getSortedFiltered() {
      var q = getTrackSearchQuery();
      var tracks = _allTracks.slice();

      if (q) {
        tracks = tracks.filter(function(t) {
          return (t.title || '').toLowerCase().indexOf(q) !== -1 ||
                 (t.artistName || '').toLowerCase().indexOf(q) !== -1 ||
                 (t.albumName || '').toLowerCase().indexOf(q) !== -1;
        });
      }

      if (_sortField !== 'index') {
        tracks.sort(function(a, b) {
          var av = (a[_sortField] || '').toString().toLowerCase();
          var bv = (b[_sortField] || '').toString().toLowerCase();
          if (_sortField === 'duration') { av = Number(a.duration || 0); bv = Number(b.duration || 0); }
          if (av < bv) return _sortAsc ? -1 : 1;
          if (av > bv) return _sortAsc ? 1 : -1;
          return 0;
        });
      } else if (!_sortAsc) {
        tracks.reverse();
      }

      return tracks;
    }

    function renderFiltered() {
      var tracks = getSortedFiltered();
      var missingRows = getFilteredImportedMissingRows(getTrackSearchQuery());
      var visibleCount = Math.min(_visibleTrackCount || tracks.length, tracks.length);
      var visibleTracks = tracks.slice(0, visibleCount);
      var list = document.getElementById('trackList');
      list.innerHTML = '';
      var frag = document.createDocumentFragment();
      visibleTracks.forEach(function(t, i) {
        frag.appendChild(buildRow(t, i));
      });
      appendImportedMissingInlineSection(frag, missingRows);
      list.appendChild(frag);
      document.getElementById('trackListEmpty').style.display = (tracks.length || missingRows.length) ? 'none' : '';
      document.getElementById('trackCountLabel').textContent =
        (visibleCount < tracks.length ? visibleCount + ' / ' : '') +
        tracks.length.toLocaleString() + ' tracks' +
        (Number(_importedMissingState.missingCount || 0) > 0 ? (' • ' + Number(_importedMissingState.missingCount || 0).toLocaleString() + ' missing') : '');
      updateLoadControls(tracks.length, visibleCount);
      syncSortHeaders();
    }

    function updateLoadControls(totalFiltered, visibleCount) {
      var wrap = document.getElementById('loadMoreWrap');
      var loadMoreBtn = document.getElementById('loadMoreBtn');
      var loadAllBtn = document.getElementById('loadAllBtn');
      if (!wrap || !loadMoreBtn || !loadAllBtn) return;

      if (_offset < _total) {
        wrap.style.display = '';
        loadMoreBtn.textContent = 'Load more (' + (_total - _offset).toLocaleString() + ' remaining)';
        loadMoreBtn.disabled = false;
        loadAllBtn.disabled = false;
        return;
      }

      if (visibleCount < totalFiltered) {
        wrap.style.display = '';
        loadMoreBtn.textContent = 'Show more (' + (totalFiltered - visibleCount).toLocaleString() + ' remaining)';
        loadMoreBtn.disabled = false;
        loadAllBtn.disabled = false;
        return;
      }

      wrap.style.display = 'none';
    }

    function getFilteredImportedMissingRows(query) {
      var q = String(query || '').toLowerCase().trim();
      var rows = Array.isArray(_importedMissingState.rows) ? _importedMissingState.rows : [];
      if (!q) return rows.slice();
      return rows.filter(function(row) {
        var title = String(row && row.title || '').toLowerCase();
        var albumTitle = String(row && row.albumTitle || '').toLowerCase();
        var artistNames = Array.isArray(row && row.artists) ? row.artists.join(', ') : String(row && row.artistName || '');
        return title.indexOf(q) !== -1 || albumTitle.indexOf(q) !== -1 || artistNames.toLowerCase().indexOf(q) !== -1;
      });
    }

    function buildImportedMissingSectionStatus(selectedCount, visibleCount, missingCount) {
      if (_importedMissingState.actionMessage) return _importedMissingState.actionMessage;
      if (!visibleCount && missingCount > 0) return 'No missing tracks match the current filter.';
      if (selectedCount > 0) return selectedCount.toLocaleString() + ' selected for Lidarr actions.';
      if (LIDARR_AUTOMATION_ELIGIBLE && LIDARR_CONFIGURED) return 'Select missing tracks to queue them for Lidarr review or add them to the Lidarr queue.';
      return 'Select missing tracks for later review.';
    }

    function appendImportedMissingInlineSection(frag, filteredRows) {
      var rows = Array.isArray(_importedMissingState.rows) ? _importedMissingState.rows : [];
      var missingCount = Number(_importedMissingState.missingCount || rows.length || 0);
      var selectedCount = rows.filter(function(row) { return row.selected; }).length;
      _importedMissingState.selectedCount = selectedCount;
      if (!missingCount && !rows.length && !_importedMissingState.actionMessage) return;

      var reviewButtonLabel = selectedCount > 0
        ? ('Queue ' + selectedCount.toLocaleString() + ' for Lidarr review')
        : 'Queue selected for Lidarr review';
      var queueButtonLabel = selectedCount > 0
        ? ('Add ' + selectedCount.toLocaleString() + ' to Lidarr queue')
        : 'Add selected to Lidarr queue';
      var lidarrEnabled = LIDARR_AUTOMATION_ELIGIBLE && LIDARR_CONFIGURED;
      var groups = groupImportedMissingRows(filteredRows);
      var wrapper = document.createElement('div');
      wrapper.className = 'imported-missing-inline';
      wrapper.innerHTML =
        '<div class="imported-missing-inline__header">' +
          '<div class="imported-missing-inline__title-wrap">' +
            '<div class="imported-missing-inline__title">Missing From Source</div>' +
            '<div class="imported-missing-inline__meta">' + missingCount.toLocaleString() + ' missing</div>' +
          '</div>' +
          '<div class="imported-missing-inline__actions">' +
            '<button class="btn btn-sm btn-ghost" type="button" onclick="setAllImportedMissingSelected(true)">Select all</button>' +
            '<button class="btn btn-sm btn-ghost" type="button" onclick="setAllImportedMissingSelected(false)">Clear</button>' +
            (lidarrEnabled ? '<button class="btn btn-sm btn-ghost" type="button" onclick="queueImportedMissingForLidarrReview()" ' + (selectedCount <= 0 ? 'disabled' : '') + '>' + escHtml(reviewButtonLabel) + '</button>' : '') +
            (lidarrEnabled ? '<button class="btn btn-sm btn-primary" type="button" onclick="queueImportedMissingInLidarr()" ' + (selectedCount <= 0 ? 'disabled' : '') + '>' + escHtml(queueButtonLabel) + '</button>' : '') +
          '</div>' +
        '</div>' +
        '<div class="imported-missing-inline__status">' + escHtml(buildImportedMissingSectionStatus(selectedCount, filteredRows.length, missingCount)) + '</div>';

      if (!filteredRows.length) {
        var empty = document.createElement('div');
        empty.className = 'cur-empty imported-missing-inline__empty';
        empty.textContent = missingCount > 0 ? 'No missing tracks match the current filter.' : 'No missing tracks for this imported playlist.';
        wrapper.appendChild(empty);
        frag.appendChild(wrapper);
        return;
      }

      groups.forEach(function(group) {
        var groupEl = document.createElement('div');
        groupEl.className = 'imported-missing-inline__group';
        var groupChecked = group.rows.length && group.selectedCount === group.rows.length;
        groupEl.innerHTML =
          '<div class="imported-missing-inline__group-header">' +
            '<label class="imported-missing-inline__group-title">' +
              '<input class="imported-missing-toggle imported-missing-group-toggle" type="checkbox" ' + (groupChecked ? 'checked ' : '') + 'onchange="toggleImportedMissingArtist(' + escAttr(JSON.stringify(group.artistName)) + ', this.checked)" />' +
              '<span>' + escHtml(group.artistName) + '</span>' +
            '</label>' +
            '<div class="imported-missing-inline__group-meta">' + group.selectedCount.toLocaleString() + ' / ' + group.rows.length.toLocaleString() + ' selected</div>' +
          '</div>';
        var bodyEl = document.createElement('div');

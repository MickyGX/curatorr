        '<label class="field"><span>Danceability min</span><input type="number" id="wiz-dance-min" min="0" max="1" step="0.01" placeholder="Any" value="' + (ws.danceabilityMin || '') + '"/></label>' +
        '<label class="field"><span>Danceability max</span><input type="number" id="wiz-dance-max" min="0" max="1" step="0.01" placeholder="Any" value="' + (ws.danceabilityMax || '') + '"/></label>' +
        '<label class="field"><span>Camelot spread</span><select id="wiz-camelot-mode"><option value="exact"' + (ws.camelotMode === 'exact' ? ' selected' : '') + '>Exact key</option><option value="adjacent"' + (ws.camelotMode === 'adjacent' ? ' selected' : '') + '>Adjacent keys</option><option value="relative"' + (ws.camelotMode === 'relative' ? ' selected' : '') + '>Relative</option><option value="harmonic"' + (ws.camelotMode === 'harmonic' ? ' selected' : '') + '>Full harmonic</option></select></label>' +

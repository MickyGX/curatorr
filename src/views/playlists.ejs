<%- include('partials/head', { pageTitle: title || 'Playlists — Curatorr', extraCss: extraCss || ['/styles-layout.css', '/styles-curatorr.css'] }) %>
<body class="dash-body cur-playlists-page">
  <div class="dash-frame<%= sidebarCollapsed ? ' sidebar-collapsed' : '' %>">
    <aside class="dash-sidebar">
      <div class="dash-brand">
        <span class="dash-logo">
          <img class="nav-icon app-icon" src="/icons/curatorr-icon.svg" alt="Curatorr" onerror="this.style.display='none'" />
        </span>
        <div><div class="dash-title">Curatorr</div></div>
      </div>
      <div class="dash-nav">
        <%- include('partials/nav-categories', { navActivePage: 'playlists', role: role }) %>
      </div>
      <%- include('partials/user-menu') %>
    </aside>

    <section class="dash-main">
      <div class="main-window-bar">
        <button class="sidebar-toggle main-toggle left-toggle" type="button" aria-label="Toggle sidebar">
          <img class="toggle-icon" src="/icons/sidebar-toggle.svg" alt="" />
        </button>
        <div class="main-window-title">
          <img class="main-window-icon" src="/icons/category.svg" alt="" />
          <span class="main-window-app">Curatorr</span>
          <span class="main-window-rest">| Playlists</span>
        </div>
        <div class="main-window-spacer"></div>
        <div class="main-window-status">
          <span class="status-dot"></span>
        </div>
      </div>

      <%
        const _lastSync = lastSync || null;
        const _playlistCards = Array.isArray(playlistCards) ? playlistCards : [];
        const _plexMachineId = String(plexMachineId || '').trim();
        const _msType = String(typeof mediaServerType !== 'undefined' ? mediaServerType : 'plex').trim().toLowerCase();
        const _msLabel = _msType === 'jellyfin' ? 'Jellyfin' : _msType === 'emby' ? 'Emby' : 'Plex';
        function fmtDate(ts) {
          if (!ts) return '—';
          return new Date(ts).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
        }
      %>

      <div class="dash-content">
        <%- include('partials/plex-banner') %>
        <div class="cur-panel cur-panel--playlist-carousel cur-panel--playlists-page-carousel">
          <div class="cur-panel-header cur-panel-header--playlist-carousel">
            <h3 class="cur-panel-title">Playlists</h3>
            <div id="plSelectionBar" class="pl-selection-bar" style="display:none">
              <span id="plSelectionCount" class="pl-selection-count"></span>
              <button class="btn btn-sm btn-ghost pl-selection-clear" type="button" onclick="clearCardSelection()">Clear</button>
              <button class="btn btn-sm" style="background:#ef4444;color:#fff;border:none" type="button" onclick="deleteSelectedPlaylists()">Delete Selected</button>
            </div>
            <div class="cur-panel-actions">
              <button class="btn btn-sm btn-ghost" type="button" onclick="openSmartPlaylistModal()">+ Smart Playlist</button>
              <span class="cur-sync-status" id="syncStatus"></span>
              <button class="btn btn-sm btn-ghost cur-nav-button cur-nav-button--compact" type="button" id="playlistCarouselPrev" aria-label="Previous">
                <span class="cur-nav-chev cur-nav-chev--left" aria-hidden="true"></span>
              </button>
              <button class="btn btn-sm btn-ghost cur-nav-button cur-nav-button--compact" type="button" id="playlistCarouselNext" aria-label="Next">
                <span class="cur-nav-chev cur-nav-chev--right" aria-hidden="true"></span>
              </button>
            </div>
          </div>
          <div class="cur-panel-body cur-panel-body--playlist-carousel">
            <% if (_playlistCards.length) { %>
              <div class="cur-playlist-carousel-viewport plex-carousel-viewport" id="playlistCarouselViewport">
                <div class="cur-playlist-carousel-track plex-carousel-track" id="playlistCarouselTrack">
                  <% _playlistCards.forEach(function(p, idx) { %>
                    <div class="plex-card cur-discover-result-card cur-playlist-carousel-card<%= idx === 0 ? ' is-active' : '' %>"
                      role="button"
                      tabindex="0"
                      data-pl-id="<%= p.plexPlaylistId || '' %>"
                      data-pl-key="<%= p.playlistKey || '' %>"
                      data-pl-title="<%= p.playlistTitle || 'Playlist' %>"
                      data-playlist-kind="<%= p.playlistKind || 'generated' %>"
                      data-playlist-type="<%= p.playlistType || '' %>"
                      data-playlist-state="<%= p.state || 'pending' %>"
                      data-playlist-track-count="<%= Number(p.trackCount || 0) %>"
                      data-playlist-updated-at="<%= Number(p.curatorrUpdatedAt || 0) %>"
                      data-playlist-art="<%= p.artPath || '' %>"
                      onclick="selectPlaylist(this)"
                      onkeydown="if(event.key==='Enter'||event.key===' ') { event.preventDefault(); selectPlaylist(this); }">
                      <div class="plex-poster-wrap cur-discover-poster-wrap cur-playlist-carousel-poster-wrap">
                        <div class="plex-poster-well cur-discover-result-art cur-playlist-carousel-art<%= p.artPath ? '' : ' is-empty' %>">
                          <% if (p.artPath) { %>
                            <img src="<%= (_msType === 'jellyfin' || _msType === 'emby') ? '/api/ms/art?id=' + encodeURIComponent(p.artPath) + (p.artTag ? '&tag=' + encodeURIComponent(p.artTag) : '') : '/api/plex/art?path=' + encodeURIComponent(p.artPath) %>" alt="" loading="lazy" onerror="this.parentElement.classList.add('is-empty');this.remove()" />
                          <% } %>
                          <% if (['personal', 'global', 'custom'].includes(p.playlistType)) { %>
                          <label class="pl-card-checkbox-wrap" title="Select" onclick="event.stopPropagation()">
                            <input type="checkbox" class="pl-card-checkbox" onchange="onCardCheckChange(this)" />
                            <span class="pl-card-checkbox-ui"></span>
                          </label>
                          <% } %>
                          <button class="pl-card-btn pl-card-btn--view" type="button" title="View playlist" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);padding:9px" onclick="event.stopPropagation(); selectPlaylist(this.closest('.cur-playlist-carousel-card'))">
                            <img src="/icons/view.svg" alt="View" style="display:block;width:23px;height:23px;filter:brightness(0) invert(1)" />
                          </button>
                          <% if (p.playlistType === 'personal') { %>
                          <button class="pl-card-btn pl-card-btn--edit" type="button" title="Edit playlist" style="position:absolute;bottom:8px;left:8px;padding:5px;background:rgba(161,106,0,.85)" onclick="event.stopPropagation(); openEditPlaylistModal(this.closest('.cur-playlist-carousel-card'))">
                            <img src="/icons/edit.svg" alt="Edit" style="display:block;width:18px;height:18px" />
                          </button>
                          <% } else if (p.playlistType === 'global') { %>
                          <button class="pl-card-btn pl-card-btn--edit" type="button" title="Edit playlist" style="position:absolute;bottom:8px;left:8px;padding:5px;background:rgba(161,106,0,.85)" onclick="event.stopPropagation(); openEditGlobalPlaylist(this.closest('.cur-playlist-carousel-card'))">
                            <img src="/icons/edit.svg" alt="Edit" style="display:block;width:18px;height:18px" />
                          </button>
                          <% } %>
                          <div class="pl-card-dots-wrap">
                            <button class="pl-card-btn pl-card-btn--dots" type="button" title="More options" onclick="event.stopPropagation(); toggleCardMenu(this)">⋯</button>
                            <div class="pl-card-menu" style="display:none">
                              <% if (p.playlistType === 'personal') { %>
                              <button type="button" onclick="event.stopPropagation(); openEditPlaylistModal(this.closest('.cur-playlist-carousel-card')); closeAllCardMenus()">Edit</button>
                              <% } else if (p.playlistType === 'global') { %>
                              <button type="button" onclick="event.stopPropagation(); openEditGlobalPlaylist(this.closest('.cur-playlist-carousel-card')); closeAllCardMenus()">Edit</button>
                              <% } %>
                              <button type="button" onclick="event.stopPropagation(); rebuildCardPlaylist(this.closest('.cur-playlist-carousel-card'))">Rebuild</button>
                              <% if (['personal', 'global', 'custom'].includes(p.playlistType)) { %>
                              <button type="button" class="pl-card-menu-delete" onclick="event.stopPropagation(); deleteCardPlaylist(this.closest('.cur-playlist-carousel-card'))">Delete</button>
                              <% } %>
                            </div>
                          </div>
                        </div>
                      </div>
                      <div class="plex-footer cur-discover-result-main cur-playlist-carousel-main">
                        <div class="plex-name cur-discover-result-name cur-playlist-carousel-title"><%= p.playlistTitle || 'Playlist' %></div>
                        <div class="plex-meta cur-discover-result-meta cur-playlist-carousel-meta"><%= Number(p.trackCount || 0).toLocaleString() %> tracks</div>
                        <div class="plex-meta cur-discover-result-meta cur-playlist-carousel-meta">Curatorr updated <%= fmtDate(p.curatorrUpdatedAt) %></div>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% } else { %>
              <div class="cur-empty">No playlists available yet.</div>
            <% } %>

            <div id="newPlaylistDialog" class="cur-inline-dialog" style="display:none">
              <div class="cur-inline-dialog-body">
                <input id="newPlaylistTitle" class="cur-input" type="text" placeholder="Playlist name…" maxlength="120" />
                <div class="cur-inline-dialog-actions">
                  <button class="btn btn-sm btn-ghost" type="button" onclick="closeNewPlaylistDialog()">Cancel</button>
                  <button class="btn btn-sm btn-primary" type="button" onclick="createPlaylist()">Create</button>
                </div>
                <div id="newPlaylistStatus" class="cur-panel-meta" style="margin-top:6px"></div>
              </div>
            </div>
          </div>
        </div>

        <%# ── Track list ───────────────────────────────────────────────── %>
        <div class="cur-panel cur-panel--playlist-tracks">
          <div class="cur-panel-header">
            <h3 class="cur-panel-title">Tracks</h3>
            <div class="cur-panel-actions" style="gap:8px">
              <span class="cur-panel-meta" id="trackCountLabel"></span>
              <input id="trackSearch" class="cur-input cur-input--sm" type="search" placeholder="Filter tracks…" oninput="applyFilter()" style="width:180px" />
            </div>
          </div>
          <div class="cur-panel-body">
            <div class="cur-pl-table">
              <div class="cur-pl-head">
                <button class="cur-pl-head-btn" id="sortIndexBtn" type="button" onclick="applySort('index')"># <span class="cur-pl-sort-arrow" aria-hidden="true"></span></button>
                <button class="cur-pl-head-btn" id="sortTitleBtn" type="button" onclick="applySort('title')">Track <span class="cur-pl-sort-arrow" aria-hidden="true"></span></button>
                <button class="cur-pl-head-btn" id="sortAlbumBtn" type="button" onclick="applySort('albumName')">Album <span class="cur-pl-sort-arrow" aria-hidden="true"></span></button>
                <button class="cur-pl-head-btn" id="sortArtistBtn" type="button" onclick="applySort('artistName')">Artist <span class="cur-pl-sort-arrow" aria-hidden="true"></span></button>
                <button class="cur-pl-head-btn cur-pl-head-btn--right" id="sortDurationBtn" type="button" onclick="applySort('duration')">Duration <span class="cur-pl-sort-arrow" aria-hidden="true"></span></button>
                <span class="cur-pl-col-act"></span>
              </div>
              <div class="cur-pl-body">
                <div id="trackList"></div>

                <div id="loadMoreWrap" style="display:none; text-align:center; padding:16px">
                  <button class="btn btn-ghost" id="loadMoreBtn" onclick="loadMore()">Load more</button>
                  <button class="btn btn-ghost" id="loadAllBtn" onclick="loadAll()" style="margin-left:8px">Load all</button>
                </div>
                <div id="trackListEmpty" class="cur-empty" style="display:none">No tracks found.</div>
                <div id="trackListLoading" class="cur-empty">Loading playlist…</div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>
  </div>

  <style>
    .playlist-preset-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin-top:10px; align-items:stretch; }
    .playlist-preset-card { position:relative; overflow:hidden; display:flex; flex-direction:column; min-height:100%; border:1px solid rgba(255,255,255,.12); border-radius:16px; background:linear-gradient(180deg,rgba(14,18,27,.92),rgba(11,15,24,.82)); color:#f8fafc; padding:12px; text-align:left; cursor:pointer; transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease; box-shadow:0 14px 34px rgba(15,23,42,.18); }
    .playlist-preset-card:hover { transform:translateY(-1px); border-color:rgba(255,255,255,.22); }
    .playlist-preset-card.is-active { border-color:rgba(245,158,11,.92); box-shadow:0 0 0 1px rgba(245,158,11,.28), 0 12px 30px rgba(0,0,0,.26); }
    .playlist-preset-card.is-disabled,
    .playlist-preset-card:disabled { opacity:.48; cursor:not-allowed; transform:none; box-shadow:none; filter:saturate(.6); }
    .playlist-preset-card__art { display:block; position:relative; overflow:hidden; height:104px; border-radius:12px; margin-bottom:12px; border:1px solid rgba(255,255,255,.10); box-shadow:inset 0 1px 0 rgba(255,255,255,.08), inset 0 -24px 36px rgba(15,23,42,.22); }
    .playlist-preset-card__art::before,
    .playlist-preset-card__art::after { content:""; position:absolute; pointer-events:none; }
    .playlist-preset-card__art::before { inset:0; background:linear-gradient(180deg,rgba(255,255,255,.14),transparent 26%,rgba(15,23,42,.26)); }
    .playlist-preset-card__art::after { right:-10%; bottom:-26%; width:72%; height:72%; border-radius:999px; border:1px solid rgba(255,255,255,.20); box-shadow:0 0 0 16px rgba(255,255,255,.05), 0 0 0 36px rgba(255,255,255,.03); opacity:.7; transform:rotate(-18deg); }
    .playlist-preset-card__eyebrow { display:block; font-size:11px; letter-spacing:.12em; text-transform:uppercase; color:rgba(255,255,255,.5); margin-bottom:4px; }
    .playlist-preset-card__title { display:block; font-weight:700; margin-bottom:4px; color:#f8fafc; }
    .playlist-preset-card__desc { display:block; font-size:12px; color:rgba(255,255,255,.74); line-height:1.45; }
    .playlist-preset-card__meta { display:block; margin-top:7px; font-size:11px; color:rgba(255,255,255,.58); }
    .playlist-preset-card--none .playlist-preset-card__art { background:
      linear-gradient(135deg,rgba(255,255,255,.06) 0 12%,transparent 12% 100%),
      linear-gradient(135deg,#111827,#1f2937); }
    .playlist-preset-card--club .playlist-preset-card__art { background:
      radial-gradient(circle at 20% 25%,rgba(236,72,153,.95),transparent 35%),
      radial-gradient(circle at 80% 20%,rgba(59,130,246,.9),transparent 34%),
      linear-gradient(135deg,#140c1c,#312e81 54%,#0f172a); }
    .playlist-preset-card--club .playlist-preset-card__art::after { right:-8%; bottom:-18%; width:82%; height:82%; border-color:rgba(244,114,182,.34); box-shadow:0 0 0 16px rgba(59,130,246,.10), 0 0 0 36px rgba(236,72,153,.10); }
    .playlist-preset-card--driving .playlist-preset-card__art { background:
      linear-gradient(180deg,rgba(251,191,36,.98),rgba(249,115,22,.88) 44%,rgba(30,41,59,.98)),
      linear-gradient(120deg,#1e3a8a,#0f172a); }
    .playlist-preset-card--driving .playlist-preset-card__art::after { right:-2%; bottom:-22%; width:56%; height:110%; border-radius:28px; border-color:rgba(255,255,255,.30); box-shadow:0 0 0 10px rgba(255,255,255,.06), inset 0 0 0 1px rgba(255,255,255,.08); transform:skewX(-18deg); }
    .playlist-preset-card--workout .playlist-preset-card__art { background:
      linear-gradient(135deg,rgba(239,68,68,.98),rgba(249,115,22,.92) 42%,rgba(17,24,39,.98)); }
    .playlist-preset-card--workout .playlist-preset-card__art::after { right:-14%; bottom:-30%; width:74%; height:88%; border-color:rgba(254,215,170,.28); box-shadow:0 0 0 16px rgba(249,115,22,.10), 0 0 0 34px rgba(239,68,68,.08); transform:rotate(-10deg); }
    .playlist-preset-card--chill .playlist-preset-card__art { background:
      radial-gradient(circle at 25% 20%,rgba(125,211,252,.85),transparent 28%),
      linear-gradient(135deg,#0f172a,#1d4ed8 55%,#164e63); }
    .playlist-preset-card--chill .playlist-preset-card__art::after { right:-4%; bottom:-24%; width:68%; height:76%; border-color:rgba(186,230,253,.26); box-shadow:0 0 0 14px rgba(125,211,252,.08), 0 0 0 32px rgba(14,165,233,.05); transform:rotate(-6deg); }
    .playlist-preset-card--harmonic .playlist-preset-card__art { background:
      radial-gradient(circle at center,rgba(255,255,255,.16) 0,rgba(255,255,255,.06) 24%,transparent 25%),
      conic-gradient(from 45deg,#f59e0b,#f97316,#ef4444,#8b5cf6,#3b82f6,#14b8a6,#f59e0b); }
    .playlist-preset-card--harmonic .playlist-preset-card__art::after { right:10%; bottom:12%; width:34%; height:34%; border-color:rgba(255,255,255,.28); box-shadow:0 0 0 12px rgba(255,255,255,.08), 0 0 0 24px rgba(255,255,255,.04); transform:none; }
    .playlist-preset-card--downtempo .playlist-preset-card__art { background:
      linear-gradient(135deg,#0f172a,#334155 45%,#475569); }
    .playlist-preset-card--downtempo .playlist-preset-card__art::after { right:-10%; bottom:-28%; width:72%; height:72%; border-color:rgba(226,232,240,.18); box-shadow:0 0 0 16px rgba(148,163,184,.08), 0 0 0 34px rgba(71,85,105,.06); }
    .playlist-feature-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:10px; margin-top:12px; align-items:end; }
    .playlist-feature-grid .field { display:flex; flex-direction:column; gap:6px; min-width:0; }
    .playlist-feature-grid .field span { font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.08em; color:var(--muted,#94a3b8); }
    .playlist-feature-grid .field input,
    .playlist-feature-grid .field select { width:100%; min-height:40px; box-sizing:border-box; border-radius:10px; border:1px solid var(--border, rgba(255,255,255,.15)); background:var(--surface-1,#1e1e1e); color:var(--text,#e5e7eb); padding:8px 10px; }
    .playlist-feature-note { margin-top:10px; font-size:12px; line-height:1.55; color:var(--muted,#a0aec0); }
    .playlist-feature-note strong { color:var(--text,#f8fafc); }
    .playlist-inline-code { display:inline-flex; align-items:center; padding:2px 6px; border-radius:5px; font-size:11px; line-height:1.35; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.08); color:inherit; }
    [data-theme="day"] .playlist-preset-card { background:linear-gradient(180deg,#ffffff,#eef3f8); border-color:rgba(10,20,30,.12); color:#223043; box-shadow:0 16px 36px rgba(15,23,42,.10); }
    [data-theme="day"] .playlist-preset-card:hover { border-color:rgba(var(--brand-rgb), .24); box-shadow:0 18px 40px rgba(15,23,42,.14); }
    [data-theme="day"] .playlist-preset-card.is-active { border-color:rgba(245,158,11,.92); box-shadow:0 0 0 1px rgba(245,158,11,.18), 0 18px 42px rgba(245,158,11,.14); }
    [data-theme="day"] .playlist-preset-card__art { border-color:rgba(10,20,30,.10); box-shadow:inset 0 1px 0 rgba(255,255,255,.18), inset 0 -24px 36px rgba(15,23,42,.12); }
    [data-theme="day"] .playlist-preset-card__eyebrow { color:#738297; }
    [data-theme="day"] .playlist-preset-card__title { color:#223043; }
    [data-theme="day"] .playlist-preset-card__desc { color:#4f5f73; }
    [data-theme="day"] .playlist-preset-card__meta { color:#6b7a8d; }
    [data-theme="day"] .playlist-feature-grid .field span { color:#6b7a8d; }
    [data-theme="day"] .playlist-feature-grid .field input,
    [data-theme="day"] .playlist-feature-grid .field select { background:linear-gradient(180deg,#ffffff,#f6f8fb); color:#223043; border-color:rgba(10,20,30,.12); }
    [data-theme="day"] .playlist-feature-note { color:#5e6d80; }
    [data-theme="day"] .playlist-feature-note strong { color:#1f2d3d; }
    [data-theme="day"] .playlist-inline-code { background:rgba(var(--brand-rgb), .09); border-color:rgba(var(--brand-rgb), .14); color:#223043; }
    @media (max-width: 860px) {
      .playlist-feature-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    }
    @media (max-width: 560px) {
      .playlist-preset-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
      .playlist-feature-grid { grid-template-columns:1fr; }
    }
  </style>

  <%# ── Smart Playlist Modal ────────────────────────────────────────────────── %>
  <div id="smartPlModal" class="spm-overlay" style="display:none" onclick="if(event.target===this)closeSmartPlaylistModal()">
    <div class="spm-dialog" role="dialog" aria-modal="true" aria-label="Create Smart Playlist">
      <div class="spm-header">
        <span class="spm-title" id="spm-modal-title">Create Smart Playlist</span>
        <button class="spm-close" type="button" onclick="closeSmartPlaylistModal()" aria-label="Close">✕</button>
      </div>
      <div class="spm-body">
        <div id="spm-wizard-body" style="display:none"></div>
        <div id="spm-flat-form">
        <div class="field" style="margin-bottom:16px">
          <span style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--muted,#888)">Playlist name</span>
          <input type="text" id="spm-name" class="cur-input" placeholder="e.g. Britpop Belters" style="width:100%;margin-top:4px" />
        </div>

        <div class="spm-filter-section" style="margin-bottom:16px">
          <div class="spm-filter-label">Feature preset <span class="gp-filter-hint">(select a starting point, then tweak the ranges)</span></div>
          <% const _spmPresetCoverage = (playlistFeatureCoverage && playlistFeatureCoverage.presets) || {}; %>
          <input type="hidden" id="spm-feature-preset" value="none" />
          <div class="playlist-preset-grid" id="spm-preset-grid">
            <button type="button" class="playlist-preset-card playlist-preset-card--none is-active" data-preset="none">
              <span class="playlist-preset-card__art" aria-hidden="true"></span>
              <span class="playlist-preset-card__eyebrow">Open brief</span>
              <span class="playlist-preset-card__title">Custom</span>
              <span class="playlist-preset-card__desc">Start clean and shape the playlist yourself.</span>
              <span class="playlist-preset-card__meta"><%= Number(_spmPresetCoverage.none?.readyTrackCount || 0).toLocaleString() %> tracks ready</span>
            </button>
            <button type="button" class="playlist-preset-card playlist-preset-card--club<%= _spmPresetCoverage.club?.enabled ? '' : ' is-disabled' %>" data-preset="club" <%= _spmPresetCoverage.club?.enabled ? '' : 'disabled' %> title="<%= _spmPresetCoverage.club?.reason || '' %>">
              <span class="playlist-preset-card__art" aria-hidden="true"></span>
              <span class="playlist-preset-card__eyebrow">Night out</span>
              <span class="playlist-preset-card__title">Club</span>
              <span class="playlist-preset-card__desc">Fast BPM, strong energy, dancefloor bias.</span>
              <span class="playlist-preset-card__meta"><%= _spmPresetCoverage.club?.enabled ? `${Number(_spmPresetCoverage.club.readyTrackCount || 0).toLocaleString()} tracks ready` : (_spmPresetCoverage.club?.reason || 'Unavailable') %></span>
            </button>
            <button type="button" class="playlist-preset-card playlist-preset-card--driving<%= _spmPresetCoverage.driving?.enabled ? '' : ' is-disabled' %>" data-preset="driving" <%= _spmPresetCoverage.driving?.enabled ? '' : 'disabled' %> title="<%= _spmPresetCoverage.driving?.reason || '' %>">
              <span class="playlist-preset-card__art" aria-hidden="true"></span>
              <span class="playlist-preset-card__eyebrow">Road pace</span>
              <span class="playlist-preset-card__title">Driving</span>
              <span class="playlist-preset-card__desc">Steady tempo and lift without going full cardio.</span>
              <span class="playlist-preset-card__meta"><%= _spmPresetCoverage.driving?.enabled ? `${Number(_spmPresetCoverage.driving.readyTrackCount || 0).toLocaleString()} tracks ready` : (_spmPresetCoverage.driving?.reason || 'Unavailable') %></span>
            </button>
            <button type="button" class="playlist-preset-card playlist-preset-card--workout<%= _spmPresetCoverage.workout?.enabled ? '' : ' is-disabled' %>" data-preset="workout" <%= _spmPresetCoverage.workout?.enabled ? '' : 'disabled' %> title="<%= _spmPresetCoverage.workout?.reason || '' %>">
              <span class="playlist-preset-card__art" aria-hidden="true"></span>
              <span class="playlist-preset-card__eyebrow">High push</span>
              <span class="playlist-preset-card__title">Workout</span>
              <span class="playlist-preset-card__desc">Higher BPM, higher energy, built for momentum.</span>
              <span class="playlist-preset-card__meta"><%= _spmPresetCoverage.workout?.enabled ? `${Number(_spmPresetCoverage.workout.readyTrackCount || 0).toLocaleString()} tracks ready` : (_spmPresetCoverage.workout?.reason || 'Unavailable') %></span>
            </button>
            <button type="button" class="playlist-preset-card playlist-preset-card--chill<%= _spmPresetCoverage.chill?.enabled ? '' : ' is-disabled' %>" data-preset="chill" <%= _spmPresetCoverage.chill?.enabled ? '' : 'disabled' %> title="<%= _spmPresetCoverage.chill?.reason || '' %>">
              <span class="playlist-preset-card__art" aria-hidden="true"></span>
              <span class="playlist-preset-card__eyebrow">Low pressure</span>
              <span class="playlist-preset-card__title">Chill</span>
              <span class="playlist-preset-card__desc">Slower pace, softer energy, easy background flow.</span>
              <span class="playlist-preset-card__meta"><%= _spmPresetCoverage.chill?.enabled ? `${Number(_spmPresetCoverage.chill.readyTrackCount || 0).toLocaleString()} tracks ready` : (_spmPresetCoverage.chill?.reason || 'Unavailable') %></span>
            </button>
            <button type="button" class="playlist-preset-card playlist-preset-card--harmonic<%= _spmPresetCoverage.harmonic?.enabled ? '' : ' is-disabled' %>" data-preset="harmonic" <%= _spmPresetCoverage.harmonic?.enabled ? '' : 'disabled' %> title="<%= _spmPresetCoverage.harmonic?.reason || '' %>">
              <span class="playlist-preset-card__art" aria-hidden="true"></span>
              <span class="playlist-preset-card__eyebrow">Key pocket</span>
              <span class="playlist-preset-card__title">Harmonic</span>
              <span class="playlist-preset-card__desc">Bias the set around a Camelot key neighborhood.</span>
              <span class="playlist-preset-card__meta"><%= _spmPresetCoverage.harmonic?.enabled ? `${Number(_spmPresetCoverage.harmonic.readyTrackCount || 0).toLocaleString()} tracks ready` : (_spmPresetCoverage.harmonic?.reason || 'Unavailable') %></span>
            </button>
          </div>
          <div class="playlist-feature-grid">
            <label class="field">
              <span>BPM min</span>
              <input type="number" id="spm-bpm-min" min="0" step="1" placeholder="Any" />
            </label>
            <label class="field">
              <span>BPM max</span>
              <input type="number" id="spm-bpm-max" min="0" step="1" placeholder="Any" />
            </label>
            <label class="field">
              <span>Energy min</span>
              <input type="number" id="spm-energy-min" min="0" max="1" step="0.01" placeholder="Any" />
            </label>
            <label class="field">
              <span>Energy max</span>
              <input type="number" id="spm-energy-max" min="0" max="1" step="0.01" placeholder="Any" />
            </label>
            <label class="field">
              <span>Danceability min</span>
              <input type="number" id="spm-danceability-min" min="0" max="1" step="0.01" placeholder="Any" />
            </label>
            <label class="field">
              <span>Danceability max</span>
              <input type="number" id="spm-danceability-max" min="0" max="1" step="0.01" placeholder="Any" />
            </label>
            <label class="field">
              <span>Camelot focus</span>
              <input type="text" id="spm-camelot-focus" placeholder="8A, 9A, 10A" />
            </label>
            <label class="field">
              <span>Camelot spread</span>
              <select id="spm-camelot-mode">
                <option value="exact">Exact key</option>
                <option value="adjacent">Adjacent keys</option>
                <option value="relative">Relative major/minor</option>
                <option value="harmonic">Full harmonic set</option>
              </select>
            </label>
          </div>
          <div class="playlist-feature-note">Presets fill these fields for you. Camelot uses DJ wheel notation rather than classical names: <code class="playlist-inline-code">8A</code> is <code class="playlist-inline-code">A minor</code>, and <code class="playlist-inline-code">8B</code> is <code class="playlist-inline-code">C major</code>. Camelot focus accepts one or more keys like <code class="playlist-inline-code">8A</code> or <code class="playlist-inline-code">8A, 9A, 10A</code>. Exact uses only the listed keys. Adjacent adds neighboring numbers on the same letter. Relative adds the same number on the opposite letter. Full harmonic set combines both.</div>
          <div class="playlist-feature-note" id="spm-feature-match-note">Current feature match: <strong id="spm-feature-match-count">—</strong> tracks after your edits.</div>
        </div>

        <div class="spm-tiers-row">
          <div class="spm-filter-section">
            <div class="spm-filter-label">Artist tier</div>
            <div class="spm-filter-chips">
              <% [['belter','Belter','belter'],['decent','Decent','decent'],['halfDecent','Half-Decent','half-decent'],['skip','Skip','skip'],['unranked','Unranked','muted']].forEach(function(t) { %>
              <label class="gp-chip-label">
                <input type="checkbox" class="spm-artist-tier" value="<%= t[0] %>" />
                <span class="cur-badge cur-badge--<%= t[2] %>"><%= t[1] %></span>
              </label>
              <% }); %>
            </div>
          </div>

          <div class="spm-filter-section">
            <div class="spm-filter-label">Track tier</div>
            <div class="spm-filter-chips">
              <% [['belter','Belter','belter'],['decent','Decent','decent'],['halfDecent','Half-Decent','half-decent'],['skip','Skip','skip'],['unplayed','Unplayed','muted']].forEach(function(t) { %>
              <label class="gp-chip-label">
                <input type="checkbox" class="spm-track-tier" value="<%= t[0] %>" />
                <span class="cur-badge cur-badge--<%= t[2] %>"><%= t[1] %></span>
              </label>
              <% }); %>
            </div>
          </div>
        </div>

        <% if ((allGenres || []).length) { %>
        <div class="spm-filter-section">
          <div class="spm-filter-label">Genres <span class="gp-filter-hint">(click once to include, again to exclude, again to clear)</span></div>
          <div class="spm-tristate-wrap">
            <input type="text" class="spm-tristate-search" placeholder="Filter genres…" data-chips="spm-genres-chips" />
            <div class="spm-tristate-chips" id="spm-genres-chips">
              <% (allGenres || []).forEach(function(g) { %>
              <button type="button" class="spm-chip" data-kind="genre" data-value="<%= g %>" data-state="neutral"><%= g %></button>
              <% }); %>
            </div>
            <div class="spm-chip-hint">None selected = include all</div>
          </div>
        </div>
        <% } %>

        <% if ((allMoods || []).length) { %>
        <div class="spm-filter-section">
          <div class="spm-filter-label">Moods <span class="gp-filter-hint">(click once to include, again to exclude, again to clear)</span></div>
          <div class="spm-tristate-wrap">
            <input type="text" class="spm-tristate-search" placeholder="Filter moods…" data-chips="spm-moods-chips" />
            <div class="spm-tristate-chips" id="spm-moods-chips">
              <% (allMoods || []).forEach(function(m) { %>
              <button type="button" class="spm-chip" data-kind="mood" data-value="<%= m %>" data-state="neutral"><%= m %></button>
              <% }); %>
            </div>
            <div class="spm-chip-hint">None selected = include all</div>
          </div>
        </div>
        <% } %>

        <% if ((allLastfmTags || []).length) { %>
        <div class="spm-filter-section">
          <div class="spm-filter-label">Last.fm Tags <span class="gp-filter-hint">(click once to include, again to exclude, again to clear)</span></div>
          <div class="spm-tristate-wrap">
            <input type="text" class="spm-tristate-search" placeholder="Filter tags… e.g. britpop" data-chips="spm-tags-chips" />
            <div class="spm-tristate-chips" id="spm-tags-chips">
              <% (allLastfmTags || []).forEach(function(t) { %>
              <button type="button" class="spm-chip" data-kind="tag" data-value="<%= t %>" data-state="neutral"><%= t %></button>
              <% }); %>
            </div>
            <div class="spm-chip-hint">None selected = include all</div>
          </div>
        </div>
        <% } %>

        <div class="spm-filter-section spm-filter-section--inline">
          <label class="field" style="flex:1">
            <span>Top N per artist</span>
            <input type="number" id="spm-top-n" min="1" max="999" placeholder="All tracks" />
          </label>
          <label class="field" style="flex:1">
            <span>Max total tracks</span>
            <input type="number" id="spm-max-tracks" min="1" placeholder="No limit" />
          </label>
          <label class="field" style="flex:1">
            <span>Auto-rebuild</span>
            <select id="spm-rebuild-schedule">
              <option value="daily">Daily</option>
              <option value="weekly">Weekly</option>
              <option value="manual">Manual only</option>
            </select>
          </label>
          <label class="field" style="flex:1">
            <span>Sort tracks by</span>
            <select id="spm-sort-by">
              <option value="ratingCount">Global rating count</option>
              <option value="tierWeight">Tier weight</option>
              <option value="playCount">Play count</option>
              <option value="bpmAsc">BPM low to high</option>
              <option value="bpmDesc">BPM high to low</option>
              <option value="energyAsc">Energy low to high</option>
              <option value="energyDesc">Energy high to low</option>
              <option value="danceabilityDesc">Danceability high to low</option>
              <option value="camelot">Camelot wheel</option>
              <option value="djFlow">DJ flow (Camelot + BPM)</option>
            </select>
          </label>
        </div>

        <% if ((blendableUsers || []).length > 1) { %>
        <div class="spm-filter-section gp-blend-section">
          <div class="spm-filter-label">
            Blend users
            <span class="gp-filter-hint">(combine listening data from other users)</span>
          </div>
          <div class="blend-slots" id="spm-blend-picker-rows"></div>
          <button class="blend-add-btn" id="spm-blend-add-btn" type="button">+ Add user</button>
          <div id="spm-blend-mode-wrap" style="display:none">
            <div class="spm-filter-label" style="margin-top:10px">Blend mode</div>
            <div class="gp-blend-modes">
              <label class="gp-blend-mode-option"><input type="radio" name="spm-blend-mode" value="average" checked /><span class="gp-blend-mode-name">Average</span><span class="gp-blend-mode-desc">Average each user's scores together — shared favourites rise, polarising tracks land in the middle.</span></label>
              <label class="gp-blend-mode-option"><input type="radio" name="spm-blend-mode" value="intersection" /><span class="gp-blend-mode-name">Intersection</span><span class="gp-blend-mode-desc">Only tracks every selected user qualifies. Safest for shared listening.</span></label>
              <label class="gp-blend-mode-option"><input type="radio" name="spm-blend-mode" value="union" /><span class="gp-blend-mode-name">Union</span><span class="gp-blend-mode-desc">Tracks any selected user qualifies. Broadest result — great for discovery.</span></label>
              <label class="gp-blend-mode-option"><input type="radio" name="spm-blend-mode" value="veto" /><span class="gp-blend-mode-name">Veto</span><span class="gp-blend-mode-desc">Union minus any track someone has skipped. Nobody gets music they hate.</span></label>
            </div>
          </div>
        </div>
        <% } %>

        <div class="spm-preview">
          <span class="spm-preview-label">Preview:</span>
          <span id="spm-prev-artists">—</span> artists ·
          <span id="spm-prev-tracks">—</span> tracks
        </div>
        </div><%# /spm-flat-form %>
      </div>

      <div class="spm-footer">
        <div id="spm-flat-footer" style="display:flex;align-items:center;gap:10px;width:100%">
          <button class="btn btn-ghost" type="button" onclick="closeSmartPlaylistModal()">Cancel</button>
          <button class="btn btn-primary" type="button" id="spm-create-btn" onclick="spmSubmit()">Create Playlist</button>
          <span id="spm-msg" style="font-size:13px;margin-left:8px"></span>
        </div>
        <div id="spm-wizard-footer" style="display:none;width:100%"></div>
      </div>
    </div>
  </div>

  <script src="/sidebar.js?v=<%= assetVersion %>"></script>
  <script src="/user-menu.js?v=<%= assetVersion %>"></script>
  <script src="/version-badge.js?v=<%= assetVersion %>"></script>
  <script src="/brand-menu.js?v=<%= assetVersion %>"></script>
  <script src="/curatorr-overview.js?v=<%= assetVersion %>"></script>
  <script src="/starfield-3d.js"></script>
  <script>
    var _offset = 0;
    var _total = 0;
    var _pageSize = 100;
    var _loading = false;
    var _loadingAllTracks = false;
    var _loadingAllTracksPromise = null;
    var _visibleTrackCount = 0;
    var _trackLoadGeneration = 0;
    var _currentPlexId = null;
    var _currentPlexKey = null;
    var _currentPlaylistKind = '';
    var _currentPlaylistType = '';
    var _allTracks = [];
    var _sortField = 'index';
    var _sortAsc = true;
    var CSRF = '<%= csrfToken %>';
    var PLEX_MACHINE_ID = '<%= _plexMachineId %>';
    var MS_LABEL = '<%= _msLabel %>';
    var _msType = '<%= _msType %>';
    var CURRENT_USER_ID = <%- JSON.stringify(currentUserId || '') %>;
    var IS_ACTUAL_ADMIN = <%- JSON.stringify(actualRole === 'admin') %>;
    var ALL_PATH_SEGMENTS = <%- JSON.stringify(allPathSegments || []) %>;

    function fmtDuration(ms) {
      if (!ms) return '';
      var s = Math.round(ms / 1000);
      var m = Math.floor(s / 60);
      var sec = s % 60;
      return m + ':' + (sec < 10 ? '0' : '') + sec;
    }

    function fmtTotalTime(ms) {
      var h = Math.floor(ms / 3600000);
      var m = Math.floor((ms % 3600000) / 60000);
      if (h > 0) return h + 'h ' + m + 'm';
      return m + ' min';
    }

    function fmtShortDate(ts) {
      if (!ts) return '—';
      return new Date(Number(ts)).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    }

    function escHtml(s) {
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function escAttr(s) {
      return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;');
    }

    // ── Sort & filter ─────────────────────────────────────────────────────────

    function applySort(field) {
      var nextField = field || 'index';
      if (_loading) return;
      if (_sortField === nextField) _sortAsc = !_sortAsc;
      else {
        _sortField = nextField;
        _sortAsc = true;
      }
      if (_sortField !== 'index' && _offset < _total) {
        ensureAllTracksLoaded('Loading full playlist for sorting…')
          .then(function() {
            renderFiltered();
          });
        return;
      }
      renderFiltered();
    }

    function syncSortHeaders() {
      var map = {
        index: document.getElementById('sortIndexBtn'),
        title: document.getElementById('sortTitleBtn'),
        albumName: document.getElementById('sortAlbumBtn'),
        artistName: document.getElementById('sortArtistBtn'),
        duration: document.getElementById('sortDurationBtn'),
      };

      Object.keys(map).forEach(function(field) {
        var btn = map[field];
        if (!btn) return;
        var active = _sortField === field;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-sort', active ? (_sortAsc ? 'ascending' : 'descending') : 'none');
        var arrow = btn.querySelector('.cur-pl-sort-arrow');
        if (arrow) arrow.textContent = active ? (_sortAsc ? '↑' : '↓') : '↕';
      });
    }

    function applyFilter() {
      renderFiltered();
    }

    function getSortedFiltered() {
      var q = (document.getElementById('trackSearch').value || '').toLowerCase().trim();
      var tracks = _allTracks.slice();

      if (q) {
        tracks = tracks.filter(function(t) {
          return (t.title || '').toLowerCase().indexOf(q) !== -1 ||
                 (t.artistName || '').toLowerCase().indexOf(q) !== -1 ||
                 (t.albumName || '').toLowerCase().indexOf(q) !== -1;
        });
      }

      if (_sortField !== 'index') {
        tracks.sort(function(a, b) {
          var av = (a[_sortField] || '').toString().toLowerCase();
          var bv = (b[_sortField] || '').toString().toLowerCase();
          if (_sortField === 'duration') { av = Number(a.duration || 0); bv = Number(b.duration || 0); }
          if (av < bv) return _sortAsc ? -1 : 1;
          if (av > bv) return _sortAsc ? 1 : -1;
          return 0;
        });
      } else if (!_sortAsc) {
        tracks.reverse();
      }

      return tracks;
    }

    function renderFiltered() {
      var tracks = getSortedFiltered();
      var visibleCount = Math.min(_visibleTrackCount || tracks.length, tracks.length);
      var visibleTracks = tracks.slice(0, visibleCount);
      var list = document.getElementById('trackList');
      list.innerHTML = '';
      var frag = document.createDocumentFragment();
      visibleTracks.forEach(function(t, i) {
        frag.appendChild(buildRow(t, i));
      });
      list.appendChild(frag);
      document.getElementById('trackListEmpty').style.display = tracks.length ? 'none' : '';
      document.getElementById('trackCountLabel').textContent =
        (visibleCount < tracks.length ? visibleCount + ' / ' : '') +
        tracks.length.toLocaleString() + ' tracks';
      updateLoadControls(tracks.length, visibleCount);
      syncSortHeaders();
    }

    function updateLoadControls(totalFiltered, visibleCount) {
      var wrap = document.getElementById('loadMoreWrap');
      var loadMoreBtn = document.getElementById('loadMoreBtn');
      var loadAllBtn = document.getElementById('loadAllBtn');
      if (!wrap || !loadMoreBtn || !loadAllBtn) return;

      if (_offset < _total) {
        wrap.style.display = '';
        loadMoreBtn.textContent = 'Load more (' + (_total - _offset).toLocaleString() + ' remaining)';
        loadMoreBtn.disabled = false;
        loadAllBtn.disabled = false;
        return;
      }

      if (visibleCount < totalFiltered) {
        wrap.style.display = '';
        loadMoreBtn.textContent = 'Show more (' + (totalFiltered - visibleCount).toLocaleString() + ' remaining)';
        loadMoreBtn.disabled = false;
        loadAllBtn.disabled = false;
        return;
      }

      wrap.style.display = 'none';
    }

    // ── Row builder ───────────────────────────────────────────────────────────

    function buildRow(t, i) {
      var row = document.createElement('div');
      row.className = 'cur-pl-row';
      row.dataset.ratingKey = t.ratingKey || '';
      row.dataset.playlistItemId = t.playlistItemID || '';

      var _isNonPlex = _msType === 'jellyfin' || _msType === 'emby';
      var albumThumbUrl = t.albumThumb
        ? (_isNonPlex ? t.albumThumb : '/api/plex/art?path=' + encodeURIComponent(t.albumThumb))
        : '';
      var artistThumbUrl = t.artistThumb
        ? (_isNonPlex ? t.artistThumb : '/api/plex/art?path=' + encodeURIComponent(t.artistThumb))
        : '';
      var albumThumbHtml = albumThumbUrl
        ? '<img src="' + albumThumbUrl + '" alt="" loading="lazy" onerror="this.style.display=\'none\';this.parentElement.innerHTML=\'<div class=&quot;cur-pl-no-art&quot;>♫</div>\'" />'
        : '<div class="cur-pl-no-art">♫</div>';
      var artistThumbHtml = artistThumbUrl
        ? '<img src="' + artistThumbUrl + '" alt="" loading="lazy" onerror="this.style.display=\'none\';this.parentElement.innerHTML=\'<div class=&quot;cur-pl-no-art&quot;>♫</div>\'" />'
        : '<div class="cur-pl-no-art">♫</div>';

      var artistHtml = '<span class="cur-overview-trigger cur-pl-artist-name" role="button" tabindex="0"' +
        ' data-cur-overview-kind="artist" data-cur-overview-name="' + escAttr(t.artistName || '') + '">' +
        escHtml(t.artistName) + '</span>';

      var albumHtml = t.albumName
        ? '<span class="cur-pl-inline-media"><span class="cur-pl-col-art cur-pl-col-art--album">' + albumThumbHtml + '</span><span class="cur-overview-trigger cur-pl-album-name" role="button" tabindex="0"' +
          ' data-cur-overview-kind="album" data-cur-overview-artist="' + escAttr(t.artistName || '') + '"' +
          ' data-cur-overview-album="' + escAttr(t.albumName || '') + '">' + escHtml(t.albumName) + '</span></span>'
        : '<span class="cur-pl-cell-empty">—</span>';

      var addArtistBtn = _currentPlexId
        ? '<button class="cur-pl-add-artist-btn" type="button" title="Add all ' + escAttr(t.artistName || '') + ' tracks to playlist"' +
          ' onclick="addArtistTracks(' + escAttr(JSON.stringify(t.artistName || '')) + ', this)">＋</button>'
        : '';

      var removeBtn = _currentPlexId && t.playlistItemID
        ? '<button class="cur-pl-remove-btn" type="button" title="Remove from playlist"' +
          ' onclick="removeTrack(this)">✕</button>'
        : '';

      row.innerHTML =
        '<span class="cur-pl-col-num">' + (i + 1) + '</span>' +
        '<span class="cur-pl-col-track">' +
          '<span class="cur-pl-track-name cur-overview-trigger" role="button" tabindex="0"' +
          ' data-cur-overview-kind="track" data-cur-overview-key="' + escAttr(t.ratingKey || '') + '">' + escHtml(t.title) + '</span>' +
        '</span>' +
        '<span class="cur-pl-col-album">' + albumHtml + '</span>' +
        '<span class="cur-pl-col-artist"><span class="cur-pl-inline-media"><span class="cur-pl-col-art cur-pl-col-art--artist">' + artistThumbHtml + '</span>' + artistHtml + '</span>' + addArtistBtn + '</span>' +
        '<span class="cur-pl-col-dur">' + fmtDuration(t.duration) + '</span>' +
        '<span class="cur-pl-col-act">' + removeBtn + '</span>';

      return row;
    }

    function renderTracks(tracks, offset) {
      // Append to _allTracks preserving original order index
      tracks.forEach(function(t, i) { t._index = offset + i; });
      _allTracks = _allTracks.concat(tracks);
      if (!_loadingAllTracks) {
        _visibleTrackCount = Math.max(_visibleTrackCount, offset + tracks.length);
      }
      renderFiltered();
    }

    // ── Track removal ─────────────────────────────────────────────────────────

    function removeTrack(btn) {
      var row = btn.closest('.cur-pl-row');
      if (!row || !_currentPlexId) return;
      var ratingKey = row.dataset.ratingKey;
      var playlistItemID = row.dataset.playlistItemId;
      if (!playlistItemID) return;

      btn.disabled = true;
      btn.textContent = '…';

      fetch('/api/music/playlist/tracks', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
        body: JSON.stringify({ plexPlaylistId: _currentPlexId, playlistItemID: playlistItemID, ratingKey: ratingKey }),
      }).then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.ok) throw new Error(data.error || 'Failed');
          // Remove from _allTracks and re-render
          _allTracks = _allTracks.filter(function(t) { return t.playlistItemID !== playlistItemID; });
      _total = Math.max(0, _total - 1);
      _visibleTrackCount = Math.max(0, Math.min(_visibleTrackCount - 1, _allTracks.length));
      renderFiltered();
        })
        .catch(function(err) {
          btn.disabled = false;
          btn.textContent = '✕';
          alert('Could not remove track: ' + (err.message || 'Unknown error'));
        });
    }

    // ── Add artist tracks ─────────────────────────────────────────────────────

    function addArtistTracks(artistName, btn) {
      if (!_currentPlexId || !artistName) return;
      btn.disabled = true;
      btn.textContent = '…';

      fetch('/api/music/playlist/tracks/add-artist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
        body: JSON.stringify({ plexPlaylistId: _currentPlexId, artistName: artistName }),
      }).then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.ok) throw new Error(data.error || 'Failed');
          btn.textContent = '✓';
          btn.title = 'Added ' + (data.added || 0) + ' tracks';
          setTimeout(function() { btn.textContent = '＋'; btn.disabled = false; }, 2000);
          // Reload tracks to show new additions
          if (data.added > 0) reloadTracks();
        })
        .catch(function(err) {
          btn.disabled = false;
          btn.textContent = '＋';
          alert('Could not add artist tracks: ' + (err.message || 'Unknown error'));
        });
    }

    // ── New playlist dialog ───────────────────────────────────────────────────

    function openNewPlaylistDialog() {
      document.getElementById('newPlaylistDialog').style.display = '';
      document.getElementById('newPlaylistTitle').focus();
    }

    function closeNewPlaylistDialog() {
      document.getElementById('newPlaylistDialog').style.display = 'none';
      document.getElementById('newPlaylistStatus').textContent = '';
    }

    function canRebuildSelection(kind, type) {
      if (kind === 'legacy') return true;
      return ['curatorred', 'crescive', 'curative', 'curatorr', 'daily-mix', 'global', 'personal'].indexOf(String(type || '').toLowerCase()) !== -1;
    }

    function updateSelectionButtons() {
      var viewBtn = document.getElementById('playlistViewBtn');
      var canView = Boolean(_currentPlexId && PLEX_MACHINE_ID);
      var canRebuild = canRebuildSelection(_currentPlaylistKind, _currentPlaylistType);
      if (viewBtn) {
        viewBtn.disabled = !canView;
        viewBtn.title = canView ? ('Open this playlist in ' + MS_LABEL) : ('This playlist is not yet available to open in ' + MS_LABEL + '.');
      }
      document.querySelectorAll('#playlistCarouselTrack .cur-playlist-carousel-rebuild').forEach(function(rebuildBtn) {
        rebuildBtn.disabled = !canRebuild;
        rebuildBtn.title = canRebuild ? 'Rebuild this playlist in Curatorr' : 'This playlist does not support automatic rebuilding.';
      });
    }

    function updateSelectionSummary(el) {
      if (!el) return;
      updateSelectionButtons();
    }

    function buildPlaylistCard(data) {
      var card = document.createElement('div');
      card.className = 'plex-card cur-discover-result-card cur-playlist-carousel-card';
      card.setAttribute('role', 'button');
      card.setAttribute('tabindex', '0');
      card.dataset.plId = data.plexPlaylistId || '';
      card.dataset.plKey = data.playlistKey || '';
      card.dataset.plTitle = data.playlistTitle || 'Playlist';
      card.dataset.playlistKind = data.playlistKind || 'generated';
      card.dataset.playlistType = data.playlistType || 'custom';
      card.dataset.playlistState = data.plexPlaylistId ? 'synced' : 'pending';
      card.dataset.playlistTrackCount = String(Number(data.trackCount || 0));
      card.dataset.playlistUpdatedAt = String(Number(data.updatedAt || Date.now()));
      card.dataset.playlistArt = data.artPath || '';
      var isPersonal = data.playlistType === 'personal';
      var isGlobal = data.playlistType === 'global';
      var isDeletable = ['personal', 'global', 'custom'].indexOf(data.playlistType || '') !== -1;
      var editBtnHtml = isPersonal
        ? '<button class="pl-card-btn pl-card-btn--edit" type="button" title="Edit playlist"><img src="/icons/edit.svg" alt="Edit" style="display:block;width:18px;height:18px" /></button>'
        : (isGlobal ? '<button class="pl-card-btn pl-card-btn--edit pl-card-btn--edit-global" type="button" title="Edit playlist"><img src="/icons/edit.svg" alt="Edit" style="display:block;width:18px;height:18px" /></button>' : '');
      card.innerHTML =
        '<div class="plex-poster-wrap cur-discover-poster-wrap cur-playlist-carousel-poster-wrap">' +
          '<div class="plex-poster-well cur-discover-result-art cur-playlist-carousel-art' + (data.artPath ? '' : ' is-empty') + '">' +
            (data.artPath ? '<img src="' + ((_msType === 'jellyfin' || _msType === 'emby') ? '/api/ms/art?id=' + encodeURIComponent(data.artPath) + (data.artTag ? '&tag=' + encodeURIComponent(data.artTag) : '') : '/api/plex/art?path=' + encodeURIComponent(data.artPath)) + '" alt="" loading="lazy" onerror="this.parentElement.classList.add(\'is-empty\');this.remove()" />' : '') +
            (isDeletable ? '<label class="pl-card-checkbox-wrap" title="Select" onclick="event.stopPropagation()"><input type="checkbox" class="pl-card-checkbox" /><span class="pl-card-checkbox-ui"></span></label>' : '') +
            '<button class="pl-card-btn pl-card-btn--view" type="button" title="View playlist"><img src="/icons/view.svg" alt="View" style="display:block;width:23px;height:23px;filter:brightness(0) invert(1)" /></button>' +
            editBtnHtml +
            '<div class="pl-card-dots-wrap">' +
              '<button class="pl-card-btn pl-card-btn--dots" type="button" title="More options">⋯</button>' +
              '<div class="pl-card-menu" style="display:none">' +
                (isPersonal ? '<button type="button" class="pl-card-menu-edit">Edit</button>' : '') +
                (isGlobal ? '<button type="button" class="pl-card-menu-edit-global">Edit</button>' : '') +
                '<button type="button" class="pl-card-menu-rebuild">Rebuild</button>' +
                (isDeletable ? '<button type="button" class="pl-card-menu-delete">Delete</button>' : '') +
              '</div>' +
            '</div>' +
          '</div>' +
        '</div>' +
        '<div class="plex-footer cur-discover-result-main cur-playlist-carousel-main">' +
          '<div class="plex-name cur-discover-result-name cur-playlist-carousel-title">' + escHtml(data.playlistTitle || 'Playlist') + '</div>' +
          '<div class="plex-meta cur-discover-result-meta cur-playlist-carousel-meta">' + Number(data.trackCount || 0).toLocaleString() + ' tracks</div>' +
          '<div class="plex-meta cur-discover-result-meta cur-playlist-carousel-meta">Curatorr updated ' + escHtml(fmtShortDate(data.updatedAt || Date.now())) + '</div>' +
        '</div>';
      card.addEventListener('click', function() { selectPlaylist(card); });
      card.addEventListener('keydown', function(event) {
        if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); selectPlaylist(card); }
      });
      var editBtn = card.querySelector('.pl-card-btn--edit:not(.pl-card-btn--edit-global)');
      if (editBtn) editBtn.addEventListener('click', function(e) { e.stopPropagation(); openEditPlaylistModal(card); });
      var editGlobalBtn = card.querySelector('.pl-card-btn--edit-global');
      if (editGlobalBtn) editGlobalBtn.addEventListener('click', function(e) { e.stopPropagation(); openEditGlobalPlaylist(card); });
      var viewBtn2 = card.querySelector('.pl-card-btn--view');
      if (viewBtn2) viewBtn2.addEventListener('click', function(e) { e.stopPropagation(); selectPlaylist(card); });
      var dotsBtn = card.querySelector('.pl-card-btn--dots');
      if (dotsBtn) dotsBtn.addEventListener('click', function(e) { e.stopPropagation(); toggleCardMenu(dotsBtn); });
      var editMenuBtn = card.querySelector('.pl-card-menu-edit');
      if (editMenuBtn) editMenuBtn.addEventListener('click', function(e) { e.stopPropagation(); closeAllCardMenus(); openEditPlaylistModal(card); });
      var editGlobalMenuBtn = card.querySelector('.pl-card-menu-edit-global');
      if (editGlobalMenuBtn) editGlobalMenuBtn.addEventListener('click', function(e) { e.stopPropagation(); closeAllCardMenus(); openEditGlobalPlaylist(card); });
      var rebuildMenuBtn = card.querySelector('.pl-card-menu-rebuild');
      if (rebuildMenuBtn) rebuildMenuBtn.addEventListener('click', function(e) { e.stopPropagation(); rebuildCardPlaylist(card); });
      var deleteMenuBtn = card.querySelector('.pl-card-menu-delete');
      if (deleteMenuBtn) deleteMenuBtn.addEventListener('click', function(e) { e.stopPropagation(); deleteCardPlaylist(card); });
      var checkboxEl = card.querySelector('.pl-card-checkbox');
      if (checkboxEl) checkboxEl.addEventListener('change', function() { onCardCheckChange(checkboxEl); });
      return card;
    }

    function createPlaylist() {
      var title = (document.getElementById('newPlaylistTitle').value || '').trim();
      if (!title) return;
      var status = document.getElementById('newPlaylistStatus');
      status.textContent = 'Creating…';

      fetch('/api/music/playlists/custom', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
        body: JSON.stringify({ title: title }),
      }).then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.ok) throw new Error(data.error || 'Failed');
          var card = buildPlaylistCard({
            plexPlaylistId: data.plexPlaylistId,
            playlistKey: data.playlistKey,
            playlistTitle: data.playlistTitle,
            playlistKind: 'generated',
            playlistType: data.playlistType || 'custom',
            trackCount: 0,
            updatedAt: Date.now(),
            artPath: '',
          });
          document.getElementById('playlistCarouselTrack').appendChild(card);
          closeNewPlaylistDialog();
          document.getElementById('newPlaylistTitle').value = '';
          selectPlaylist(card);
        })
        .catch(function(err) {
          status.textContent = 'Error: ' + (err.message || 'Unknown');
        });
    }

    // ── Playlist selection ────────────────────────────────────────────────────

    function selectPlaylist(el) {
      var plId = el.getAttribute('data-pl-id') || '';
      var plKey = el.getAttribute('data-pl-key') || '';
      var title = el.getAttribute('data-pl-title') || '';
      _currentPlaylistKind = el.getAttribute('data-playlist-kind') || '';
      _currentPlaylistType = el.getAttribute('data-playlist-type') || '';
      document.querySelectorAll('#playlistCarouselTrack .cur-playlist-carousel-card').forEach(function(card) {
        card.classList.remove('is-active');
      });
      el.classList.add('is-active');
      _currentPlexId = plId || null;
      _currentPlexKey = plKey || null;
      updateSelectionSummary(el);
      // Generated playlist not yet synced to Plex — no ID to fetch tracks from
      if (!plId && plKey) {
        _allTracks = []; _offset = 0; _total = 0; _loading = false; _visibleTrackCount = 0;
        document.getElementById('trackList').innerHTML = '';
        document.getElementById('trackListLoading').style.display = 'none';
        document.getElementById('loadMoreWrap').style.display = 'none';
        var emptyEl = document.getElementById('trackListEmpty');
        emptyEl.textContent = 'Not yet synced to ' + MS_LABEL + '. It will be created automatically on the next scheduled run.';
        emptyEl.style.display = '';
        return;
      }
      reloadTracks();
    }

    function reloadTracks() {
      _trackLoadGeneration += 1;
      var generation = _trackLoadGeneration;
      _offset = 0;
      _total = 0;
      _loading = false;
      _loadingAllTracks = false;
      _loadingAllTracksPromise = null;
      _allTracks = [];
      _visibleTrackCount = 0;
      document.getElementById('trackList').innerHTML = '';
      document.getElementById('trackListEmpty').style.display = 'none';
      document.getElementById('trackListLoading').style.display = '';
      document.getElementById('loadMoreWrap').style.display = 'none';
      loadTracks(0, null, generation).then(function(data) {
        if (!data || generation !== _trackLoadGeneration) return;
        if (_offset < _total) ensureAllTracksLoaded('', { silent: true, generation: generation });
      });
    }

    // ── Track loading ─────────────────────────────────────────────────────────

    function loadTracks(offset, limitOverride, generationOverride) {
      if (_loading) return Promise.resolve();
      var generation = Number(generationOverride || _trackLoadGeneration);
      _loading = true;
      var limit = Math.max(1, Number(limitOverride || _pageSize));
      var url = '/api/music/playlist/tracks?offset=' + offset + '&limit=' + limit;
      if (_currentPlexId) url += '&plexPlaylistId=' + encodeURIComponent(_currentPlexId);
      return fetch(url)
        .then(function(r) { return r.json(); })
        .then(function(data) {
          _loading = false;
          if (generation !== _trackLoadGeneration) return data;
          document.getElementById('trackListLoading').style.display = 'none';

          if (!data.ok || !data.playlistTitle) {
            var emptyEl = document.getElementById('trackListEmpty');
            emptyEl.style.display = '';
            emptyEl.innerHTML = data.error
              ? 'Error loading tracks: ' + data.error
              : 'No playlist found. <a href="/wizard/user">Complete your personal setup</a> to create your playlist.';
            return data;
          }

          _total = data.total;
          _offset = offset + data.tracks.length;
          var selectedCard = document.querySelector('#playlistCarouselTrack .cur-playlist-carousel-card.is-active');
          if (selectedCard) {
            selectedCard.setAttribute('data-playlist-track-count', String(_total));
            // Sync the visible track count on the carousel card to match the actual Plex count
            var metaEl = selectedCard.querySelector('.cur-playlist-carousel-meta');
            if (metaEl) metaEl.textContent = Number(_total).toLocaleString() + ' tracks';
            updateSelectionSummary(selectedCard);
          }

          if (data.tracks.length === 0 && offset === 0) {
            document.getElementById('trackListEmpty').style.display = '';
            return data;
          }

          renderTracks(data.tracks, offset);

          return data;
        })
        .catch(function(err) {
          _loading = false;
          if (generation !== _trackLoadGeneration) return;
          document.getElementById('trackListLoading').style.display = 'none';
          document.getElementById('trackListEmpty').style.display = '';
          document.getElementById('trackListEmpty').textContent = 'Failed to load tracks: ' + err.message;
          console.error('Track load error:', err);
          throw err;
        });
    }

    function loadMore() {
      if (_offset >= _total) {
        var totalFiltered = getSortedFiltered().length;
        if (_visibleTrackCount < totalFiltered) {
          _visibleTrackCount = Math.min(totalFiltered, _visibleTrackCount + _pageSize);
          renderFiltered();
        }
        return;
      }
      loadTracks(_offset);
    }

    function loadAll() {
      ensureAllTracksLoaded('Loading full playlist…').then(function() {
        _visibleTrackCount = getSortedFiltered().length;
        renderFiltered();
      });
    }

    function ensureAllTracksLoaded(message, options) {
      options = options || {};
      var generation = Number(options.generation || _trackLoadGeneration);
      if (_loadingAllTracks && _loadingAllTracksPromise) return _loadingAllTracksPromise;
      if (_offset >= _total || _total === 0) return Promise.resolve();

      _loadingAllTracks = true;
      _loadingAllTracksPromise = Promise.resolve();
      var loadingEl = document.getElementById('trackListLoading');
      var loadMoreBtn = document.getElementById('loadMoreBtn');
      var loadAllBtn = document.getElementById('loadAllBtn');
      if (!options.silent && loadingEl) {
        loadingEl.textContent = message || 'Loading…';
        loadingEl.style.display = '';
      }
      if (!options.silent && loadMoreBtn) loadMoreBtn.disabled = true;
      if (!options.silent && loadAllBtn) loadAllBtn.disabled = true;

      function fetchNext() {
        if (generation !== _trackLoadGeneration) return Promise.resolve();
        if (_offset >= _total) return Promise.resolve();
        return loadTracks(_offset, 200, generation).then(fetchNext);
      }

      _loadingAllTracksPromise = fetchNext()
        .catch(function() {})
        .finally(function() {
          if (generation !== _trackLoadGeneration) return;
          _loadingAllTracks = false;
          _loadingAllTracksPromise = null;
          if (!options.silent && loadingEl) loadingEl.style.display = 'none';
          if (!options.silent && loadMoreBtn) loadMoreBtn.disabled = false;
          if (!options.silent && loadAllBtn) loadAllBtn.disabled = false;
        });
      return _loadingAllTracksPromise;
    }

    // ── Playlist actions ─────────────────────────────────────────────────────

    function rebuildCurrentPlaylist() {
      var card = document.querySelector('#playlistCarouselTrack .cur-playlist-carousel-card.is-active');
      if (card) rebuildCardPlaylist(card);
    }

    function rebuildCardPlaylist(card) {
      if (!card) return;
      closeAllCardMenus();
      var status = document.getElementById('syncStatus');
      var kind = card.dataset.playlistKind || '';
      var key = card.dataset.plKey || '';
      if (!canRebuildSelection(kind, card.dataset.playlistType || '')) {
        status.textContent = 'This playlist does not support rebuilding.';
        return;
      }
      status.textContent = 'Rebuilding…';
      fetch('/api/music/playlists/rebuild', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
        body: JSON.stringify({ playlistKind: kind, playlistKey: key }),
      })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.ok) {
            status.textContent = 'Rebuilt.';
            var reloadUrl = new URL(window.location.href);
            reloadUrl.searchParams.delete('blend');
            reloadUrl.searchParams.delete('name');
            window.location.href = reloadUrl.toString();
          }
          else { status.textContent = 'Error: ' + (data.error || 'Unknown'); }
        })
        .catch(function() { status.textContent = 'Network error.'; });
    }

    function deleteCardPlaylist(card) {
      if (!card) return;
      closeAllCardMenus();
      var playlistKey = card.dataset.plKey;
      var playlistTitle = card.dataset.plTitle;
      if (!playlistKey) return;
      if (!confirm('Delete "' + playlistTitle + '" from Curatorr and ' + MS_LABEL + '? This cannot be undone.')) return;
      fetch('/api/music/playlists/generated?playlistKey=' + encodeURIComponent(playlistKey), {
        method: 'DELETE',
        headers: { 'X-CSRF-Token': CSRF },
      })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.ok) { window.location.reload(); }
          else { alert('Could not delete: ' + (data.error || 'Unknown error')); }
        })
        .catch(function() { alert('Network error deleting playlist.'); });
    }

    function toggleCardMenu(btn) {
      var menu = btn.parentElement.querySelector('.pl-card-menu');
      if (!menu) return;
      var isOpen = menu.style.display !== 'none';
      closeAllCardMenus();
      if (!isOpen) menu.style.display = '';
    }

    function closeAllCardMenus() {
      document.querySelectorAll('.pl-card-menu').forEach(function(m) { m.style.display = 'none'; });
    }

    // ── Multi-select ──────────────────────────────────────────────────────────
    function onCardCheckChange(cb) {
      var card = cb.closest('.cur-playlist-carousel-card');
      if (cb.checked) { card.classList.add('is-selected'); } else { card.classList.remove('is-selected'); }
      updateSelectionBar();
    }

    function updateSelectionBar() {
      var selected = document.querySelectorAll('.pl-card-checkbox:checked');
      var bar = document.getElementById('plSelectionBar');
      var count = document.getElementById('plSelectionCount');
      if (selected.length) {
        bar.style.display = '';
        count.textContent = selected.length + ' selected';
      } else {
        bar.style.display = 'none';
      }
    }

    function clearCardSelection() {
      document.querySelectorAll('.pl-card-checkbox:checked').forEach(function(cb) {
        cb.checked = false;
        cb.closest('.cur-playlist-carousel-card').classList.remove('is-selected');
      });
      updateSelectionBar();
    }

    function deleteSelectedPlaylists() {
      var cards = Array.from(document.querySelectorAll('.pl-card-checkbox:checked'))
        .map(function(cb) { return cb.closest('.cur-playlist-carousel-card'); })
        .filter(function(card) {
          var t = card.dataset.playlistType || '';
          return ['personal', 'global', 'custom'].indexOf(t) !== -1;
        });
      if (!cards.length) return;
      var titles = cards.map(function(c) { return '"' + (c.dataset.plTitle || 'Playlist') + '"'; }).join(', ');
      if (!confirm('Delete ' + titles + ' from Curatorr and ' + MS_LABEL + '? This cannot be undone.')) return;
      var keys = cards.map(function(c) { return c.dataset.plKey; });
      Promise.all(keys.map(function(key) {
        return fetch('/api/music/playlists/generated?playlistKey=' + encodeURIComponent(key), {
          method: 'DELETE', headers: { 'X-CSRF-Token': CSRF },
        }).then(function(r) { return r.json(); });
      })).then(function() { window.location.reload(); }).catch(function() { alert('Error deleting playlists.'); });
    }

    function viewCurrentPlaylist() {
      if (!_currentPlexId || !PLEX_MACHINE_ID) return;
      var target = 'https://app.plex.tv/desktop/#!/server/' + encodeURIComponent(PLEX_MACHINE_ID) +
        '/details?key=' + encodeURIComponent('/playlists/' + _currentPlexId);
      window.open(target, '_blank', 'noopener');
    }

    function bindPlaylistCarousel() {
      var vp = document.getElementById('playlistCarouselViewport');
      var prev = document.getElementById('playlistCarouselPrev');
      var next = document.getElementById('playlistCarouselNext');
      if (!vp) {
        if (prev) prev.style.display = 'none';
        if (next) next.style.display = 'none';
        return;
      }
      function updateNav() {
        var maxLeft = Math.max(0, vp.scrollWidth - vp.clientWidth - 2);
        if (prev) prev.disabled = vp.scrollLeft <= 2;
        if (next) next.disabled = vp.scrollLeft >= maxLeft;
      }
      var down = false;
      var startX = 0;
      var startScroll = 0;
      var moved = false;
      vp.addEventListener('pointerdown', function(e) {
        if (e.pointerType === 'mouse') return;
        down = true;
        moved = false;
        startX = e.clientX;
        startScroll = vp.scrollLeft;
        vp.classList.add('is-dragging');
        if (vp.setPointerCapture) vp.setPointerCapture(e.pointerId);
      });
      vp.addEventListener('pointermove', function(e) {
        if (!down) return;
        var d = e.clientX - startX;
        if (Math.abs(d) > 6) moved = true;
        vp.scrollLeft = startScroll - d;
        updateNav();
      });
      function end(e) {
        if (!down) return;
        down = false;
        vp.classList.remove('is-dragging');
        updateNav();
        if (e && vp.releasePointerCapture) try { vp.releasePointerCapture(e.pointerId); } catch (_) {}
      }
      vp.addEventListener('pointerup', end);
      vp.addEventListener('pointercancel', end);
      vp.addEventListener('pointerleave', function(e) { if (e.pointerType !== 'mouse') end(e); });
      vp.addEventListener('click', function(e) {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
          moved = false;
        }
      }, true);
      vp.addEventListener('scroll', updateNav, { passive: true });
      if (prev) prev.addEventListener('click', function() {
        vp.scrollBy({ left: -Math.max(280, Math.floor(vp.clientWidth * 0.82)), behavior: 'smooth' });
        window.setTimeout(updateNav, 220);
      });
      if (next) next.addEventListener('click', function() {
        vp.scrollBy({ left: Math.max(280, Math.floor(vp.clientWidth * 0.82)), behavior: 'smooth' });
        window.setTimeout(updateNav, 220);
      });
      window.addEventListener('resize', updateNav);
      updateNav();
    }

    // ── Smart Playlist Modal ──────────────────────────────────────────────────

    var _spmPreviewTimer = null;

    var _spmEditId = null; // non-null when editing an existing personal playlist
    var SPM_FEATURE_PRESETS = {
      none: { bpmMin: '', bpmMax: '', energyMin: '', energyMax: '', danceabilityMin: '', danceabilityMax: '', camelotFocus: '', camelotMode: 'exact' },
      club: { bpmMin: '118', bpmMax: '132', energyMin: '0.70', energyMax: '', danceabilityMin: '0.55', danceabilityMax: '', camelotFocus: '', camelotMode: 'exact' },
      driving: { bpmMin: '110', bpmMax: '145', energyMin: '0.60', energyMax: '', danceabilityMin: '', danceabilityMax: '', camelotFocus: '', camelotMode: 'exact' },
      workout: { bpmMin: '124', bpmMax: '150', energyMin: '0.72', energyMax: '', danceabilityMin: '0.55', danceabilityMax: '', camelotFocus: '', camelotMode: 'exact' },
      chill: { bpmMin: '', bpmMax: '105', energyMin: '', energyMax: '0.45', danceabilityMin: '', danceabilityMax: '', camelotFocus: '', camelotMode: 'exact' },
      harmonic: { bpmMin: '', bpmMax: '', energyMin: '', energyMax: '', danceabilityMin: '', danceabilityMax: '', camelotFocus: '8A', camelotMode: 'harmonic' },
      downtempo: { bpmMin: '70', bpmMax: '100', energyMin: '', energyMax: '0.40', danceabilityMin: '', danceabilityMax: '0.65', camelotFocus: '', camelotMode: 'exact' },

    function getImportUrlSupportSummary() {
      var supported = [];
      if (SPOTIFY_CONFIGURED) supported.push('Spotify playlist links, URIs, and playlist ids');
      if (YOUTUBE_CONFIGURED) supported.push('YouTube playlist links and playlist ids');
      return supported.length ? supported.join('; ') : 'No URL providers are configured.';
    }

    function detectImportUrlProvider(value) {
      var raw = String(value || '').trim();
      if (!raw) return { provider: '', label: 'Auto-detecting', supported: false };
      if (/^spotify:playlist:/i.test(raw)) {
        return { provider: 'spotify', label: 'Spotify', supported: SPOTIFY_CONFIGURED };
      }
      if (/^(PL|LL|FL|UU|RD|OLAK5uy)[A-Za-z0-9_-]{10,}$/i.test(raw)) {
        return { provider: 'youtube', label: 'YouTube', supported: YOUTUBE_CONFIGURED };
      }
      if (/^[A-Za-z0-9]{20,}$/i.test(raw)) {
        return { provider: 'spotify', label: 'Spotify', supported: SPOTIFY_CONFIGURED };
      }
      try {
        var parsed = new URL(raw);
        var host = String(parsed.hostname || '').toLowerCase();
        if (host.endsWith('spotify.com')) return { provider: 'spotify', label: 'Spotify', supported: SPOTIFY_CONFIGURED };
        if (host.indexOf('youtube.com') !== -1 || host === 'youtu.be') return { provider: 'youtube', label: 'YouTube', supported: YOUTUBE_CONFIGURED };
        if (host.endsWith('music.apple.com')) return { provider: 'apple', label: 'Apple Music', supported: false };
        if (host.endsWith('deezer.com')) return { provider: 'deezer', label: 'Deezer', supported: false };
        if (host.indexOf('amazon.') !== -1) return { provider: 'amazon', label: 'Amazon Music', supported: false };
      } catch (_err) {}
      return { provider: 'unknown', label: 'Unsupported', supported: false };
    }

    function updateImportUrlProviderUI(value) {
      var badgeEl = document.getElementById('importUrlProviderBadge');
      var noteEl = document.getElementById('importUrlSupportNote');
      var info = detectImportUrlProvider(value);
      if (badgeEl) {
        badgeEl.textContent = info.label;
        badgeEl.classList.toggle('is-unsupported', Boolean(String(value || '').trim()) && !info.supported);
      }
      if (noteEl) {
        if (!String(value || '').trim()) noteEl.textContent = 'Supported URLs: ' + getImportUrlSupportSummary() + '.';
        else if (info.supported) noteEl.textContent = 'Supported now: ' + getImportUrlSupportSummary() + '.';
        else if (info.provider === 'youtube' || info.provider === 'apple' || info.provider === 'deezer' || info.provider === 'amazon') {
          noteEl.textContent = info.label + ' URLs are not supported yet. Supported now: ' + getImportUrlSupportSummary() + '.';
        } else {
          noteEl.textContent = 'Unsupported URL. Supported now: ' + getImportUrlSupportSummary() + '.';
        }
      }
    }

    function renderActiveImportSpotifyPreview() {
      var activeTab = (_importSourceTab === 'url' || _importSourceTab === 'lastfm' || _importSourceTab === 'listenbrainz')
        ? _importSourceTab
        : 'spotify';
      var selection = getImportSpotifySelectionForTab(activeTab);
      var preview = getImportSpotifyPreviewForTab(activeTab);
      var statusEl = document.getElementById('importSpotifyStatus');
      var previewEl = document.getElementById('importSpotifyPreview');
      var summaryEl = document.getElementById('importSpotifyPreviewSummary');
      var statsEl = document.getElementById('importSpotifyPreviewStats');
      var sectionsEl = document.getElementById('importSpotifyPreviewSections');
      var provider = String(selection && selection.provider || (activeTab === 'url' ? '' : activeTab)).trim().toLowerCase();
      var providerLabel = provider === 'youtube'
        ? 'YouTube'
        : (provider === 'lastfm' ? 'Last.fm' : (provider === 'listenbrainz' ? 'ListenBrainz' : 'Spotify'));
      if (!statusEl || !previewEl) return;
      if (!selection) {
        if (previewEl) previewEl.style.display = 'none';
        if (sectionsEl) sectionsEl.style.display = 'none';
        statusEl.textContent = getImportSpotifyIdleStatus(activeTab);
        return;
      }
      if (!preview) {
        if (previewEl) previewEl.style.display = 'none';
        if (sectionsEl) sectionsEl.style.display = 'none';
        statusEl.textContent = 'Checking local matches…';
        return;
      }
      if (summaryEl) {
        summaryEl.textContent = (preview.playlist && preview.playlist.name ? preview.playlist.name : selection.name) + ' by ' + (preview.playlist && preview.playlist.ownerName ? preview.playlist.ownerName : (selection.ownerName || providerLabel));
      }
      if (statsEl) {
        statsEl.textContent = Number(preview.totalSourceTracks || 0).toLocaleString() + ' source tracks • '
          + Number(preview.matchedCount || 0).toLocaleString() + ' matched • '
          + Number(preview.unmatchedCount || 0).toLocaleString() + ' unmatched'
          + (Number(preview.duplicateCount || 0) ? (' • ' + Number(preview.duplicateCount || 0).toLocaleString() + ' duplicates skipped') : '')
          + (preview.warning ? (' • shared URL preview limited') : '');
      }
      renderImportSpotifyPreviewDetails(preview);
      if (previewEl) previewEl.style.display = '';
      if (statusEl) {
        if (preview.warning) statusEl.textContent = preview.warning;
        else if (!Number(preview.totalSourceTracks || 0) && Number(selection.trackCount || 0) > 0) {
          statusEl.textContent = providerLabel + ' did not expose track details for this playlist.';
        } else if (!Number(preview.totalSourceTracks || 0)) statusEl.textContent = 'This ' + providerLabel + ' playlist is empty.';
        else if (!Number(preview.matchedCount || 0)) statusEl.textContent = 'No tracks from this ' + providerLabel + ' playlist matched your local library.';
        else statusEl.textContent = providerLabel + ' preview ready.';
      }
    }


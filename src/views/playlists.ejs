    function renderSpotifyPreviewSection(sectionId, listId, items, formatter, totalCount) {
      var sectionEl = document.getElementById(sectionId);
      var listEl = document.getElementById(listId);
      if (!sectionEl || !listEl) return;
      listEl.innerHTML = '';
      var safeItems = Array.isArray(items) ? items : [];
      if (!safeItems.length) {
        sectionEl.style.display = 'none';
        return;
      }
      safeItems.forEach(function(item) {
        var row = document.createElement('div');
        row.className = 'import-spotify-preview__item';
        row.innerHTML = formatter(item);
        listEl.appendChild(row);
      });
      if (Number(totalCount || 0) > safeItems.length) {
        var more = document.createElement('div');
        more.className = 'import-spotify-preview__more';
        more.textContent = '+' + (Number(totalCount || 0) - safeItems.length).toLocaleString() + ' more';
        listEl.appendChild(more);
      }
      sectionEl.style.display = '';
    }

    function renderImportSpotifyPreviewDetails(data) {
      var sectionsEl = document.getElementById('importSpotifyPreviewSections');
      if (!sectionsEl) return;
      renderSpotifyPreviewSection(
        'importSpotifyMatchedSection',
        'importSpotifyMatchedList',
        Array.isArray(data?.matched) ? data.matched.slice(0, 5) : [],
        function(item) {
          return '<div class="import-spotify-preview__item-title">' + escHtml(item.spotifyTitle || item.trackTitle || 'Matched track') + '</div>'
            + '<div class="import-spotify-preview__item-meta">'
            + escHtml((Array.isArray(item.spotifyArtists) ? item.spotifyArtists.join(', ') : '') || item.artistName || '')
            + (item.trackTitle && item.trackTitle !== item.spotifyTitle ? ' → ' + escHtml(item.trackTitle) : '')
            + (item.albumName ? ' • ' + escHtml(item.albumName) : '')
            + '</div>';
        },
        Number(data?.matchedCount || 0)
      );
      renderSpotifyPreviewSection(
        'importSpotifyUnmatchedArtistsSection',
        'importSpotifyUnmatchedArtistsList',
        Array.isArray(data?.unmatchedArtists) ? data.unmatchedArtists.slice(0, 6) : [],
        function(item) {
          var sampleTracks = Array.isArray(item.sampleTracks) ? item.sampleTracks : [];
          var sampleText = sampleTracks
            .map(function(track) {
              var title = String(track?.title || '').trim();
              var albumTitle = String(track?.albumTitle || '').trim();
              if (!title) return '';
              return title + (albumTitle ? ' (' + albumTitle + ')' : '');
            })
            .filter(Boolean)
            .join(' • ');
          var meta = Number(item.trackCount || 0).toLocaleString() + ' unmatched track' + (Number(item.trackCount || 0) === 1 ? '' : 's');
          if (sampleText) meta += ' • ' + sampleText;
          return '<div class="import-spotify-preview__item-title">' + escHtml(item.artistName || 'Unknown artist') + '</div>'
            + '<div class="import-spotify-preview__item-meta">' + escHtml(meta) + '</div>';
        },
        Number(data?.unmatchedArtistCount || 0)
      );
      renderSpotifyPreviewSection(
        'importSpotifyUnmatchedSection',
        'importSpotifyUnmatchedList',
        Array.isArray(data?.unmatched) ? data.unmatched.slice(0, 5) : [],
        function(item) {
          return '<div class="import-spotify-preview__item-title">' + escHtml(item.title || 'Unmatched track') + '</div>'
            + '<div class="import-spotify-preview__item-meta">'
            + escHtml(Array.isArray(item.artists) ? item.artists.join(', ') : '')
            + (item.albumTitle ? ' • ' + escHtml(item.albumTitle) : '')
            + '</div>';
        },
        Number(data?.unmatchedCount || 0)
      );
      renderSpotifyPreviewSection(
        'importSpotifyDuplicateSection',
        'importSpotifyDuplicateList',
        Array.isArray(data?.duplicateMatches) ? data.duplicateMatches.slice(0, 5) : [],
        function(item) {
          return '<div class="import-spotify-preview__item-title">' + escHtml(item.spotifyTitle || item.trackTitle || 'Duplicate match') + '</div>'
            + '<div class="import-spotify-preview__item-meta">'
            + escHtml((Array.isArray(item.spotifyArtists) ? item.spotifyArtists.join(', ') : '') || item.artistName || '')
            + (item.trackTitle && item.trackTitle !== item.spotifyTitle ? ' → ' + escHtml(item.trackTitle) : '')
            + '</div>';
        },
        Number(data?.duplicateCount || 0)
      );
      var hasVisibleSections = !!(
        (Array.isArray(data?.matched) && data.matched.length)
        || (Array.isArray(data?.unmatchedArtists) && data.unmatchedArtists.length)
        || (Array.isArray(data?.unmatched) && data.unmatched.length)
        || (Array.isArray(data?.duplicateMatches) && data.duplicateMatches.length)
      );
      sectionsEl.style.display = hasVisibleSections ? '' : 'none';
    }

    function loadImportSpotifyPreview(item, sourceTab) {
      var activeTab = (sourceTab === 'url' || sourceTab === 'lastfm' || sourceTab === 'listenbrainz') ? sourceTab : 'spotify';
      var statusEl = document.getElementById('importSpotifyStatus');
      var previewEl = document.getElementById('importSpotifyPreview');
      if (!item || !item.id) return;
      var provider = String(item.provider || (activeTab === 'url' ? '' : activeTab)).trim().toLowerCase() || 'spotify';
      setImportSpotifyPreviewForTab(activeTab, null);
      if (_importSourceTab === activeTab) {
        if (previewEl) previewEl.style.display = 'none';
        if (document.getElementById('importSpotifyPreviewSections')) document.getElementById('importSpotifyPreviewSections').style.display = 'none';
        if (statusEl) statusEl.textContent = 'Checking local matches…';
      }
      fetch(buildImportPreviewUrl(provider, item, activeTab))
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.ok) throw new Error(data.error || 'Failed to preview playlist.');
          setImportSpotifyPreviewForTab(activeTab, data);
          var selection = getImportSpotifySelectionForTab(activeTab);
          if (selection && !selection.name && data.playlist && data.playlist.name) {
            selection.name = data.playlist.name;
            selection.ownerName = data.playlist.ownerName || selection.ownerName || '';
            selection.trackCount = Number(data.playlistTrackCount || data.totalSourceTracks || 0);
            resetImportedTitleField();
            if (activeTab === 'spotify') renderImportSpotifySources();
          }
          if (_importSourceTab === activeTab) renderActiveImportSpotifyPreview();
          updateImportSubmitButton();
        })
        .catch(function(err) {
          setImportSpotifyPreviewForTab(activeTab, null);
          if (_importSourceTab === activeTab && statusEl) statusEl.textContent = 'Error: ' + (err.message || 'Unknown');
          updateImportSubmitButton();
        });
    }

    function submitImportPlex() {
      var titleInput = document.getElementById('importPlexTitle');
      var submitBtn = document.getElementById('importPlexSubmitBtn');
      var globalCheckbox = document.getElementById('importGlobalCheckbox');
      var makeGlobal = globalCheckbox && globalCheckbox.checked;
      var title = String(titleInput && titleInput.value || '').trim()
        || ((_importSourceTab === 'spotify' || _importSourceTab === 'url')
          ? (getImportSpotifySelectionForTab(_importSourceTab) && getImportSpotifySelectionForTab(_importSourceTab).name)
          : (_importSourceTab === 'lastfm'
            ? (_importLastfmSelection && _importLastfmSelection.title)
            : (_importSourceTab === 'listenbrainz'
              ? (_importListenbrainzSelection && _importListenbrainzSelection.title)
              : (_importPlexSelection && _importPlexSelection.title))))
        || 'Imported Playlist';
      if (_importSourceTab === 'spotify' || _importSourceTab === 'url') {
        var spotifySelection = getImportSpotifySelectionForTab(_importSourceTab);
        if (!spotifySelection) return;
        var spotifyStatusEl = document.getElementById('importSpotifyStatus');
        var provider = String(spotifySelection.provider || (_importSourceTab === 'url' ? '' : 'spotify')).trim().toLowerCase() || 'spotify';
        var providerLabel = provider === 'youtube' ? 'YouTube' : 'Spotify';
        submitBtn.disabled = true;
        if (spotifyStatusEl) spotifyStatusEl.textContent = 'Importing matched ' + providerLabel + ' tracks…';
        fetch(getUrlImportEndpoint(provider, 'import'), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
          body: JSON.stringify({
            playlistId: spotifySelection.id,
            title: title,
            audience: makeGlobal ? 'global' : 'personal',
            source: (_importSourceTab === 'url' && provider === 'spotify') ? 'url' : undefined,
          }),
        })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (!data.ok) throw new Error(data.error || 'Import failed.');
            var playlist = data.playlist || {};
            var card = buildPlaylistCard({
              plexPlaylistId: playlist.plexPlaylistId || '',
              playlistKey: playlist.playlistKey || '',
              playlistTitle: playlist.playlistTitle || title,
              playlistKind: 'generated',
              playlistType: 'custom',
              playlistAudience: data.audience === 'global' ? 'global' : 'imported',
              sourceType: playlist.sourceType || (provider === 'youtube' ? 'youtube-playlist' : 'spotify-playlist'),
              importedSyncPeriod: playlist.importedSyncPeriod || 'disabled',
              active: true,
              trackCount: Number(data.importedTrackCount || playlist.trackCount || 0),
              missingCount: Number(data.importedMissingCount || playlist.missingCount || 0),
              updatedAt: Number(playlist.updatedAt || playlist.lastSyncedAt || Date.now()),
              artPath: '',
            });
            insertPlaylistCardSorted(card);
            closeImportPlaylistModal();
            selectPlaylist(card);
          })
          .catch(function(err) {
            if (spotifyStatusEl) spotifyStatusEl.textContent = 'Error: ' + (err.message || 'Unknown');
          })
          .finally(function() {
            if ((_importSourceTab === 'spotify' || _importSourceTab === 'url') && getImportSpotifyPreviewForTab(_importSourceTab)) renderActiveImportSpotifyPreview();
            updateImportSubmitButton();

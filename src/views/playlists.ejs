              renderTierPills([['belter','Belter'],['decent','Decent'],['halfDecent','Half-Decent'],['skip','Skip'],['unplayed','Unplayed']], _wizardState.trackTiers, 'track-tier', 'Track tier') +
            '</div>' +
          '</div>' +
        '</div>' +
        '<div class="spm-wizard-subsection spm-wizard-accordion" style="margin-top:18px" data-accordion-kind="seasonal">' +

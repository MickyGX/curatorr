    function wizardPrefillFromPlaylist(playlist, playlistTarget) {
      var rules = playlist && playlist.rules ? playlist.rules : {};
      var trackFilters = wizardStarterTrackFilters(playlist && playlist.trackFilters);
      var target = playlistTarget || 'personal';
      if (target !== 'global' && Array.isArray(rules.blendUsers) && rules.blendUsers.length) target = 'blend';
      return {
        templateId: 'blank',
        name: String(playlist && playlist.name || '').trim(),
        nameManual: true,
        playlistTarget: target,
        rebuildSchedule: String(rules.rebuildSchedule || 'daily'),
        genres: normaliseUiTriState(rules.genres),
        moods: normaliseUiTriState(rules.moods),
        tags: normaliseUiTriState(rules.tags),
        artistTiers: normaliseUiTriState(rules.artistTiers),
        trackTiers: normaliseUiTriState(rules.trackTiers),
        featurePreset: wizardNormalizeStarterPreset(rules.featurePreset),
        bpmMin: rules.bpmMin != null ? rules.bpmMin : null,
        bpmMax: rules.bpmMax != null ? rules.bpmMax : null,
        energyMin: rules.energyMin != null ? rules.energyMin : null,
        energyMax: rules.energyMax != null ? rules.energyMax : null,
        danceabilityMin: rules.danceabilityMin != null ? rules.danceabilityMin : null,
        danceabilityMax: rules.danceabilityMax != null ? rules.danceabilityMax : null,
        camelotFocus: String(rules.camelotFocus || ''),
        camelotMode: String(rules.camelotMode || 'exact'),
        topNPerArtist: rules.topNPerArtist != null ? Number(rules.topNPerArtist) : null,
        maxTracks: rules.maxTracks != null ? Number(rules.maxTracks) : null,
        sortBy: String(rules.sortBy || 'ratingCount'),
        blendUsers: Array.isArray(rules.blendUsers) ? rules.blendUsers.slice() : [],
        blendMode: String(rules.blendMode || 'average'),
        seasonalGenres: Array.isArray(rules.seasonalGenres) ? rules.seasonalGenres.slice() : [],
        seasonalKeywords: Array.isArray(rules.seasonalKeywords) ? rules.seasonalKeywords.slice() : [],
        seasonalExcludeGenres: Array.isArray(rules.seasonalExcludeGenres) ? rules.seasonalExcludeGenres.slice() : [],
        seasonalExcludeKeywords: Array.isArray(rules.seasonalExcludeKeywords) ? rules.seasonalExcludeKeywords.slice() : [],
        seasonalGenresMode: rules.seasonalGenresMode === 'all' ? 'all' : 'any',
        seasonalKeywordsMode: rules.seasonalKeywordsMode === 'all' ? 'all' : 'any',
        includeFolders: trackFilters.includeFolders,
        excludeFolders: trackFilters.excludeFolders,
        advancedRules: trackFilters.rules,
        deduplicateByMbid: trackFilters.deduplicateByMbid,
      };
    }

    function openWizardEdit(kind, id, endpoint) {
      fetch(endpoint)
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.ok || !data.playlist) { alert('Could not load playlist data.'); return; }
          openSmartPlaylistWizard(
            wizardPrefillFromPlaylist(data.playlist, kind === 'global' ? 'global' : 'personal'),
            { editKind: kind, editId: id }
          );
        })
        .catch(function() { alert('Network error loading playlist.'); });
    }

    function openEditPlaylistModal(card) {
      if (!card) return;
      var key = card.dataset.plKey || '';
      var id = key.replace(/^personal:/, '');
      if (!id) return;
      openWizardEdit('personal', id, '/api/music/playlists/personal/' + encodeURIComponent(id));
    }

    function openEditGlobalPlaylist(card) {
      if (!card) return;
      var plKey = card.dataset.plKey || '';
      var gpId = plKey.replace(/^global:/, '');
      if (!gpId) return;
      openWizardEdit('global', gpId, '/api/playlists/global/' + encodeURIComponent(gpId));
    }

    function spmResetChips(containerId) {
      var container = document.getElementById(containerId);
      if (!container) return;
      container.querySelectorAll('.spm-chip').forEach(function(chip) {
        chip.dataset.state = 'neutral';
        chip.classList.remove('is-include', 'is-exclude');
      });
    }

    function spmResetFilters() {
      document.querySelectorAll('.spm-artist-tier').forEach(function(cb) { cb.checked = false; });
      document.querySelectorAll('.spm-track-tier').forEach(function(cb) { cb.checked = false; });
      spmResetChips('spm-genres-chips');
      spmResetChips('spm-moods-chips');
      spmResetChips('spm-tags-chips');
      if (window.spmSetBlendUsers) window.spmSetBlendUsers([], 'average');
      var blendModeDefault = document.querySelector('input[name="spm-blend-mode"][value="average"]');
      if (blendModeDefault) blendModeDefault.checked = true;
      spmApplyPresetDefaults('none');
      var topN = document.getElementById('spm-top-n');
      if (topN) topN.value = '';
      var maxT = document.getElementById('spm-max-tracks');
      if (maxT) maxT.value = '';
      var sortBy = document.getElementById('spm-sort-by');
      if (sortBy) sortBy.value = 'ratingCount';
      var rebSched = document.getElementById('spm-rebuild-schedule');
      if (rebSched) rebSched.value = 'daily';
      spmUpdateBlendVisibility();
    }

    function spmUpdateBlendVisibility() {
      var pickerRows = document.getElementById('spm-blend-picker-rows');
      var anyRows = pickerRows && pickerRows.querySelectorAll('.blend-slot').length > 0;
      var wrap = document.getElementById('spm-blend-mode-wrap');
      if (wrap) wrap.style.display = anyRows ? '' : 'none';
    }
    document.querySelectorAll('input[name="spm-blend-mode"]').forEach(function(r) {
      r.addEventListener('change', spmSchedulePreview);
    });

    // Blend picker initialisation
    (function() {
      var SPM_BLEND_USERS = <%- JSON.stringify((blendableUsers || []).map(function(u) { return { id: u.id, avatar: u.avatarUrl || u.avatar || '' }; })) %>;
      var slotsEl = document.getElementById('spm-blend-picker-rows');
      var addBtn = document.getElementById('spm-blend-add-btn');
      if (!slotsEl || !addBtn) return;

      function escH(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
      function avatarSrc(u) { return (u && u.avatar) || '/icons/user-profile.svg'; }

      function buildOptionsList(selId) {
        return SPM_BLEND_USERS.map(function(u) {
          return '<button class="blend-slot__option' + (u.id === selId ? ' is-active' : '') + '" type="button" data-uid="' + escH(u.id) + '">' +
            '<img class="blend-slot__opt-avatar" src="' + escH(avatarSrc(u)) + '" alt="" onerror="this.onerror=null;this.src=\'/icons/user-profile.svg\';" />' +
            '<span class="blend-slot__optname">' + escH(u.id) + '</span>' +
          '</button>';
        }).join('');
      }

      function spmCreateSlot(userId) {
        var user = SPM_BLEND_USERS.find(function(u) { return u.id === userId; }) || { id: userId, avatar: '' };
        var slot = document.createElement('div');
        slot.className = 'blend-slot';
        slot.dataset.uid = userId;
        slot.innerHTML =
          '<details class="blend-slot__menu">' +
            '<summary class="blend-slot__summary">' +
              '<img class="blend-slot__avatar" src="' + escH(avatarSrc(user)) + '" alt="" onerror="this.onerror=null;this.src=\'/icons/user-profile.svg\';" />' +
              '<span class="blend-slot__name">' + escH(user.id) + '</span>' +
              '<span class="blend-slot__chev" aria-hidden="true"></span>' +
            '</summary>' +
            '<div class="blend-slot__list">' + buildOptionsList(userId) + '</div>' +
          '</details>' +
          '<button class="blend-slot__remove" type="button" aria-label="Remove">×</button>';
        var menu = slot.querySelector('.blend-slot__menu');
        slot.querySelectorAll('.blend-slot__option').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var uid = btn.dataset.uid;
            var chosen = SPM_BLEND_USERS.find(function(u) { return u.id === uid; }) || { id: uid, avatar: '' };
            slot.dataset.uid = uid;
            slot.querySelector('.blend-slot__avatar').src = avatarSrc(chosen);
            slot.querySelector('.blend-slot__name').textContent = uid;
            slot.querySelectorAll('.blend-slot__option').forEach(function(b) { b.classList.toggle('is-active', b === btn); });
            menu.removeAttribute('open');
            spmUpdateBlendVisibility(); spmSchedulePreview();
          });
        });
        slot.querySelector('.blend-slot__remove').addEventListener('click', function() {
          slot.remove();
          spmUpdateBlendVisibility(); spmSchedulePreview();
        });
        document.addEventListener('click', function(e) { if (!slot.contains(e.target)) menu.removeAttribute('open'); });
        return slot;
      }

      window.spmGetBlendUsers = function() {
        return Array.from(slotsEl.querySelectorAll('.blend-slot')).map(function(s) { return s.dataset.uid; });
      };

      window.spmSetBlendUsers = function(userIds, mode) {
        slotsEl.innerHTML = '';
        (userIds || []).forEach(function(uid) { slotsEl.appendChild(spmCreateSlot(uid)); });
        if (mode) {
          var radio = document.querySelector('input[name="spm-blend-mode"][value="' + mode + '"]');
          if (radio) radio.checked = true;
        }
        spmUpdateBlendVisibility();
      };

      addBtn.addEventListener('click', function() {
        var first = SPM_BLEND_USERS[0];
        if (first) { slotsEl.appendChild(spmCreateSlot(first.id)); spmUpdateBlendVisibility(); spmSchedulePreview(); }
      });

      spmUpdateBlendVisibility();
    })();

    function spmApplyChips(containerId, triState) {
      // triState: flat string[] (legacy) or { include: [], exclude: [] }
      var container = document.getElementById(containerId);
      if (!container) return;
      var includeSet, excludeSet;
      if (Array.isArray(triState)) {
        includeSet = new Set(triState);
        excludeSet = new Set();
      } else {
        includeSet = new Set((triState && triState.include) || []);
        excludeSet = new Set((triState && triState.exclude) || []);
      }
      container.querySelectorAll('.spm-chip').forEach(function(chip) {
        var v = chip.dataset.value;
        if (includeSet.has(v)) {
          chip.dataset.state = 'include';
          chip.classList.add('is-include');
          chip.classList.remove('is-exclude');
        } else if (excludeSet.has(v)) {
          chip.dataset.state = 'exclude';
          chip.classList.add('is-exclude');
          chip.classList.remove('is-include');
        } else {
          chip.dataset.state = 'neutral';
          chip.classList.remove('is-include', 'is-exclude');
        }
      });
    }

    function spmApplyRules(rules) {
      var artistTierState = normaliseUiTriState(rules.artistTiers);
      var trackTierState = normaliseUiTriState(rules.trackTiers);
      if (artistTierState.include.length) {
        artistTierState.include.forEach(function(v) {
          var cb = document.querySelector('.spm-artist-tier[value="' + v + '"]');
          if (cb) cb.checked = true;
        });
      }
      if (trackTierState.include.length) {
        trackTierState.include.forEach(function(v) {
          var cb = document.querySelector('.spm-track-tier[value="' + v + '"]');
          if (cb) cb.checked = true;
        });
      }
      spmApplyChips('spm-genres-chips', rules.genres || []);
      spmApplyChips('spm-moods-chips',  rules.moods  || []);
      spmApplyChips('spm-tags-chips',   rules.tags   || []);
      if (window.spmSetBlendUsers) window.spmSetBlendUsers(rules.blendUsers || [], rules.blendMode || 'average');
      spmLoadFeatureRules(rules);
      spmUpdateBlendVisibility();
      var topN = document.getElementById('spm-top-n');
      if (topN) topN.value = rules.topNPerArtist || '';
      var maxT = document.getElementById('spm-max-tracks');
      if (maxT) maxT.value = rules.maxTracks || '';
      var sortBy = document.getElementById('spm-sort-by');
      if (sortBy && rules.sortBy) sortBy.value = rules.sortBy;
      var rebSched = document.getElementById('spm-rebuild-schedule');
      if (rebSched && rules.rebuildSchedule) rebSched.value = rules.rebuildSchedule;
    }

    function closeSmartPlaylistModal() {
      var modal = document.getElementById('smartPlModal');
      if (modal) modal.style.display = 'none';
      if (_spmPreviewTimer) { clearTimeout(_spmPreviewTimer); _spmPreviewTimer = null; }
      // Restore flat form visibility for next edit open
      document.getElementById('spm-flat-form').style.display = '';
      document.getElementById('spm-flat-footer').style.display = 'flex';
      document.getElementById('spm-wizard-body').style.display = 'none';
      document.getElementById('spm-wizard-footer').style.display = 'none';
      document.getElementById('spm-msg').textContent = '';
      document.getElementById('spm-create-btn').disabled = false;
      _spmEditId = null;
      _wizardEditKind = null;
      _wizardEditId = '';
      _wizardPendingPrefill = null;
    }

    function spmSubmit() {
      if (_spmEditId) { updateSmartPlaylist(); } else { createSmartPlaylist(); }
    }

    function updateSmartPlaylist() {
      var name = (document.getElementById('spm-name').value || '').trim();
      if (!name) { document.getElementById('spm-msg').textContent = 'Please enter a playlist name.'; return; }
      var rules = getSpmRules();
      var msg = document.getElementById('spm-msg');
      var btn = document.getElementById('spm-create-btn');
      btn.disabled = true;
      msg.textContent = 'Saving…';
      fetch('/api/music/playlists/personal/' + encodeURIComponent(_spmEditId), {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
        body: JSON.stringify(Object.assign({ name: name }, rules)),
      })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.ok) throw new Error(data.error || 'Failed');
          closeSmartPlaylistModal();
          window.location.reload();
        })
        .catch(function(err) {
          msg.textContent = 'Error: ' + (err.message || 'Unknown');
          btn.disabled = false;
        });
    }

    function spmReadChips(containerId) {
      var inc = [], exc = [];
      var container = document.getElementById(containerId);
      if (!container) return { include: inc, exclude: exc };
      container.querySelectorAll('.spm-chip').forEach(function(chip) {
        if (chip.dataset.state === 'include') inc.push(chip.dataset.value);
        else if (chip.dataset.state === 'exclude') exc.push(chip.dataset.value);
      });
      return { include: inc, exclude: exc };
    }

    function getSpmRules() {
      var artistTiers = Array.from(document.querySelectorAll('.spm-artist-tier:checked')).map(function(el) { return el.value; });
      var trackTiers = Array.from(document.querySelectorAll('.spm-track-tier:checked')).map(function(el) { return el.value; });
      var topN = parseInt(document.getElementById('spm-top-n').value, 10) || null;
      var maxTracks = parseInt(document.getElementById('spm-max-tracks').value, 10) || null;
      var rebuildSchedule = document.getElementById('spm-rebuild-schedule') ? document.getElementById('spm-rebuild-schedule').value : 'daily';
      var sortBy = document.getElementById('spm-sort-by').value || 'ratingCount';
      var blendUsers = (window.spmGetBlendUsers ? window.spmGetBlendUsers() : []);
      var blendModeEl = document.querySelector('input[name="spm-blend-mode"]:checked');
      var blendMode = blendModeEl ? blendModeEl.value : 'average';
      return {
        artistTiers: artistTiers,
        trackTiers: trackTiers,
        genres: spmReadChips('spm-genres-chips'),
        moods:  spmReadChips('spm-moods-chips'),
        tags:   spmReadChips('spm-tags-chips'),
        topNPerArtist: topN,
        maxTracks: maxTracks,
        sortBy: sortBy,
        rebuildSchedule: rebuildSchedule,
        blendUsers: blendUsers,
        blendMode: blendMode,
        featurePreset: document.getElementById('spm-feature-preset').value || 'none',
        bpmMin: document.getElementById('spm-bpm-min').value || null,
        bpmMax: document.getElementById('spm-bpm-max').value || null,
        energyMin: document.getElementById('spm-energy-min').value || null,
        energyMax: document.getElementById('spm-energy-max').value || null,
        danceabilityMin: document.getElementById('spm-danceability-min').value || null,
        danceabilityMax: document.getElementById('spm-danceability-max').value || null,
        camelotFocus: document.getElementById('spm-camelot-focus').value || '',
        camelotMode: document.getElementById('spm-camelot-mode').value || 'exact',
      };
    }

    function spmSchedulePreview() {
      if (_spmPreviewTimer) clearTimeout(_spmPreviewTimer);
      _spmPreviewTimer = setTimeout(spmRunPreview, 600);
    }

    function spmRunPreview() {
      if (_spmPreviewTimer) { clearTimeout(_spmPreviewTimer); _spmPreviewTimer = null; }
      var rules = getSpmRules();
      var params = new URLSearchParams();
      params.set('rules', JSON.stringify(rules));
      document.getElementById('spm-prev-artists').textContent = '…';
      document.getElementById('spm-prev-tracks').textContent = '…';
      document.getElementById('spm-feature-match-count').textContent = '…';
      fetch('/api/music/playlists/personal/preview?' + params.toString())
        .then(function(r) { return r.json(); })
        .then(function(data) {
          document.getElementById('spm-prev-artists').textContent = (data.artistCount || 0).toLocaleString();
          document.getElementById('spm-prev-tracks').textContent = (data.trackCount || 0).toLocaleString();
          document.getElementById('spm-feature-match-count').textContent = (data.featureTrackCount || 0).toLocaleString();
        })
        .catch(function() {
          document.getElementById('spm-prev-artists').textContent = '?';
          document.getElementById('spm-prev-tracks').textContent = '?';
          document.getElementById('spm-feature-match-count').textContent = '?';
        });
    }

    function createSmartPlaylist(nameOverride, rulesOverride, optionsOverride) {
      var name = nameOverride || (document.getElementById('spm-name').value || '').trim();
      var msg = document.getElementById('wiz-msg') || document.getElementById('spm-msg');
      var btn = document.getElementById('wiz-create-btn') || document.getElementById('spm-create-btn');
      if (!name) {
        if (msg) msg.textContent = 'Please enter a playlist name.';
        var nameInput = document.getElementById('wiz-finish-name') || document.getElementById('spm-name');
        if (nameInput) nameInput.focus();
        return;
      }
      var rules = rulesOverride || getSpmRules();
      var options = optionsOverride || {};
      var playlistTarget = options.playlistTarget || 'personal';
      var trackFilters = options.trackFilters || null;
      var editKind = options.editKind || _wizardEditKind || null;
      var editId = options.editId || _wizardEditId || '';
      var isEdit = Boolean(editKind && editId);
      var endpoint = isEdit
        ? (editKind === 'global'
          ? '/api/playlists/global/' + encodeURIComponent(editId)
          : '/api/music/playlists/personal/' + encodeURIComponent(editId))
        : (playlistTarget === 'global' ? '/api/playlists/global' : '/api/music/playlists/personal');
      var payload = Object.assign({ name: name }, rules);
      if (trackFilters || isEdit) payload.trackFilters = trackFilters || { includeFolders: [], excludeFolders: [], deduplicateByMbid: false, rules: [] };
      if (btn) btn.disabled = true;
      if (msg) msg.textContent = isEdit ? 'Saving…' : 'Creating…';
      fetch(endpoint, {
        method: isEdit ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': CSRF },
        body: JSON.stringify(payload),
      })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.ok) throw new Error(data.error || 'Failed');
          if (isEdit) {
            closeSmartPlaylistModal();
            window.location.reload();
            return;
          }
          var playlist = data.playlist || {};
          var isGlobal = playlistTarget === 'global';
          var card = buildPlaylistCard({
            plexPlaylistId: data.plexPlaylistId || '',
            playlistKey: data.playlistKey || (isGlobal ? 'global:' + String(playlist.id || '') : 'personal:' + String(playlist.id || '')),
            playlistTitle: data.playlistTitle || playlist.name || name,
            playlistKind: 'generated',
            playlistType: isGlobal ? 'global' : 'personal',
            trackCount: 0,
            updatedAt: playlist.createdAt || Date.now(),
            artPath: '',
          });
          var carouselTrack = document.getElementById('playlistCarouselTrack');
          if (carouselTrack) carouselTrack.appendChild(card);
          closeSmartPlaylistModal();
          selectPlaylist(card);
        })
        .catch(function(err) {
          if (msg) msg.textContent = 'Error: ' + (err.message || 'Unknown');
          if (btn) btn.disabled = false;
        });
    }


      })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data.ok) throw new Error(data.error || 'Failed to add selected artists to the Lidarr queue.');
          _importedMissingState.rows = Array.isArray(data.rows) ? data.rows : [];
          _importedMissingState.selectedCount = Number(data.selectedCount || 0);

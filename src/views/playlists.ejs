          '<div class="spm-tristate-chips" id="wiz-chips-' + kind + '">';
        var incSet = new Set(triState.include || []);
        var excSet = new Set(triState.exclude || []);
        values.forEach(function(v) {
          var state = incSet.has(v) ? 'include' : excSet.has(v) ? 'exclude' : 'neutral';
          var cls = state === 'include' ? ' is-include' : state === 'exclude' ? ' is-exclude' : '';
          s += '<button type="button" class="spm-chip' + cls + '" data-kind="' + kind + '" data-value="' + escH(v) + '" data-state="' + state + '">' + escH(v) + '</button>';
        });
        s += '</div><div class="spm-chip-hint">None selected = include all</div></div></div>';
        return s;
      }

      function renderSeasonalChips(items, stateObj, kind, title, placeholderSearch, mode) {

    function wizardApplyPresetValues(state, presetId, overwrite) {
      var nextValues = wizardPresetValues(presetId);
      Object.keys(nextValues).forEach(function(key) {
        if (overwrite || state[key] == null || state[key] === '') state[key] = nextValues[key];
      });

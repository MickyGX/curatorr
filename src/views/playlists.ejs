    function wizardAudioProfileContentDefaults(presetId) {
      return WIZARD_FEATURE_PRESET_CONTENT[presetId || 'none'] || WIZARD_FEATURE_PRESET_CONTENT.none;
    }

    function wizardUpdateContentStateWithSuggestedValues(currentState, defaultsState, shouldApply) {
      var triState = normaliseUiTriState(currentState);
      var includeSet = new Set(triState.include || []);
      var excludeSet = new Set(triState.exclude || []);
      var suggestedInclude = defaultsState && defaultsState.include ? defaultsState.include : [];
      var suggestedExclude = defaultsState && defaultsState.exclude ? defaultsState.exclude : [];
      suggestedInclude.forEach(function(value) {
        if (shouldApply) {
          includeSet.add(value);
          excludeSet.delete(value);
        } else {
          includeSet.delete(value);
        }
      });
      suggestedExclude.forEach(function(value) {
        if (shouldApply) {
          excludeSet.add(value);
          includeSet.delete(value);
        } else {
          excludeSet.delete(value);
        }
      });
      return {
        include: Array.from(includeSet),
        exclude: Array.from(excludeSet),
        includeMode: triState.includeMode === 'all' ? 'all' : 'any',
      };
    }

    function wizardSuggestedContentApplied(state, presetId) {
      var defaults = wizardAudioProfileContentDefaults(presetId);
      var kinds = ['genres', 'moods', 'tags', 'decades'];
      var hasSuggestions = false;
      return kinds.every(function(kind) {
        var suggested = defaults[kind] || { include: [], exclude: [] };
        var triState = normaliseUiTriState(state && state[kind]);
        var includeSet = new Set(triState.include || []);
        var excludeSet = new Set(triState.exclude || []);
        var suggestedInclude = suggested.include || [];
        var suggestedExclude = suggested.exclude || [];
        if (suggestedInclude.length || suggestedExclude.length) hasSuggestions = true;
        return suggestedInclude.every(function(value) {
          return includeSet.has(value) && !excludeSet.has(value);
        }) && suggestedExclude.every(function(value) {
          return excludeSet.has(value) && !includeSet.has(value);
        });
      }) && hasSuggestions;
    }

    function wizardToggleContentStateFromAudioProfile(state, presetId) {
      var defaults = wizardAudioProfileContentDefaults(presetId);
      var shouldApply = !wizardSuggestedContentApplied(state, presetId);
      state.genres = wizardUpdateContentStateWithSuggestedValues(state.genres, defaults.genres, shouldApply);
      state.moods = wizardUpdateContentStateWithSuggestedValues(state.moods, defaults.moods, shouldApply);
      state.tags = wizardUpdateContentStateWithSuggestedValues(state.tags, defaults.tags, shouldApply);
      return shouldApply;
    }

    function wizardHasImportedContentSet(contentSet) {
      var detected = contentSet;
      if (!detected || typeof detected !== 'object') return false;
      return ['genres', 'moods', 'albumGenres', 'albumStyles', 'albumMoods', 'tags', 'decades'].some(function(kind) {
        return normaliseUiTriState(detected[kind]).include.length > 0;
      });
    }

    function wizardHasImportedSuggestedContent(state) {
      return wizardHasImportedContentSet(state && state.importSuggestedContent);
    }

    function wizardHasImportedDetectedContent(state) {
      return wizardHasImportedContentSet(state && state.importDetectedContent);

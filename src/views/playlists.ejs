        '</div>';
      html += renderSourceSection(
        wizardMediaServerMetadataLabel(),
        escH(mediaServerLabel) + ' metadata shapes the pool here. Track and album metadata are kept separate so you can decide whether to filter by song-level or release-level signals.',
        mediaServerBody,
      );

      function renderTierPills(items, stateObj, kind, title) {
        var triState = normaliseUiTriState(stateObj);

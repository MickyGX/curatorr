        renderWizChips(ALLALBUMSTYLES, _wizardState.albumStyles, 'album-styles', 'Filter album styles…') +
        renderWizChips(ALLALBUMMOODS, _wizardState.albumMoods, 'album-moods', 'Filter album moods…') +

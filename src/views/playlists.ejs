          ? (ws.popularityPercent ? ('Top ' + escH(String(ws.popularityPercent)) + '% by popularity') : 'Custom percentile')
          : (ws.popularityMode === 'top50' ? 'Top 50% by popularity'
            : ws.popularityMode === 'top25' ? 'Top 25% by popularity'
            : ws.popularityMode === 'top10' ? 'Top 10% by popularity'
            : 'Top 5% by popularity');
        html += row('Overall popularity', popularityLabel);
      }
      if (ws.deduplicateByMbid) html += row('Deduplicate releases', 'MusicBrainz recording ID');
      if (ws.deduplicateByArtistTitle) html += row('Deduplicate release variants', 'Artist + fuzzy song title');
      if (ws.deduplicateByDuration) html += row('Dedupe duration guard', 'Within 5 seconds');
      if (ws.deduplicateIgnoreLikelyVariants) html += row('Dedupe variant guard', 'Keep live/demo/remix-style versions');
      if (ws.deduplicateIgnoreLiveAlbums) html += row('Dedupe album guard', 'Keep live album/subformat tracks');
      html += row('Sort by', escH(ws.sortBy || 'ratingCount'));
      if (ws.finalOrdering && ws.finalOrdering !== 'none') html += row('Final ordering', escH(wizardFinalOrderingLabel(ws.finalOrdering)));
      html += '</div>';
      if (selectedTemplate) {
        html += '<div class="spm-wizard-subsection">';
        html += '<div class="spm-wizard-subsection-title">Selected saved template</div>';
        html += '<div class="spm-wizard-subsection-copy">This playlist started from a saved template. Rename it, overwrite it with the current rules, or delete it.</div>';
        html += '<div class="spm-wizard-save-tmpl-row">' +
          '<input type="text" id="wiz-selected-tmpl-name" class="spm-wizard-save-tmpl-input" placeholder="Template name" value="' + escH(selectedTemplate.name || '') + '" />' +
          '<button class="btn btn-ghost" type="button" id="wiz-update-tmpl-btn" style="white-space:nowrap">Update template</button>' +
          '<button class="btn btn-ghost" type="button" id="wiz-delete-tmpl-btn" style="white-space:nowrap">Delete</button>' +
          '</div>';
        html += '</div>';
      }
      html += '<div class="spm-wizard-subsection">';
      html += '<div class="spm-wizard-subsection-title">Save as new template</div>';
      html += '<div class="spm-wizard-subsection-copy">Save this rule set under a new name so it appears in the saved templates list next time.</div>';
      html += '<div class="spm-wizard-save-tmpl-row">' +
        '<input type="text" id="wiz-tmpl-name" class="spm-wizard-save-tmpl-input" placeholder="Save these rules as a template (optional name)…" />' +
        '<button class="btn btn-ghost" type="button" id="wiz-save-tmpl-btn" style="white-space:nowrap">Save template</button>' +
        '</div>';
      html += '</div>';
      return html;
    }

    function wizardSaveStateFromStep(step) {
      if (step === 1) {
        var targetEl = document.querySelector('#spm-wizard-body .spm-wizard-choice-card.is-selected');
        if (targetEl) _wizardState.playlistTarget = targetEl.dataset.target || 'personal';
        var selectedSavedTemplate = document.querySelector('#spm-wizard-body [data-user-template-id].is-selected');
        var selectedStartingPoint = document.querySelector('#spm-wizard-body [data-starting-point-id].is-selected');
        _wizardState.startingPointId = selectedStartingPoint ? (selectedStartingPoint.dataset.startingPointId || 'blank') : 'blank';
        _wizardState.templateId = selectedSavedTemplate
          ? (selectedSavedTemplate.dataset.userTemplateId || 'blank')
          : (_wizardState.startingPointId || 'blank');
        var selPreset = document.querySelector('#spm-wizard-body [data-audio-preset].is-selected');
        _wizardState.featurePreset = selPreset ? (selPreset.dataset.audioPreset || 'none') : 'none';
        _wizardState.bpmMin          = document.getElementById('wiz-bpm-min') ? document.getElementById('wiz-bpm-min').value || null : null;
        _wizardState.bpmMax          = document.getElementById('wiz-bpm-max') ? document.getElementById('wiz-bpm-max').value || null : null;
        _wizardState.energyMin       = document.getElementById('wiz-energy-min') ? document.getElementById('wiz-energy-min').value || null : null;
        _wizardState.energyMax       = document.getElementById('wiz-energy-max') ? document.getElementById('wiz-energy-max').value || null : null;
        _wizardState.danceabilityMin = document.getElementById('wiz-dance-min') ? document.getElementById('wiz-dance-min').value || null : null;
        _wizardState.danceabilityMax = document.getElementById('wiz-dance-max') ? document.getElementById('wiz-dance-max').value || null : null;
        _wizardState.camelotFocus    = document.getElementById('wiz-camelot-focus') ? document.getElementById('wiz-camelot-focus').value : '';
        _wizardState.camelotMode     = document.getElementById('wiz-camelot-mode') ? document.getElementById('wiz-camelot-mode').value : 'exact';
        var blendRadio = document.querySelector('input[name="wiz-blend-mode"]:checked');
        if (blendRadio) _wizardState.blendMode = blendRadio.value;
        if (window._wizGetBlendUsers) _wizardState.blendUsers = window._wizGetBlendUsers();
        wizardSyncSuggestedName(_wizardState, false);
      } else if (step === 2) {
        ['genre','mood','album-genres','album-styles','album-moods','tag','decade','seasonal-genre','seasonal-keyword','artist-tier','track-tier'].forEach(function(kind) {
          var inc = [], exc = [];
          var seen = new Set();
          var selectedModeBtn = document.querySelector('[data-match-mode-kind="' + kind + '"].is-selected');
          var selectedMode = selectedModeBtn && selectedModeBtn.dataset.matchModeValue === 'all' ? 'all' : 'any';
          document.querySelectorAll('#wiz-chips-' + kind + ' .spm-chip').forEach(function(chip) {
            seen.add(chip.dataset.value);
            if (chip.dataset.state === 'include') inc.push(chip.dataset.value);
            else if (chip.dataset.state === 'exclude') exc.push(chip.dataset.value);
          });
          if (kind === 'seasonal-genre' || kind === 'seasonal-keyword') {
            var incKey = kind === 'seasonal-genre' ? 'seasonalGenres' : 'seasonalKeywords';
            var excKey = kind === 'seasonal-genre' ? 'seasonalExcludeGenres' : 'seasonalExcludeKeywords';
            var modeKey = kind === 'seasonal-genre' ? 'seasonalGenresMode' : 'seasonalKeywordsMode';
            (_wizardState[incKey] || []).forEach(function(value) {
              if (!seen.has(value) && inc.indexOf(value) === -1) inc.push(value);
            });
            (_wizardState[excKey] || []).forEach(function(value) {
              if (!seen.has(value) && exc.indexOf(value) === -1) exc.push(value);
            });
            _wizardState[incKey] = inc;
            _wizardState[excKey] = exc;
            _wizardState[modeKey] = selectedMode;
            return;
          }
          if (kind === 'artist-tier' || kind === 'track-tier') {
            var tierKey = kind === 'artist-tier' ? 'artistTiers' : 'trackTiers';
            var prevTier = normaliseUiTriState(_wizardState[tierKey]);
            prevTier.include.forEach(function(value) {
              if (!seen.has(value) && inc.indexOf(value) === -1) inc.push(value);
            });
            prevTier.exclude.forEach(function(value) {
              if (!seen.has(value) && exc.indexOf(value) === -1) exc.push(value);
            });
            _wizardState[tierKey] = { include: inc, exclude: exc, includeMode: 'any' };
            return;
          }
          var key = kind === 'genre'
            ? 'genres'
            : kind === 'mood'
              ? 'moods'
              : kind === 'album-genres'
                ? 'albumGenres'
                : kind === 'album-styles'
                  ? 'albumStyles'
                  : kind === 'album-moods'
                    ? 'albumMoods'
                    : kind === 'decade'
                      ? 'decades'
                      : 'tags';
          var prev = normaliseUiTriState(_wizardState[key]);
          (prev.include || []).forEach(function(value) {
            if (!seen.has(value) && inc.indexOf(value) === -1) inc.push(value);
          });
          (prev.exclude || []).forEach(function(value) {
            if (!seen.has(value) && exc.indexOf(value) === -1) exc.push(value);
          });
          _wizardState[key] = { include: inc, exclude: exc, includeMode: selectedMode || prev.includeMode || 'any' };
        });
        _wizardState.lastPlayedMode = document.getElementById('wiz-last-played-mode')
          ? (document.getElementById('wiz-last-played-mode').value || 'any')
          : 'any';
        _wizardState.lastPlayedDays = parseInt(document.getElementById('wiz-last-played-days')
          ? document.getElementById('wiz-last-played-days').value
          : '', 10) || null;
        if (_wizardState.lastPlayedMode !== 'within' && _wizardState.lastPlayedMode !== 'notWithin') {
          _wizardState.lastPlayedDays = null;
        }
      } else if (step === 3) {
        _wizardState.topNPerArtist = parseInt(document.getElementById('wiz-top-n') ? document.getElementById('wiz-top-n').value : '', 10) || null;
        _wizardState.maxTracksPerAlbum = parseInt(document.getElementById('wiz-max-album-tracks') ? document.getElementById('wiz-max-album-tracks').value : '', 10) || null;
        _wizardState.maxTracks     = parseInt(document.getElementById('wiz-max-tracks') ? document.getElementById('wiz-max-tracks').value : '', 10) || null;
        _wizardState.albumPopularityMode = document.getElementById('wiz-album-popularity') ? document.getElementById('wiz-album-popularity').value : 'all';
        _wizardState.popularityMode = document.getElementById('wiz-popularity-mode') ? document.getElementById('wiz-popularity-mode').value : 'all';
        _wizardState.popularityPercent = parseInt(document.getElementById('wiz-popularity-percent') ? document.getElementById('wiz-popularity-percent').value : '', 10) || null;
        _wizardState.sortBy        = document.getElementById('wiz-sort-by') ? document.getElementById('wiz-sort-by').value : 'ratingCount';
        _wizardState.finalOrdering = document.getElementById('wiz-final-ordering') ? document.getElementById('wiz-final-ordering').value : 'none';
        _wizardState.deduplicateByMbid = !!(document.getElementById('wiz-dedupe-mbid') && document.getElementById('wiz-dedupe-mbid').checked);
        _wizardState.deduplicateByArtistTitle = !!(document.getElementById('wiz-dedupe-artist-title') && document.getElementById('wiz-dedupe-artist-title').checked);
        _wizardState.deduplicateByDuration = !!(document.getElementById('wiz-dedupe-duration') && document.getElementById('wiz-dedupe-duration').checked);
        _wizardState.deduplicateIgnoreLikelyVariants = !!(document.getElementById('wiz-dedupe-variant-guard') && document.getElementById('wiz-dedupe-variant-guard').checked);
        _wizardState.deduplicateIgnoreLiveAlbums = !!(document.getElementById('wiz-dedupe-live-album-guard') && document.getElementById('wiz-dedupe-live-album-guard').checked);
      } else if (step === 4 && IS_ACTUAL_ADMIN) {
        ['include', 'exclude'].forEach(function(kind) {
          var container = document.getElementById('wiz-folder-' + kind + '-chips');
          var values = container ? Array.from(container.querySelectorAll('[data-folder]')).map(function(chip) { return chip.dataset.folder; }) : [];
          if (kind === 'include') _wizardState.includeFolders = values;
          else _wizardState.excludeFolders = values;
        });
        _wizardState.advancedRules = Array.from(document.querySelectorAll('#wiz-regex-rules .spm-wizard-regex-row')).map(function(row) {
          var field = row.querySelector('.wiz-regex-field') ? row.querySelector('.wiz-regex-field').value : 'trackTitle';
          return {
            field: field,
            operator: wizardNormalizeTrackRuleOperator(field, row.querySelector('.wiz-regex-operator') ? row.querySelector('.wiz-regex-operator').value : 'regex'),
            value: row.querySelector('.wiz-regex-value') ? row.querySelector('.wiz-regex-value').value.trim() : '',
            caseSensitive: !!(row.querySelector('.wiz-regex-case') && row.querySelector('.wiz-regex-case').checked),
          };
        });
      } else if (step === WIZARD_TOTAL_STEPS) {
        var finishNameEl = document.getElementById('wiz-finish-name');
        if (finishNameEl) _wizardState.name = finishNameEl.value.trim();
        var schedEl = document.getElementById('wiz-schedule');
        if (schedEl) _wizardState.rebuildSchedule = schedEl.value;
        var artworkModeEl = document.getElementById('wiz-artwork-mode');
        if (artworkModeEl) _wizardState.artworkMode = artworkModeEl.value || 'auto';
        var keepImportedEl = document.getElementById('wiz-keep-imported-source');
        if (keepImportedEl) _wizardState.keepImportedSource = !!keepImportedEl.checked;
      }
    }

    function wizardRunPreview() {
      try { wizardSaveStateFromStep(_wizardState.step || 1); } catch (_) {}
      var request = wizardBuildPreviewRequest(25);
      var atEl = document.getElementById('wiz-prev-artists');
      var trEl = document.getElementById('wiz-prev-tracks');
      var eatEl = document.getElementById('wiz-prev-eligible-artists');
      var etrEl = document.getElementById('wiz-prev-eligible-tracks');
      var dedupeReportEl = document.getElementById('wiz-dedupe-report');
      var dedupeCountEl = document.getElementById('wiz-dedupe-count');
      var dedupeNoteEl = document.getElementById('wiz-dedupe-sample-note');
      var previewSeq = ++_wizardPreviewSeq;
      _wizardAudioPreview.loading = true;
      _wizardAudioPreview.error = false;
      _wizardDedupePreview = { count: 0, matches: [] };
      if (atEl) atEl.textContent = '…';
      if (trEl) trEl.textContent = '…';
      if (eatEl) eatEl.textContent = '…';
      if (etrEl) etrEl.textContent = '…';
      if (dedupeReportEl) dedupeReportEl.style.display = 'none';
      wizardRefreshAudioProfileStatus();
      fetch(request.endpoint + '?' + request.params.toString())
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (previewSeq !== _wizardPreviewSeq) return;
          var counts = request.isGlobal ? (data.forUser || data.average || { artistCount: 0, trackCount: 0 }) : data;
          var dedupeCount = Number(data.dedupeDuplicateCount || 0) || 0;
          var dedupeMatches = Array.isArray(data.dedupeDuplicateMatches) ? data.dedupeDuplicateMatches : [];
          if (atEl) atEl.textContent = (counts.artistCount || 0).toLocaleString();
          if (trEl) trEl.textContent = (counts.trackCount || 0).toLocaleString();
          if (eatEl) eatEl.textContent = (counts.eligibleArtistCount || counts.artistCount || 0).toLocaleString();
          if (etrEl) etrEl.textContent = (counts.eligibleTrackCount || counts.trackCount || 0).toLocaleString();
          _wizardDedupePreview = { count: dedupeCount, matches: dedupeMatches };
          if (dedupeReportEl) dedupeReportEl.style.display = dedupeCount > 0 ? '' : 'none';
          if (dedupeCountEl) dedupeCountEl.textContent = dedupeCount.toLocaleString();
          if (dedupeNoteEl) {
            dedupeNoteEl.textContent = dedupeCount > dedupeMatches.length
              ? 'preview loaded ' + dedupeMatches.length.toLocaleString() + '; CSV fetches up to 10,000'
              : '';
          }
          _wizardAudioPreview.loading = false;
          _wizardAudioPreview.error = false;
          _wizardAudioPreview.matchingTrackCount = Number(counts.eligibleTrackCount || counts.trackCount || 0);
          wizardRefreshAudioProfileStatus();
          wizardRefreshDraftAction();
        })
        .catch(function() {
          if (previewSeq !== _wizardPreviewSeq) return;
          if (atEl) atEl.textContent = '?';
          if (trEl) trEl.textContent = '?';
          if (eatEl) eatEl.textContent = '?';
          if (etrEl) etrEl.textContent = '?';
          if (dedupeReportEl) dedupeReportEl.style.display = 'none';
          _wizardAudioPreview.loading = false;
          _wizardAudioPreview.error = true;
          _wizardAudioPreview.matchingTrackCount = null;
          wizardRefreshAudioProfileStatus();
          wizardRefreshDraftAction();
        });
    }

    function wizardBuildPreviewRequest(dedupeReportLimit) {
      var rules = wizardAssembleRules(_wizardState);
      var trackFilters = wizardAssembleTrackFilters(_wizardState);
      var target = _wizardState.playlistTarget || 'personal';
      var isGlobal = target === 'global' && IS_ACTUAL_ADMIN;
      var endpoint = isGlobal ? '/api/playlists/global/preview' : '/api/music/playlists/personal/preview';
      var params = new URLSearchParams();
      params.set('rules', JSON.stringify(rules));
      if (trackFilters) params.set('trackFilters', JSON.stringify(trackFilters));
      if (isGlobal && CURRENT_USER_ID) params.set('userId', CURRENT_USER_ID);
      if (dedupeReportLimit != null) params.set('dedupeReportLimit', String(dedupeReportLimit));
      return { endpoint: endpoint, params: params, isGlobal: isGlobal };
    }

    function wizardCsvCell(value) {
      var text = String(value == null ? '' : value);
      return /[",\n\r]/.test(text) ? '"' + text.replace(/"/g, '""') + '"' : text;
    }

    function wizardFormatDurationMs(ms) {
      var totalSeconds = Math.round((Number(ms || 0) || 0) / 1000);
      if (!totalSeconds) return '';
      var minutes = Math.floor(totalSeconds / 60);
      var seconds = totalSeconds % 60;
      return minutes + ':' + String(seconds).padStart(2, '0');
    }

    function wizardDedupeMatchesToCsv(matches) {
      var headers = [
        'method','reason','key',
        'kept_rating_key','kept_artist','kept_title','kept_album','kept_album_type','kept_recording_mbid','kept_duration','kept_rating_count','kept_view_count','kept_file_path',
        'duplicate_rating_key','duplicate_artist','duplicate_title','duplicate_album','duplicate_album_type','duplicate_recording_mbid','duplicate_duration','duplicate_rating_count','duplicate_view_count','duplicate_file_path',
      ];
      var rows = [headers];
      (matches || []).forEach(function(match) {
        var kept = match && match.kept || {};
        var dup = match && match.duplicate || {};
        rows.push([
          match && match.method || '',
          match && match.reason || '',
          match && match.key || '',
          kept.ratingKey || '',
          kept.artistName || '',
          kept.trackTitle || '',
          kept.albumName || '',
          kept.albumType || '',
          kept.recordingMbid || '',
          wizardFormatDurationMs(kept.durationMs),
          kept.ratingCount || 0,
          kept.viewCount || 0,
          kept.filePath || '',
          dup.ratingKey || '',
          dup.artistName || '',
          dup.trackTitle || '',
          dup.albumName || '',
          dup.albumType || '',
          dup.recordingMbid || '',
          wizardFormatDurationMs(dup.durationMs),
          dup.ratingCount || 0,
          dup.viewCount || 0,
          dup.filePath || '',
        ]);
      });
      return rows.map(function(row) { return row.map(wizardCsvCell).join(','); }).join('\n') + '\n';
    }

    function wizardFetchDedupeReport(limit) {
      try { wizardSaveStateFromStep(_wizardState.step || 1); } catch (_) {}
      var request = wizardBuildPreviewRequest(limit || 10000);
      return fetch(request.endpoint + '?' + request.params.toString())
        .then(function(r) {
          if (!r.ok) throw new Error('Preview failed');
          return r.json();
        })
        .then(function(data) {
          var matches = Array.isArray(data.dedupeDuplicateMatches) ? data.dedupeDuplicateMatches : [];
          var count = Number(data.dedupeDuplicateCount || 0) || 0;
          _wizardDedupePreview = { count: count, matches: matches };
          return { count: count, matches: matches };
        });
    }

    function wizardSetMessage(text) {
      var msgEl = document.getElementById('wiz-msg');
      if (msgEl) msgEl.textContent = text || '';
    }

    function wizardWriteClipboard(text) {
      if (navigator.clipboard && navigator.clipboard.writeText) return navigator.clipboard.writeText(text);
      return new Promise(function(resolve, reject) {
        var area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', 'readonly');
        area.style.position = 'fixed';
        area.style.left = '-9999px';
        document.body.appendChild(area);
        area.select();
        try {
          if (document.execCommand('copy')) resolve();
          else reject(new Error('Copy failed'));
        } catch (err) {
          reject(err);
        } finally {
          document.body.removeChild(area);
        }
      });
    }

    function wizardCopyDedupeCsv() {
      wizardSetMessage('Building duplicate report...');
      wizardFetchDedupeReport(10000)
        .then(function(report) {
          return wizardWriteClipboard(wizardDedupeMatchesToCsv(report.matches)).then(function() { return report; });
        })
        .then(function(report) {
          var suffix = report.count > report.matches.length ? ' first ' + report.matches.length.toLocaleString() + ' copied' : ' copied';
          wizardSetMessage('Duplicate CSV' + suffix + '.');
        })
        .catch(function() { wizardSetMessage('Could not copy duplicate CSV.'); });
    }

    function wizardDownloadDedupeCsv() {
      wizardSetMessage('Building duplicate report...');
      wizardFetchDedupeReport(10000)
        .then(function(report) {
          var csv = wizardDedupeMatchesToCsv(report.matches);
          var blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
          var url = URL.createObjectURL(blob);
          var link = document.createElement('a');
          link.href = url;
          link.download = 'curatorr-dedupe-duplicates-' + new Date().toISOString().slice(0, 10) + '.csv';
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          URL.revokeObjectURL(url);
          var suffix = report.count > report.matches.length ? ' first ' + report.matches.length.toLocaleString() + ' downloaded' : ' downloaded';
          wizardSetMessage('Duplicate CSV' + suffix + '.');
        })
        .catch(function() { wizardSetMessage('Could not download duplicate CSV.'); });
    }

    function clearWizardAutoloadParams(keys) {
      var url = new URL(window.location.href);
      var changed = false;
      (keys || []).forEach(function(key) {
        if (url.searchParams.has(key)) {
          url.searchParams.delete(key);
          changed = true;
        }
      });
      if (!changed) return;
      var next = url.pathname;
      var query = url.searchParams.toString();
      if (query) next += '?' + query;
      if (url.hash) next += url.hash;
      window.history.replaceState({}, document.title, next);
    }

    function wizardBindBlendPicker(stepNumber) {
      var slotsEl = document.getElementById('wiz-blend-slots');
      var addBtn  = document.getElementById('wiz-blend-add');
      if (!slotsEl) return;
      function escA(s) { return String(s||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;'); }
      function avSrc(u) { return (u && u.avatar) ? u.avatar : '/icons/user-profile.svg'; }
      function updateWizBlendMode() {
        var wrap = document.getElementById('wiz-blend-mode-wrap');
        if (wrap) wrap.style.display = slotsEl.querySelectorAll('.blend-slot').length ? '' : 'none';
      }
      window._wizGetBlendUsers = function() {
        return Array.from(slotsEl.querySelectorAll('.blend-slot')).map(function(s) { return s.dataset.uid; });
      };
      function makeWizSlot(uid) {
        var user = WIZARD_BLEND_USERS.find(function(u) { return u.id === uid; }) || { id: uid, avatar: '' };
        var slot = document.createElement('div');
        slot.className = 'blend-slot';
        slot.dataset.uid = uid;
        slot.innerHTML = '<details class="blend-slot__menu"><summary class="blend-slot__summary"><img class="blend-slot__avatar" src="' + escA(avSrc(user)) + '" alt="" onerror="this.onerror=null;this.src=\'/icons/user-profile.svg\';" /><span class="blend-slot__name">' + escH(uid) + '</span><span class="blend-slot__chev"></span></summary><div class="blend-slot__list">' +
          WIZARD_BLEND_USERS.map(function(u) { return '<button class="blend-slot__option' + (u.id===uid?' is-active':'') + '" type="button" data-uid="' + escA(u.id) + '"><img class="blend-slot__opt-avatar" src="' + escA(avSrc(u)) + '" alt="" onerror="this.onerror=null;this.src=\'/icons/user-profile.svg\';" /><span class="blend-slot__optname">' + escH(u.id) + '</span></button>'; }).join('') +
          '</div></details><button class="blend-slot__remove" type="button" aria-label="Remove">×</button>';
        slot.querySelectorAll('.blend-slot__option').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var u2 = WIZARD_BLEND_USERS.find(function(u) { return u.id === btn.dataset.uid; }) || { id: btn.dataset.uid, avatar: '' };
            slot.dataset.uid = u2.id;
            slot.querySelector('.blend-slot__avatar').src = avSrc(u2);
            slot.querySelector('.blend-slot__name').textContent = u2.id;
            slot.querySelectorAll('.blend-slot__option').forEach(function(b) { b.classList.toggle('is-active', b === btn); });
            slot.querySelector('.blend-slot__menu').removeAttribute('open');
            updateWizBlendMode();
            wizardSaveStateFromStep(stepNumber);
            setTimeout(wizardRunPreview, 300);
          });
        });
        slot.querySelector('.blend-slot__remove').addEventListener('click', function() {
          slot.remove();
          updateWizBlendMode();
          wizardSaveStateFromStep(stepNumber);
          setTimeout(wizardRunPreview, 300);
        });
        return slot;
      }
      (_wizardState.blendUsers || []).forEach(function(uid) { slotsEl.appendChild(makeWizSlot(uid)); });
      updateWizBlendMode();
      document.querySelectorAll('input[name="wiz-blend-mode"]').forEach(function(radio) {
        radio.addEventListener('change', function() {
          wizardSaveStateFromStep(stepNumber);
          setTimeout(wizardRunPreview, 300);
        });
      });
      if (addBtn && WIZARD_BLEND_USERS.length > 1) {
        addBtn.addEventListener('click', function() {
          var selected = new Set(window._wizGetBlendUsers ? window._wizGetBlendUsers() : []);
          var first = WIZARD_BLEND_USERS.find(function(user) { return !selected.has(user.id); }) || WIZARD_BLEND_USERS[0];
          if (first) {
            slotsEl.appendChild(makeWizSlot(first.id));
            updateWizBlendMode();
            wizardSaveStateFromStep(stepNumber);
            setTimeout(wizardRunPreview, 300);
          }
        });
      }
    }

    function wizardBindStep(step) {
      // Back button
      var backBtn = document.getElementById('wiz-back-btn');
      if (backBtn) backBtn.addEventListener('click', function() {
        wizardSaveStateFromStep(step);
        wizardRenderStep(step - 1);
      });
      // Next / create button
      var nextBtn = document.getElementById('wiz-next-btn');
      if (nextBtn) nextBtn.addEventListener('click', function() {
        wizardSaveStateFromStep(step);
        var msgEl = document.getElementById('wiz-msg');
        if (step === 1) {
          if (_wizardState.playlistTarget === 'blend' && !(_wizardState.blendUsers || []).length) {
            if (msgEl) msgEl.textContent = 'Add at least one user to make this a blend playlist.';
            return;
          }
        }
        if (msgEl) msgEl.textContent = '';
        wizardRenderStep(step + 1);
      });
      var createBtn = document.getElementById('wiz-create-btn');
      if (createBtn) createBtn.addEventListener('click', function() {
        wizardSaveStateFromStep(step);
        var msgEl = document.getElementById('wiz-msg');
        if (_wizardState.playlistTarget === 'blend' && !(_wizardState.blendUsers || []).length) {
          if (msgEl) msgEl.textContent = 'Add at least one user to make this a blend playlist.';
          return;
        }
        // Optionally save as template first
        var tmplNameEl = document.getElementById('wiz-tmpl-name');
        var tmplName = tmplNameEl ? tmplNameEl.value.trim() : '';
        if (tmplName) {
          fetch('/api/music/playlist-templates', {
            method: 'POST', headers: {'Content-Type':'application/json','X-CSRF-Token':CSRF},
            body: JSON.stringify({
              name: tmplName,
              rules: wizardAssembleRules(_wizardState),
              trackFilters: wizardAssembleTrackFilters(_wizardState),
              startingPointId: _wizardState.startingPointId || 'blank',
            }),
          }).catch(function(){});
        }
        createSmartPlaylist(_wizardState.name, wizardAssembleRules(_wizardState), {
          playlistTarget: _wizardState.playlistTarget || 'personal',
          trackFilters: wizardAssembleTrackFilters(_wizardState),
          artwork: wizardAssembleArtwork(_wizardState),
          editKind: _wizardEditKind,
          editId: _wizardEditId,
          importSource: _wizardState.importSource || null,
          removeImportedSourcePlaylistKey: _wizardState.importSource && _wizardState.keepImportedSource === false
            ? String(_wizardState.importSource.playlistKey || '')
            : '',
        });
      });
      var saveDraftBtn = document.getElementById('wiz-save-draft-btn');
      if (saveDraftBtn) saveDraftBtn.addEventListener('click', function() {
        wizardSaveStateFromStep(step);
        createSmartPlaylist(_wizardState.name, wizardAssembleRules(_wizardState), {
          playlistTarget: _wizardState.playlistTarget || 'personal',
          trackFilters: wizardAssembleTrackFilters(_wizardState),
          artwork: wizardAssembleArtwork(_wizardState),
          editKind: _wizardEditKind,
          editId: _wizardEditId,
          allowEmptyDraft: true,
          importSource: _wizardState.importSource || null,
        });
      });
      var copyDedupeBtn = document.getElementById('wiz-dedupe-copy-btn');
      if (copyDedupeBtn) copyDedupeBtn.addEventListener('click', wizardCopyDedupeCsv);
      var downloadDedupeBtn = document.getElementById('wiz-dedupe-download-btn');
      if (downloadDedupeBtn) downloadDedupeBtn.addEventListener('click', wizardDownloadDedupeCsv);

      // Step 1: basics
      if (step === 1) {
        document.querySelectorAll('#spm-wizard-body .spm-wizard-choice-card').forEach(function(card) {
          card.addEventListener('click', function() {
            wizardSaveStateFromStep(1);
            _wizardState.playlistTarget = card.dataset.target || 'personal';
            wizardRenderStep(1);
          });
        });
        document.querySelectorAll('#spm-wizard-body [data-user-template-id]').forEach(function(card) {
          card.addEventListener('click', function() {
            wizardSaveStateFromStep(1);
            wizardApplyTemplate(card.dataset.userTemplateId);
            wizardRenderStep(1);
          });
        });
        document.querySelectorAll('#spm-wizard-body [data-starting-point-id]').forEach(function(card) {
          card.addEventListener('click', function() {
            wizardSaveStateFromStep(1);
            wizardApplyTemplate(card.dataset.startingPointId);
            wizardRenderStep(1);
          });
        });
        document.querySelectorAll('#spm-wizard-body [data-audio-preset]').forEach(function(card) {
          card.addEventListener('click', function() {
            if (card.disabled) return;
            var alreadySelected = card.classList.contains('is-selected');
            wizardSaveStateFromStep(1);
            var nextPreset = alreadySelected ? 'none' : card.dataset.audioPreset;
            wizardReplaceAudioState(_wizardState, nextPreset);
            wizardRenderStep(1);
          });
        });
        ['wiz-bpm-min', 'wiz-bpm-max', 'wiz-energy-min', 'wiz-energy-max', 'wiz-dance-min', 'wiz-dance-max', 'wiz-camelot-focus', 'wiz-camelot-mode'].forEach(function(id) {
          var el = document.getElementById(id);
          if (!el) return;
          var handler = function() { wizardSaveStateFromStep(1); setTimeout(wizardRunPreview, 200); };
          el.addEventListener('change', handler);
          if (el.tagName === 'INPUT') el.addEventListener('input', handler);
        });
        if (_wizardState.playlistTarget === 'blend') wizardBindBlendPicker(1);
      }

      // Step 2: content
      if (step === 2) {
        var applySuggestedBtn = document.getElementById('wiz-apply-suggested-content');
        if (applySuggestedBtn) {
          applySuggestedBtn.addEventListener('click', function() {
            wizardToggleContentStateFromAudioProfile(_wizardState, _wizardState.featurePreset || 'none');
            wizardRenderStep(2);
            setTimeout(wizardRunPreview, 50);
          });
        }
        var toggleImportDetectedBtn = document.getElementById('wiz-toggle-import-detected');
        if (toggleImportDetectedBtn) {
          toggleImportDetectedBtn.addEventListener('click', function() {
            wizardToggleImportedContentMode(_wizardState);
            wizardRenderStep(2);
            setTimeout(wizardRunPreview, 50);
          });
        }
        var clearContentBtn = document.getElementById('wiz-clear-content-filters');
        if (clearContentBtn) {
          clearContentBtn.addEventListener('click', function() {
            wizardClearContentState(_wizardState);
            wizardRenderStep(2);
            setTimeout(wizardRunPreview, 50);
          });
        }
        document.querySelectorAll('#spm-wizard-body [data-accordion-toggle]').forEach(function(btn) {
          btn.addEventListener('click', function() {
            _wizardState.activeContentSection = btn.dataset.accordionToggle || 'genre';
            wizardRenderStep(2);
          });
        });
        document.querySelectorAll('#spm-wizard-body [data-match-mode-kind]').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var group = btn.closest('[data-match-mode-group]');
            if (group) {
              group.querySelectorAll('[data-match-mode-kind]').forEach(function(peer) {
                peer.classList.toggle('is-selected', peer === btn);
              });
            }
            wizardSaveStateFromStep(2);
            setTimeout(wizardRunPreview, 200);
          });
        });
        var lastPlayedModeEl = document.getElementById('wiz-last-played-mode');
        if (lastPlayedModeEl) {
          lastPlayedModeEl.addEventListener('change', function() {
            wizardSaveStateFromStep(2);
            if ((_wizardState.lastPlayedMode === 'within' || _wizardState.lastPlayedMode === 'notWithin') && !_wizardState.lastPlayedDays) {
              _wizardState.lastPlayedDays = 30;
            }
            wizardRenderStep(2);
            setTimeout(wizardRunPreview, 50);
          });
        }
        var lastPlayedDaysEl = document.getElementById('wiz-last-played-days');
        if (lastPlayedDaysEl) {
          var lastPlayedDaysHandler = function() {
            wizardSaveStateFromStep(2);
            setTimeout(wizardRunPreview, 200);
          };
          lastPlayedDaysEl.addEventListener('change', lastPlayedDaysHandler);
          lastPlayedDaysEl.addEventListener('input', lastPlayedDaysHandler);
        }
        document.querySelectorAll('#spm-wizard-body .spm-chip').forEach(function(chip) {
          chip.addEventListener('click', function() {
            var s = chip.dataset.state || 'neutral';
            if (s === 'neutral')  { chip.dataset.state = 'include'; chip.classList.add('is-include'); chip.classList.remove('is-exclude'); }
            else if (s === 'include') { chip.dataset.state = 'exclude'; chip.classList.add('is-exclude'); chip.classList.remove('is-include'); }
            else { chip.dataset.state = 'neutral'; chip.classList.remove('is-include','is-exclude'); }
            wizardSaveStateFromStep(2);
            setTimeout(wizardRunPreview, 300);
          });
        });
        document.querySelectorAll('#spm-wizard-body .wiz-chip-search').forEach(function(inp) {
          inp.addEventListener('input', function() {
            var q = inp.value.toLowerCase();
            var kind = inp.dataset.kind;
            document.querySelectorAll('#wiz-chips-' + kind + ' .spm-chip').forEach(function(chip) {
              chip.dataset.hidden = chip.dataset.value.toLowerCase().indexOf(q) === -1 ? 'true' : 'false';
            });
          });
        });
      } else if (step === WIZARD_TOTAL_STEPS) {
        var artworkModeEl = document.getElementById('wiz-artwork-mode');
        var artworkFileEl = document.getElementById('wiz-artwork-file');
        var artworkStatusEl = document.getElementById('wiz-artwork-status');
        var artworkWrapEl = document.getElementById('wiz-artwork-custom-wrap');
        if (artworkModeEl) {
          artworkModeEl.addEventListener('change', function() {
            _wizardState.artworkMode = artworkModeEl.value || 'auto';
            if (artworkWrapEl) artworkWrapEl.style.display = _wizardState.artworkMode === 'custom' ? '' : 'none';
          });
        }
        if (artworkFileEl) {
          artworkFileEl.addEventListener('change', function() {
            var file = artworkFileEl.files && artworkFileEl.files[0];
            if (!file) {
              _wizardState.customArtworkData = '';
              if (artworkStatusEl) artworkStatusEl.textContent = _wizardState.customArtworkAsset
                ? 'Current custom image will stay in place unless you upload a replacement.'
                : 'PNG, JPG, or WEBP up to 5 MB.';
              return;
            }
            var allowed = ['image/png', 'image/jpeg', 'image/webp'];
            if (allowed.indexOf(String(file.type || '').toLowerCase()) === -1) {
              artworkFileEl.value = '';
              _wizardState.customArtworkData = '';
              if (artworkStatusEl) artworkStatusEl.textContent = 'Please choose a PNG, JPG, or WEBP image.';
              return;
            }
            if (Number(file.size || 0) > 5 * 1024 * 1024) {
              artworkFileEl.value = '';
              _wizardState.customArtworkData = '';
              if (artworkStatusEl) artworkStatusEl.textContent = 'Artwork images must be 5 MB or smaller.';
              return;
            }
            var reader = new FileReader();
            reader.onload = function(loadEvent) {
              _wizardState.customArtworkData = String(loadEvent && loadEvent.target && loadEvent.target.result || '');
              if (artworkStatusEl) artworkStatusEl.textContent = 'Ready to save: ' + file.name;
            };
            reader.onerror = function() {
              _wizardState.customArtworkData = '';
              if (artworkStatusEl) artworkStatusEl.textContent = 'Could not read the selected image.';
            };
            reader.readAsDataURL(file);
          });
        }
      }

      // Step 3: output rules
      if (step === 3) {
        ['wiz-top-n','wiz-max-album-tracks','wiz-max-tracks','wiz-album-popularity','wiz-popularity-mode','wiz-popularity-percent','wiz-sort-by','wiz-final-ordering','wiz-dedupe-mbid','wiz-dedupe-artist-title','wiz-dedupe-duration','wiz-dedupe-variant-guard','wiz-dedupe-live-album-guard'].forEach(function(id) {
          var el = document.getElementById(id);
          if (!el) return;
          var handler = function() { wizardSaveStateFromStep(3); setTimeout(wizardRunPreview, 300); };
          if (id === 'wiz-popularity-mode') {
            handler = function() {
              wizardSaveStateFromStep(3);
              wizardRenderStep(3);
            };
          }
          el.addEventListener('change', handler);
          if (el.tagName === 'INPUT' && el.type !== 'checkbox') el.addEventListener('input', handler);
        });
      }

      // Step 4: advanced settings (admin only)
      if (step === 4 && IS_ACTUAL_ADMIN) {
        document.querySelectorAll('#spm-wizard-body [data-advanced-toggle]').forEach(function(btn) {
          btn.addEventListener('click', function() {
            _wizardState.activeAdvancedSection = btn.dataset.advancedToggle || 'include';
            wizardRenderStep(4);
          });
        });
        ['include', 'exclude'].forEach(function(kind) {
          var chips = document.getElementById('wiz-folder-' + kind + '-chips');
          if (chips) {
            chips.querySelectorAll('.spm-folder-chip-remove').forEach(function(btn) {
              btn.onclick = function() {
                var chip = btn.closest('.spm-folder-chip');
                if (chip) chip.remove();
                wizardSaveStateFromStep(4);
                setTimeout(wizardRunPreview, 150);
              };
            });
          }
          document.querySelectorAll('[data-folder-root="' + kind + '"]').forEach(function(btn) {
            btn.addEventListener('click', function() {
              wizardSaveStateFromStep(4);
              _wizardFolderBrowse[kind] = '';
              wizardRenderStep(4);
            });
          });
          document.querySelectorAll('[data-folder-up="' + kind + '"]').forEach(function(btn) {
            btn.addEventListener('click', function() {
              wizardSaveStateFromStep(4);
              var current = _wizardFolderBrowse[kind] || '';
              _wizardFolderBrowse[kind] = current.indexOf('/') === -1 ? '' : current.split('/').slice(0, -1).join('/');
              wizardRenderStep(4);
            });
          });
          document.querySelectorAll('[data-folder-browse="' + kind + '"]').forEach(function(btn) {
            btn.addEventListener('click', function() {
              wizardSaveStateFromStep(4);
              _wizardFolderBrowse[kind] = btn.dataset.folderPath || '';
              wizardRenderStep(4);
            });
          });
          document.querySelectorAll('[data-folder-open="' + kind + '"]').forEach(function(btn) {
            btn.addEventListener('click', function() {
              wizardSaveStateFromStep(4);
              _wizardFolderBrowse[kind] = btn.dataset.folderPath || '';
              wizardRenderStep(4);
            });
          });
          document.querySelectorAll('[data-folder-add="' + kind + '"]').forEach(function(btn) {
            btn.addEventListener('click', function() {
              var value = btn.dataset.folderPath || '';
              if (!chips || !value) return;
              if (Array.from(chips.querySelectorAll('[data-folder]')).some(function(chip) { return chip.dataset.folder === value; })) return;
              var chip = document.createElement('span');
              chip.className = 'spm-folder-chip';
              chip.dataset.folder = value;
              chip.innerHTML = escH(value) + '<button type="button" class="spm-folder-chip-remove" aria-label="Remove">×</button>';
              chips.appendChild(chip);
              wizardSaveStateFromStep(4);
              setTimeout(wizardRunPreview, 150);
              chip.querySelector('.spm-folder-chip-remove').onclick = function() {
                chip.remove();
                wizardSaveStateFromStep(4);
                setTimeout(wizardRunPreview, 150);
              };
            });
          });
        });
        var regexAddBtn = document.getElementById('wiz-regex-add');
        if (regexAddBtn) regexAddBtn.addEventListener('click', function() {
          wizardSaveStateFromStep(4);
          _wizardState.advancedRules = (_wizardState.advancedRules || []).concat([{ field: 'trackTitle', operator: 'regex', value: '', caseSensitive: false }]);
          wizardRenderStep(4);
        });
        document.querySelectorAll('[data-regex-remove]').forEach(function(btn) {
          btn.addEventListener('click', function() {
            wizardSaveStateFromStep(4);
            var idx = parseInt(btn.dataset.regexRemove || '', 10);
            _wizardState.advancedRules = (_wizardState.advancedRules || []).filter(function(_, index) { return index !== idx; });
            wizardRenderStep(4);
          });
        });
        document.querySelectorAll('#wiz-regex-rules select, #wiz-regex-rules input').forEach(function(el) {
          var handler = function() {
            var row = el.closest('.spm-wizard-regex-row');
            if (el.classList.contains('wiz-regex-field') || el.classList.contains('wiz-regex-operator')) wizardSyncTrackRuleRow(row);
            wizardSaveStateFromStep(4);
            setTimeout(wizardRunPreview, 200);
          };
          el.addEventListener('change', handler);
          if (el.tagName === 'INPUT' && el.type !== 'checkbox') el.addEventListener('input', handler);
        });
      }

      // Finish step: save template + schedule
      if (step === WIZARD_TOTAL_STEPS) {
        var finishNameEl = document.getElementById('wiz-finish-name');
        if (finishNameEl) {
          finishNameEl.addEventListener('input', function() {
            _wizardState.name = finishNameEl.value.trim();
            _wizardState.nameManual = true;
          });
        }
        var scheduleEl = document.getElementById('wiz-schedule');
        if (scheduleEl) scheduleEl.addEventListener('change', function() { wizardSaveStateFromStep(WIZARD_TOTAL_STEPS); });
        var saveTmplBtn = document.getElementById('wiz-save-tmpl-btn');
        if (saveTmplBtn) saveTmplBtn.addEventListener('click', function() {
          wizardSaveStateFromStep(WIZARD_TOTAL_STEPS);
          var nameEl = document.getElementById('wiz-tmpl-name');
          var n = nameEl ? nameEl.value.trim() : '';
          if (!n) { nameEl && nameEl.focus(); return; }
          var msgEl = document.getElementById('wiz-msg');
          fetch('/api/music/playlist-templates', {
            method: 'POST', headers: {'Content-Type':'application/json','X-CSRF-Token':CSRF},
            body: JSON.stringify({
              name: n,
              rules: wizardAssembleRules(_wizardState),
              trackFilters: wizardAssembleTrackFilters(_wizardState),
              startingPointId: _wizardState.startingPointId || 'blank',
            }),
          }).then(function() {
            return wizardRefreshTemplates({ keepTemplateId: _wizardState.templateId || 'blank' });
          }).then(function() {
            saveTmplBtn.textContent = 'Saved ✓';
            saveTmplBtn.disabled = true;
            if (nameEl) nameEl.value = '';
            if (msgEl) msgEl.textContent = 'Template saved.';
            setTimeout(function() {
              saveTmplBtn.textContent = 'Save template';
              saveTmplBtn.disabled = false;
            }, 2000);
          }).catch(function() {
            if (msgEl) msgEl.textContent = 'Unable to save template.';
          });
        });
        var updateTmplBtn = document.getElementById('wiz-update-tmpl-btn');
        if (updateTmplBtn) updateTmplBtn.addEventListener('click', function() {
          wizardSaveStateFromStep(WIZARD_TOTAL_STEPS);
          var selectedTemplate = wizardSelectedUserTemplate();
          var nameEl = document.getElementById('wiz-selected-tmpl-name');
          var n = nameEl ? nameEl.value.trim() : '';
          var msgEl = document.getElementById('wiz-msg');
          if (!selectedTemplate) {
            if (msgEl) msgEl.textContent = 'Select a saved template first.';
            return;
          }
          if (!n) {
            if (nameEl) nameEl.focus();
            return;
          }
          updateTmplBtn.disabled = true;
          fetch('/api/music/playlist-templates/' + encodeURIComponent(selectedTemplate.id), {
            method: 'PUT', headers: {'Content-Type':'application/json','X-CSRF-Token':CSRF},
            body: JSON.stringify({
              name: n,
              rules: wizardAssembleRules(_wizardState),
              trackFilters: wizardAssembleTrackFilters(_wizardState),
              startingPointId: _wizardState.startingPointId || 'blank',
            }),
          }).then(function(r) {
            if (!r.ok) throw new Error('update_failed');
            return wizardRefreshTemplates({ keepTemplateId: selectedTemplate.id });
          }).then(function() {
            if (!_wizardState.nameManual) wizardSyncSuggestedName(_wizardState, false);
            wizardRenderStep(WIZARD_TOTAL_STEPS);
            var nextMsgEl = document.getElementById('wiz-msg');
            if (nextMsgEl) nextMsgEl.textContent = 'Template updated.';
          }).catch(function() {
            if (msgEl) msgEl.textContent = 'Unable to update template.';
            updateTmplBtn.disabled = false;
          });
        });
        var deleteTmplBtn = document.getElementById('wiz-delete-tmpl-btn');
        if (deleteTmplBtn) deleteTmplBtn.addEventListener('click', function() {
          wizardSaveStateFromStep(WIZARD_TOTAL_STEPS);
          var selectedTemplate = wizardSelectedUserTemplate();
          var msgEl = document.getElementById('wiz-msg');
          if (!selectedTemplate) {
            if (msgEl) msgEl.textContent = 'Select a saved template first.';
            return;
          }
          if (!window.confirm('Delete template "' + selectedTemplate.name + '"?')) return;
          deleteTmplBtn.disabled = true;
          fetch('/api/music/playlist-templates/' + encodeURIComponent(selectedTemplate.id), {
            method: 'DELETE', headers: {'X-CSRF-Token':CSRF},
          }).then(function(r) {
            if (!r.ok) throw new Error('delete_failed');
            _wizardState.templateId = 'blank';
            if (!_wizardState.nameManual) wizardSyncSuggestedName(_wizardState, false);
            return wizardRefreshTemplates({ keepTemplateId: 'blank' });
          }).then(function() {
            wizardRenderStep(WIZARD_TOTAL_STEPS);
            var nextMsgEl = document.getElementById('wiz-msg');
            if (nextMsgEl) nextMsgEl.textContent = 'Template deleted.';
          }).catch(function() {
            if (msgEl) msgEl.textContent = 'Unable to delete template.';
            deleteTmplBtn.disabled = false;
          });
        });
      }
    }

    function initSmartPlaylistModal() {
      document.querySelectorAll('.spm-artist-tier, .spm-track-tier').forEach(function(cb) {
        cb.addEventListener('change', spmSchedulePreview);
      });

      // Tri-state chip click cycling: neutral → include → exclude → neutral
      document.querySelectorAll('#spm-flat-form .spm-chip').forEach(function(chip) {
        chip.addEventListener('click', function() {
          var state = chip.dataset.state || 'neutral';
          if (state === 'neutral') {
            chip.dataset.state = 'include';
            chip.classList.add('is-include');
            chip.classList.remove('is-exclude');
          } else if (state === 'include') {
            chip.dataset.state = 'exclude';
            chip.classList.add('is-exclude');
            chip.classList.remove('is-include');
          } else {
            chip.dataset.state = 'neutral';
            chip.classList.remove('is-include', 'is-exclude');
          }
          spmSchedulePreview();
        });
      });

      // Tri-state chip search filter
      document.querySelectorAll('#spm-flat-form .spm-tristate-search').forEach(function(input) {
        input.addEventListener('input', function() {
          var q = this.value.toLowerCase();
          var chipsId = this.getAttribute('data-chips');
          var container = chipsId ? document.getElementById(chipsId) : null;
          if (!container) return;
          container.querySelectorAll('.spm-chip').forEach(function(chip) {
            chip.dataset.hidden = chip.dataset.value.toLowerCase().indexOf(q) === -1 ? 'true' : 'false';
          });
        });
      });

      ['spm-top-n', 'spm-max-album-tracks', 'spm-max-tracks', 'spm-sort-by', 'spm-rebuild-schedule', 'spm-bpm-min', 'spm-bpm-max', 'spm-energy-min', 'spm-energy-max', 'spm-danceability-min', 'spm-danceability-max', 'spm-camelot-focus', 'spm-camelot-mode'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.addEventListener('change', spmSchedulePreview);
        if (el && el.tagName === 'INPUT') el.addEventListener('input', spmSchedulePreview);
      });
      document.querySelectorAll('#spm-preset-grid .playlist-preset-card').forEach(function(card) {
        card.addEventListener('click', function() {
          spmApplyPresetDefaults(card.dataset.preset || 'none');
        });
      });
    }

    initSmartPlaylistModal();

    bindPlaylistCarousel();
    bindPlaylistCarouselAutoCollapse();
    document.querySelectorAll('[data-playlist-type-filter]').forEach(function(button) {
      button.addEventListener('click', function() {
        _playlistCardFilterState.type = String(button.getAttribute('data-playlist-type-filter') || 'all');
        applyPlaylistCardFilters({ resetScroll: true });
      });
    });
    document.querySelectorAll('[data-playlist-status-filter]').forEach(function(button) {
      button.addEventListener('click', function() {
        _playlistCardFilterState.status = String(button.getAttribute('data-playlist-status-filter') || 'all');
        applyPlaylistCardFilters({ resetScroll: true });
      });
    });
    updatePlaylistFilterButtons();
    var initialCard = document.querySelector('#playlistCarouselTrack .cur-playlist-carousel-card');
    if (initialCard) applyPlaylistCardFilters();
    else loadTracks(0);

    // Auto-open smart playlist modal with prefill params if navigated from elsewhere
    (function() {
      var params = new URLSearchParams(window.location.search);
      var editPersonalId = params.get('editPersonal');
      var editGlobalId = params.get('editGlobal');
      var wizardTarget = params.get('wizardTarget');
      var blendParam = params.get('blend');
      var nameParam = params.get('name');
      if (editPersonalId) {
        clearWizardAutoloadParams(['editPersonal']);
        openWizardEdit('personal', editPersonalId, '/api/music/playlists/personal/' + encodeURIComponent(editPersonalId));
        return;
      }
      if (editGlobalId) {
        clearWizardAutoloadParams(['editGlobal']);
        openWizardEdit('global', editGlobalId, '/api/playlists/global/' + encodeURIComponent(editGlobalId));
        return;
      }
      if (wizardTarget === 'global' && IS_ACTUAL_ADMIN) {
        clearWizardAutoloadParams(['wizardTarget']);
        openSmartPlaylistWizard({ playlistTarget: 'global' });
        return;
      }
      if (!blendParam) return;
      var otherUsers = blendParam.split(',').map(function(u) { return u.trim(); }).filter(Boolean);
      if (!otherUsers.length) return;
      var blendUsers = CURRENT_USER_ID ? [CURRENT_USER_ID].concat(otherUsers) : otherUsers;
      clearWizardAutoloadParams(['blend', 'name']);
      openSmartPlaylistWizard({
        name: nameParam || '',
        playlistTarget: 'blend',
        blendUsers: blendUsers,
        blendMode: 'average',
      });
    })();

    document.addEventListener('click', function(e) {
      if (!e.target.closest('.pl-card-dots-wrap')) closeAllCardMenus();
    });
  </script>
</body>
</html>

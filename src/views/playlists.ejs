              '<span class="spm-chip-hint" style="margin:0">Days</span>' +
              '<input type="number" id="wiz-last-played-days" class="input" min="1" step="1" placeholder="30" value="' + escH(_wizardState.lastPlayedDays != null ? String(_wizardState.lastPlayedDays) : '') + '" />' +
            '</label>' +
          '</div>' +
        '</div>' +
        '<div class="spm-wizard-subsection spm-wizard-accordion' + (tiersOpen ? ' is-open' : '') + '" data-accordion-kind="tiers">' +
          '<button type="button" class="spm-wizard-accordion-toggle" data-accordion-toggle="tiers">' +
            '<span class="spm-wizard-subsection-title">Artist and track tiers</span>' +
            '<span class="spm-wizard-accordion-indicator">' + (tiersOpen ? '−' : '+') + '</span>' +

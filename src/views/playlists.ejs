      card.dataset.plKey = data.playlistKey || '';
      card.dataset.plTitle = data.playlistTitle || 'Playlist';
      card.dataset.playlistKind = data.playlistKind || 'generated';
      card.dataset.playlistType = data.playlistType || 'custom';
      card.dataset.playlistAudience = resolvePlaylistAudience(data);
      card.dataset.playlistActive = data.active === false ? 'false' : 'true';
      card.dataset.playlistState = data.active === false ? 'disabled' : (String(data.playlistKind || '').trim().toLowerCase() === 'draft' ? 'draft' : (data.plexPlaylistId ? 'synced' : 'pending'));
      card.dataset.playlistTrackCount = String(Number(data.trackCount || 0));
      card.dataset.playlistMissingCount = String(Number(data.missingCount || 0));

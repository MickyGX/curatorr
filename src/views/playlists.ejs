        .then(function(r) { return r.json(); })
        .then(function(data) {
          _wizardTemplates = data.templates || [];
          var keepTemplateId = String(options.keepTemplateId || '').trim();
          if (!keepTemplateId) return _wizardTemplates;
          if (_wizardTemplates.some(function(t) { return t.id === keepTemplateId; }) || keepTemplateId === 'blank') {
            _wizardState.templateId = keepTemplateId;
            if (!String(_wizardState.startingPointId || '').trim()) _wizardState.startingPointId = 'blank';
            return _wizardTemplates;
          }
          _wizardState.templateId = 'blank';
          _wizardState.startingPointId = 'blank';
          return _wizardTemplates;
        })
        .catch(function() {
          _wizardTemplates = [];
          if (options.keepTemplateId) {

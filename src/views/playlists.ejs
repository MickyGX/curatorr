    var WIZARD_LIBRARY_TRACK_COUNT = <%- JSON.stringify((playlistFeatureCoverage && playlistFeatureCoverage.totalTracks) || 0) %>;
    var WIZARD_GENERATED_PLAYLIST_COUNTS = <%- JSON.stringify((playlistCards || []).reduce(function(map, card) {
      var type = String(card && card.playlistType || '').trim();
      var count = Number(card && card.trackCount || 0);
      if (type && count > 0 && !map[type]) map[type] = count;
      return map;
    }, {})) %>;

    var WIZARD_TOTAL_STEPS = IS_ACTUAL_ADMIN ? 5 : 4;

    function cloneWizardValue(value) {
      return value == null ? value : JSON.parse(JSON.stringify(value));
    }

    function normaliseUiTriState(value) {
      if (!value) return { include: [], exclude: [], includeMode: 'any' };
      if (Array.isArray(value)) return { include: value.filter(Boolean), exclude: [], includeMode: 'any' };
      return {
        include: Array.isArray(value.include) ? value.include.filter(Boolean) : [],
        exclude: Array.isArray(value.exclude) ? value.exclude.filter(Boolean) : [],
        includeMode: value.includeMode === 'all' ? 'all' : 'any',
      };
    }

    function wizardNormalizeStarterPreset(value) {
      var raw = String(value || '').trim().toLowerCase();
      return ['none','club','driving','workout','chill','harmonic','downtempo','wakeup'].indexOf(raw) !== -1 ? raw : 'none';
    }

    function wizardStarterTrackFilters(trackFilters) {
      var tf = trackFilters && typeof trackFilters === 'object' ? trackFilters : null;
      if (!tf) return { includeFolders: [], excludeFolders: [], rules: [], deduplicateByMbid: false, deduplicateByArtistTitle: false, deduplicateByDuration: false, deduplicateIgnoreLikelyVariants: false, deduplicateIgnoreLiveAlbums: false };
      return {
        includeFolders: Array.isArray(tf.includeFolders) ? tf.includeFolders.slice() : [],
        excludeFolders: Array.isArray(tf.excludeFolders) ? tf.excludeFolders.slice() : [],
        rules: Array.isArray(tf.rules) ? tf.rules.filter(function(rule) {
          return String(rule && rule.field || '') !== 'ratingCount';
        }).map(function(rule) { return cloneWizardValue(rule); }) : [],
        deduplicateByMbid: Boolean(tf.deduplicateByMbid),
        deduplicateByArtistTitle: Boolean(tf.deduplicateByArtistTitle),
        deduplicateByDuration: Boolean(tf.deduplicateByDuration),
        deduplicateIgnoreLikelyVariants: Boolean(tf.deduplicateIgnoreLikelyVariants),
        deduplicateIgnoreLiveAlbums: Boolean(tf.deduplicateIgnoreLiveAlbums),
      };
    }

    function wizardEstimatedStarterMaxTracks(capMultiplier, fallback) {
      var cap = Number(capMultiplier);
      var total = Number(WIZARD_LIBRARY_TRACK_COUNT || 0);
      if (Number.isFinite(cap) && cap > 0 && total > 0) return Math.max(1, Math.round(total * Math.max(0, Math.min(1, cap))));
      var fallbackNum = Number(fallback);
      return Number.isFinite(fallbackNum) && fallbackNum > 0 ? Math.round(fallbackNum) : null;
    }

    function wizardManagedStarterTrackCount(type, capMultiplier, baselineShare) {
      var liveCount = Number((WIZARD_GENERATED_PLAYLIST_COUNTS || {})[type] || 0);
      if (Number.isFinite(liveCount) && liveCount > 0) return Math.round(liveCount);
      var total = Number(WIZARD_LIBRARY_TRACK_COUNT || 0);
      var share = Number(baselineShare);
      var cap = Number(capMultiplier);
      if (total > 0 && Number.isFinite(share) && share > 0) {
        var normalizedCap = Number.isFinite(cap) ? Math.max(0, Math.min(1, cap)) : 1;
        return Math.max(1, Math.round(total * share * normalizedCap));
      }
      return null;
    }

    function wizardPctLabel(value, fallback) {
      var num = Number(value);
      if (!Number.isFinite(num)) num = Number(fallback);
      if (!Number.isFinite(num)) return '';
      return Math.round(num * 100) + '%';
    }


      var listenbrainzBtn = document.getElementById('importListenbrainzTabBtn');
      var plexPanel = document.getElementById('importPlexPanel');
      var spotifyPanel = document.getElementById('importSpotifyPanel');
      var urlPanel = document.getElementById('importUrlPanel');
      var lastfmPanel = document.getElementById('importLastfmPanel');
      var listenbrainzPanel = document.getElementById('importListenbrainzPanel');
      var previewWrap = document.getElementById('importPreviewWrap');
      if (plexBtn) {
        plexBtn.classList.toggle('is-active', _importSourceTab === 'plex');
        plexBtn.setAttribute('aria-selected', _importSourceTab === 'plex' ? 'true' : 'false');

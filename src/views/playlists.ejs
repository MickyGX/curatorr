    function wizardFolderChildren(prefix) {
      var base = prefix ? prefix + '/' : '';
      var seen = new Set();
      return ALL_PATH_SEGMENTS.reduce(function(acc, path) {
        if (prefix) {
          if (path === prefix || path.indexOf(base) !== 0) return acc;
        }
        var rest = prefix ? path.slice(base.length) : path;
        if (!rest) return acc;
        var name = rest.split('/')[0];
        var fullPath = prefix ? (prefix + '/' + name) : name;
        if (!name || seen.has(fullPath)) return acc;
        seen.add(fullPath);
        acc.push({
          name: name,
          path: fullPath,
          hasChildren: ALL_PATH_SEGMENTS.some(function(entry) { return entry.indexOf(fullPath + '/') === 0; }),
        });
        return acc;
      }, []).sort(function(a, b) { return a.name.localeCompare(b.name); });

        var s = '<div class="spm-filter-section">' +
          '<div class="spm-filter-label">' + escH(title) + '</div>' +
          renderIncludeModeControl(kind, mode) +
          '<input type="text" class="spm-tristate-search wiz-chip-search" placeholder="' + escH(placeholderSearch) + '" data-kind="' + kind + '" />' +
          '<div class="spm-tristate-chips" id="wiz-chips-' + kind + '">';
        var incSet = new Set(triState.include || []);
        var excSet = new Set(triState.exclude || []);
        items.forEach(function(v) {
          var state = incSet.has(v) ? 'include' : excSet.has(v) ? 'exclude' : 'neutral';
          var cls = state === 'include' ? ' is-include' : state === 'exclude' ? ' is-exclude' : '';

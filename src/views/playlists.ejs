          bodyHtml +
          '</div>';
      }

      var mediaServerBody = '';
      mediaServerBody += '<div class="spm-wizard-subsection" style="margin-top:14px">' +
        '<div class="spm-wizard-subsection-title" style="font-size:12px;letter-spacing:.16em;text-transform:uppercase">' + escH(mediaServerLabel + ' track metadata') + '</div>' +
        renderWizChips(ALLGENRES, _wizardState.genres, 'genre', 'Filter genres…') +
        renderWizChips(ALLMOODS,  _wizardState.moods,  'mood',  'Filter moods…') +
        '</div>';
      mediaServerBody += '<div class="spm-wizard-subsection" style="margin-top:14px">' +
